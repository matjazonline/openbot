+        );
+        refused(
+            ActionService::new(adapter(&f, 0))
+                .dispatch_remote(&request, &provider, &CancellationToken::new())
+                .await
+                .map(|_| ()),
+        );
+        assert_eq!(provider.polls.load(Ordering::SeqCst), 1);
+        inert(&f, &request, &run.cancelled).await;
