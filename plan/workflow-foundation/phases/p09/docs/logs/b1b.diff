+        ),
+        Err(AppError::Conflict(_) | AppError::NotFound(_)) => (
+            None,
+            Some(format!(
+                "{} changed or was revoked since the page was shown; nothing was revoked. Here are the tools as they are now.",
+                name.as_str()
+            )),
+        ),
