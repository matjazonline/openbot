+//! The run controls through the workspace: each acts at the revision the page showed, says what
+//! it did or why it did nothing, and the annotation of an uncertain action records a note without
+//! resuming the run.
+use super::*;
+
+#[tokio::test]
+async fn controls_act_at_the_revision_seen_and_say_what_they_did() {
+    let Some(f) = Fixture::new().await else {
+        return;
+    };
+    // A step that fails at run time: its output is not the integer its schema asks for.
+    let workflow = Uuid::new_v4();
+    let mut source = example("data.map", workflow);
+    source["input_schema"] = json!({"type": "object", "properties": {"x": {}}, "required": ["x"]});
+    source["steps"]["start"]["with"]["value"] = json!({"ref": "/input/x"});
+    source["steps"]["start"]["with"]["output_schema"] = json!({"literal": {"type": "integer"}});
+    let version = f.published(workflow, "Strict", &source).await;
+    let binding = f.bound(version, RelatedAssociation::Company).await;
+
+    // Cancel: a stale revision does nothing and shows the run as it is; the current one cancels.
+    let queued = f.start(binding, json!({"x": 1})).await;
+    let pane = f.pane(f.owner, queued).await.unwrap();
+    assert!(
+        pane.contains("Cancel run")
+            && pane.contains("No effect of this run has been accepted yet.")
+    );
+    let key = field_value(&pane, "command_key");
+    let (_, revision) = f.state(queued).await;
+    let stale = cancel(
+        f.ui(f.owner),
+        Path(queued),
+        f.query(),
+        form(&[
+            ("expected_revision", &(revision + 5).to_string()),
+            ("command_key", &key),
+        ]),
+    )
+    .await
+    .unwrap()
+    .0;
+    assert!(stale.contains("Nothing was done"), "{stale}");
+    assert_eq!(f.state(queued).await.0, "queued");
+    let fresh = field_value(&stale, "command_key");
+    assert_ne!(fresh, key, "a fresh key after a refusal");
+    let cancelled = cancel(
+        f.ui(f.owner),
+        Path(queued),
+        f.query(),
+        form(&[
+            ("expected_revision", &revision.to_string()),
+            ("command_key", &fresh),
+        ]),
+    )
+    .await
+    .unwrap()
+    .0;
+    assert!(cancelled.contains("Cancelled"), "{cancelled}");
+    // The timeline records the control with its actor and revisions.
+    assert!(
+        cancelled.contains("cancel by ") && cancelled.contains(": applied (revision "),
+        "{cancelled}"
+    );
+    assert!(cancelled.contains("effects already accepted stay"));
+    assert_eq!(f.state(queued).await.0, "cancelled");
+
+    // Retry: refused for a run that has not failed; applied to a failed one.
+    let failing = f.start(binding, json!({"x": "not a number"})).await;
+    f.run_until_done(&[failing]).await;
+    let (state, revision) = f.state(failing).await;
+    assert_eq!(state, "failed");
+    let pane = f.pane(f.owner, failing).await.unwrap();
+    assert!(pane.contains("Retry failed step") && pane.contains("not a new revision"));
+    let retried = retry(
+        f.ui(f.owner),
+        Path(failing),
+        f.query(),
+        form(&[
+            ("expected_revision", &revision.to_string()),
+            ("command_key", "retry-1"),
+        ]),
+    )
+    .await
+    .unwrap()
+    .0;
+    // An output that breaks its schema fails the same way again, so the step is not safe to
+    // repeat: the command refuses and says why (an applied retry is the JSON route's test).
+    assert!(
+        retried.contains("Nothing was done: This run cannot be retried"),
+        "{retried}"
+    );
+    assert_eq!(f.state(failing).await.0, "failed");
+    let refused = retry(
+        f.ui(f.owner),
+        Path(queued),
+        f.query(),
+        form(&[("expected_revision", "1"), ("command_key", "retry-2")]),
+    )
+    .await
+    .unwrap()
+    .0;
+    assert!(refused.contains("Nothing was done"), "{refused}");
+}
+
+/// A leased HTTP step whose outcome is unknown (the reconciliation fixture's path): the pane
+/// offers the annotation with the action's identities, the step opens to its failed worker
+/// attempt, and the form records an unknown note through the shared command without resuming
+/// the run. The same form again, with the page's key, records nothing more.
+#[tokio::test]
+async fn an_uncertain_action_is_annotated_from_the_pane_and_its_step_shows_the_attempt() {
+    use crate::adapters::persistence::workflow::reconciliation_fixture::{
+        HttpForm, uncertain_http,
+    };
+    let action = uncertain_http(HttpForm::Slot).await;
+    let engine: Engine = Arc::new(WorkflowEngine::for_tests(action.persistence.clone()));
+    let ui = || ui_over(&action.persistence, &engine, action.owner);
+    let query = || {
+        Query(CompanyQuery {
+            company_id: action.company,
+        })
+    };
+
+    let shown = pane(ui(), Path(action.run), pane_query(action.company, None))
+        .await
+        .unwrap()
+        .0;
+    assert!(shown.contains("waiting on reconciliation"), "{shown}");
+    assert!(
+        shown.contains("Reconciliation needed for a remote action ("),
+        "the timeline lists the run's reconciliation record: {shown}"
+    );
+    assert!(shown.contains(&format!(
+        r#"hx-trigger="sse:run-{}, sse:resync, sse:tick""#,
+        action.run
+    )));
+    assert!(shown.contains("Record what happened (an annotation, not a resume)"));
+    assert_eq!(field_value(&shown, "marker_id"), action.marker.to_string());
+    assert_eq!(
+        field_value(&shown, "invocation_id"),
+        action.invocation.to_string()
+    );
+    assert_eq!(
+        field_value(&shown, "argument_digest"),
+        action.argument_digest
+    );
+    assert_eq!(field_value(&shown, "target"), "remote");
+
+    let body = step(ui(), Path((action.run, action.execution)), query())
+        .await
+        .unwrap()
+        .0;
+    assert!(body.contains("Diagnostics: worker attempts"), "{body}");
+    assert!(body.contains("<td>failed</td>"), "{body}");
+
+    let fields = [
+        "execution_id",
+        "invocation_id",
+        "argument_digest",
+        "marker_id",
+        "target",
+        "expected_revision",
+        "command_key",
+    ]
+    .map(|name| (name, field_value(&shown, name)));
+    let mut submitted: Vec<(&str, &str)> = fields
+        .iter()
+        .map(|(name, value)| (*name, value.as_str()))
+        .collect();
+    submitted.push(("note", "The vendor's dashboard shows nothing yet."));
+    let recorded = reconcile(ui(), Path(action.run), query(), form(&submitted))
+        .await
+        .unwrap()
+        .0;
+    // The answer sits above the body, which is all a wake-up reloads.
+    let body_at = recorded.find(r#"<div id="run-body""#).unwrap();
+    assert!(
+        recorded[..body_at].contains("Recorded: what happened to this action is unknown"),
+        "{recorded}"
+    );
+    let reloaded = pane(
+        ui(),
+        Path(action.run),
+        pane_query(action.company, Some(PanePart::Body)),
+    )
+    .await
+    .unwrap()
+    .0;
+    assert!(!reloaded.contains("Recorded:"), "{reloaded}");
+    let evidence = || async {
+        sqlx::query_scalar::<_, i64>(
+            "SELECT count(*) FROM workflow_action_evidence WHERE run_id = $1",
+        )
+        .bind(action.run)
+        .fetch_one(action.persistence.pool())
+        .await
+        .unwrap()
+    };
+    assert_eq!(evidence().await, 1);
+    let (state, reason): (String, Option<String>) =
+        sqlx::query_as("SELECT state, waiting_reason FROM workflow_runs WHERE id = $1")
+            .bind(action.run)
+            .fetch_one(action.persistence.pool())
+            .await
+            .unwrap();
+    assert_eq!(
+        (state.as_str(), reason.as_deref()),
+        ("waiting", Some("reconciliation"))
+    );
+
+    // Pressing the same form again replays the command: nothing new is recorded.
+    let again = reconcile(ui(), Path(action.run), query(), form(&submitted))
+        .await
+        .unwrap()
+        .0;
+    assert!(again.contains("Recorded"), "{again}");
+    assert_eq!(evidence().await, 1);
+}
--- a/src/adapters/http/routes/workflows/ui/runs/events.rs
+++ b/src/adapters/http/routes/workflows/ui/runs/events.rs
@@ -0,0 +1,105 @@
+//! The run event stream the runs workspace reloads on (P08-D4 §D4.1 `workflow_run_changed`).
+//! Wake-ups only, never state:
+//! - `resync` first and on lag: every view reads again in full.
+//! - `runs` and `run-<id>` for a run of this company on a channel the caller can see.
+//! - `tick` every 30 s, once the caller's access has been checked again (the stream ends when it
+//!   no longer holds). Step progress inside a run does not notify, so the pane of an unfinished
+//!   run reloads on it; the list does not.
+//!
+//! The stream subscribes before it authorizes or reads anything, so a change between the page's
+//! render and this subscription is covered by the first `resync`.
+use super::*;
+use crate::application::workflow::RelatedChannelId;
+use crate::infra::events::{MailboxEvent, RunScope};
+use async_stream::stream;
+use axum::extract::State;
+use axum::response::sse::{Event, KeepAlive, Sse};
+use std::convert::Infallible;
+use tokio_stream::{Stream, StreamExt, wrappers::BroadcastStream};
+
+/// How often an open stream re-checks access and wakes the pane of an unfinished run.
+const RECHECK_INTERVAL: std::time::Duration = std::time::Duration::from_secs(30);
+
+pub(super) fn resync_event() -> Event {
+    Event::default().event("resync").data("{}")
+}
+
+fn tick_event() -> Event {
+    Event::default().event("tick").data("{}")
+}
+
+/// The events one run change wakes: the list, and the pane showing that run.
+pub(super) fn run_events(run: Uuid) -> [Event; 2] {
+    [
+        Event::default().event("runs").data(run.to_string()),
+        Event::default()
+            .event(format!("run-{run}"))
+            .data(run.to_string()),
+    ]
+}
+
+/// Whether the caller may see a run of this scope: its channel, or the company for a run
+/// without one.
+async fn sees(ui: &Ui, company: Uuid, scope: &RunScope) -> AppResult<bool> {
+    let association = match scope.channel_id {
+        Some(channel) => RelatedAssociation::Channel(RelatedChannelId::new(channel)),
+        None => RelatedAssociation::Company,
+    };
+    Visibility::new(&ui.engine, super::super::company(company), ui.actor()?)
+        .allows(association)
+        .await
+}
+
+/// GET /ui/workflow-runs/events — the stream described above.
+pub(super) async fn stream(
+    State(state): State<AppState>,
+    ui: Ui,
+    Query(query): Query<CompanyQuery>,
+) -> AppResult<Sse<impl Stream<Item = Result<Event, Infallible>>>> {
+    let receiver = state.events.subscribe();
+    let company = ui.company(query.company_id).await?.id;
+    Ok(
+        Sse::new(run_event_stream(receiver, ui, company, RECHECK_INTERVAL))
+            .keep_alive(KeepAlive::default()),
+    )
+}
+
+/// The stream's events for a receiver subscribed before `ui` was authorized for `company`,
+/// re-checking that access every `recheck`.
+pub(super) fn run_event_stream(
+    receiver: tokio::sync::broadcast::Receiver<MailboxEvent>,
+    ui: Ui,
+    company: Uuid,
+    recheck: std::time::Duration,
+) -> impl Stream<Item = Result<Event, Infallible>> {
+    stream! {
+        yield Ok(resync_event());
+        let mut events = BroadcastStream::new(receiver);
+        let mut periodic = tokio::time::interval(recheck);
+        periodic.tick().await;
+        loop {
+            tokio::select! {
+                event = events.next() => match event {
+                    Some(Ok(MailboxEvent::Resync)) | Some(Err(_)) => yield Ok(resync_event()),
+                    Some(Ok(event)) => {
+                        let Some(scope) = event.run_scope(company) else { continue };
+                        match sees(&ui, company, &scope).await {
+                            Ok(true) => {
+                                for event in run_events(scope.run_id) {
+                                    yield Ok(event);
+                                }
+                            }
+                            Ok(false) => {}
+                            Err(_) => break,
+                        }
+                    }
+                    None => break,
+                },
+                _ = periodic.tick() => match ui.company(company).await {
+                    Ok(_) => yield Ok(tick_event()),
+                    Err(_) => break,
+                },
+            }
+        }
+    }
+}
--- a/src/adapters/http/routes/workflows/ui/runs/events_tests.rs
+++ b/src/adapters/http/routes/workflows/ui/runs/events_tests.rs
@@ -0,0 +1,105 @@
+//! The workspace's event stream: what wakes it, for whom, and the periodic access re-check.
+use super::*;
+
+/// The stream's names: `resync` first (a change before it subscribed is covered), `runs` and
+/// `run-<id>` for a run the viewer can see, nothing for another company's or a hidden channel's
+/// run, and `resync` on the listener's reconnect.
+#[tokio::test]
+async fn the_event_stream_wakes_with_resync_first_and_names_only_visible_runs() {
+    let Some(f) = Fixture::new().await else {
+        return;
+    };
+    let events = MailboxEvents::new();
+    let receiver = events.subscribe();
+    // A change published after subscribing but before the first read is still delivered.
+    let visible = Uuid::new_v4();
+    let board = f.channel("Board", "board", true).await;
+    events.publish(MailboxEvent::WorkflowRunChanged(RunScope {
+        company_id: f.other,
+        channel_id: None,
+        thread_id: None,
+        run_id: Uuid::new_v4(),
+    }));
+    events.publish(MailboxEvent::WorkflowRunChanged(RunScope {
+        company_id: f.company,
+        channel_id: Some(board),
+        thread_id: None,
+        run_id: Uuid::new_v4(),
+    }));
+    events.publish(MailboxEvent::WorkflowRunChanged(RunScope {
+        company_id: f.company,
+        channel_id: None,
+        thread_id: None,
+        run_id: visible,
+    }));
+    events.publish(MailboxEvent::Resync);
+    let stream = events::run_event_stream(
+        receiver,
+        f.ui(f.admin),
+        f.company,
+        Duration::from_secs(3600),
+    );
+    tokio::pin!(stream);
+    let mut names = Vec::new();
+    while names.len() < 4 {
+        let event = tokio::time::timeout(Duration::from_secs(5), stream.next())
+            .await
+            .expect("an event")
+            .expect("open")
+            .unwrap();
+        // Axum's Event renders as SSE text; the name is its `event:` line.
+        let text = format!("{event:?}");
+        names.push(text);
+    }
+    let rendered = names.join("\n");
+    assert!(names[0].contains("resync"), "{rendered}");
+    assert!(
+        names[1].contains("runs") && names[2].contains(&format!("run-{visible}")),
+        "{rendered}"
+    );
+    assert!(names[3].contains("resync"), "{rendered}");
+    assert!(!rendered.contains(&board.to_string()));
+}
+
+/// The periodic re-check: while the viewer may still manage the company it sends `tick` (which
+/// only an unfinished run's pane reloads on), and once they may not, the stream ends.
+#[tokio::test]
+async fn the_event_stream_ticks_while_access_holds_and_ends_when_it_is_lost() {
+    let Some(f) = Fixture::new().await else {
+        return;
+    };
+    let events = MailboxEvents::new();
+    let stream = events::run_event_stream(
+        events.subscribe(),
+        f.ui(f.admin),
+        f.company,
+        Duration::from_millis(50),
+    );
+    tokio::pin!(stream);
+    async fn next(
+        stream: &mut (
+                 impl tokio_stream::Stream<
+            Item = Result<axum::response::sse::Event, std::convert::Infallible>,
+        > + Unpin
+             ),
+    ) -> Option<String> {
+        tokio::time::timeout(Duration::from_secs(5), stream.next())
+            .await
+            .expect("the stream answers")
+            .map(|event| format!("{:?}", event.unwrap()))
+    }
+    assert!(next(&mut stream).await.unwrap().contains("resync"));
+    let tick = next(&mut stream).await.unwrap();
+    assert!(tick.contains("tick") && !tick.contains("resync"), "{tick}");
+    sqlx::query("DELETE FROM company_members WHERE company_id = $1 AND user_id = $2")
+        .bind(f.company)
+        .bind(f.admin)
+        .execute(f.persistence.pool())
+        .await
+        .unwrap();
+    assert_eq!(
+        next(&mut stream).await,
+        None,
+        "the stream ends once access is gone"
+    );
+}
--- a/src/adapters/http/routes/workflows/ui/runs/mod.rs
+++ b/src/adapters/http/routes/workflows/ui/runs/mod.rs
@@ -0,0 +1,380 @@
+//! `/ui/workflow-runs` (p09 B2a): the runs workspace, its list, one run's pane and one step of
+//! it, the controls (cancel, retry, rerun, the reconciliation annotation) through the JSON
+//! routes' own commands, and the run event stream the page reloads on. A run is shown to whoever
+//! the JSON routes show it to: an owner or admin of the company who can see the run's channel.
+use super::super::bindings::Visibility;
+use super::*;
+use crate::application::workflow::authoring::workflow_graph;
+use crate::application::workflow::reads::{PageRequest, RunFilter, RunSummary};
+use crate::application::workflow::run_views::{RunView, StepView};
+use crate::domain::workflow::{RunId, WorkflowBindingId};
+use axum::extract::{Path, Query};
+use serde::Deserialize;
+use std::collections::{BTreeMap, HashMap};
+
+mod controls;
+mod events;
+
+use controls::*;
+
+const LIST_PAGE: i64 = 50;
+const CANCEL_ROUTE: &str = "/ui/workflow-runs/{run_id}/cancel";
+const RETRY_ROUTE: &str = "/ui/workflow-runs/{run_id}/retry";
+const RERUN_ROUTE: &str = "/ui/workflow-runs/{run_id}/rerun";
+const RECONCILE_ROUTE: &str = "/ui/workflow-runs/{run_id}/reconcile";
+/// Every write this workspace registers; the CSRF test routes these same patterns.
+#[cfg(test)]
+const WRITE_ROUTES: [&str; 4] = [CANCEL_ROUTE, RETRY_ROUTE, RERUN_ROUTE, RECONCILE_ROUTE];
+
+pub(super) fn router() -> Router<AppState> {
+    Router::new()
+        .route("/ui/workflow-runs", get(workspace))
+        .route("/ui/workflow-runs/list", get(list))
+        .route("/ui/workflow-runs/events", get(events::stream))
+        .route("/ui/workflow-runs/{run_id}", get(pane))
+        .route("/ui/workflow-runs/{run_id}/steps/{execution_id}", get(step))
+        .route(CANCEL_ROUTE, post(cancel))
+        .route(RETRY_ROUTE, post(retry))
+        .route(RERUN_ROUTE, post(rerun))
+        .route(RECONCILE_ROUTE, post(reconcile))
+}
+
+#[derive(Debug, Deserialize)]
+pub struct WorkspaceQuery {
+    pub company_id: Option<Uuid>,
+    pub run_id: Option<Uuid>,
+    pub binding_id: Option<Uuid>,
+    pub state: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct ListQuery {
+    pub company_id: Uuid,
+    pub binding_id: Option<Uuid>,
+    pub state: Option<String>,
+    pub after: Option<Uuid>,
+    /// A "Load more" request: answer the entries only, not the whole region.
+    pub more: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct CompanyQuery {
+    pub company_id: Uuid,
+}
+
+/// A state filter value the list accepts; anything else lists every state.
+fn state_filter(state: Option<&str>) -> Option<String> {
+    state
+        .filter(|state| {
+            matches!(
+                *state,
+                "queued" | "running" | "waiting" | "succeeded" | "failed" | "cancelled"
+            )
+        })
+        .map(str::to_owned)
+}
+
+/// The graph's progress marks: a step whose newest activation finished is done; one that has not
+/// is current while the run goes on and stopped once it has ended; a failed run's newest step
+/// failed.
+fn marks(view: &RunView) -> BTreeMap<String, pages::NodeMark> {
+    let mut marks = BTreeMap::new();
+    let ended = pages::run_ended(&view.detail.summary.state);
+    // Oldest first, so a later activation of a step decides its mark.
+    for execution in view.detail.executions.iter().rev() {
+        let mark = if execution.completed_at.is_some() {
+            pages::NodeMark::Done
+        } else if ended {
+            pages::NodeMark::Stopped
+        } else {
+            pages::NodeMark::Current
+        };
+        marks.insert(execution.step.clone(), mark);
+    }
+    if view.detail.summary.state == "failed"
+        && let Some(newest) = view.detail.executions.first()
+    {
+        marks.insert(newest.step.clone(), pages::NodeMark::Failed);
+    }
+    marks
+}
+
+impl Ui {
+    /// The run, when the caller may see it: the company is one they manage (`self.company`
+    /// first), and the run's channel is one they can see. Anything else is not found.
+    async fn visible_run(&self, company: Uuid, run: Uuid) -> AppResult<RunView> {
+        let not_found = || AppError::NotFound("Workflow run not found".into());
+        let company_id = super::company(company);
+        let view = self
+            .engine
+            .run_views()
+            .run_view(company_id, RunId::new(run))
+            .await?
+            .ok_or_else(not_found)?;
+        let mut visibility = Visibility::new(&self.engine, company_id, self.actor()?);
+        if !visibility.allows(view.detail.summary.association).await? {
+            return Err(not_found());
+        }
+        Ok(view)
+    }
+
+    /// User names by id, for the actors a run's history names.
+    async fn people(&self, company: Uuid) -> AppResult<HashMap<Uuid, String>> {
+        Ok(self
+            .engine
+            .authoring_reads()
+            .binding_options(super::company(company))
+            .await?
+            .people
+            .into_iter()
+            .map(|person| (person.id, person.label))
+            .collect())
+    }
+
+    async fn run_pane_html(
+        &self,
+        company: Uuid,
+        run: Uuid,
+        banner: Option<pages::RunBanner<'_>>,
+    ) -> AppResult<String> {
+        let parts = self.pane_parts(company, run).await?;
+        Ok(pages::run_pane(&parts.view(company, banner)))
+    }
+
+    /// What a pane renders from, for a run the caller may see.
+    async fn pane_parts(&self, company: Uuid, run: Uuid) -> AppResult<PaneParts> {
+        let view = self.visible_run(company, run).await?;
+        let graph_html = match self
+            .engine
+            .run_views()
+            .run_bundle(super::company(company), RunId::new(run))
+            .await?
+        {
+            Some(bundle) => pages::workflow_graph_view(
+                &workflow_graph(bundle.compiled().graph().definition()),
+                &marks(&view),
+            ),
+            None => String::new(),
+        };
+        let people = self.people(company).await?;
+        Ok(PaneParts {
+            view,
+            graph_html,
+            people,
+        })
+    }
+
+    /// One page of the list: the runs the caller may see, how many were left out, the cursor.
+    async fn run_page(
+        &self,
+        company: Uuid,
+        binding: Option<Uuid>,
+        state: Option<String>,
+        after: Option<Uuid>,
+    ) -> AppResult<(Vec<RunSummary>, usize, Option<Uuid>, HashMap<Uuid, String>)> {
+        let company_id = super::company(company);
+        let page = self
+            .engine
+            .reads()
+            .list_runs(
+                company_id,
+                &RunFilter {
+                    binding: binding.map(WorkflowBindingId::new),
+                    state,
+                },
+                PageRequest::new(after, Some(LIST_PAGE))?,
+            )
+            .await?;
+        let next = page
+            .more
+            .then(|| page.items.last().map(|last| last.run.as_uuid()))
+            .flatten();
+        let mut visibility = Visibility::new(&self.engine, company_id, self.actor()?);
+        let mut visible = Vec::new();
+        let mut hidden = 0;
+        for run in page.items {
+            if visibility.allows(run.association).await? {
+                visible.push(run);
+            } else {
+                hidden += 1;
+            }
+        }
+        visibility.report("workflow-runs-ui");
+        let workflows: Vec<Uuid> = visible.iter().map(|run| run.workflow.as_uuid()).collect();
+        let titles = self
+            .engine
+            .run_views()
+            .workflow_titles(company_id, &workflows)
+            .await?;
+        Ok((visible, hidden, next, titles))
+    }
+}
