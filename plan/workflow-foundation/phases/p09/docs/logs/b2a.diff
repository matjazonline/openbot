+fn form(fields: &[(&str, &str)]) -> axum::body::Bytes {
+    axum::body::Bytes::from(
+        url::form_urlencoded::Serializer::new(String::new())
+            .extend_pairs(fields)
+            .finish(),
+    )
+}
