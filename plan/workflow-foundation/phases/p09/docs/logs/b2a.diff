+/// The cursor after `marker` in a page (up to the next `&` or `"`).
+fn field_after(html: &str, marker: &str) -> Uuid {
+    let start = html.find(marker).unwrap() + marker.len();
+    let end = start + html[start..].find(['&', '"']).unwrap();
+    html[start..end].parse().unwrap()
+}
