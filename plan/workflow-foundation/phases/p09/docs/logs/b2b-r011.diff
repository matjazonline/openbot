+    s.intent(TO).await;
+    s.drain(&s.admissions(admission(s.p()))).await;
+    let first = s.runs(binding).await[0];
+    for _ in 0..THREAD_RUN_LIMIT {
+        s.intent(TO).await;
+        s.drain(&s.admissions(admission(s.p()))).await;
+    }
+    for _ in 0..201 {
+        s.message().await;
+    }
