+    let latest = s
+        .p()
+        .thread_runs(company, s.thread, s.owner().user_id())
+        .await
+        .unwrap();
+    assert!(
+        !latest.inspectable.contains(&first),
+        "outside both newest windows"
     );
+    let backlog = s
+        .p()
+        .list_thread_message_views_after(s.thread, None, 50)
+        .await
+        .unwrap();
+    let ids: Vec<_> = backlog
+        .iter()
+        .flat_map(|message| message.run_ids.iter().copied())
+        .collect();
+    assert!(ids.contains(&first));
+    let inspectable = s
+        .p()
+        .inspectable_runs(company, s.owner().user_id(), &ids)
+        .await
+        .unwrap();
+    assert!(
+        inspectable.contains(&first),
+        "the real reconnect batch authorizes its own identities"
+    );
