-                        version.draft_revision
-                    ),
-                    version.source,
-                )
-            }
-        });
-    }
-    let (to_label, to_source) = sources.pop().expect("two sides");
-    let (from_label, from_source) = sources.pop().expect("two sides");
-    Ok(Html(pages::diff_block(
