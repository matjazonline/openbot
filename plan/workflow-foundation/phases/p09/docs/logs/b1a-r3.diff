+            Path(workflow),
+            Query(CompareQuery {
+                company_id: f.company,
+                from: version.as_uuid().to_string(),
+                to: "draft".into()
+            })
+        )
+        .await,
+        Err(AppError::NotFound(_))
+    ));
+}
