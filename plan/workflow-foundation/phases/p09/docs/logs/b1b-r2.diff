+/// The binding command answers `Conflict` for a resource slot that is not ready too; that is
+/// said as the refusal it is, with every choice kept, not as a duplicate or a concurrent edit
+/// (F019).
+#[tokio::test]
+async fn a_resource_that_is_not_ready_is_refused_as_such_on_create_configure_and_activate() {
+    let Some(f) = Fixture::new().await else {
+        return;
+    };
+    let workflow = Uuid::new_v4();
+    let version = f
+        .published(
+            workflow,
+            "Http",
+            &serde_json::to_string_pretty(&example("http.request", workflow)).unwrap(),
+        )
+        .await
+        .to_string();
+    // Two bearer connections; only one has its secret.
+    let (unready, ready) = (Uuid::new_v4(), Uuid::new_v4());
+    for id in [unready, ready] {
+        sqlx::query(
+            "INSERT INTO workflow_http_connections (company_id, id, origin, enabled, bearer) \
+             VALUES ($1, $2, $3, true, true)",
+        )
+        .bind(f.company)
+        .bind(id)
+        .bind(format!("https://h{}.example.test", id.simple()))
+        .execute(f.persistence.pool())
+        .await
+        .unwrap();
+    }
+    let credential = |connection: Uuid| {
+        sqlx::query(
+            "INSERT INTO workflow_http_credentials (company_id, connection_id, envelope) \
+             VALUES ($1, $2, 'enc:v2:fixture')",
+        )
+        .bind(f.company)
+        .bind(connection)
+        .execute(f.persistence.pool())
+    };
+    credential(ready).await.unwrap();
+    let pane = f.pane(f.owner, workflow, "bindings").await.unwrap();
+    let key = field_value(&pane, "form_key");
+    let (unready_id, ready_id) = (unready.to_string(), ready.to_string());
+    let html = f
+        .save_binding(
+            f.owner,
+            workflow,
+            &[
+                ("form_key", &key),
+                ("version_id", &version),
+                ("association", "company"),
+                ("resource:service", &unready_id),
+            ],
+        )
+        .await;
+    assert!(
+        html.contains("Not saved:") && html.contains("not ready"),
+        "{html}"
+    );
+    assert!(!html.contains("already created"), "{html}");
+    assert!(html.contains(&format!(r#"<option value="{unready}" selected>"#)));
+    assert!(f.usage(workflow).await.is_empty());
+    // The same form, with the ready connection, saves under the same key.
+    let html = f
+        .save_binding(
+            f.owner,
+            workflow,
+            &[
+                ("form_key", &key),
+                ("version_id", &version),
+                ("association", "company"),
+                ("resource:service", &ready_id),
+            ],
+        )
+        .await;
+    assert!(html.contains("Saved binding"), "{html}");
+    let binding = f.usage(workflow).await[0].binding.binding.as_uuid();
+    // Configure to the unready one: refused as such, the choice kept.
+    let html = f
+        .save_binding(
+            f.owner,
+            workflow,
+            &[
+                ("binding_id", &binding.to_string()),
+                ("expected_state_revision", "1"),
+                ("version_id", &version),
+                ("resource:service", &unready_id),
+            ],
+        )
+        .await;
+    assert!(
+        html.contains("Not saved:") && html.contains("not ready"),
+        "{html}"
+    );
+    assert!(!html.contains("Someone changed this binding"), "{html}");
+    assert!(html.contains(&format!(r#"<option value="{unready}" selected>"#)));
+    // The ready connection loses its secret: activation is refused for that reason.
+    sqlx::query(
+        "DELETE FROM workflow_http_credentials WHERE company_id = $1 AND connection_id = $2",
+    )
+    .bind(f.company)
+    .bind(ready)
+    .execute(f.persistence.pool())
+    .await
+    .unwrap();
+    let html = f
+        .activity(f.owner, workflow, binding, 1, true)
+        .await
+        .unwrap();
+    assert!(
+        html.contains("Not activated:") && html.contains("not ready"),
+        "{html}"
+    );
+    assert!(!html.contains("changed since the page was shown"), "{html}");
+    // A stale row is still said as one.
+    credential(ready).await.unwrap();
+    assert!(
+        f.activity(f.owner, workflow, binding, 1, true)
+            .await
+            .unwrap()
+            .contains("Activated binding")
+    );
+    let stale = f
+        .activity(f.owner, workflow, binding, 1, false)
+        .await
+        .unwrap();
+    assert!(
+        stale.contains("changed since the page was shown"),
+        "{stale}"
+    );
+}
