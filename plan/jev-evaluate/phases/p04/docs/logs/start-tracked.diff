+        let connection = jev::connection_on(tx, configuration.company_id(), id.as_uuid())
+            .await?
+            .ok_or_else(jev::revoked)?;
+        if !connection.enabled || !models.is_subset(&connection.models) {
+            return Err(jev::revoked());
+        }
+    }
     Ok(())
