+            fixture.target.company.as_uuid(),
+            fixture.target.actor,
+            library.agent,
+            AgentWrite {
+                name: "Portable agent".into(),
+                slug: "installed-agent".into(),
+                provider: Some(SCRIPTED_PROVIDER.into()),
+                model: Some(SCRIPTED_MODEL.into()),
+                ..Default::default()
+            },
+        )
+        .await
+}
