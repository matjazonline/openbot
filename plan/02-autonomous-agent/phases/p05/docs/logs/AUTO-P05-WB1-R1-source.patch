+
+async fn model(fixture: &Fixture) {
+    CompanyPersistence::replace_model_connections_for_user(
+        &fixture.persistence,
+        fixture.target.actor.user_id(),
+        fixture.target.company.as_uuid(),
+        vec![CompanyModelConnectionWrite {
