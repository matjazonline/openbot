+        WorkflowSourceDecoder,
+        AgentPublicationDirectory {
+            persistence: p.clone(),
+            inner: Preflight,
+        },
+    );
+    source["workflow_id"] = json!(target.workflow);
+    let mut draft = fixture.save(expected);
