+        }
+        Removal::Delete => {
+            f.vault
+                .delete(
+                    &f.account.owner,
+                    f.account.id,
+                    f.account.authorization_revision,
+                )
+                .await
+                .unwrap();
+        }
+    }
+    assert!(protocol::complete(&f.vault, &claim, &i, &c).await.is_err());
+    assert_eq!(f.server.calls(), 0);
