+async fn delayed_claim(removal: Removal) {
+    let f = Box::pin(StrictSetup::new()).await;
+    let (i, c) = prepared(&f.setup).await;
+    let claim = protocol::reserve(&f.vault, &i, &c).await.unwrap();
+    match removal {
+        Removal::Disconnect => {
+            f.vault
