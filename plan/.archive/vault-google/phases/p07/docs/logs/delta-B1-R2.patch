+#[tokio::test]
+async fn vault_google_e2e_stalled_refresh_rechecks_disconnect_membership_rebind_and_operation() {
+    for mutation in [
+        Mutation::Disconnect,
+        Mutation::Membership,
+        Mutation::Rebind,
+        Mutation::Operation,
+    ] {
+        Box::pin(stalled(mutation)).await;
+    }
