+async fn vault_google_e2e_all_vault_kinds_survive_key_rotation_retirement_and_native_renewal() {
+    for case in [Case::Bearer, Case::ApiKey, Case::Google, Case::Workspace] {
+        Box::pin(rotate(case)).await;
