+    independent.vault.persistence.pool().close().await;
+}
+async fn settle(p: &PostgresPersistence, claim: &ClaimedWorkflow, output: Value) {
+    assert!(
+        p.complete_io(crate::application::workflow::lease::FencedWorkflowResult {
+            fence: claim.fence,
+            policy: lease(),
+            output,
+        })
+        .await
+        .unwrap()
+        .is_some()
+    );
+}
