+    account_id uuid NOT NULL,
+    owner_namespace text NOT NULL,
+    owner_subject text NOT NULL,
+    host_scope text NOT NULL CHECK (octet_length(host_scope) BETWEEN 1 AND 256),
+    host_binding text NOT NULL CHECK (octet_length(host_binding) BETWEEN 1 AND 256),
+    app_id text NOT NULL CHECK (octet_length(app_id) BETWEEN 1 AND 128),
+    app_policy text NOT NULL CHECK (app_policy ~ '^[0-9a-f]{64}$'),
