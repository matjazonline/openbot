+    UNIQUE (account_id,host_binding)
+);
+CREATE FUNCTION public.guard_integration_grant() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    PERFORM id FROM public.integration_accounts WHERE id=NEW.account_id FOR UPDATE;
+    IF TG_OP='INSERT' THEN
+        IF NOT EXISTS(SELECT 1 FROM public.integration_use_grants WHERE account_id=NEW.account_id AND host_binding=NEW.host_binding)
+            AND (SELECT count(*) FROM public.integration_use_grants WHERE account_id=NEW.account_id)>=128 THEN
+            RAISE EXCEPTION USING ERRCODE='23514',CONSTRAINT='integration_grant_cap',MESSAGE='Integration grant limit';
+        END IF;
+    ELSIF ROW(NEW.id,NEW.account_id,NEW.owner_namespace,NEW.owner_subject,NEW.host_scope,NEW.host_binding)
+            IS DISTINCT FROM ROW(OLD.id,OLD.account_id,OLD.owner_namespace,OLD.owner_subject,OLD.host_scope,OLD.host_binding)
+        OR NEW.revision<>OLD.revision+1 THEN
+        RAISE EXCEPTION USING ERRCODE='23514',CONSTRAINT='integration_grant_revision',MESSAGE='Invalid grant transition';
