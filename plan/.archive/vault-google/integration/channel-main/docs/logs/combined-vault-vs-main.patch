+-- workspace-fixture-v1 is a contract-test schema, never enabled in the production registry.
+CREATE FUNCTION public.guard_integration_account() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE owner_retired boolean;
+BEGIN
+    IF TG_OP = 'UPDATE' THEN
+        IF ROW(NEW.id, NEW.owner_namespace, NEW.owner_subject, NEW.key, NEW.provider_id,
+            NEW.auth_config_id, NEW.auth_method, NEW.credential_schema, NEW.external_identity, NEW.authorization_key)
+            IS DISTINCT FROM ROW(OLD.id, OLD.owner_namespace, OLD.owner_subject, OLD.key, OLD.provider_id,
+            OLD.auth_config_id, OLD.auth_method, OLD.credential_schema, OLD.external_identity, OLD.authorization_key) THEN
+            RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_account_immutable_identity', MESSAGE = 'Immutable integration identity';
+        END IF;
+        RETURN NEW;
+    END IF;
+    INSERT INTO public.integration_owner_states(owner_namespace, owner_subject)
+        VALUES(NEW.owner_namespace, NEW.owner_subject) ON CONFLICT DO NOTHING;
+    SELECT retired INTO owner_retired FROM public.integration_owner_states
+        WHERE owner_namespace = NEW.owner_namespace AND owner_subject = NEW.owner_subject FOR UPDATE;
+    IF owner_retired THEN
+        RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_owner_retired', MESSAGE = 'Integration owner retired';
+    END IF;
+    IF (SELECT count(*) FROM public.integration_accounts
+        WHERE owner_namespace = NEW.owner_namespace AND owner_subject = NEW.owner_subject) >= 128 THEN
+        RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_account_owner_cap', MESSAGE = 'Integration account limit';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER integration_account_guard BEFORE INSERT OR UPDATE ON public.integration_accounts
+    FOR EACH ROW EXECUTE FUNCTION public.guard_integration_account();
