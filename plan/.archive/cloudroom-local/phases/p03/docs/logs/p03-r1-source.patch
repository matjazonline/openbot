diff --git a/src/adapters/persistence/local_agents/protocol/observations.rs b/src/adapters/persistence/local_agents/protocol/observations.rs
new file mode 100644
index 00000000..4cefda48
--- /dev/null
+++ b/src/adapters/persistence/local_agents/protocol/observations.rs
@@ -0,0 +1,346 @@
+use super::*;
+
+struct Mutation {
+    dispatch: DispatchEvidence,
+    outcome: Option<OperationOutcome>,
+    output: Option<LocalOutput>,
+    truncated: bool,
+    state: Option<TurnState>,
+    usage: Option<MeasuredUsage>,
+    definitive_refusal: bool,
+}
+
+impl Mutation {
+    fn new(operation: &LocalAgentOperation) -> Self {
+        Self {
+            dispatch: operation.dispatch().clone(),
+            outcome: operation.outcome(),
+            output: None,
+            truncated: false,
+            state: None,
+            usage: None,
+            definitive_refusal: false,
+        }
+    }
+}
+
+pub(super) async fn accept(
+    p: &PostgresPersistence,
+    fence: ConnectionFence,
+    observation: &JournalObservation,
+) -> AppResult<u64> {
+    let digest = observation.canonical_digest()?;
+    let sequence = observation.sequence().get();
+    let operation = observation.operation_id();
+    let mut tx = begin(&p.pool).await?;
+    let machine = lock_fence(&mut tx, fence).await?;
+    if machine.journal_generation != fence.generation.get() as i64 {
+        return Err(AppError::InvalidCredentials);
+    }
+    let acknowledged = machine.acknowledged_sequence as u64;
+    if sequence <= acknowledged {
+        let old:Option<String>=sqlx::query_scalar("SELECT digest FROM local_agent_observations WHERE company_id=$1 AND installation_id=$2 AND sequence=$3")
+            .bind(fence.machine.company_id).bind(fence.machine.installation_id.as_uuid()).bind(sequence as i64).fetch_optional(&mut *tx).await?;
+        if old.as_deref() != Some(digest.as_str()) {
+            return Err(AppError::Conflict(
+                "journal sequence content changed".into(),
+            ));
+        }
+        reconcile_generation(&mut tx, fence, operation).await?;
+        commit_cursor(&mut tx, fence, acknowledged).await?;
+        tx.commit().await?;
+        return Ok(acknowledged);
+    }
+    if sequence != acknowledged + 1 {
+        return Err(AppError::Conflict("journal sequence gap".into()));
+    }
+    let row=sqlx::query_as::<_,OperationDb>(&format!("SELECT {OPERATION_COLUMNS} FROM local_agent_operations WHERE company_id=$1 AND machine_id=$2 AND installation_id=$3 AND id=$4 FOR UPDATE"))
+        .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid()).bind(operation.as_uuid())
+        .fetch_optional(&mut *tx).await?.ok_or_else(missing)?;
+    if row.delivery_attempted_at.is_none() {
+        return Err(AppError::BadRequest(
+            "observation precedes possible delivery".into(),
+        ));
+    }
+    let original = row.operation()?;
+    let mut mutation = apply(&original, observation)?;
+    validate_terminal(&mut tx, &original, &mut mutation).await?;
+    persist_evidence(&mut tx, fence, &row, observation, &mutation).await?;
+    sqlx::query("INSERT INTO local_agent_observations(company_id,machine_id,installation_id,sequence,operation_id,digest,observation) VALUES($1,$2,$3,$4,$5,$6,$7)")
+        .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid())
+        .bind(sequence as i64).bind(operation.as_uuid()).bind(digest.as_str()).bind(encode(observation)?).execute(&mut *tx).await?;
+    reconcile_generation(&mut tx, fence, operation).await?;
+    commit_cursor(&mut tx, fence, sequence).await?;
+    tx.commit().await?;
+    Ok(sequence)
+}
+
+async fn reconcile_generation(
+    db: &mut PgConnection,
+    fence: ConnectionFence,
+    operation: OperationId,
+) -> AppResult<()> {
+    sqlx::query("UPDATE local_agent_operations SET last_observed_generation=$4 WHERE company_id=$1 AND machine_id=$2 AND id=$3")
+        .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(operation.as_uuid()).bind(fence.generation.get() as i64).execute(db).await?;
+    Ok(())
+}
+
+fn apply(operation: &LocalAgentOperation, observation: &JournalObservation) -> AppResult<Mutation> {
+    let mut mutation = Mutation::new(operation);
+    match observation {
+        JournalObservation::Agent { observation } => {
+            apply_agent(operation, observation, &mut mutation)?
+        }
+        JournalObservation::Catalog { sequence, .. } => {
+            if matches!(mutation.dispatch, DispatchEvidence::NotDispatched {}) {
+                return Err(AppError::BadRequest(
+                    "catalog observation requires a receipt".into(),
+                ));
+            }
+            if !matches!(operation.command(), LocalCommand::RefreshCatalog {}) {
+                return Err(missing());
+            }
+            mutation.dispatch = DispatchEvidence::CatalogSnapshot {
+                sequence: *sequence,
+            };
+            mutation.outcome = Some(OperationOutcome::Succeeded);
+        }
+        JournalObservation::Control {
+            sequence,
+            thread_id,
+            evidence,
+            ..
+        } => {
+            if matches!(mutation.dispatch, DispatchEvidence::NotDispatched {})
+                || (!matches!(operation.command(), LocalCommand::Inspect { .. })
+                    && !matches!(
+                        mutation.dispatch,
+                        DispatchEvidence::SubmissionIntent { .. }
+                            | DispatchEvidence::NativeIdentity { .. }
+                    ))
+            {
+                return Err(AppError::BadRequest(
+                    "control observation requires local dispatch evidence".into(),
+                ));
+            }
+            if target_thread(operation.command()) != Some(thread_id) {
+                return Err(missing());
+            }
+            match (operation.command(), evidence) {
+                (LocalCommand::Inspect { .. }, ControlEvidence::Snapshot { state }) => {
+                    mutation.state = Some(*state)
+                }
+                (LocalCommand::StopThread { .. }, ControlEvidence::StopAccepted {})
+                | (LocalCommand::ArchiveThread { .. }, ControlEvidence::ArchiveAccepted {}) => {}
+                _ => {
+                    return Err(AppError::BadRequest(
+                        "control evidence does not match command".into(),
+                    ));
+                }
+            }
+            mutation.dispatch = DispatchEvidence::NativeIdentity {
+                sequence: *sequence,
+                thread_id: thread_id.clone(),
+                turn_id: None,
+            };
+            mutation.outcome = Some(OperationOutcome::Succeeded);
+        }
+    }
+    let mut frozen = encode(operation)?;
+    frozen["dispatch"] = encode(&mutation.dispatch)?;
+    frozen["outcome"] = encode(&mutation.outcome)?;
+    let _: LocalAgentOperation = decode(frozen, "observation transition")?;
+    Ok(mutation)
+}
+
+fn apply_agent(
+    operation: &LocalAgentOperation,
+    observation: &LocalAgentObservation,
+    mutation: &mut Mutation,
+) -> AppResult<()> {
+    match &observation.evidence {
+        LocalEvidence::Receipt {} => {
+            if matches!(mutation.dispatch, DispatchEvidence::NotDispatched {}) {
+                mutation.dispatch = DispatchEvidence::AcceptedLocally {
+                    sequence: observation.sequence,
+                };
+            }
+        }
+        LocalEvidence::SubmissionIntent {} => {
+            if matches!(mutation.dispatch, DispatchEvidence::NotDispatched {}) {
+                return Err(AppError::BadRequest(
+                    "submission intent requires receipt".into(),
+                ));
+            }
+            if matches!(mutation.dispatch, DispatchEvidence::AcceptedLocally { .. }) {
+                mutation.dispatch = DispatchEvidence::SubmissionIntent {
+                    sequence: observation.sequence,
+                };
+            }
+        }
+        LocalEvidence::Refused { reason } => {
+            if matches!(
+                mutation.dispatch,
+                DispatchEvidence::NativeIdentity { .. } | DispatchEvidence::CatalogSnapshot { .. }
+            ) {
+                return Err(AppError::BadRequest(
+                    "native observation cannot become pre-dispatch refusal".into(),
+                ));
+            }
+            mutation.definitive_refusal = true;
+            mutation.outcome = Some(if *reason == LocalRefusal::Expired {
+                OperationOutcome::Expired
+            } else {
+                OperationOutcome::Failed
+            });
+        }
+        LocalEvidence::Uncertain {} => mutation.outcome = Some(OperationOutcome::Uncertain),
+        LocalEvidence::Turn { .. } => apply_turn(operation, observation, mutation)?,
+    }
+    Ok(())
+}
+
+fn apply_turn(
+    operation: &LocalAgentOperation,
+    observation: &LocalAgentObservation,
+    mutation: &mut Mutation,
+) -> AppResult<()> {
+    let LocalEvidence::Turn {
+        thread_id,
+        turn_id,
+        state,
+        output,
+        truncated,
+        usage,
+    } = &observation.evidence
+    else {
+        return Err(AppError::BadRequest("turn evidence required".into()));
+    };
+
+    if !operation.command().is_effect()
+        && !matches!(operation.command(), LocalCommand::Inspect { .. })
+    {
+        return Err(missing());
+    }
+    if target_thread(operation.command()).is_some_and(|expected| expected != thread_id) {
+        return Err(missing());
+    }
+    if let DispatchEvidence::NativeIdentity {
+        thread_id: old_thread,
+        turn_id: old_turn,
+        ..
+    } = &mutation.dispatch
+        && (old_thread != thread_id || old_turn.as_ref().is_some_and(|old| old != turn_id))
+    {
+        return Err(AppError::Conflict("native turn identity changed".into()));
+    }
+    if !matches!(
+        mutation.dispatch,
+        DispatchEvidence::SubmissionIntent { .. } | DispatchEvidence::NativeIdentity { .. }
+    ) {
+        return Err(AppError::BadRequest(
+            "native turn requires a submission intent".into(),
+        ));
+    }
+    mutation.dispatch = DispatchEvidence::NativeIdentity {
+        sequence: observation.sequence,
+        thread_id: thread_id.clone(),
+        turn_id: Some(turn_id.clone()),
+    };
+    mutation.state = Some(*state);
+    mutation.outcome = match state {
+        TurnState::Completed => Some(OperationOutcome::Succeeded),
+        TurnState::Failed => Some(OperationOutcome::Failed),
+        TurnState::Stopped => Some(OperationOutcome::Cancelled),
+        TurnState::Missing => Some(OperationOutcome::Uncertain),
+        _ => mutation.outcome,
+    };
+    if output.is_some()
+        && !matches!(
+            state,
+            TurnState::Completed | TurnState::Failed | TurnState::Stopped
+        )
+    {
+        return Err(AppError::BadRequest(
+            "output requires a terminal turn".into(),
+        ));
+    }
+    if usage
+        .as_ref()
+        .is_some_and(|u| u.input_tokens > MAX_SAFE_INTEGER || u.output_tokens > MAX_SAFE_INTEGER)
+    {
+        return Err(AppError::BadRequest(
+            "usage exceeds protocol precision".into(),
+        ));
+    }
+    mutation.output = output.clone();
+    mutation.truncated = *truncated;
+    mutation.usage = usage.clone();
+    Ok(())
+}
+
+async fn validate_terminal(
+    db: &mut PgConnection,
+    operation: &LocalAgentOperation,
+    mutation: &mut Mutation,
+) -> AppResult<()> {
+    if operation
+        .outcome()
+        .is_some_and(|outcome| outcome != OperationOutcome::Uncertain)
+    {
+        mutation.outcome = operation.outcome();
+        mutation.output = None;
+        mutation.state = None;
+        mutation.usage = None;
+    } else {
+        let expired: bool = sqlx::query_scalar("SELECT $1::timestamptz<=clock_timestamp()")
+            .bind(operation.deadline())
+            .fetch_one(db)
+            .await?;
+        if expired && !mutation.definitive_refusal {
+            mutation.outcome = Some(OperationOutcome::Uncertain);
+        }
+    }
+    Ok(())
+}
+
+async fn persist_evidence(
+    db: &mut PgConnection,
+    fence: ConnectionFence,
+    row: &OperationDb,
+    observation: &JournalObservation,
+    mutation: &Mutation,
+) -> AppResult<()> {
+    if let DispatchEvidence::NativeIdentity { thread_id, .. } = &mutation.dispatch
+        && let Some(session) = row.session_id
+    {
+        let updated=sqlx::query("UPDATE local_agent_sessions SET thread_id=$5 WHERE company_id=$1 AND machine_id=$2 AND installation_id=$3 AND id=$4 AND (thread_id IS NULL OR thread_id=$5)")
+                .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid()).bind(session).bind(thread_id.as_str()).execute(&mut *db).await?;
+        if updated.rows_affected() != 1 {
+            return Err(AppError::Conflict("session thread identity changed".into()));
+        }
+    }
+    if let JournalObservation::Catalog {
+        sequence, catalog, ..
+    } = observation
+    {
+        sqlx::query("INSERT INTO local_machine_capabilities(company_id,machine_id,installation_id,sequence,catalog) VALUES($1,$2,$3,$4,$5)")
+            .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid())
+            .bind(sequence.get() as i64).bind(encode(catalog)?).execute(&mut *db).await?;
+        sqlx::query(
+            "UPDATE local_machines SET capabilities_sequence=$3 WHERE company_id=$1 AND id=$2",
+        )
+        .bind(fence.machine.company_id)
+        .bind(fence.machine.machine_id.as_uuid())
+        .bind(sequence.get() as i64)
+        .execute(&mut *db)
+        .await?;
+    }
+    sqlx::query("UPDATE local_agent_operations SET dispatch=$3,outcome=$4,output=COALESCE($5,output),output_truncated=CASE WHEN $5::text IS NULL THEN output_truncated ELSE $6 END, \
+        observed_turn_state=COALESCE($7,observed_turn_state),measured_usage=COALESCE($8,measured_usage) WHERE company_id=$1 AND id=$2")
+        .bind(fence.machine.company_id).bind(row.id).bind(encode(&mutation.dispatch)?).bind(mutation.outcome.map(|o|encode(&o)).transpose()?.and_then(|v|v.as_str().map(str::to_owned)))
+        .bind(mutation.output.as_ref().map(LocalOutput::as_str)).bind(mutation.truncated)
+        .bind(mutation.state.map(|s|encode(&s)).transpose()?.and_then(|v|v.as_str().map(str::to_owned)))
+        .bind(mutation.usage.as_ref().map(encode).transpose()?).execute(db).await?;
+    Ok(())
+}
diff --git a/src/adapters/persistence/local_agents/protocol/operation_record_tests.rs b/src/adapters/persistence/local_agents/protocol/operation_record_tests.rs
new file mode 100644
index 00000000..483571a1
--- /dev/null
+++ b/src/adapters/persistence/local_agents/protocol/operation_record_tests.rs
@@ -0,0 +1,120 @@
+use super::{test_support::*, *};
+
+#[tokio::test]
+async fn cloudroom_commands_persisted_command_session_binding_is_checked_beyond_its_digest() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let command = c.send();
+    let operation = c.admission(command.clone()).operation;
+    let record = OperationDb {
+        id: operation.id().as_uuid(),
+        command: encode(&command).unwrap(),
+        deadline: operation.deadline(),
+        payload_digest: operation.payload_digest().as_str().to_owned(),
+        dispatch: encode(operation.dispatch()).unwrap(),
+        outcome: None,
+        session_id: Some(Uuid::new_v4()),
+        actor_id: Some(c.f.owner),
+        delivery_attempted_at: None,
+    };
+    assert!(
+        record.operation().is_err(),
+        "a matching payload digest does not authorize a different row session"
+    );
+    let commands = [
+        command,
+        LocalCommand::Create {
+            session_id: c.session.id,
+            selection: c.session.profile.selection.clone(),
+            prompt: LocalPrompt::try_from("binding proof".to_owned()).unwrap(),
+        },
+        LocalCommand::Inspect {
+            session_id: c.session.id,
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+        },
+        LocalCommand::StopThread {
+            session_id: c.session.id,
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+        },
+        LocalCommand::ArchiveThread {
+            session_id: c.session.id,
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+        },
+    ];
+    for command in commands {
+        let request = c.admission(command);
+        let mut valid = c.f.database.pool.begin().await.unwrap();
+        insert(&mut valid, &c, &request.operation, c.session.id)
+            .await
+            .unwrap();
+        valid.rollback().await.unwrap();
+        let mut invalid = c.f.database.pool.begin().await.unwrap();
+        let error = insert(
+            &mut invalid,
+            &c,
+            &request.operation,
+            SessionId::new(Uuid::new_v4()).unwrap(),
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(
+            error.as_database_error().unwrap().code().as_deref(),
+            Some("23514")
+        );
+        assert_eq!(
+            error.as_database_error().unwrap().constraint(),
+            Some("local_operation_command_session")
+        );
+        invalid.rollback().await.unwrap();
+        assert_create_machine_binding(&c, &request.operation).await;
+    }
+}
+
+async fn assert_create_machine_binding(c: &Context, operation: &LocalAgentOperation) {
+    let LocalCommand::Create {
+        session_id,
+        selection,
+        prompt,
+    } = operation.command()
+    else {
+        return;
+    };
+    let mut changed = selection.clone();
+    changed.machine_id = MachineId::new(Uuid::new_v4()).unwrap();
+    let forged = LocalAgentOperation::queued(
+        operation.id(),
+        LocalCommand::Create {
+            session_id: *session_id,
+            selection: changed,
+            prompt: prompt.clone(),
+        },
+        operation.deadline(),
+    )
+    .unwrap();
+    let mut tx = c.f.database.pool.begin().await.unwrap();
+    let error = insert(&mut tx, c, &forged, *session_id).await.unwrap_err();
+    assert_eq!(
+        error.as_database_error().unwrap().code().as_deref(),
+        Some("23514")
+    );
+    assert_eq!(
+        error.as_database_error().unwrap().constraint(),
+        Some("local_operation_create_machine")
+    );
+    tx.rollback().await.unwrap();
+}
+
+async fn insert(
+    db: &mut PgConnection,
+    c: &Context,
+    operation: &LocalAgentOperation,
+    session: SessionId,
+) -> Result<(), sqlx::Error> {
+    sqlx::query("INSERT INTO local_agent_operations(company_id,id,machine_id,installation_id,session_id,logical_key,command,payload_digest,deadline) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)")
+        .bind(c.f.company).bind(operation.id().as_uuid()).bind(c.paired.receipt.machine.id.as_uuid())
+        .bind(c.paired.receipt.machine.installation_id.as_uuid()).bind(session.as_uuid()).bind(operation.id().to_string())
+        .bind(encode(operation.command()).unwrap()).bind(operation.payload_digest().as_str()).bind(operation.deadline())
+        .execute(db).await?;
+    Ok(())
+}
diff --git a/src/adapters/persistence/local_agents/protocol/test_support.rs b/src/adapters/persistence/local_agents/protocol/test_support.rs
new file mode 100644
index 00000000..653edfee
--- /dev/null
+++ b/src/adapters/persistence/local_agents/protocol/test_support.rs
@@ -0,0 +1,171 @@
+use super::*;
+use crate::adapters::persistence::local_agents::test_support::{
+    Fixture, Paired, SessionSetup, prepare_session,
+};
+
+pub(crate) struct Context {
+    pub f: Fixture,
+    pub paired: Paired,
+    pub session: SessionSetup,
+    pub journal: Uuid,
+    pub fence: ConnectionFence,
+}
+
+impl Context {
+    pub async fn new() -> Option<Self> {
+        let f = Fixture::new().await?;
+        let paired = f.pair(f.company).await;
+        let journal = Uuid::new_v4();
+        let fence = f
+            .persistence
+            .acquire_connection(
+                paired.candidate.credential.verifier(),
+                paired.receipt.machine.installation_id,
+                Uuid::new_v4(),
+            )
+            .await
+            .unwrap()
+            .unwrap();
+        let hello = JournalHello {
+            version: 1,
+            installation_id: fence.machine.installation_id,
+            journal_id: journal,
+            journal_sequence: 0,
+        };
+        assert!(
+            !f.persistence
+                .connect_journal(fence, &hello)
+                .await
+                .unwrap()
+                .recovery_required
+        );
+        let session = prepare_session(&f, &paired).await;
+        assert!(f.persistence.finish_reconciliation(fence).await.unwrap());
+        let deliveries = f.persistence.pending_commands(fence).await.unwrap();
+        assert_eq!(deliveries.len(), 1);
+        assert!(matches!(
+            deliveries[0].operation.command(),
+            LocalCommand::RefreshCatalog {}
+        ));
+        let id = deliveries[0].operation.id();
+        let receipt = agent(1, id, LocalEvidence::Receipt {});
+        assert_eq!(
+            f.persistence
+                .accept_observation(fence, &receipt)
+                .await
+                .unwrap(),
+            1
+        );
+        let catalog = f
+            .persistence
+            .capabilities(
+                f.company,
+                paired.receipt.machine.id,
+                EventSequence::try_from(1).unwrap(),
+            )
+            .await
+            .unwrap()
+            .unwrap()
+            .catalog;
+        let observation = JournalObservation::Catalog {
+            sequence: EventSequence::try_from(2).unwrap(),
+            operation_id: id,
+            catalog,
+        };
+        assert_eq!(
+            f.persistence
+                .accept_observation(fence, &observation)
+                .await
+                .unwrap(),
+            2
+        );
+        Some(Self {
+            f,
+            paired,
+            session,
+            journal,
+            fence,
+        })
+    }
+    pub fn send(&self) -> LocalCommand {
+        LocalCommand::Send {
+            session_id: self.session.id,
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+            prompt: LocalPrompt::try_from("bounded protocol proof".to_owned()).unwrap(),
+        }
+    }
+    pub fn admission(&self, command: LocalCommand) -> OperationAdmission {
+        let id = OperationId::new(Uuid::new_v4()).unwrap();
+        OperationAdmission {
+            company_id: self.f.company,
+            actor_id: self.f.owner,
+            machine_id: self.paired.receipt.machine.id,
+            logical_key: LogicalInvocationKey::parse(id.to_string()).unwrap(),
+            operation: LocalAgentOperation::queued(
+                id,
+                command,
+                Utc::now() + chrono::Duration::minutes(30),
+            )
+            .unwrap(),
+        }
+    }
+    pub async fn reconnect(&self, journal: Uuid, sequence: u64) -> (ConnectionFence, Welcome) {
+        let fence = self
+            .f
+            .persistence
+            .acquire_connection(
+                self.paired.candidate.credential.verifier(),
+                self.paired.receipt.machine.installation_id,
+                Uuid::new_v4(),
+            )
+            .await
+            .unwrap()
+            .unwrap();
+        let welcome = self
+            .f
+            .persistence
+            .connect_journal(
+                fence,
+                &JournalHello {
+                    version: 1,
+                    installation_id: fence.machine.installation_id,
+                    journal_id: journal,
+                    journal_sequence: sequence,
+                },
+            )
+            .await
+            .unwrap();
+        (fence, welcome)
+    }
+}
+
+pub(crate) fn agent(sequence: u64, id: OperationId, evidence: LocalEvidence) -> JournalObservation {
+    JournalObservation::Agent {
+        observation: LocalAgentObservation {
+            sequence: EventSequence::try_from(sequence).unwrap(),
+            operation_id: id,
+            evidence,
+        },
+    }
+}
+
+pub(crate) fn turn(
+    sequence: u64,
+    id: OperationId,
+    turn_id: &str,
+    state: TurnState,
+    output: Option<&str>,
+) -> JournalObservation {
+    agent(
+        sequence,
+        id,
+        LocalEvidence::Turn {
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+            turn_id: CloudroomTurnId::try_from(turn_id.to_owned()).unwrap(),
+            state,
+            output: output.map(|v| LocalOutput::try_from(v.to_owned()).unwrap()),
+            truncated: false,
+            usage: None,
+        },
+    )
+}
diff --git a/src/adapters/persistence/local_agents/store.rs b/src/adapters/persistence/local_agents/store.rs
new file mode 100644
index 00000000..afe7db60
--- /dev/null
+++ b/src/adapters/persistence/local_agents/store.rs
@@ -0,0 +1,381 @@
+use super::*;
+
+#[async_trait]
+impl LocalMachineStore for PostgresPersistence {
+    async fn create_pairing(&self, write: PairingCreate) -> AppResult<PairingAttempt> {
+        let mut tx = begin(&self.pool).await?;
+        authorize(&mut tx, write.company_id, write.actor_id).await?;
+        let active: i64 = sqlx::query_scalar("SELECT count(*) FROM local_pairings WHERE company_id=$1 AND consumed_at IS NULL AND revoked_at IS NULL AND expires_at>clock_timestamp()")
+            .bind(write.company_id).fetch_one(&mut *tx).await?;
+        if active >= MAX_PAIRING_CODES as i64 {
+            return Err(AppError::Conflict(
+                "five pairing codes are already outstanding".into(),
+            ));
+        }
+        if let Some(machine) = write.replace_machine {
+            revoke(&mut tx, write.company_id, machine).await?;
+        }
+        let row = sqlx::query_as::<_,PairingDb>(&format!("INSERT INTO local_pairings (id,company_id,actor_id,code_hash,expires_at) VALUES ($1,$2,$3,$4,clock_timestamp()+make_interval(secs=>$5)) RETURNING {PAIRING_COLUMNS}"))
+            .bind(write.id.as_uuid()).bind(write.company_id).bind(write.actor_id).bind(write.code_hash.as_bytes().as_slice())
+            .bind(PAIRING_TTL_SECONDS as f64).fetch_one(&mut *tx).await?;
+        let result = row.projection()?;
+        tx.commit().await?;
+        Ok(result)
+    }
+
+    async fn list_pairings(
+        &self,
+        company: Uuid,
+        after: Option<PairingId>,
+    ) -> AppResult<Vec<PairingAttempt>> {
+        let mut tx = begin(&self.pool).await?;
+        let rows = sqlx::query_as::<_,PairingDb>(&format!("SELECT {PAIRING_COLUMNS} FROM local_pairings WHERE company_id=$1 AND ($2::uuid IS NULL OR id>$2) ORDER BY id LIMIT $3"))
+            .bind(company).bind(after.map(PairingId::as_uuid)).bind(MAX_PAGE_RECORDS as i64).fetch_all(&mut *tx).await?;
+        tx.commit().await?;
+        rows.iter().map(PairingDb::projection).collect()
+    }
+
+    async fn cancel_pairing(&self, actor: Uuid, company: Uuid, id: PairingId) -> AppResult<()> {
+        let mut tx = begin(&self.pool).await?;
+        authorize(&mut tx, company, actor).await?;
+        let changed = sqlx::query("UPDATE local_pairings SET revoked_at=COALESCE(revoked_at,clock_timestamp()) WHERE company_id=$1 AND id=$2 AND consumed_at IS NULL")
+            .bind(company).bind(id.as_uuid()).execute(&mut *tx).await?;
+        if changed.rows_affected() == 0 {
+            return Err(missing());
+        }
+        tx.commit().await?;
+        Ok(())
+    }
+
+    async fn reserve_pairing_budget(&self, keys: &[AuthAttemptKey]) -> AppResult<bool> {
+        if keys.is_empty() || keys.len() > 3 {
+            return Err(AppError::BadRequest("invalid pairing budget".into()));
+        }
+        let mut tx = begin(&self.pool).await?;
+        // One short transaction serializes cardinality and each identity's fixed window.
+        sqlx::query(
+            "SELECT pg_advisory_xact_lock(hashtextextended('openbot.local-pair-budgets',0))",
+        )
+        .execute(&mut *tx)
+        .await?;
+        sqlx::query("DELETE FROM local_pair_budgets WHERE identity_key IN (SELECT identity_key FROM local_pair_budgets WHERE window_ends_at<=clock_timestamp() ORDER BY window_ends_at,identity_key LIMIT 100)")
+            .execute(&mut *tx).await?;
+        let mut admitted = true;
+        for key in keys {
+            let exists: bool = sqlx::query_scalar(
+                "SELECT EXISTS(SELECT 1 FROM local_pair_budgets WHERE identity_key=$1)",
+            )
+            .bind(key.as_bytes().as_slice())
+            .fetch_one(&mut *tx)
+            .await?;
+            let count: i64 = sqlx::query_scalar("SELECT count(*) FROM local_pair_budgets")
+                .fetch_one(&mut *tx)
+                .await?;
+            if !exists && count >= 4096 {
+                admitted = false;
+                break;
+            }
+            let result = sqlx::query_scalar::<_,i16>("INSERT INTO local_pair_budgets (identity_key,attempts,window_ends_at) VALUES ($1,1,clock_timestamp()+INTERVAL '2 minutes') \
+                ON CONFLICT (identity_key) DO UPDATE SET attempts=CASE WHEN local_pair_budgets.window_ends_at<=clock_timestamp() THEN 1 ELSE local_pair_budgets.attempts+1 END, \
+                window_ends_at=CASE WHEN local_pair_budgets.window_ends_at<=clock_timestamp() THEN clock_timestamp()+INTERVAL '2 minutes' ELSE local_pair_budgets.window_ends_at END \
+                WHERE local_pair_budgets.window_ends_at<=clock_timestamp() OR local_pair_budgets.attempts<12 RETURNING attempts")
+                .bind(key.as_bytes().as_slice()).fetch_optional(&mut *tx).await?;
+            if result.is_none() {
+                admitted = false;
+                break;
+            }
+        }
+        // Refusals spend prior reservations too; a wrong code cannot roll its source budget back.
+        tx.commit().await?;
+        Ok(admitted)
+    }
+
+    async fn claim_pairing(&self, claim: &PairingClaim) -> AppResult<Option<PairingReceipt>> {
+        claim.validate()?;
+        let hash = claim.code.verifier();
+        let mut tx = begin(&self.pool).await?;
+        let company = sqlx::query_scalar::<_, Uuid>(
+            "SELECT company_id FROM local_pairings WHERE code_hash=$1",
+        )
+        .bind(hash.as_bytes().as_slice())
+        .fetch_optional(&mut *tx)
+        .await?;
+        let Some(company) = company else {
+            return Ok(None);
+        };
+        let locked =
+            sqlx::query_scalar::<_, Uuid>("SELECT id FROM companies WHERE id=$1 FOR NO KEY UPDATE")
+                .bind(company)
+                .fetch_optional(&mut *tx)
+                .await?;
+        if locked.is_none() {
+            return Ok(None);
+        }
+        let row = sqlx::query_as::<_,PairingDb>(&format!("SELECT {PAIRING_COLUMNS} FROM local_pairings WHERE company_id=$1 AND code_hash=$2 FOR UPDATE"))
+            .bind(company).bind(hash.as_bytes().as_slice()).fetch_optional(&mut *tx).await?;
+        let Some(row) = row else {
+            return Ok(None);
+        };
+        if row.revoked_at.is_some() {
+            return Ok(None);
+        }
+        if row.consumed_at.is_some() {
+            if !row.matches(claim) {
+                return Ok(None);
+            }
+            let result = receipt(
+                &mut tx,
+                company,
+                row.machine_id.ok_or_else(|| invalid("consumed pairing"))?,
+            )
+            .await?;
+            tx.commit().await?;
+            return Ok(result);
+        }
+        let Some(actor) = row.actor_id else {
+            return Ok(None);
+        };
+        match authorize(&mut tx, company, actor).await {
+            Ok(()) => {}
+            Err(AppError::NotFound(_) | AppError::Forbidden(_)) => return Ok(None),
+            Err(error) => return Err(error),
+        }
+        let live: bool = sqlx::query_scalar("SELECT $1::timestamptz>clock_timestamp()")
+            .bind(row.expires_at)
+            .fetch_one(&mut *tx)
+            .await?;
+        if !live {
+            return Ok(None);
+        }
+        let machine = Uuid::new_v4();
+        if !insert_claim(&mut tx, company, machine, row.id, claim).await? {
+            return Ok(None);
+        }
+        let result = receipt(&mut tx, company, machine).await?;
+        tx.commit().await?;
+        Ok(result)
+    }
+
+    async fn pairing_status(
+        &self,
+        installation: InstallationId,
+        claim: ClaimVerifier,
+    ) -> AppResult<Option<PairingReceipt>> {
+        let mut tx = begin(&self.pool).await?;
+        let row = sqlx::query_as::<_,(Uuid,Uuid)>("SELECT company_id,machine_id FROM local_pairings WHERE installation_id=$1 AND claim_verifier=$2 AND consumed_at IS NOT NULL AND revoked_at IS NULL")
+            .bind(installation.as_uuid()).bind(claim.as_bytes().as_slice()).fetch_optional(&mut *tx).await?;
+        let result = match row {
+            Some((company, machine)) => receipt(&mut tx, company, machine).await?,
+            None => None,
+        };
+        tx.commit().await?;
+        Ok(result)
+    }
+
+    async fn list_machines(
+        &self,
+        company: Uuid,
+        after: Option<MachineId>,
+    ) -> AppResult<Vec<LocalMachine>> {
+        let mut tx = begin(&self.pool).await?;
+        let rows=sqlx::query_as::<_,MachineDb>(&format!("SELECT {MACHINE_COLUMNS} FROM local_machines AS machine WHERE company_id=$1 AND ($2::uuid IS NULL OR id>$2) ORDER BY id LIMIT $3"))
+            .bind(company).bind(after.map(MachineId::as_uuid)).bind(MAX_PAGE_RECORDS as i64).fetch_all(&mut *tx).await?;
+        tx.commit().await?;
+        rows.into_iter().map(MachineDb::entity).collect()
+    }
+
+    async fn change_machine(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        change: MachineChange,
+    ) -> AppResult<LocalMachine> {
+        let mut tx = begin(&self.pool).await?;
+        authorize(&mut tx, company, actor).await?;
+        let row = lock_machine(&mut tx, company, id).await?;
+        match change {
+            MachineChange::Revoke => revoke(&mut tx, company, id).await?,
+            MachineChange::Enable | MachineChange::Disable => {
+                if row.state == "revoked" {
+                    return Err(AppError::Conflict(
+                        "revoked machines require a new pairing".into(),
+                    ));
+                }
+                let state = match change {
+                    MachineChange::Enable => "enabled",
+                    _ => "disabled",
+                };
+                sqlx::query("UPDATE local_machines SET state=$3 WHERE company_id=$1 AND id=$2")
+                    .bind(company)
+                    .bind(id.as_uuid())
+                    .bind(state)
+                    .execute(&mut *tx)
+                    .await?;
+            }
+        }
+        let result = lock_machine(&mut tx, company, id).await?.entity()?;
+        tx.commit().await?;
+        Ok(result)
+    }
+
+    async fn set_projects(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        projects: &[CloudroomProjectId],
+    ) -> AppResult<()> {
+        let unique: std::collections::HashSet<_> = projects.iter().collect();
+        if projects.len() > MAX_PROJECTS || unique.len() != projects.len() {
+            return Err(AppError::BadRequest("invalid project selection".into()));
+        }
+        let mut tx = begin(&self.pool).await?;
+        authorize(&mut tx, company, actor).await?;
+        if lock_machine(&mut tx, company, id).await?.state == "revoked" {
+            return Err(missing());
+        }
+        if !projects.is_empty() {
+            let catalog = current_catalog(&mut tx, company, id).await?;
+            if projects
+                .iter()
+                .any(|project| !catalog.projects.contains(project))
+            {
+                return Err(AppError::BadRequest("project is not advertised".into()));
+            }
+        }
+        sqlx::query("DELETE FROM local_machine_projects WHERE company_id=$1 AND machine_id=$2")
+            .bind(company)
+            .bind(id.as_uuid())
+            .execute(&mut *tx)
+            .await?;
+        let values: Vec<&str> = projects.iter().map(CloudroomProjectId::as_str).collect();
+        sqlx::query("INSERT INTO local_machine_projects (company_id,machine_id,project_id) SELECT $1,$2,project FROM unnest($3::text[]) AS project")
+            .bind(company).bind(id.as_uuid()).bind(values).execute(&mut *tx).await?;
+        tx.commit().await?;
+        Ok(())
+    }
+
+    async fn save_profile(&self, actor: Uuid, profile: &LocalAgentProfile) -> AppResult<()> {
+        validate_name(&profile.name)?;
+        let mut tx = begin(&self.pool).await?;
+        authorize(&mut tx, profile.company_id, actor).await?;
+        let selection = &profile.selection;
+        let machine = lock_machine(&mut tx, profile.company_id, selection.machine_id).await?;
+        if machine.state != "enabled" {
+            return Err(AppError::Conflict("machine is not enabled".into()));
+        }
+        let allowed: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM local_machine_projects WHERE company_id=$1 AND machine_id=$2 AND project_id=$3)")
+            .bind(profile.company_id).bind(selection.machine_id.as_uuid()).bind(selection.project_id.as_str()).fetch_one(&mut *tx).await?;
+        if !allowed {
+            return Err(AppError::BadRequest("project is not enabled".into()));
+        }
+        current_catalog(&mut tx, profile.company_id, selection.machine_id)
+            .await?
+            .validate_selection(selection)
+            .map_err(|error| AppError::BadRequest(error.into()))?;
+        sqlx::query("INSERT INTO local_agent_profiles (company_id,id,machine_id,name,selection) VALUES ($1,$2,$3,$4,$5) \
+            ON CONFLICT (company_id,id) DO UPDATE SET machine_id=EXCLUDED.machine_id,name=EXCLUDED.name,selection=EXCLUDED.selection")
+            .bind(profile.company_id).bind(profile.id.as_uuid()).bind(selection.machine_id.as_uuid()).bind(&profile.name).bind(encode(selection)?).execute(&mut *tx).await?;
+        tx.commit().await?;
+        Ok(())
+    }
+
+    async fn acquire_connection(
+        &self,
+        verifier: CredentialVerifier,
+        installation: InstallationId,
+        owner: Uuid,
+    ) -> AppResult<Option<ConnectionFence>> {
+        if owner.is_nil() {
+            return Err(AppError::BadRequest("invalid connection owner".into()));
+        }
+        let mut tx = begin(&self.pool).await?;
+        let machine = sqlx::query_as::<_,MachineDb>(&format!("SELECT {MACHINE_COLUMNS} FROM local_machines AS machine JOIN local_machine_credentials AS credential \
+            ON credential.company_id=machine.company_id AND credential.machine_id=machine.id AND credential.generation=machine.credential_generation \
+            WHERE credential.verifier=$1 AND credential.revoked_at IS NULL AND machine.installation_id=$2 AND machine.state<>'revoked' FOR UPDATE OF machine"))
+            .bind(verifier.as_bytes().as_slice()).bind(installation.as_uuid()).fetch_optional(&mut *tx).await?;
+        let Some(machine) = machine else {
+            return Ok(None);
+        };
+        let generation = machine
+            .connection_generation
+            .checked_add(1)
+            .ok_or_else(|| AppError::Conflict("connection generation exhausted".into()))?;
+        let entity = machine.entity()?;
+        sqlx::query("UPDATE local_machines SET connection_generation=$3,connection_owner=$4,connection_expires_at=clock_timestamp()+make_interval(secs=>$5),last_seen_at=clock_timestamp() WHERE company_id=$1 AND id=$2")
+            .bind(entity.company_id).bind(entity.id.as_uuid()).bind(generation).bind(owner).bind(CONNECTION_STALE_SECONDS as f64).execute(&mut *tx).await?;
+        let fence = ConnectionFence {
+            machine: MachineAuthentication {
+                company_id: entity.company_id,
+                machine_id: entity.id,
+                installation_id: entity.installation_id,
+                credential_generation: entity.credential_generation,
+            },
+            generation: ConnectionGeneration::try_from(generation as u64)
+                .map_err(|_| invalid("connection generation"))?,
+            owner_id: owner,
+        };
+        tx.commit().await?;
+        Ok(Some(fence))
+    }
+
+    async fn renew_connection(&self, fence: ConnectionFence) -> AppResult<bool> {
+        let mut tx = begin(&self.pool).await?;
+        let result = sqlx::query("UPDATE local_machines AS machine SET connection_expires_at=clock_timestamp()+make_interval(secs=>$7),last_seen_at=clock_timestamp() \
+            WHERE company_id=$1 AND id=$2 AND installation_id=$3 AND credential_generation=$4 AND connection_generation=$5 AND connection_owner=$6 \
+            AND connection_expires_at>clock_timestamp() AND state<>'revoked' \
+            AND EXISTS(SELECT 1 FROM local_machine_credentials AS credential WHERE credential.company_id=machine.company_id AND credential.machine_id=machine.id AND credential.generation=machine.credential_generation AND credential.revoked_at IS NULL)")
+            .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid())
+            .bind(fence.machine.credential_generation.get() as i64).bind(fence.generation.get() as i64).bind(fence.owner_id).bind(CONNECTION_STALE_SECONDS as f64)
+            .execute(&mut *tx).await?;
+        tx.commit().await?;
+        Ok(result.rows_affected() == 1)
+    }
+
+    async fn release_connection(&self, fence: ConnectionFence) -> AppResult<()> {
+        let mut tx = begin(&self.pool).await?;
+        sqlx::query("UPDATE local_machines SET connection_owner=NULL,connection_expires_at=NULL WHERE company_id=$1 AND id=$2 AND installation_id=$3 AND credential_generation=$4 AND connection_generation=$5 AND connection_owner=$6")
+            .bind(fence.machine.company_id).bind(fence.machine.machine_id.as_uuid()).bind(fence.machine.installation_id.as_uuid())
+            .bind(fence.machine.credential_generation.get() as i64).bind(fence.generation.get() as i64).bind(fence.owner_id).execute(&mut *tx).await?;
+        tx.commit().await?;
+        Ok(())
+    }
+}
+
+async fn insert_claim(
+    db: &mut PgConnection,
+    company: Uuid,
+    machine: Uuid,
+    pairing: Uuid,
+    claim: &PairingClaim,
+) -> AppResult<bool> {
+    let reserved = sqlx::query("INSERT INTO local_installations (company_id,installation_id) VALUES ($1,$2) ON CONFLICT (installation_id) DO NOTHING")
+        .bind(company).bind(claim.installation_id.as_uuid()).execute(&mut *db).await?;
+    if reserved.rows_affected() == 0 {
+        return Ok(false);
+    }
+    sqlx::query(
+        "INSERT INTO local_machines (id,company_id,installation_id,name) VALUES ($1,$2,$3,$4)",
+    )
+    .bind(machine)
+    .bind(company)
+    .bind(claim.installation_id.as_uuid())
+    .bind(&claim.name)
+    .execute(&mut *db)
+    .await?;
+    let credential = sqlx::query("INSERT INTO local_machine_credentials (company_id,machine_id,generation,verifier) VALUES ($1,$2,1,$3) ON CONFLICT (verifier) DO NOTHING")
+        .bind(company).bind(machine).bind(claim.credential_verifier.as_bytes().as_slice()).execute(&mut *db).await?;
+    if credential.rows_affected() == 0 {
+        return Ok(false);
+    }
+    let consumed = sqlx::query("UPDATE local_pairings SET consumed_at=clock_timestamp(),installation_id=$3,machine_id=$4,claim_verifier=$5,credential_verifier=$6 \
+        WHERE company_id=$1 AND id=$2 AND consumed_at IS NULL AND revoked_at IS NULL AND expires_at>clock_timestamp()")
+        .bind(company).bind(pairing).bind(claim.installation_id.as_uuid()).bind(machine).bind(claim.claim_verifier.as_bytes().as_slice())
+        .bind(claim.credential_verifier.as_bytes().as_slice()).execute(db).await;
+    match consumed {
+        Ok(result) => Ok(result.rows_affected() == 1),
+        Err(sqlx::Error::Database(error)) if error.is_unique_violation() => Ok(false),
+        Err(error) => Err(error.into()),
+    }
+}
