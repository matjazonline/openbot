@@ -0,0 +1,201 @@
+use super::*;
+use crate::adapters::persistence::local_agents::test_support::Candidate;
+use std::{
+    net::{IpAddr, Ipv4Addr},
+    os::fd::AsRawFd,
+};
+
+#[derive(sqlx::FromRow)]
+struct SlowState {
+    disconnected: bool,
+    possible: i64,
+    cancelled: i64,
+}
+
+#[tokio::test]
+async fn cloudroom_connection_concurrent_replicas_with_independent_pools_accept_one_hello() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let options = c.f.database.pool.connect_options().as_ref().clone();
+    let first_pool = sqlx::postgres::PgPoolOptions::new()
+        .max_connections(2)
+        .connect_with(options.clone())
+        .await
+        .unwrap();
+    let second_pool = sqlx::postgres::PgPoolOptions::new()
+        .max_connections(2)
+        .connect_with(options)
+        .await
+        .unwrap();
+    let first = Server::start(Arc::new(
+        crate::adapters::persistence::PostgresPersistence::new(first_pool.clone()),
+    ))
+    .await;
+    let second = Server::start(Arc::new(
+        crate::adapters::persistence::PostgresPersistence::new(second_pool.clone()),
+    ))
+    .await;
+    let barrier = tokio::sync::Barrier::new(2);
+    let open_first = async {
+        barrier.wait().await;
+        socket(&first, &c).await
+    };
+    let open_second = async {
+        barrier.wait().await;
+        socket(&second, &c).await
+    };
+    let (mut a, mut b) = tokio::join!(open_first, open_second);
+    let hello = ClientMessage::Hello {
+        hello: JournalHello {
+            version: 1,
+            installation_id: c.paired.receipt.machine.installation_id,
+            journal_id: c.journal,
+            journal_sequence: 2,
+        },
+    };
+    let first_hello = async {
+        write(&mut a, &hello).await;
+        read(&mut a).await
+    };
+    let second_hello = async {
+        write(&mut b, &hello).await;
+        read(&mut b).await
+    };
+    let (a, b) = tokio::join!(first_hello, second_hello);
+    assert_ne!(a.is_some(), b.is_some());
+    let Some(ServerMessage::Welcome { welcome }) = a.or(b) else {
+        panic!("one current lease must accept the hello")
+    };
+    let generation:i64=sqlx::query_scalar("SELECT connection_generation FROM local_machines WHERE company_id=$1 AND id=$2 AND connection_owner IS NOT NULL")
+        .bind(c.f.company).bind(c.paired.receipt.machine.id.as_uuid()).fetch_one(&c.f.database.pool).await.unwrap();
+    assert_eq!(
+        generation,
+        welcome.identity.connection_generation.get() as i64
+    );
+    first.close().await;
+    second.close().await;
+    first_pool.close().await;
+    second_pool.close().await;
+}
+
+#[tokio::test]
+async fn cloudroom_connection_global_capacity_bounds_pending_upgrades_and_releases_all() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let server = Server::start(c.f.persistence.clone()).await;
+    let address = server
+        .origin
+        .strip_prefix("ws://")
+        .unwrap()
+        .split('/')
+        .next()
+        .unwrap();
+    let mut sockets = Vec::new();
+    for index in 0..=MAX_CONNECTIONS {
+        let code =
+            c.f.cases
+                .create_pairing(c.f.owner, c.f.company, None)
+                .await
+                .unwrap();
+        let candidate = Candidate::new(code.code);
+        c.f.cases
+            .pair(
+                IpAddr::V4(Ipv4Addr::new(127, 0, 0, index as u8 + 2)),
+                candidate.claim.clone(),
+            )
+            .await
+            .unwrap();
+        let request = connect_request(
+            &server.origin,
+            &candidate.credential,
+            candidate.claim.installation_id,
+        );
+        let connected =
+            tokio_tungstenite::client_async(request, TcpStream::connect(address).await.unwrap())
+                .await;
+        if index < MAX_CONNECTIONS {
+            sockets.push(connected.unwrap().0);
+        } else {
+            let tokio_tungstenite::tungstenite::Error::Http(response) = connected.unwrap_err()
+            else {
+                panic!("expected bounded admission")
+            };
+            assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+        }
+    }
+    assert_eq!(server.service.slots.available_permits(), 0);
+    timeout(Duration::from_secs(5), server.close())
+        .await
+        .unwrap();
+    drop(sockets);
+}
+
+#[tokio::test]
+async fn cloudroom_connection_shutdown_cancels_slow_consumer_and_keeps_possible_delivery_uncertain()
+{
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let server = Server::start(c.f.persistence.clone()).await;
+    let address = server
+        .origin
+        .strip_prefix("ws://")
+        .unwrap()
+        .split('/')
+        .next()
+        .unwrap();
+    let stream = TcpStream::connect(address).await.unwrap();
+    let requested: libc::c_int = 1024;
+    // A real bounded kernel receive buffer makes the unread escaped prompts apply backpressure.
+    let result = unsafe {
+        libc::setsockopt(
+            stream.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_RCVBUF,
+            &requested as *const _ as *const libc::c_void,
+            std::mem::size_of_val(&requested) as libc::socklen_t,
+        )
+    };
+    assert_eq!(result, 0);
+    let request = connect_request(
+        &server.origin,
+        &c.paired.candidate.credential,
+        c.paired.receipt.machine.installation_id,
+    );
+    let socket = tokio_tungstenite::client_async(request, stream)
+        .await
+        .unwrap()
+        .0;
+    let mut peer = Peer::initialize(socket, &c, 2).await;
+    assert!(peer.ready().await);
+    let large = LocalCommand::Send {
+        session_id: c.session.id,
+        thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+        prompt: LocalPrompt::try_from("\u{1}".repeat(MAX_PROMPT_BYTES)).unwrap(),
+    };
+    let first =
+        c.f.persistence
+            .enqueue_operation(&c.admission(large.clone()))
+            .await
+            .unwrap();
+    peer.command(first.id()).await;
+    for _ in 0..7 {
+        c.f.persistence
+            .enqueue_operation(&c.admission(large.clone()))
+            .await
+            .unwrap();
+    }
+    // Stop polling the receiver while the server redelivers the unacknowledged large commands.
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert!(server.service.tasks.len() > 1);
+    timeout(Duration::from_secs(3), server.close())
+        .await
+        .unwrap();
+    let state:SlowState=sqlx::query_as("SELECT machine.connection_owner IS NULL AS disconnected,(SELECT count(*) FROM local_agent_operations WHERE company_id=$1 AND delivery_attempted_at IS NOT NULL AND outcome IS NULL) AS possible,(SELECT count(*) FROM local_agent_operations WHERE company_id=$1 AND outcome='cancelled') AS cancelled FROM local_machines AS machine WHERE company_id=$1 AND id=$2")
+        .bind(c.f.company).bind(c.paired.receipt.machine.id.as_uuid()).fetch_one(&c.f.database.pool).await.unwrap();
+    assert!(state.disconnected);
+    assert!(state.possible > 0);
+    assert_eq!(state.cancelled, 0);
+}
diff --git a/src/adapters/http/routes/local_machine_connection/connection_tests.rs b/src/adapters/http/routes/local_machine_connection/connection_tests.rs
new file mode 100644
index 00000000..9bccc20a
--- /dev/null
+++ b/src/adapters/http/routes/local_machine_connection/connection_tests.rs
@@ -0,0 +1,419 @@
+use super::*;
+use crate::application::local_agents::ports::LocalAgentRead;
+use crate::{
+    adapters::persistence::local_agents::protocol_test_support::{Context, agent},
+    application::local_agents::{LocalCatalog, MachineChange},
+    domain::local_agents::*,
+};
+use futures::{SinkExt, StreamExt};
+use std::collections::VecDeque;
+use tokio::{
+    io::{AsyncRead, AsyncWrite},
+    net::TcpStream,
+    task::JoinHandle,
+};
+use tokio_tungstenite::{
+    WebSocketStream,
+    tungstenite::{Message, client::IntoClientRequest},
+};
+
+#[path = "connection_failure_tests.rs"]
+mod failures;
+#[cfg(unix)]
+#[path = "tls_tests.rs"]
+mod tls;
+
+struct Server {
+    service: Arc<LocalMachineConnections>,
+    stop: CancellationToken,
+    task: Option<JoinHandle<()>>,
+    origin: String,
+}
+impl Server {
+    async fn start(store: Arc<dyn LocalProtocolStore>) -> Self {
+        let service = Arc::new(LocalMachineConnections::new(store));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let origin = format!(
+            "ws://{}/v1/local-machines/connect",
+            listener.local_addr().unwrap()
+        );
+        let app = router().with_state(service.clone());
+        let stop = CancellationToken::new();
+        let shutdown = stop.clone();
+        let task = tokio::spawn(async move {
+            axum::serve(listener, app)
+                .with_graceful_shutdown(shutdown.cancelled_owned())
+                .await
+                .unwrap();
+        });
+        Self {
+            service,
+            stop,
+            task: Some(task),
+            origin,
+        }
+    }
+    async fn close(mut self) {
+        self.service.shutdown().await.unwrap();
+        assert!(self.service.tasks.is_empty());
+        assert_eq!(self.service.slots.available_permits(), MAX_CONNECTIONS);
+        self.stop.cancel();
+        timeout(Duration::from_secs(2), self.task.take().unwrap())
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.stop.cancel();
+        self.service.shutdown.cancel();
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+async fn socket(server: &Server, c: &Context) -> WebSocketStream<TcpStream> {
+    let request = connect_request(
+        &server.origin,
+        &c.paired.candidate.credential,
+        c.paired.receipt.machine.installation_id,
+    );
+    let address = server
+        .origin
+        .strip_prefix("ws://")
+        .unwrap()
+        .split('/')
+        .next()
+        .unwrap();
+    let stream = TcpStream::connect(address).await.unwrap();
+    tokio_tungstenite::client_async(request, stream)
+        .await
+        .unwrap()
+        .0
+}
+
+fn connect_request(
+    origin: &str,
+    credential: &MachineCredential,
+    installation: InstallationId,
+) -> tokio_tungstenite::tungstenite::http::Request<()> {
+    let mut request = origin.into_client_request().unwrap();
+    request.headers_mut().insert(
+        "authorization",
+        format!("Bearer {}", credential.expose_secret())
+            .parse()
+            .unwrap(),
+    );
+    request.headers_mut().insert(
+        "x-openbot-installation-id",
+        installation.to_string().parse().unwrap(),
+    );
+    request
+        .headers_mut()
+        .insert("x-openbot-protocol-version", "1".parse().unwrap());
+    request
+}
+
+struct Peer<S> {
+    socket: WebSocketStream<S>,
+    identity: ConnectionIdentity,
+    sequence: u64,
+    catalog: LocalCatalog,
+    commands: VecDeque<CommandDelivery>,
+}
+impl<S: AsyncRead + AsyncWrite + Unpin> Peer<S> {
+    async fn initialize(mut socket: WebSocketStream<S>, c: &Context, sequence: u64) -> Self {
+        let hello = ClientMessage::Hello {
+            hello: JournalHello {
+                version: 1,
+                installation_id: c.paired.receipt.machine.installation_id,
+                journal_id: c.journal,
+                journal_sequence: sequence,
+            },
+        };
+        write(&mut socket, &hello).await;
+        let ServerMessage::Welcome { welcome } = read(&mut socket).await.unwrap() else {
+            panic!("expected welcome")
+        };
+        assert!(!welcome.recovery_required);
+        assert_eq!(welcome.acknowledged_sequence, sequence);
+        let machine =
+            c.f.persistence
+                .machine(c.f.company, c.paired.receipt.machine.id)
+                .await
+                .unwrap()
+                .unwrap();
+        let catalog =
+            c.f.persistence
+                .capabilities(
+                    c.f.company,
+                    machine.id,
+                    machine.capabilities_sequence.unwrap(),
+                )
+                .await
+                .unwrap()
+                .unwrap()
+                .catalog;
+        Self {
+            socket,
+            identity: welcome.identity,
+            sequence,
+            catalog,
+            commands: VecDeque::new(),
+        }
+    }
+    async fn ready(&mut self) -> bool {
+        write(
+            &mut self.socket,
+            &ClientMessage::Ready {
+                identity: self.identity,
+            },
+        )
+        .await;
+        loop {
+            match read(&mut self.socket).await.unwrap() {
+                ServerMessage::Ready { ready, .. } => return ready,
+                ServerMessage::Command { delivery, .. } => self.commands.push_back(*delivery),
+                other => panic!("unexpected message {other:?}"),
+            }
+        }
+    }
+    async fn observe(&mut self, observation: JournalObservation) {
+        let sequence = observation.sequence().get();
+        write(
+            &mut self.socket,
+            &ClientMessage::Observation {
+                identity: self.identity,
+                observation,
+            },
+        )
+        .await;
+        loop {
+            match read(&mut self.socket).await.unwrap() {
+                ServerMessage::Acknowledged { through, .. } => {
+                    assert!(through >= sequence);
+                    self.sequence = self.sequence.max(through);
+                    return;
+                }
+                ServerMessage::Command { delivery, .. } => self.commands.push_back(*delivery),
+                other => panic!("unexpected message {other:?}"),
+            }
+        }
+    }
+    async fn command(&mut self, wanted: OperationId) -> CommandDelivery {
+        loop {
+            let delivery = match self.commands.pop_front() {
+                Some(delivery) => delivery,
+                None => match read(&mut self.socket).await.unwrap() {
+                    ServerMessage::Command { delivery, .. } => *delivery,
+                    other => panic!("unexpected {other:?}"),
+                },
+            };
+            if delivery.operation.id() == wanted {
+                return delivery;
+            }
+            assert!(matches!(
+                delivery.operation.command(),
+                LocalCommand::RefreshCatalog {}
+            ));
+            let id = delivery.operation.id();
+            self.observe(agent(self.sequence + 1, id, LocalEvidence::Receipt {}))
+                .await;
+            self.observe(JournalObservation::Catalog {
+                sequence: EventSequence::try_from(self.sequence + 1).unwrap(),
+                operation_id: id,
+                catalog: self.catalog.clone(),
+            })
+            .await;
+        }
+    }
+}
+
+async fn write<S: AsyncRead + AsyncWrite + Unpin>(
+    socket: &mut WebSocketStream<S>,
+    message: &ClientMessage,
+) {
+    for frame in framing::encode(message).unwrap() {
+        socket.send(Message::Text(frame.into())).await.unwrap();
+    }
+}
+async fn read<S: AsyncRead + AsyncWrite + Unpin>(
+    socket: &mut WebSocketStream<S>,
+) -> Option<ServerMessage> {
+    let mut assembler = framing::Assembler::default();
+    loop {
+        match timeout(Duration::from_secs(5), socket.next())
+            .await
+            .expect("bounded WebSocket response")?
+        {
+            Ok(Message::Text(text)) => {
+                if let Some(bytes) = assembler.push(&text).unwrap() {
+                    return Some(serde_json::from_slice(&bytes).unwrap());
+                }
+            }
+            Ok(Message::Ping(bytes)) => socket.send(Message::Pong(bytes)).await.unwrap(),
+            Ok(Message::Pong(_)) => {}
+            Ok(Message::Close(_)) | Err(_) => return None,
+            other => panic!("unexpected frame {other:?}"),
+        }
+    }
+}
+
+#[tokio::test]
+async fn cloudroom_connection_two_replicas_supersede_live_socket_and_join_shutdown() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let first = Server::start(c.f.persistence.clone()).await;
+    let second = Server::start(c.f.persistence.clone()).await;
+    let mut old = Peer::initialize(socket(&first, &c).await, &c, 2).await;
+    let mut current = Peer::initialize(socket(&second, &c).await, &c, 2).await;
+    assert!(current.identity.connection_generation > old.identity.connection_generation);
+    timeout(Duration::from_secs(3), async {
+        while read(&mut old.socket).await.is_some() {}
+    })
+    .await
+    .unwrap();
+    first.close().await;
+    let saved:(i64,bool)=sqlx::query_as("SELECT connection_generation,connection_owner IS NOT NULL FROM local_machines WHERE company_id=$1 AND id=$2")
+        .bind(c.f.company).bind(c.paired.receipt.machine.id.as_uuid()).fetch_one(&c.f.database.pool).await.unwrap();
+    assert_eq!(
+        saved,
+        (current.identity.connection_generation.get() as i64, true)
+    );
+    assert!(current.ready().await);
+    second.close().await;
+    let connected: bool = sqlx::query_scalar(
+        "SELECT connection_owner IS NOT NULL FROM local_machines WHERE company_id=$1 AND id=$2",
+    )
+    .bind(c.f.company)
+    .bind(c.paired.receipt.machine.id.as_uuid())
+    .fetch_one(&c.f.database.pool)
+    .await
+    .unwrap();
+    assert!(!connected);
+}
+
+#[tokio::test]
+async fn cloudroom_connection_lost_ack_reconnect_rewraps_receipt_and_rejects_old_envelope() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let server = Server::start(c.f.persistence.clone()).await;
+    let mut first = Peer::initialize(socket(&server, &c).await, &c, 2).await;
+    assert!(first.ready().await);
+    let operation =
+        c.f.persistence
+            .enqueue_operation(&c.admission(c.send()))
+            .await
+            .unwrap();
+    let delivered = first.command(operation.id()).await;
+    assert_eq!(delivered.mode, DeliveryMode::Dispatch);
+    assert_eq!(
+        delivered.operation.payload_digest(),
+        operation.payload_digest()
+    );
+    let receipt = agent(
+        first.sequence + 1,
+        operation.id(),
+        LocalEvidence::Receipt {},
+    );
+    let through = receipt.sequence().get();
+    let old_identity = first.identity;
+    write(
+        &mut first.socket,
+        &ClientMessage::Observation {
+            identity: first.identity,
+            observation: receipt.clone(),
+        },
+    )
+    .await;
+    timeout(Duration::from_secs(3), async {
+        loop {
+            let cursor: i64 = sqlx::query_scalar(
+                "SELECT acknowledged_sequence FROM local_machines WHERE company_id=$1 AND id=$2",
+            )
+            .bind(c.f.company)
+            .bind(c.paired.receipt.machine.id.as_uuid())
+            .fetch_one(&c.f.database.pool)
+            .await
+            .unwrap();
+            if cursor == through as i64 {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    drop(first); // Lose the already committed ACK before consuming it.
+    let mut second = Peer::initialize(socket(&server, &c).await, &c, through).await;
+    second.observe(receipt.clone()).await;
+    assert!(second.ready().await);
+    write(
+        &mut second.socket,
+        &ClientMessage::Observation {
+            identity: old_identity,
+            observation: receipt,
+        },
+    )
+    .await;
+    timeout(Duration::from_secs(3), async {
+        while read(&mut second.socket).await.is_some() {}
+    })
+    .await
+    .unwrap();
+    let copies: i64 = sqlx::query_scalar(
+        "SELECT count(*) FROM local_agent_observations WHERE company_id=$1 AND sequence=$2",
+    )
+    .bind(c.f.company)
+    .bind(through as i64)
+    .fetch_one(&c.f.database.pool)
+    .await
+    .unwrap();
+    assert_eq!(copies, 1);
+    server.close().await;
+}
+
+#[tokio::test]
+async fn cloudroom_connection_revocation_during_bounded_hello_accepts_no_observation() {
+    let Some(c) = Context::new().await else {
