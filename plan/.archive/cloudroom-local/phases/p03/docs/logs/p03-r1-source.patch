+fn sql_state<T: std::fmt::Debug>(result: Result<T, sqlx::Error>, code: &str) {
+    let error = result.unwrap_err();
+    assert_eq!(
+        error.as_database_error().unwrap().code().as_deref(),
+        Some(code),
+        "{error}"
+    );
+}
