+struct Server {
+    service: Arc<LocalMachineConnections>,
+    stop: CancellationToken,
+    task: Option<JoinHandle<()>>,
+    origin: String,
+}
+impl Server {
+    async fn start(store: Arc<dyn LocalProtocolStore>) -> Self {
+        let service = Arc::new(LocalMachineConnections::new(store));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let origin = format!(
+            "ws://{}/v1/local-machines/connect",
+            listener.local_addr().unwrap()
+        );
+        let app = router().with_state(service.clone());
+        let stop = CancellationToken::new();
+        let shutdown = stop.clone();
+        let task = tokio::spawn(async move {
+            axum::serve(listener, app)
+                .with_graceful_shutdown(shutdown.cancelled_owned())
+                .await
+                .unwrap();
+        });
+        Self {
+            service,
+            stop,
+            task: Some(task),
+            origin,
+        }
+    }
+    async fn close(mut self) {
+        self.service.shutdown().await.unwrap();
+        assert!(self.service.tasks.is_empty());
+        assert_eq!(self.service.slots.available_permits(), MAX_CONNECTIONS);
+        self.stop.cancel();
+        timeout(Duration::from_secs(2), self.task.take().unwrap())
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.stop.cancel();
+        self.service.shutdown.cancel();
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
