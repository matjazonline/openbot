+#[derive(sqlx::FromRow)]
+struct Capacity {
+    unsettled: i64,
+    queued: i64,
+}
+
+async fn capacity(db: &mut PgConnection, company: Uuid, machine: MachineId) -> AppResult<Capacity> {
+    sqlx::query_as("SELECT count(*) FILTER(WHERE command->>'kind' IN ('create','send')) AS unsettled,count(*) AS queued \
+        FROM local_agent_operations WHERE company_id=$1 AND machine_id=$2 AND (outcome IS NULL OR \
+        (outcome='uncertain' AND command->>'kind' IN ('create','send') AND COALESCE(observed_turn_state NOT IN ('completed','failed','stopped'),true)))")
+        .bind(company).bind(machine.as_uuid()).fetch_one(db).await.map_err(Into::into)
+}
