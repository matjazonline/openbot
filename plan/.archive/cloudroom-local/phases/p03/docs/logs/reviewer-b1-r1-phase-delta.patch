+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &turn(
+                13,
+                resolved,
+                "turn_resolved",
+                TurnState::Completed,
+                Some("resolved"),
+            ),
+        )
+        .await
+        .unwrap();
+    c.f.persistence
+        .enqueue_operation(&c.admission(c.send()))
