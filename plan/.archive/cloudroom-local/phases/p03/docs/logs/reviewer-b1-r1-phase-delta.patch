+fn supervise_local_machine_shutdown(
+    connections: Arc<
+        open_bots::adapters::http::routes::local_machine_connection::LocalMachineConnections,
+    >,
+    mut shutdown: tokio::sync::broadcast::Receiver<()>,
+) -> tokio::task::JoinHandle<()> {
