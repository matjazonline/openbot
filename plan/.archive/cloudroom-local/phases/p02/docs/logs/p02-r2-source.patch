+    assert_eq!(leap.timestamp_subsec_nanos() % 1_000, 0);
+    assert!(
+        LocalAgentOperation::queued(
+            OperationId::new(uuid::Uuid::new_v4()).unwrap(),
+            LocalCommand::RefreshCatalog {},
+            leap
+        )
+        .is_err()
