+pub fn validate_name(name: &str) -> AppResult<()> {
+    if name.is_empty()
+        || name.len() > 128
+        || name.trim() != name
+        || name.chars().any(char::is_control)
+    {
+        return Err(AppError::BadRequest(
+            "name must be 1–128 UTF-8 bytes without surrounding whitespace or controls".into(),
+        ));
+    }
+    Ok(())
+}
