index 00000000..7860ddd6
--- /dev/null
+++ b/src/application/local_agents/bounds.rs
@@ -0,0 +1,51 @@
+//! Code-owned protocol limits. Adapters must reject before parsing or dispatching.
+use chrono::{DateTime, Utc};
+
+pub use crate::domain::local_agents::{MAX_PROMPT_BYTES, MAX_RESULT_BYTES};
+
+pub const PROTOCOL_VERSION: u16 = 1;
+pub const PAIRING_ENTROPY_BYTES: usize = 16;
+pub const PAIRING_TTL_SECONDS: i64 = 600;
+pub const MAX_PAIRING_CODES: usize = 5;
+pub const HANDSHAKE_SECONDS: u64 = 10;
+pub const HEARTBEAT_SECONDS: u64 = 15;
+pub const CONNECTION_STALE_SECONDS: u64 = 45;
+pub const MAX_FRAME_BYTES: usize = 64 * 1024;
+pub const MAX_CHUNK_BYTES: usize = 16 * 1024;
+pub const REASSEMBLY_SECONDS: u64 = 30;
+pub const MAX_UNSETTLED_EFFECTS: usize = 8;
+pub const MAX_QUEUED_COMMANDS: usize = 32;
+pub const RESERVED_CONTROL_COMMANDS: usize = 8;
+pub const MAX_PROJECTS: usize = 128;
+pub const MAX_PROVIDERS: usize = 32;
+pub const MAX_MODELS_PER_PROVIDER: usize = 256;
+pub const MAX_PAGE_RECORDS: usize = 100;
+pub const DEFAULT_DEADLINE_SECONDS: i64 = 30 * 60;
+pub const MAX_DEADLINE_SECONDS: i64 = 24 * 60 * 60;
+pub const MAX_OUTBOX_BYTES: usize = 64 * 1024 * 1024;
+
+pub fn validate_capacity(
+    unsettled: usize,
+    queued: usize,
+    command: &super::LocalCommand,
+) -> Result<(), &'static str> {
+    let queue_limit = if command.is_effect() {
+        MAX_QUEUED_COMMANDS - RESERVED_CONTROL_COMMANDS
+    } else {
+        MAX_QUEUED_COMMANDS
+    };
+    if queued >= queue_limit || (command.is_effect() && unsettled >= MAX_UNSETTLED_EFFECTS) {
+        return Err("machine command capacity exhausted");
+    }
+    Ok(())
+}
+
+pub fn validate_deadline(now: DateTime<Utc>, deadline: DateTime<Utc>) -> Result<(), &'static str> {
+    let remaining = deadline.signed_duration_since(now);
+    if remaining <= chrono::Duration::zero()
+        || remaining > chrono::Duration::seconds(MAX_DEADLINE_SECONDS)
+    {
+        return Err("deadline must be in the next 24 hours");
+    }
+    Ok(())
+}
diff --git a/src/application/local_agents/catalog.rs b/src/application/local_agents/catalog.rs
new file mode 100644
index 00000000..234e2b54
--- /dev/null
+++ b/src/application/local_agents/catalog.rs
@@ -0,0 +1,60 @@
+use super::bounds::{MAX_MODELS_PER_PROVIDER, MAX_PROJECTS, MAX_PROVIDERS};
+use crate::{
+    application::transport::bounded::BoundedVec,
+    domain::local_agents::{
+        CloudroomProjectId, EventSequence, ExecutionSelection, InstallationId, LocalProvider,
+        LocalReasoningLevel, MachineId, ModelId,
+    },
+};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LocalCatalog {
+    pub projects: BoundedVec<CloudroomProjectId, MAX_PROJECTS>,
+    pub providers: BoundedVec<ProviderCatalog, MAX_PROVIDERS>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ProviderCatalog {
+    pub provider: LocalProvider,
+    pub models: BoundedVec<ModelCapabilities, MAX_MODELS_PER_PROVIDER>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelCapabilities {
+    pub model: ModelId,
+    pub reasoning_levels: BoundedVec<LocalReasoningLevel, 8>,
+}
+
+impl LocalCatalog {
+    pub fn validate_selection(&self, selection: &ExecutionSelection) -> Result<(), &'static str> {
+        if !self.projects.contains(&selection.project_id) {
+            return Err("project is not advertised");
+        }
+        let model = self
+            .providers
+            .iter()
+            .filter(|provider| provider.provider == selection.provider)
+            .flat_map(|provider| provider.models.iter())
+            .find(|model| model.model == selection.model)
+            .ok_or("exact provider/model is not advertised")?;
+        if !model.reasoning_levels.contains(&selection.policy.reasoning) {
+            return Err("reasoning level is not supported by this model");
+        }
+        Ok(())
+    }
+}
+
+/// A machine's capabilities_sequence references this accepted installation-scoped snapshot.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CapabilitySnapshot {
+    pub machine_id: MachineId,
+    pub installation_id: InstallationId,
+    pub sequence: EventSequence,
+    pub observed_at: chrono::DateTime<chrono::Utc>,
+    pub catalog: LocalCatalog,
+}
diff --git a/src/application/local_agents/contract_tests.rs b/src/application/local_agents/contract_tests.rs
new file mode 100644
index 00000000..14839d0e
