+    machine_id uuid NOT NULL,
+    installation_id uuid NOT NULL,
+    profile_id uuid NOT NULL,
+    selection jsonb NOT NULL CHECK ((jsonb_typeof(selection) = 'object' AND selection->>'machine_id' = machine_id::text) IS TRUE),
+    conversation_id uuid,
+    workflow_run_id uuid,
+    thread_id text CHECK (thread_id ~ '^[A-Za-z0-9_.:-]{1,128}$'),
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    PRIMARY KEY (company_id,id),
+    UNIQUE (installation_id,thread_id),
+    UNIQUE (company_id,machine_id,installation_id,id),
+    FOREIGN KEY (company_id,machine_id,installation_id) REFERENCES public.local_machines(company_id,id,installation_id) ON DELETE CASCADE,
+    FOREIGN KEY (company_id,profile_id) REFERENCES public.local_agent_profiles(company_id,id),
+    FOREIGN KEY (company_id,conversation_id) REFERENCES public.threads(company_id,id),
+    FOREIGN KEY (company_id,workflow_run_id) REFERENCES public.workflow_runs(company_id,id),
+    CHECK (num_nonnulls(conversation_id,workflow_run_id) = 1)
+);
+
+CREATE TABLE public.local_agent_operations (
+    id uuid NOT NULL,
+    company_id uuid NOT NULL,
+    machine_id uuid NOT NULL,
+    installation_id uuid NOT NULL,
+    session_id uuid,
+    logical_key text NOT NULL CHECK (octet_length(logical_key) BETWEEN 1 AND 256),
+    command jsonb NOT NULL CHECK (jsonb_typeof(command) = 'object'),
+    payload_digest text NOT NULL CHECK (payload_digest ~ '^[0-9a-f]{64}$'),
+    deadline timestamptz NOT NULL,
+    -- Set before the first transport write; a lost receipt does not prove non-delivery.
+    delivery_attempted_at timestamptz,
+    dispatch jsonb NOT NULL DEFAULT '{"kind":"not_dispatched"}'::jsonb,
+    outcome text CHECK (outcome IN ('succeeded','failed','cancelled','expired','uncertain')),
+    output text CHECK (octet_length(output) <= 262144),
+    output_truncated boolean NOT NULL DEFAULT false,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    PRIMARY KEY (company_id,id),
+    UNIQUE (company_id,machine_id,logical_key),
+    UNIQUE (company_id,machine_id,installation_id,id),
+    FOREIGN KEY (company_id,machine_id,installation_id) REFERENCES public.local_machines(company_id,id,installation_id) ON DELETE CASCADE,
+    FOREIGN KEY (company_id,machine_id,installation_id,session_id) REFERENCES public.local_agent_sessions(company_id,machine_id,installation_id,id),
+    CHECK ((command->>'kind' IN ('create','send','inspect','stop_thread','archive_thread','refresh_catalog')) IS TRUE),
+    CHECK (((command->>'kind' = 'refresh_catalog') = (session_id IS NULL)) IS TRUE),
+    CHECK ((dispatch->>'kind' IN ('not_dispatched','accepted_locally','submission_intent','native_identity','catalog_snapshot')) IS TRUE)
+);
+
+CREATE TABLE public.local_agent_observations (
+    company_id uuid NOT NULL,
+    machine_id uuid NOT NULL,
+    installation_id uuid NOT NULL,
+    sequence bigint NOT NULL CHECK (sequence > 0),
+    operation_id uuid NOT NULL,
+    digest text NOT NULL CHECK (digest ~ '^[0-9a-f]{64}$'),
+    observation jsonb NOT NULL CHECK (jsonb_typeof(observation) = 'object' AND octet_length(observation::text) <= 2097152),
+    accepted_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    PRIMARY KEY (company_id,installation_id,sequence),
+    FOREIGN KEY (company_id,machine_id,installation_id,operation_id) REFERENCES public.local_agent_operations(company_id,machine_id,installation_id,id) ON DELETE CASCADE
+);
+
+CREATE TABLE public.local_pair_budgets (
+    identity_key bytea PRIMARY KEY CHECK (octet_length(identity_key) = 32),
+    attempts smallint NOT NULL CHECK (attempts BETWEEN 1 AND 12),
+    window_ends_at timestamptz NOT NULL
+);
+
+CREATE FUNCTION public.local_installation_identity_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'installation reservations cannot be changed or released' USING ERRCODE='23514';
+END $$;
+CREATE TRIGGER local_installation_identity_immutable BEFORE UPDATE OR DELETE ON public.local_installations
+    FOR EACH ROW EXECUTE FUNCTION public.local_installation_identity_immutable();
+
+CREATE FUNCTION public.local_operation_inputs_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.company_id,NEW.machine_id,NEW.installation_id,NEW.session_id,NEW.logical_key,NEW.command,NEW.payload_digest,NEW.deadline)
+        IS DISTINCT FROM ROW(OLD.company_id,OLD.machine_id,OLD.installation_id,OLD.session_id,OLD.logical_key,OLD.command,OLD.payload_digest,OLD.deadline)
+        OR (OLD.delivery_attempted_at IS NOT NULL AND NEW.delivery_attempted_at IS DISTINCT FROM OLD.delivery_attempted_at)
+    THEN RAISE EXCEPTION 'local operation inputs are immutable' USING ERRCODE='23514'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_operation_inputs_immutable BEFORE UPDATE ON public.local_agent_operations
+    FOR EACH ROW EXECUTE FUNCTION public.local_operation_inputs_immutable();
+
+CREATE FUNCTION public.local_session_inputs_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.company_id,NEW.machine_id,NEW.installation_id,NEW.profile_id,NEW.selection,NEW.conversation_id,NEW.workflow_run_id)
+        IS DISTINCT FROM ROW(OLD.company_id,OLD.machine_id,OLD.installation_id,OLD.profile_id,OLD.selection,OLD.conversation_id,OLD.workflow_run_id)
+        OR (OLD.thread_id IS NOT NULL AND NEW.thread_id IS DISTINCT FROM OLD.thread_id)
+    THEN RAISE EXCEPTION 'local session inputs and native identity are immutable' USING ERRCODE='23514'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_session_inputs_immutable BEFORE UPDATE ON public.local_agent_sessions
+    FOR EACH ROW EXECUTE FUNCTION public.local_session_inputs_immutable();
