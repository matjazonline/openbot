diff --git a/integrations/cloudroom-plugin/compatibility/check-source.mjs b/integrations/cloudroom-plugin/compatibility/check-source.mjs
new file mode 100644
index 00000000..ad3ee8b2
--- /dev/null
+++ b/integrations/cloudroom-plugin/compatibility/check-source.mjs
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { realpathSync, readFileSync, lstatSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { dirname, resolve, sep } from "node:path";
+import { fileURLToPath } from "node:url";
+
+export const CLOUDROOM_REVISION = "d8b3cc3a16bb4b06fc99d8e543d40f1087d1e815";
+const compatibilityRoot = dirname(fileURLToPath(import.meta.url));
+
+function checkedGit(checkout, revision) {
+  const root = realpathSync(checkout);
+  const git = (args) => execFileSync("git", ["-C", root, ...args], {
+    encoding: "utf8", timeout: 10_000, maxBuffer: 64 * 1024,
+    stdio: ["ignore", "pipe", "pipe"],
+  }).trim();
+  assert.equal(realpathSync(git(["rev-parse", "--show-toplevel"])), root, "pass the checkout root");
+  assert.equal(git(["rev-parse", "HEAD"]), revision, "wrong Cloudroom revision");
+  return { root, git };
+}
+
+export function verifySource(checkout, expectedRevision = CLOUDROOM_REVISION) {
+  const { git } = checkedGit(checkout, expectedRevision);
+  // Explicit repository root: callers may run from gui/. Quiet avoids logging a private diff.
+  git(["diff", "--quiet", "HEAD", "--", "gui/"]);
+  return expectedRevision;
+}
+
+export function prepareSource(checkout, {
+  revision = CLOUDROOM_REVISION,
+  patch = JSON.parse(readFileSync(resolve(compatibilityRoot, "manifest.json"), "utf8")).sourcePatch,
+  patchRoot = compatibilityRoot,
+} = {}) {
+  const { root, git } = checkedGit(checkout, revision);
+  const hash = (value) => createHash("sha256").update(value).digest("hex");
+  assert(patch && patch.sourcePath.startsWith("gui/") && !patch.sourcePath.split("/").includes(".."));
+  const patchPath = realpathSync(resolve(patchRoot, patch.path));
+  assert(patchPath.startsWith(realpathSync(patchRoot) + sep), "patch escapes fixture root");
+  assert.equal(hash(readFileSync(patchPath)), patch.sha256, "tampered source patch");
+  const target = resolve(root, patch.sourcePath);
+  assert(realpathSync(target).startsWith(root + sep), "source path escapes checkout");
+  assert(lstatSync(target).isFile() && (lstatSync(target).mode & 0o111) === 0, "unexpected source file mode");
+  assert.equal(git(["ls-files", "--others", "--exclude-standard", "--", "gui/"]), "", "unexpected untracked GUI inputs");
+  const changed = () => git(["diff", "--name-only", "HEAD"]).split("\n").filter(Boolean);
+  const before = changed();
+  if (before.length === 0) {
+    assert.equal(hash(readFileSync(target)), patch.beforeSha256, "unexpected source base");
+    const patchPaths = git(["apply", "--numstat", patchPath]).split("\n").map((line) => line.split("\t")[2]);
+    assert.deepEqual(patchPaths, [patch.sourcePath], "patch changes unapproved paths");
+    git(["apply", "--check", patchPath]);
+    git(["apply", "--whitespace=error", patchPath]);
+  } else assert.deepEqual(before, [patch.sourcePath], "unapproved source edits");
+  assert.deepEqual(changed(), [patch.sourcePath], "unapproved source edits");
+  assert.equal(hash(readFileSync(target)), patch.afterSha256, "source differs from approved patch");
+  return { revision, patchSha256: patch.sha256, sourceSha256: patch.afterSha256 };
+}
diff --git a/integrations/cloudroom-plugin/compatibility/check-source.test.mjs b/integrations/cloudroom-plugin/compatibility/check-source.test.mjs
new file mode 100644
index 00000000..5c620891
--- /dev/null
+++ b/integrations/cloudroom-plugin/compatibility/check-source.test.mjs
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync, readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { verifySource, prepareSource } from "./check-source.mjs";
+
+test("source verification rejects changed tracked GUI source before any build, from any cwd", () => {
+  const fixture = mkdtempSync(join(tmpdir(), "openbot-source-guard-"));
+  const git = (args) => execFileSync("git", ["-C", fixture, ...args], { encoding: "utf8", stdio: "pipe" }).trim();
+  try {
+    git(["init", "--quiet"]);
+    mkdirSync(join(fixture, "gui"));
+    writeFileSync(join(fixture, "gui/package.json"), "{}\n");
+    git(["add", "gui/package.json"]);
+    git(["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "-c", "core.hooksPath=/dev/null", "commit", "--quiet", "--no-gpg-sign", "-m", "fixture"]);
+    const head = git(["rev-parse", "HEAD"]);
+    assert.equal(verifySource(fixture, head), head);
+    assert.throws(() => verifySource(join(fixture, "gui"), head), /checkout root/);
+    assert.throws(() => verifySource(fixture, "0".repeat(40)), /wrong Cloudroom revision/);
+    writeFileSync(join(fixture, "gui/package.json"), '{"modified":true}\n');
+    // The old guard falsely passed this exact change when invoked from gui/.
+    assert.doesNotThrow(() => execFileSync("git", ["diff", "--exit-code", "HEAD", "--", "gui"], { cwd: join(fixture, "gui"), stdio: "pipe" }));
+    assert.throws(() => verifySource(fixture, head));
+  } finally { rmSync(fixture, { recursive: true, force: true }); }
+});
+
+test("prepared source accepts only the exact approved patch and rejects tampering", () => {
+  const fixture = mkdtempSync(join(tmpdir(), "openbot-patched-source-"));
+  const patches = mkdtempSync(join(tmpdir(), "openbot-patch-input-"));
+  const git = (args) => execFileSync("git", ["-C", fixture, ...args], { encoding: "utf8", stdio: "pipe" }).trim();
+  const hash = (value) => createHash("sha256").update(value).digest("hex");
+  try {
+    git(["init", "--quiet"]);
+    mkdirSync(join(fixture, "gui"));
+    writeFileSync(join(fixture, "gui/package.json"), "{}\n");
+    writeFileSync(join(fixture, "gui/other.ts"), "export const base = true;\n");
+    git(["add", "."]);
+    git(["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "-c", "core.hooksPath=/dev/null", "commit", "--quiet", "--no-gpg-sign", "-m", "fixture"]);
+    const revision = git(["rev-parse", "HEAD"]);
+    const after = '{"approved":true}\n';
+    writeFileSync(join(fixture, "gui/package.json"), after);
+    const patchText = git(["diff", "--full-index", "--binary"]) + "\n";
+    writeFileSync(join(fixture, "gui/package.json"), "{}\n");
+    writeFileSync(join(patches, "approved.patch"), patchText);
+    const patch = { path: "approved.patch", sha256: hash(patchText), sourcePath: "gui/package.json",
+      beforeSha256: hash("{}\n"), afterSha256: hash(after) };
+    const options = { revision, patchRoot: patches, patch };
+    assert.throws(() => prepareSource(fixture, { ...options, revision: "0".repeat(40) }), /wrong Cloudroom revision/);
+    assert.equal(prepareSource(fixture, options).patchSha256, patch.sha256);
+    assert.equal(readFileSync(join(fixture, "gui/package.json"), "utf8"), after);
+    assert.deepEqual(prepareSource(fixture, options), prepareSource(fixture, options));
+    writeFileSync(join(fixture, "gui/package.json"), '{"unapproved":true}\n');
+    assert.throws(() => prepareSource(fixture, options), /source differs/);
+    writeFileSync(join(fixture, "gui/package.json"), after);
+    writeFileSync(join(fixture, "gui/other.ts"), "export const base = false;\n");
+    assert.throws(() => prepareSource(fixture, options), /unapproved source edits/);
+    writeFileSync(join(fixture, "gui/other.ts"), "export const base = true;\n");
+    writeFileSync(join(fixture, "gui/untracked.ts"), "export const unapproved = true;\n");
+    assert.throws(() => prepareSource(fixture, options), /untracked/);
+    rmSync(join(fixture, "gui/untracked.ts"));
+    writeFileSync(join(patches, "approved.patch"), patchText + "tampered");
+    assert.throws(() => prepareSource(fixture, options), /tampered/);
+  } finally { rmSync(fixture, { recursive: true, force: true }); rmSync(patches, { recursive: true, force: true }); }
+});
diff --git a/integrations/cloudroom-plugin/compatibility/local-caller.mjs b/integrations/cloudroom-plugin/compatibility/local-caller.mjs
new file mode 100644
index 00000000..d9d97b35
--- /dev/null
+++ b/integrations/cloudroom-plugin/compatibility/local-caller.mjs
@@ -0,0 +1,33 @@
+// Test fixture for the local caller proof performed by Cloudroom's desktop wrapper.
+// No provider credentials are read or exported. Keep the issued token in memory only.
+import assert from "node:assert/strict";
+import { realpath, stat, writeFile, unlink } from "node:fs/promises";
+import { join } from "node:path";
+
+export async function localCallerHeaders(origin, profile) {
+  const url = new URL(origin);
+  assert.equal(url.protocol, "http:");
+  assert.equal(url.hostname, "127.0.0.1");
+  const post = async (path, body) => {
+    const response = await fetch(new URL(path, url), {
+      method: "POST", headers: { "content-type": "application/json" },
+      body: JSON.stringify(body), redirect: "error", signal: AbortSignal.timeout(5000),
+    });
+    assert(response.ok, "local caller proof refused");
+    return response.json();
+  };
+  const started = await post("/api/v1/caller-proofs", {});
+  assert.match(started.id, /^[0-9a-f]{12}-[0-9a-f]{32}$/);
+  assert.equal(await realpath(started.directory), join(await realpath(profile), "caller-proofs"));
+  const directory = await stat(started.directory);
+  assert(directory.isDirectory() && directory.uid === process.getuid());
+  const path = join(started.directory, started.id);
+  await writeFile(path, started.id, { flag: "wx", mode: 0o600 });
+  try {
+    const { token } = await post(`/api/v1/caller-proofs/${started.id}`, { claim: started.claim });
+    assert.match(token, /^[A-Za-z0-9_-]{32,128}$/);
+    return { "x-cloudroom-caller": token };
+  } finally {
+    try { await unlink(path); } catch (error) { if (error.code !== "ENOENT") throw error; }
+  }
+}
