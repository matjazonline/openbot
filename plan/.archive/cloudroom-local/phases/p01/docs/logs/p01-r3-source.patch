+    Expired,
+    Uncertain,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TurnState {
+    Queued,
+    Running,
+    WaitingForInput,
+    Completed,
+    Failed,
+    Stopped,
+    Missing,
+}
