+            if let Some(outcome) = view.operation.outcome() {
+                assert_eq!(outcome, expected);
+                return;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+    })
+    .await
+    .unwrap();
+}
+
