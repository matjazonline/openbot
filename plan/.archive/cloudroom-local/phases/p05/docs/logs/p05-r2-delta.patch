+fn runner<'a, H: WorkflowHandler>(
+    p: &'a PostgresPersistence,
+    handler: &'a H,
+) -> WorkflowWorker<'a, PostgresPersistence, H> {
+    WorkflowWorker {
+        port: p,
+        handler,
+        notices: None,
+        worker: WorkflowWorkerId(Uuid::new_v4()),
+        lease: lease(),
+        poll: PollPolicy::new(Duration::from_millis(50), 8).unwrap(),
+        active_jobs: None,
+        monitoring: None,
+    }
+}
