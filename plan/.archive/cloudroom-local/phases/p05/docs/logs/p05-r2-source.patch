+// Production Rust markup and scripts; HTTP authorization and persistence are tested in Rust.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createServer } from 'node:http';
+import { chromium, expect } from '@playwright/test';
+
+const directory = process.env.CLOUDROOM_MANAGEMENT_BROWSER_FIXTURES;
+assert.ok(directory, 'Run dump_cloudroom_management_browser_fixtures against owned PostgreSQL');
+const fixture = name => readFileSync(`${directory}/${name}`);
+const metadata = JSON.parse(fixture('metadata.json'));
+const paging = JSON.parse(fixture('profiles-navigation.json'));
+const root = new URL('../../', import.meta.url);
+const csp = readFileSync(new URL('src/adapters/http/security.rs', root), 'utf8').match(/const CSP: &str = "([^"]+)";/)[1];
+
+test('local profile and session forms escape native output and acknowledge accepted writes', async () => {
+  const writes = [];
+  const pending = new Set();
+  let release;
+  const server = createServer(async (request, response) => {
+    const url = new URL(request.url, 'http://127.0.0.1');
+    if (request.method === 'POST') {
+      let body = ''; for await (const chunk of request) body += chunk;
+      writes.push({ path: url.pathname, fields: new URLSearchParams(body) });
+      pending.add(response);
+      await new Promise(resolve => { release = resolve; });
+      pending.delete(response);
+      response.writeHead(200, { 'content-type': 'text/html', 'content-security-policy': csp }).end(fixture('page.html'));
+      return;
+    }
+    if (url.pathname.startsWith('/assets/')) {
+      const name = url.pathname.split('/').at(-1);
+      try {
+        const content = ['app.js', 'theme-init.js'].includes(name) ? fixture(name) : readFileSync(new URL(url.pathname.slice(1), root));
+        response.writeHead(200, { 'content-type': name.endsWith('.css') ? 'text/css' : 'text/javascript' }).end(content);
+      } catch { response.writeHead(404).end(); }
+      return;
+    }
+    const file = url.searchParams.get('profile') === paging.profile ? 'profiles-selected.html'
+      : url.searchParams.get('after_profile') === paging.cursor ? 'profiles-next.html'
+      : url.searchParams.get('conversation') === paging.conversation ? 'profiles-first.html' : 'page.html';
+    response.writeHead(200, { 'content-type': 'text/html', 'content-security-policy': csp }).end(fixture(file));
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const browser = await chromium.launch(process.env.CHROME_PATH ? { executablePath: process.env.CHROME_PATH } : {});
+  try {
+    const page = await browser.newPage({ viewport: { width: 1400, height: 1100 } });
+    const errors = [];
+    const submissions = [];
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('console', message => {
+      if (message.text().startsWith('LOCAL_FORM_STATE ')) submissions.push(JSON.parse(message.text().slice(17)));
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}/ui/companies/${metadata.company}/local-agents`);
+    const observeSubmits = () => page.evaluate(() => document.addEventListener('submit', event => {
+      const form = event.target;
+      console.info('LOCAL_FORM_STATE ' + JSON.stringify({ busy: form.getAttribute('aria-busy'),
+        disabled: form.querySelector('button').getAttribute('aria-disabled') }));
+    }));
+    await observeSubmits();
+    await expect(page.locator('main img')).toHaveCount(0);
+    await expect(page.getByText('Result <img src=x onerror=alert(1)>', { exact: true })).toBeVisible();
+    await expect(page.getByText('Measured usage: Unavailable', { exact: true })).toBeVisible();
+    await expect(page.getByText('Waiting for input or permission. Respond in Cloudroom on the machine.')).toBeVisible();
+    await expect(page.getByRole('button', { name: 'Stop entire thread', exact: true })).toBeVisible();
+    await expect(page.locator('input[readonly]')).toHaveValue('thread_management');
+    for (const theme of ['dark', 'light']) {
+      await page.evaluate(theme => document.documentElement.setAttribute('data-theme', theme), theme);
+      const field = page.locator('input[name=name]');
+      await expect(field).toHaveValue('Profile "<img src=x onerror=alert(1)>');
+      await field.focus();
+      assert.equal(await field.evaluate(element => getComputedStyle(element).outlineOffset), '-1px');
+    }
+    const form = page.locator(`form[action$="/sessions"]`).filter({ has: page.locator('textarea[name=prompt]') });
+    await form.locator('textarea').fill('');
+    await form.getByRole('button').click();
+    assert.equal(writes.length, 0, 'invalid native form does not start work');
+    await expect(form).not.toHaveAttribute('aria-busy', 'true');
+    await form.locator('textarea').fill('Browser explicit native task');
+    await form.getByRole('button').click({ noWaitAfter: true });
+    await expect.poll(() => writes.length).toBe(1);
+    await expect.poll(() => submissions.length).toBe(1);
+    assert.deepEqual(submissions[0], { busy: 'true', disabled: 'true' });
+    assert.equal(writes[0].fields.get('prompt'), 'Browser explicit native task');
+    assert.equal(writes[0].fields.get('conversation_id'), metadata.conversation);
+    assert.equal(writes[0].fields.get('profile_id'), metadata.profile);
+    assert.match(writes[0].fields.get('request_id'), /^[0-9a-f-]{36}$/);
+    release();
+    await page.waitForURL('**/sessions');
+    await page.waitForLoadState('load');
+    const base = `http://127.0.0.1:${server.address().port}/ui/companies/${paging.company}/local-agents`;
+    await page.goto(`${base}?channel=${paging.channel}&conversation=${paging.conversation}`);
+    await page.getByRole('link', { name: 'More profiles', exact: true }).click();
+    assert.equal(new URL(page.url()).searchParams.get('conversation'), paging.conversation);
+    await page.getByRole('link', { name: paging.name, exact: true }).click();
+    assert.equal(new URL(page.url()).searchParams.get('conversation'), paging.conversation);
+    await expect(form.locator('[name=profile_id]')).toHaveValue(paging.profile);
+    await expect(form.locator('[name=conversation_id]')).toHaveValue(paging.conversation);
+    await observeSubmits();
+    await form.locator('textarea').fill('Use the selected later-page profile');
+    await form.getByRole('button').click({ noWaitAfter: true });
+    await expect.poll(() => writes.length).toBe(2);
+    assert.equal(writes[1].fields.get('profile_id'), paging.profile);
+    assert.equal(writes[1].fields.get('conversation_id'), paging.conversation);
+    release();
+    await page.waitForURL('**/sessions');
+    await page.waitForLoadState('load');
+    assert.deepEqual(errors, []);
+  } finally {
+    release?.();
+    for (const response of pending) response.destroy();
+    await browser.close();
+    server.closeAllConnections();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
diff --git a/src/adapters/http/pages/local_agents/machines.rs b/src/adapters/http/pages/local_agents/machines.rs
new file mode 100644
index 00000000..9d32b39e
--- /dev/null
+++ b/src/adapters/http/pages/local_agents/machines.rs
@@ -0,0 +1,84 @@
+use super::*;
+
+pub(super) fn render(view: &Page<'_>) -> String {
+    let company = view.company.id;
+    let base = base(company);
+    let cards=view.machines.iter().map(|machine| {
+        let state=enum_value(&machine.state);
+        let seen=machine.last_seen_at.map_or_else(||"Never".into(),|time|time.to_rfc3339());
+        let controls=if machine.state!=MachineState::Revoked {
+            let change=if machine.state==MachineState::Enabled{"disable"}else{"enable"};
+            let change_form=form(&format!("{base}/machines/{}/state",machine.id),&format!(r#"<input type="hidden" name="change" value="{change}">"#),if change=="disable"{"Disable new work"}else{"Enable new work"});
+            let revoke=form(&format!("{base}/machines/{}/state",machine.id),r#"<input type="hidden" name="change" value="revoke">"#,"Revoke machine credential");
+            format!("{change_form}{revoke}")
+        }else{String::new()};
+        format!(r#"<article class="card card-border bg-base-100 p-4 space-y-2"><a class="link font-semibold" href="{base}?machine={id}">{name}</a><p>{state} · Last seen {seen}</p><p class="font-mono text-xs break-all">{id}</p><div class="flex flex-wrap gap-3">{controls}</div>{replacement}</article>"#,
+            id=machine.id,name=text(&machine.name),seen=text(&seen),state=text(&state),
+            replacement=form(&format!("{base}/pairings"),&format!(r#"<input type="hidden" name="replace" value="{}">"#,machine.id),"Create replacement pairing code"))
+    }).collect::<String>();
+    let next = if view.machines.len() == bounds::MAX_PAGE_RECORDS {
+        view.machines.last().map_or_else(String::new, |machine| {
+            format!(
+                r#"<a class="link" href="{base}?after={}">More machines</a>"#,
+                machine.id
+            )
+        })
+    } else {
+        String::new()
+    };
+    let pending=view.pairings.iter().filter(|pair|pair.consumed_at.is_none()&&pair.revoked_at.is_none()).map(|pair| {
+        format!(r#"<li class="flex flex-wrap gap-3 items-center">Pairing expires {expires}{cancel}</li>"#,expires=text(&pair.expires_at.to_rfc3339()),
+            cancel=form(&format!("{base}/pairings/{}/cancel",pair.id),"","Cancel pairing"))
+    }).collect::<String>();
+    let issued=view.pairing.map_or_else(String::new,|created|format!(r#"<div role="status" class="alert flex-col items-start"><p>Enter this one-time code in the Openbot plugin on the company machine. It expires at {expires}.</p><code class="select-all font-mono break-all">{code}</code></div>"#,
+        expires=text(&created.attempt.expires_at.to_rfc3339()),code=text(created.code.expose_secret())));
+    format!(
+        r#"<section class="space-y-4"><h2 class="text-xl font-semibold">Company machines</h2><p>Keep the Cloudroom server, host daemon and Openbot plugin running. Disabling or revoking a machine prevents new work; it does not prove disconnected native work stopped.</p>{issued}{new_pair}<ul>{pending}</ul><div class="grid gap-4 md:grid-cols-2">{cards}</div>{next}{selected}</section>"#,
+        new_pair = form(&format!("{base}/pairings"), "", "Create pairing code"),
+        selected = selected(view)
+    )
+}
+
+fn selected(view: &Page<'_>) -> String {
+    let (Some(details), Some(runtime)) = (view.machine, view.runtime) else {
+        return String::new();
+    };
+    let machine = &details.machine;
+    let base = base(view.company.id);
+    use crate::application::local_agents::protocol::ConnectionIssue;
+    let connection = match runtime.last_issue {
+        Some(ConnectionIssue::IncompatibleProtocol) => {
+            "Incompatible plugin protocol · install the supported plugin build"
+        }
+        Some(ConnectionIssue::RecoveryRequired) => {
+            "Journal recovery required · restore the original journal or revoke and pair again; do not repeat uncertain work"
+        }
+        Some(ConnectionIssue::ConnectionFailed) => {
+            "Connection failed · inspect local plugin logs and test the catalog"
+        }
+        None if !runtime.connected => "Offline",
+        None if runtime.reconciled => "Connected · protocol compatible",
+        None => "Connected · handshake or reconciliation pending",
+    };
+    let test=view.test.map_or_else(String::new,|test|format!("<p role=\"status\">Catalog connection test: {}. Reload this page to reconcile its current result.</p>",text(&test.operation.outcome().map_or_else(||"queued".into(),|outcome|enum_value(&outcome)))));
+    let catalog=details.capabilities.as_ref().map_or_else(||"<p>No verified catalog yet. Start the plugin and request a connection test.</p>".into(),|cap| {
+        let providers=cap.catalog.providers.iter().map(|provider|format!("<li>{}: {} advertised models</li>",text(&enum_value(&provider.provider)),provider.models.len())).collect::<String>();
+        let projects=cap.catalog.projects.iter().map(|project|format!(r#"<label class="flex gap-2 items-center"><input type="checkbox" class="checkbox" name="project" value="{id}"{checked}>{name}</label>"#,
+            id=attr(project.as_str()),name=text(project.as_str()),checked=if runtime.projects.contains(project){" checked"}else{""})).collect::<String>();
+        format!("<p>Catalog observed at {}. Advertised availability is not proof of a working provider login.</p><ul>{providers}</ul>{}",text(&cap.observed_at.to_rfc3339()),form(&format!("{base}/machines/{}/projects",machine.id),&projects,"Save enabled projects"))
+    });
+    format!(
+        r#"<article class="card card-border p-4 space-y-3"><h3 class="font-semibold">{name}</h3><p>{connection}</p><p>{effects} unsettled native effects · {commands} outstanding commands</p><p>A connection test checks plugin reachability and catalog exchange. Only an explicit native task establishes provider execution. Offline work waits until its saved deadline; it never moves to another machine.</p>{test}{refresh}{catalog}</article>"#,
+        name = text(&machine.name),
+        effects = runtime.unsettled_effects,
+        commands = runtime.outstanding_commands,
+        refresh = form(
+            &format!("{base}/machines/{}/test", machine.id),
+            &format!(
+                r#"<input type="hidden" name="request_id" value="{}">"#,
+                request_id()
+            ),
+            "Test connection / Refresh catalog"
+        )
+    )
+}
diff --git a/src/adapters/http/pages/local_agents/mod.rs b/src/adapters/http/pages/local_agents/mod.rs
new file mode 100644
index 00000000..ac31627c
--- /dev/null
+++ b/src/adapters/http/pages/local_agents/mod.rs
@@ -0,0 +1,91 @@
+use super::{escape_html_attr as attr, escape_html_text as text};
+use crate::application::local_agents::{management::*, *};
+use crate::domain::{
+    entities::{company::Company, thread::Thread},
+    local_agents::*,
+};
+use uuid::Uuid;
+
+mod machines;
+mod profiles;
+mod sessions;
+
+pub struct Page<'a> {
+    pub company: &'a Company,
+    pub machines: &'a [LocalMachine],
+    pub pairings: &'a [PairingAttempt],
+    pub profiles: &'a RecordPage<LocalAgentProfile>,
+    pub machine: Option<&'a MachineDetails>,
+    pub runtime: Option<&'a MachineRuntime>,
+    pub profile: Option<&'a LocalAgentProfile>,
+    pub provider: Option<LocalProvider>,
+    pub model: Option<&'a ModelId>,
+    pub conversation: Option<&'a Thread>,
+    pub sessions: Option<&'a RecordPage<SessionSummary>>,
+    pub session: Option<&'a SessionDetails>,
+    pub test: Option<&'a LocalOperationView>,
+    pub pairing: Option<&'a CreatedPairing>,
+}
+
+pub fn page(view: &Page<'_>) -> String {
+    let company = view.company.id;
+    let body = format!(
+        r#"<main class="h-full overflow-auto p-6 mx-auto max-w-5xl space-y-6">
+        <a class="link" href="/ui/companies?company_id={company}">Company settings</a>
+        <h1 class="text-2xl font-bold">Local agents · {name}</h1>
+        <p>Cloudroom runs native agents under the machine's local account. Local profiles are separate from Openbot agents and use the local account's files, tools, provider logins and permission policy.</p>
+        {machines}{profiles}{start}{session}</main>"#,
+        name = text(&view.company.name),
+        machines = machines::render(view),
+        profiles = profiles::render(view),
+        start = sessions::start(view),
+        session = view
+            .session
+            .map_or_else(String::new, |session| sessions::detail(company, session))
+    );
+    super::mailbox::ui_layout("Local agents", &body)
+}
+
+fn base(company: Uuid) -> String {
+    format!("/ui/companies/{company}/local-agents")
+}
+fn navigation(view: &Page<'_>, query: &str) -> String {
+    let context = view.conversation.map_or_else(String::new, |thread| {
+        format!("&channel={}&conversation={}", thread.channel_id, thread.id)
+    });
+    format!("{}?{query}{context}", base(view.company.id))
+}
+fn conversation_fields(view: &Page<'_>) -> String {
+    view.conversation.map_or_else(String::new, |thread| format!(
+        r#"<input type="hidden" name="channel" value="{}"><input type="hidden" name="conversation" value="{}">"#,
+        thread.channel_id, thread.id))
+}
+fn request_id() -> Uuid {
+    Uuid::new_v4()
+}
+fn button(label: &str) -> String {
+    super::onboarding::busy_submit_button(label)
+}
+fn form(action: &str, fields: &str, label: &str) -> String {
+    format!(
+        r#"<form method="post" action="{}" data-submit="busy-once" data-pending-label="Working…" class="space-y-3">{}{}</form>"#,
+        attr(action),
+        fields,
+        button(label)
+    )
+}
+fn enum_value(value: &impl serde::Serialize) -> String {
+    serde_json::to_value(value)
+        .expect("closed enum serializes")
+        .as_str()
+        .expect("string enum")
+        .to_owned()
+}
+fn option(value: &str, label: &str, selected: bool) -> String {
+    format!(
+        r#"<option value="{}"{}>{}</option>"#,
+        attr(value),
+        if selected { " selected" } else { "" },
+        text(label)
+    )
+}
diff --git a/src/adapters/http/pages/local_agents/profiles.rs b/src/adapters/http/pages/local_agents/profiles.rs
new file mode 100644
index 00000000..e54638b8
--- /dev/null
+++ b/src/adapters/http/pages/local_agents/profiles.rs
@@ -0,0 +1,138 @@
+use super::*;
+
+pub(super) fn render(view: &Page<'_>) -> String {
+    let base = base(view.company.id);
+    let rows=view.profiles.entries.iter().map(|profile|format!(r#"<li class="flex flex-wrap items-center gap-3"><a class="link" href="{link}">{name}</a><span>{provider} · {model} · project {project}</span><code class="select-all text-xs">{id}</code>{delete}</li>"#,
+        id=profile.id,name=text(&profile.name),provider=text(&enum_value(&profile.selection.provider)),model=text(profile.selection.model.as_str()),project=text(profile.selection.project_id.as_str()),
+        link=attr(&navigation(view,&format!("profile={}",profile.id))),
+        delete=form(&format!("{base}/profiles/{}/delete",profile.id),"","Delete unused profile"))).collect::<String>();
+    let next = if view.profiles.truncated {
+        view.profiles
+            .entries
+            .last()
+            .map_or_else(String::new, |profile| {
+                format!(
+                    r#"<a class="link" href="{}">More profiles</a>"#,
+                    attr(&navigation(view, &format!("after_profile={}", profile.id)))
+                )
+            })
+    } else {
+        String::new()
+    };
+    format!(
+        r#"<section class="space-y-4"><h2 class="text-xl font-semibold">Local agent profiles</h2><p>Profiles select an exact machine, enabled project, provider and model. Accepted sessions keep their original selection when a profile is edited.</p><ul class="space-y-3">{rows}</ul>{next}{editor}</section>"#,
+        editor = editor(view)
+    )
+}
+
+fn editor(view: &Page<'_>) -> String {
+    let (Some(machine), Some(runtime)) = (view.machine, view.runtime) else {
+        return "<p>Select a machine to configure a profile.</p>".into();
+    };
+    let Some(capabilities) = &machine.capabilities else {
+        return String::new();
+    };
+    let base = base(view.company.id);
+    let seeded = view
+        .profile
+        .filter(|profile| profile.selection.machine_id == machine.machine.id);
+    let preferred = view
+        .provider
+        .or_else(|| seeded.map(|profile| profile.selection.provider));
+    let provider = capabilities
+        .catalog
+        .providers
+        .iter()
+        .find(|provider| Some(provider.provider) == preferred)
+        .or_else(|| capabilities.catalog.providers.first());
+    let Some(provider) = provider else {
+        return "<p>No native provider is advertised. Install and authenticate the CLI locally, then refresh the catalog.</p>".into();
+    };
+    let preferred_model = view
+        .model
+        .or_else(|| seeded.map(|profile| &profile.selection.model));
+    let model = provider
+        .models
+        .iter()
+        .find(|model| Some(&model.model) == preferred_model)
+        .or_else(|| provider.models.first());
+    let Some(model) = model else {
+        return "<p>The selected provider advertises no models.</p>".into();
+    };
+    let providers = capabilities
+        .catalog
+        .providers
+        .iter()
+        .map(|entry| {
+            option(
+                &enum_value(&entry.provider),
+                &enum_value(&entry.provider),
+                entry.provider == provider.provider,
+            )
+        })
+        .collect::<String>();
+    let models = provider
+        .models
+        .iter()
+        .map(|entry| {
+            option(
+                entry.model.as_str(),
+                entry.model.as_str(),
+                entry.model == model.model,
+            )
+        })
+        .collect::<String>();
+    let profile_hidden = view.profile.map_or_else(String::new, |profile| {
+        format!(
+            r#"<input type="hidden" name="profile" value="{}">"#,
+            profile.id
+        )
+    });
+    let picker = format!(
+        r#"<form method="get" action="{base}" class="space-y-3"><input type="hidden" name="machine" value="{machine}">{profile_hidden}{context}<label class="block">Provider<select class="select w-full" name="provider">{providers}</select></label><label class="block">Model<select class="select w-full" name="model">{models}</select></label><button type="submit" class="btn btn-ghost">Choose provider / model</button></form>"#,
+        machine = machine.machine.id,
+        context = conversation_fields(view)
+    );
+    let projects = runtime
+        .projects
+        .iter()
+        .map(|project| {
+            option(
+                project.as_str(),
+                project.as_str(),
+                seeded.is_some_and(|profile| &profile.selection.project_id == project),
+            )
+        })
+        .collect::<String>();
+    let reasoning = model
+        .reasoning_levels
+        .iter()
+        .map(|level| {
+            option(
+                &enum_value(level),
+                &enum_value(level),
+                seeded.is_some_and(|profile| profile.selection.policy.reasoning == *level),
+            )
+        })
+        .collect::<String>();
+    let fields = format!(
+        r#"<input type="hidden" name="machine_id" value="{machine}"><input type="hidden" name="provider" value="{provider}"><input type="hidden" name="model" value="{model}"><label class="block">Profile name<input class="input w-full" name="name" maxlength="128" required value="{name}"></label><label class="block">Enabled project<select class="select w-full" name="project" required>{projects}</select></label><label class="block">Reasoning<select class="select w-full" name="reasoning" required>{reasoning}</select></label><p>Workspace: existing project directory. Permissions: provider defaults. Native prompts are answered in Cloudroom.</p>"#,
+        machine = machine.machine.id,
+        provider = attr(&enum_value(&provider.provider)),
+        model = attr(model.model.as_str()),
+        name = attr(view.profile.map_or("", |profile| profile.name.as_str()))
+    );
+    let action = view.profile.map_or_else(
+        || format!("{base}/profiles"),
+        |profile| format!("{base}/profiles/{}", profile.id),
+    );
+    format!(
+        "<article class=\"card card-border p-4 space-y-4\"><h3 class=\"font-semibold\">{title}</h3>{picker}{editor}</article>",
+        title = if view.profile.is_some() {
+            "Edit profile"
+        } else {
+            "New profile"
+        },
+        editor = form(&action, &fields, "Save profile")
+    )
+}
diff --git a/src/adapters/http/pages/local_agents/sessions.rs b/src/adapters/http/pages/local_agents/sessions.rs
new file mode 100644
index 00000000..3d8bf49a
--- /dev/null
+++ b/src/adapters/http/pages/local_agents/sessions.rs
@@ -0,0 +1,141 @@
+use super::*;
+
+pub(super) fn start(view: &Page<'_>) -> String {
+    let base = base(view.company.id);
+    let open = format!(
+        r#"<form method="get" action="{base}" class="flex flex-wrap gap-3"><label>Open a local session reference<input class="input" name="session" required maxlength="36" aria-label="Local session ID"></label><button class="btn" type="submit">Open session</button></form>"#
+    );
+    let Some(conversation) = view.conversation else {
+        return format!(
+            r#"<section class="space-y-3"><h2 class="text-xl font-semibold">Local sessions</h2><p>Open a conversation in Mailbox and choose “Run locally” to start a session associated with it. Workflows can use the explicit local_agent.run step.</p><a class="link" href="/ui?company_id={}">Choose a conversation in Mailbox</a>{open}</section>"#,
+            view.company.id
+        );
+    };
+    let profiles = view
+        .profiles
+        .entries
+        .iter()
+        .chain(view.profile.filter(|profile| {
+            !view
+                .profiles
+                .entries
+                .iter()
+                .any(|entry| entry.id == profile.id)
+        }))
+        .map(|profile| {
+            option(
+                &profile.id.to_string(),
+                &profile.name,
+                view.profile
+                    .is_some_and(|selected| selected.id == profile.id),
+            )
+        })
+        .collect::<String>();
+    let fields = format!(
+        r#"<input type="hidden" name="request_id" value="{request}"><input type="hidden" name="conversation_id" value="{conversation}"><label class="block">Local profile<select name="profile_id" class="select w-full" required>{profiles}</select></label><label class="block">Prompt<textarea name="prompt" class="textarea w-full" required maxlength="32768" rows="4"></textarea></label><p>This starts a native CLI agent with the profile's local files and permissions. Only this bounded prompt is sent; Openbot conversation history and tool authority are not added.</p>"#,
+        request = request_id(),
+        conversation = conversation.id
+    );
+    let sessions=view.sessions.map_or_else(String::new,|page| {
+        let rows=page.entries.iter().map(|session|format!(r#"<li><a class="link font-mono" href="{base}?session={id}">{id}</a> · created {created}</li>"#,id=session.id,created=text(&session.created_at.to_rfc3339()))).collect::<String>();
+        format!("<ul>{rows}</ul>{}",if page.truncated{"<p>Showing the newest 100 sessions. Open a known session reference for older work; Cloudroom owns the full transcript.</p>"}else{""})
+    });
+    format!(
+        r#"<section class="space-y-4"><h2 class="text-xl font-semibold">Start native work for {subject}</h2>{start}{sessions}{open}</section>"#,
+        subject = text(&conversation.subject),
+        start = form(&format!("{base}/sessions"), &fields, "Start native agent")
+    )
+}
+
+pub(super) fn detail(company: Uuid, details: &SessionDetails) -> String {
+    let session = &details.session;
+    let base = base(company);
+    let thread=session.thread_id.as_ref().map_or_else(||"<p>Native thread identity is not known yet. Do not repeat uncertain submissions.</p>".into(),|id|format!(r#"<label class="block">Cloudroom thread ID<input class="input w-full font-mono" readonly value="{}"></label><p>Copy this ID and open the thread in Cloudroom on the machine. A remote browser cannot open that machine's localhost UI.</p>"#,attr(id.as_str())));
+    let commands = if session.thread_id.is_some() {
+        let fields = format!(
+            r#"<input type="hidden" name="request_id" value="{}"><input type="hidden" name="kind" value="send"><label class="block">Follow-up prompt<textarea class="textarea w-full" name="prompt" required maxlength="32768" rows="3"></textarea></label>"#,
+            request_id()
+        );
+        let follow = form(
+            &format!("{base}/sessions/{}/commands", session.id),
+            &fields,
+            "Send explicit follow-up",
+        );
+        let controls=[("inspect","Inspect thread"),("stop","Stop entire thread"),("archive","Archive entire thread")].into_iter().map(|(kind,label)|form(&format!("{base}/sessions/{}/commands",session.id),&format!(r#"<input type="hidden" name="request_id" value="{}"><input type="hidden" name="kind" value="{kind}">"#,request_id()),label)).collect::<String>();
+        format!(
+            "{follow}<p>Stop and archive are thread-wide: they can affect work started in the local UI. They never complete or restart an Openbot workflow.</p><div class=\"flex flex-wrap gap-3\">{controls}</div>"
+        )
+    } else {
+        String::new()
+    };
+    let operations = details
+        .recent
+        .entries
+        .iter()
+        .map(operation)
+        .collect::<String>();
+    format!(
+        r#"<section class="space-y-4"><h2 class="text-xl font-semibold">Session <span class="font-mono select-all">{id}</span></h2><p>Original profile: <code class="select-all">{profile}</code> · {provider} / {model}</p>{thread}{commands}<p>Native permission requests must be answered in Cloudroom. A waiting or disconnected native agent is not a completed operation.</p><div class="space-y-4">{operations}</div>{older}</section>"#,
+        id = session.id,
+        profile = session.profile_id,
+        provider = text(&enum_value(&session.selection.provider)),
+        model = text(session.selection.model.as_str()),
+        older = if details.recent.truncated {
+            "<p>Earlier operations omitted from this bounded view. Cloudroom retains the canonical transcript.</p>"
+        } else {
+            ""
+        }
+    )
+}
+
+fn operation(view: &LocalOperationView) -> String {
+    let operation = &view.operation;
+    let prompt = match operation.command() {
+        LocalCommand::Create { prompt, .. } | LocalCommand::Send { prompt, .. } => format!(
+            "<h4 class=\"font-semibold\">Prompt</h4><pre class=\"whitespace-pre-wrap break-words\">{}</pre>",
+            text(prompt.as_str())
+        ),
+        _ => String::new(),
+    };
+    let status = operation.outcome().map_or_else(
+        || {
+            view.observed_turn_state.map_or_else(
+                || "Queued / no terminal evidence".into(),
+                |state| enum_value(&state),
+            )
+        },
+        |outcome| enum_value(&outcome),
+    );
+    let usage = view.measured_usage.as_ref().map_or_else(
+        || "Unavailable".into(),
+        |usage| {
+            format!(
+                "{} input tokens · {} output tokens",
+                usage.input_tokens, usage.output_tokens
+            )
+        },
+    );
+    let output=view.output.as_ref().map_or_else(String::new,|output|format!("<h4 class=\"font-semibold\">Bounded output</h4><pre class=\"whitespace-pre-wrap break-words\">{}</pre>",text(output.as_str())));
+    let blocked = if view.observed_turn_state == Some(TurnState::WaitingForInput) {
+        "<p>Waiting for input or permission. Respond in Cloudroom on the machine.</p>"
+    } else {
+        ""
+    };
+    format!(
+        r#"<article class="card card-border p-4 space-y-2"><h3 class="font-mono select-all">{id}</h3><p>{origin} · {status} · deadline {deadline}</p><p>Measured usage: {usage}</p>{blocked}{prompt}{output}{truncated}</article>"#,
+        id = operation.id(),
+        origin = if view.origin == OperationOrigin::Workflow {
+            "Workflow request"
+        } else {
+            "Direct request"
+        },
+        status = text(&status),
+        deadline = text(&operation.deadline().to_rfc3339()),
+        usage = text(&usage),
+        truncated = if view.output_truncated {
+            "<p>Output shortened by the operation or page bound; use Cloudroom for the full transcript.</p>"
+        } else {
+            ""
+        }
+    )
+}
diff --git a/src/adapters/http/routes/local_agents.rs b/src/adapters/http/routes/local_agents.rs
new file mode 100644
index 00000000..a2ab24ab
--- /dev/null
+++ b/src/adapters/http/routes/local_agents.rs
@@ -0,0 +1,272 @@
+use crate::{
+    adapters::http::auth::AuthenticatedUser,
+    app_error::{AppError, AppResult},
+    application::local_agents::{LocalMachineUseCases, management::*},
+    domain::local_agents::*,
+};
+use axum::{
+    Json, Router,
+    extract::{DefaultBodyLimit, FromRef, Path, Query, State},
+    http::StatusCode,
+    middleware,
+    response::{IntoResponse, Response},
+    routing::{get, post},
+};
+use serde::Deserialize;
+use std::sync::Arc;
+use uuid::Uuid;
+
+#[cfg(test)]
+#[path = "local_agents_tests.rs"]
+mod tests;
+
+pub fn router<S>() -> Router<S>
+where
+    S: Clone + Send + Sync + 'static,
+    Arc<LocalAgentManagement>: FromRef<S>,
+    Arc<LocalMachineUseCases>: FromRef<S>,
+{
+    Router::new()
+        .route(
+            "/api/companies/{company}/local-agent-profiles",
+            get(profiles).post(create_profile),
+        )
+        .route(
+            "/api/companies/{company}/local-agent-profiles/{profile}",
+            get(profile).put(update_profile).delete(delete_profile),
+        )
+        .route(
+            "/api/companies/{company}/local-agent-sessions",
+            get(sessions).post(start),
+        )
+        .route(
+            "/api/companies/{company}/local-agent-sessions/{session}",
+            get(session),
+        )
+        .route(
+            "/api/companies/{company}/local-agent-sessions/{session}/commands",
+            post(control),
+        )
+        .route(
+            "/api/companies/{company}/local-agent-operations/{operation}",
+            get(operation),
+        )
+        .route(
+            "/api/companies/{company}/local-machines/{machine}/runtime",
+            get(runtime),
+        )
+        .route(
+            "/api/companies/{company}/local-machines/{machine}/test-connection",
+            post(test_connection),
+        )
+        // JSON escaping can use six bytes per prompt byte, plus the fixed request fields.
+        .layer(DefaultBodyLimit::max(MAX_PROMPT_BYTES * 6 + 4096))
+        .layer(middleware::map_response(
+            super::local_machines::private_response,
+        ))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProfileInput {
+    name: String,
+    selection: ExecutionSelection,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StartInput {
+    request_id: OperationId,
+    profile_id: ProfileId,
+    conversation_id: Uuid,
+    prompt: LocalPrompt,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ControlInput {
+    request_id: OperationId,
+    command: SessionCommand,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TestInput {
+    request_id: OperationId,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProfileQuery {
+    after: Option<ProfileId>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SessionQuery {
+    conversation_id: Option<Uuid>,
+    run_id: Option<Uuid>,
+}
+
+async fn profiles(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path(company): Path<Uuid>,
+    Query(query): Query<ProfileQuery>,
+) -> AppResult<Json<RecordPage<LocalAgentProfile>>> {
+    Ok(Json(cases.profiles(user.id, company, query.after).await?))
+}
+async fn profile(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, ProfileId)>,
+) -> AppResult<Json<LocalAgentProfile>> {
+    Ok(Json(
+        cases
+            .profile(user.id, company, id)
+            .await?
+            .ok_or_else(missing)?,
+    ))
+}
+async fn create_profile(
+    State(cases): State<Arc<LocalMachineUseCases>>,
+    user: AuthenticatedUser,
+    Path(company): Path<Uuid>,
+    Json(input): Json<ProfileInput>,
+) -> AppResult<impl IntoResponse> {
+    let profile = LocalAgentProfile {
+        id: ProfileId::new(Uuid::new_v4()).map_err(|_| missing())?,
+        company_id: company,
+        name: input.name,
+        selection: input.selection,
+    };
+    cases.save_profile(user.id, &profile).await?;
+    Ok((StatusCode::CREATED, Json(profile)))
+}
+async fn update_profile(
+    State(cases): State<Arc<LocalMachineUseCases>>,
+    State(management): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, ProfileId)>,
+    Json(input): Json<ProfileInput>,
+) -> AppResult<Json<LocalAgentProfile>> {
+    management
+        .profile(user.id, company, id)
+        .await?
+        .ok_or_else(missing)?;
+    let profile = LocalAgentProfile {
+        id,
+        company_id: company,
+        name: input.name,
+        selection: input.selection,
+    };
+    cases.save_profile(user.id, &profile).await?;
+    Ok(Json(profile))
+}
+async fn delete_profile(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, ProfileId)>,
+) -> AppResult<StatusCode> {
+    cases.delete_profile(user.id, company, id).await?;
+    Ok(StatusCode::NO_CONTENT)
+}
+async fn sessions(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path(company): Path<Uuid>,
+    Query(query): Query<SessionQuery>,
+) -> AppResult<Json<RecordPage<SessionSummary>>> {
+    let association = match (query.conversation_id, query.run_id) {
+        (Some(conversation_id), None) => SessionAssociation::Conversation { conversation_id },
+        (None, Some(run_id)) => SessionAssociation::Workflow { run_id },
+        _ => {
+            return Err(AppError::BadRequest(
+                "Select exactly one conversation or workflow run".into(),
+            ));
+        }
+    };
+    Ok(Json(cases.sessions(user.id, company, &association).await?))
+}
+async fn session(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, SessionId)>,
+) -> AppResult<Json<SessionDetails>> {
+    Ok(Json(cases.session(user.id, company, id).await?))
+}
+async fn start(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path(company): Path<Uuid>,
+    Json(input): Json<StartInput>,
+) -> AppResult<Response> {
+    Ok(operation_response(
+        cases
+            .start(StartSession {
+                actor: user.id,
+                company,
+                request_id: input.request_id,
+                profile_id: input.profile_id,
+                conversation_id: input.conversation_id,
+                prompt: input.prompt,
+            })
+            .await?,
+    ))
+}
+async fn control(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, session_id)): Path<(Uuid, SessionId)>,
+    Json(input): Json<ControlInput>,
+) -> AppResult<Response> {
+    Ok(operation_response(
+        cases
+            .control(ControlSession {
+                actor: user.id,
+                company,
+                session_id,
+                request_id: input.request_id,
+                command: input.command,
+            })
+            .await?,
+    ))
+}
+async fn operation(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, OperationId)>,
+) -> AppResult<Json<LocalOperationView>> {
+    Ok(Json(cases.operation(user.id, company, id).await?))
+}
+async fn runtime(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, MachineId)>,
+) -> AppResult<Json<MachineRuntime>> {
+    Ok(Json(cases.runtime(user.id, company, id).await?))
+}
+async fn test_connection(
+    State(cases): State<Arc<LocalAgentManagement>>,
+    user: AuthenticatedUser,
+    Path((company, id)): Path<(Uuid, MachineId)>,
+    Json(input): Json<TestInput>,
+) -> AppResult<impl IntoResponse> {
+    Ok((
+        StatusCode::ACCEPTED,
+        Json(
+            cases
+                .test_connection(user.id, company, id, input.request_id)
+                .await?,
+        ),
+    ))
+}
+fn operation_response(view: LocalOperationView) -> Response {
+    (
+        if view.operation.outcome().is_some() {
+            StatusCode::OK
+        } else {
+            StatusCode::ACCEPTED
+        },
+        Json(view),
+    )
+        .into_response()
+}
+fn missing() -> AppError {
+    AppError::NotFound("Local agent resource".into())
+}
