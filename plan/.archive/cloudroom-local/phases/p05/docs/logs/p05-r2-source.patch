+  execFileSync('openssl', ['req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '1', '-config', 'config', '-keyout', 'key.pem', '-out', 'cert.pem'], { cwd: directory, stdio: 'pipe' });
