+        .unwrap();
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &agent(4, operation.id(), LocalEvidence::SubmissionIntent {}),
+        )
+        .await
+        .unwrap();
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &turn(5, operation.id(), "turn_owned", TurnState::Running, None),
