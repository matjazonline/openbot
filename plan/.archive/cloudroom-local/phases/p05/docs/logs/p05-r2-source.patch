+    let second = p
+        .list_profiles(s.f.owner, s.f.company, Some(cursor))
+        .await
+        .unwrap();
+    let chosen = second
+        .entries
+        .iter()
+        .find(|profile| profile.id != s.profile.id)
+        .unwrap();
+    for (name, profiles, selected) in [
