+                SELECT $1,$2,'person',$3,$4 WHERE NOT EXISTS(SELECT 1 FROM principals WHERE company_id=$2 AND user_id=$3 AND kind='person')")
+                .bind(Uuid::new_v4()).bind(companies[0]).bind(user).bind(role).execute(&mut *tx).await.unwrap();
