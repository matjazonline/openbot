--- /dev/null
+++ b/integrations/cloudroom-plugin/src/lock.ts
@@ -0,0 +1,11 @@
+import { constants, openSync, closeSync } from 'node:fs';
+import { dirname, join, isAbsolute } from 'node:path';
+import { flockSync } from 'fs-ext';
+export function acquireProfileLock(databaseName: string): () => void {
+  if (!isAbsolute(databaseName)) throw new Error('persistent plugin database required');
+  const fd = openSync(join(dirname(databaseName), 'openbot-connector.lock'),
+    constants.O_RDWR | constants.O_CREAT | constants.O_NOFOLLOW, 0o600);
+  try { flockSync(fd, 'exnb'); } catch { closeSync(fd); throw new Error('another connector owns this profile'); }
+  let held = true;
+  return () => { if (held) { held = false; closeSync(fd); } };
+}
diff --git a/integrations/cloudroom-plugin/src/protocol.ts b/integrations/cloudroom-plugin/src/protocol.ts
new file mode 100644
index 00000000..dbbf8dc6
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/protocol.ts
@@ -0,0 +1,167 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { z } from 'zod';
+
+export const LIMITS = Object.freeze({ prompt: 32 * 1024, output: 256 * 1024, frame: 64 * 1024,
+  chunk: 16 * 1024, logical: 2 * 1024 * 1024, assemblyMs: 30_000, outbox: 64 * 1024 * 1024,
+  effects: 8, queued: 32, controls: 8, projects: 128, providers: 32, models: 256, page: 100,
+  heartbeatMs: 15_000, ioMs: 5_000, handshakeMs: 10_000, history: 4096, terminalReserve: 3 * 1024 * 1024 });
+const sequence = z.number().int().min(0).max(Number.MAX_SAFE_INTEGER);
+const positive = sequence.min(1);
+export const uuid = z.string().regex(/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/)
+  .refine(value => value !== '00000000-0000-0000-0000-000000000000');
+export const external = z.string().regex(/^[A-Za-z0-9_.:-]{1,128}$/);
+const model = z.string().refine(value => value.length > 0 && Buffer.byteLength(value) <= 128
+  && !/[\p{White_Space}\p{Cc}]/u.test(value));
+const text = (maximum: number) => z.string().refine(value => Buffer.byteLength(value) <= maximum && !value.includes('\0'));
+const prompt = text(LIMITS.prompt).refine(value => value.trim().length > 0);
+const digestSchema = z.string().regex(/^[0-9a-f]{64}$/);
+export const reasoning = z.enum(['none', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra', 'ultracode']);
+export const provider = z.enum(['claude-code', 'codex', 'acp-opencode']);
+export const policySchema = z.object({ workspace: z.literal('project_directory'),
+  permissions: z.literal('provider_default'), reasoning }).strict();
+export const selectionSchema = z.object({ machine_id: uuid, project_id: external, provider,
+  model, policy: policySchema }).strict();
+export type Selection = z.infer<typeof selectionSchema>;
+export const commandSchema = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('create'), session_id: uuid, selection: selectionSchema, prompt }).strict(),
+  z.object({ kind: z.literal('send'), session_id: uuid, thread_id: external, prompt }).strict(),
+  z.object({ kind: z.literal('inspect'), session_id: uuid, thread_id: external }).strict(),
+  z.object({ kind: z.literal('stop_thread'), session_id: uuid, thread_id: external }).strict(),
+  z.object({ kind: z.literal('archive_thread'), session_id: uuid, thread_id: external }).strict(),
+  z.object({ kind: z.literal('refresh_catalog') }).strict(),
+]);
+export type Command = z.infer<typeof commandSchema>;
+export const turnState = z.enum(['queued', 'running', 'waiting_for_input', 'completed', 'failed', 'stopped', 'missing']);
+const dispatch = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('not_dispatched') }).strict(),
+  z.object({ kind: z.literal('accepted_locally'), sequence: positive }).strict(),
+  z.object({ kind: z.literal('submission_intent'), sequence: positive }).strict(),
+  z.object({ kind: z.literal('native_identity'), sequence: positive, thread_id: external, turn_id: external.nullable() }).strict(),
+  z.object({ kind: z.literal('catalog_snapshot'), sequence: positive }).strict(),
+]);
+const deadline = z.string().refine(value => {
+  const matched = /^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{3}|\d{6}))?Z$/.exec(value);
+  if (!matched || !Number.isFinite(Date.parse(value))) return false;
+  if (matched[2] === '000' || (matched[2]?.length === 6 && matched[2].endsWith('000'))) return false;
+  return new Date(value).toISOString().slice(0, 19) === matched[1];
+});
+const operationSchema = z.object({ id: uuid, command: commandSchema, deadline,
+  payload_digest: digestSchema, dispatch,
+  outcome: z.enum(['succeeded', 'failed', 'cancelled', 'expired', 'uncertain']).nullable() }).strict();
+export type Operation = z.infer<typeof operationSchema>;
+export type Delivery = { operation: Operation; mode: 'dispatch' | 'reconcile' };
+export const identitySchema = z.object({ installation_id: uuid, credential_generation: positive,
+  connection_generation: positive }).strict();
+export type Identity = z.infer<typeof identitySchema>;
+export const catalogSchema = z.object({ projects: z.array(external).max(LIMITS.projects),
+  providers: z.array(z.object({ provider, models: z.array(z.object({ model,
+    reasoning_levels: z.array(reasoning).max(8) }).strict()).max(LIMITS.models) }).strict()).max(LIMITS.providers) }).strict();
+export type Catalog = z.infer<typeof catalogSchema>;
+export const refusalSchema = z.enum(['project_unavailable', 'provider_unavailable', 'model_unavailable',
+  'reasoning_unavailable', 'capacity', 'expired', 'recovery_required']);
+export type Refusal = z.infer<typeof refusalSchema>;
+export const evidenceSchema = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('receipt') }).strict(),
+  z.object({ kind: z.literal('submission_intent') }).strict(),
+  z.object({ kind: z.literal('submission'), thread_id: external, state: z.enum(['accepted', 'queued', 'missing']) }).strict(),
+  z.object({ kind: z.literal('refused'), reason: refusalSchema }).strict(),
+  z.object({ kind: z.literal('uncertain') }).strict(),
+  z.object({ kind: z.literal('turn'), thread_id: external, turn_id: external, state: turnState,
+    output: text(LIMITS.output).nullable(), truncated: z.boolean(),
+    usage: z.object({ input_tokens: sequence, output_tokens: sequence }).strict().nullable() }).strict(),
+]);
+export type Evidence = z.infer<typeof evidenceSchema>;
+export const observationSchema = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('agent'), observation: z.object({ sequence: positive, operation_id: uuid, evidence: evidenceSchema }).strict() }).strict(),
+  z.object({ kind: z.literal('catalog'), sequence: positive, operation_id: uuid, catalog: catalogSchema }).strict(),
+  z.object({ kind: z.literal('control'), sequence: positive, operation_id: uuid, thread_id: external,
+    evidence: z.discriminatedUnion('kind', [z.object({ kind: z.literal('snapshot'), state: turnState }).strict(),
+      z.object({ kind: z.literal('stop_accepted') }).strict(), z.object({ kind: z.literal('archive_accepted') }).strict()]) }).strict(),
+]);
+export type Observation = z.infer<typeof observationSchema>;
+export const serverSchema = z.discriminatedUnion('kind', [
+  z.object({ kind: z.literal('welcome'), welcome: z.object({ identity: identitySchema, acknowledged_sequence: sequence,
+    recovery_required: z.boolean() }).strict() }).strict(),
+  z.object({ kind: z.literal('command'), identity: identitySchema,
+    delivery: z.object({ operation: operationSchema, mode: z.enum(['dispatch', 'reconcile']) }).strict() }).strict(),
+  z.object({ kind: z.literal('acknowledged'), identity: identitySchema, through: sequence }).strict(),
+  z.object({ kind: z.literal('ready'), identity: identitySchema, ready: z.boolean() }).strict(),
+]);
+export type ServerMessage = z.infer<typeof serverSchema>;
+export const sha256 = (bytes: string | Buffer) => createHash('sha256').update(bytes).digest('hex');
+export const isEffect = (command: Command) => command.kind === 'create' || command.kind === 'send';
+export const sessionId = (command: Command) => 'session_id' in command ? command.session_id : undefined;
+export const targetThread = (command: Command) => 'thread_id' in command ? command.thread_id : undefined;
+export const observationSequence = (observation: Observation) => observation.kind === 'agent' ? observation.observation.sequence : observation.sequence;
+export function commandDigest(command: Command, exactDeadline: string): string {
+  return sha256(JSON.stringify([commandSchema.parse(command), deadline.parse(exactDeadline)]));
+}
+export function parseOperation(value: unknown): Operation {
+  const operation = operationSchema.parse(value);
+  if (commandDigest(operation.command, operation.deadline) !== operation.payload_digest) throw new Error('command digest mismatch');
+  const evidence = operation.dispatch;
+  if (evidence.kind === 'native_identity' && targetThread(operation.command)
+      && evidence.thread_id !== targetThread(operation.command)) throw new Error('command thread mismatch');
+  if ((evidence.kind === 'catalog_snapshot') !== (operation.command.kind === 'refresh_catalog')
+      && evidence.kind === 'catalog_snapshot') throw new Error('invalid catalog receipt');
+  if (operation.command.kind === 'refresh_catalog' && evidence.kind === 'native_identity') throw new Error('invalid native receipt');
+  if (operation.outcome === 'succeeded' && !(evidence.kind === 'catalog_snapshot'
+      || (evidence.kind === 'native_identity' && (!isEffect(operation.command) || evidence.turn_id !== null)))) {
+    throw new Error('success without native evidence');
+  }
+  return operation;
+}
+export function parseServer(value: unknown): ServerMessage {
+  const parsed = serverSchema.parse(value);
+  if (parsed.kind === 'command') parsed.delivery.operation = parseOperation(parsed.delivery.operation);
+  return parsed;
+}
+export function nativeInput(operation: Operation): string {
+  if (!('prompt' in operation.command)) throw new Error('not an effect');
+  const header = `[Openbot operation ${operation.id}]\n`;
+  if (Buffer.byteLength(header) !== 57) throw new Error('invalid operation identity');
+  return header + operation.command.prompt;
+}
+export function encodeFrames(message: unknown): string[] {
+  const bytes = Buffer.from(JSON.stringify(message));
+  if (!bytes.length || bytes.length > LIMITS.logical) throw new Error('logical message bound');
+  const transfer_id = randomUUID(); const digest = sha256(bytes);
+  const frames: string[] = [];
+  for (let index = 0; index * LIMITS.chunk < bytes.length; index++) {
+    frames.push(JSON.stringify({ version: 1, transfer_id, index, parts: Math.ceil(bytes.length / LIMITS.chunk),
+      total_bytes: bytes.length, digest, data: bytes.subarray(index * LIMITS.chunk, (index + 1) * LIMITS.chunk).toString('base64') }));
+  }
+  return frames;
+}
+const chunkSchema = z.object({ version: z.literal(1), transfer_id: uuid, index: sequence,
+  parts: positive.max(128), total_bytes: positive.max(LIMITS.logical), digest: digestSchema,
+  data: z.string().max(Math.ceil(LIMITS.chunk / 3) * 4) }).strict();
+type PartialMessage = { transfer: string; next: number; parts: number; size: number; digest: string; chunks: Buffer[]; expires: number };
+export class FrameAssembler {
+  private pending: PartialMessage | undefined;
+  private readonly now: () => number;
+  constructor(now: () => number = () => performance.now()) { this.now = now; }
+  expire(): void { if (this.pending && this.now() >= this.pending.expires) throw new Error('chunk assembly expired'); }
+  push(frame: Buffer | string): unknown | undefined {
+    if (Buffer.byteLength(frame) > LIMITS.frame) throw new Error('physical frame bound');
+    this.expire();
+    const source = typeof frame === 'string' ? frame : new TextDecoder('utf-8', { fatal: true }).decode(frame);
+    const c = chunkSchema.parse(JSON.parse(source));
+    if (c.parts !== Math.ceil(c.total_bytes / LIMITS.chunk) || c.index >= c.parts) throw new Error('invalid chunk bounds');
+    const data = Buffer.from(c.data, 'base64');
+    const expected = c.index + 1 === c.parts ? c.total_bytes - c.index * LIMITS.chunk : LIMITS.chunk;
+    if (data.length !== expected || data.toString('base64') !== c.data) throw new Error('invalid chunk encoding');
+    this.pending ??= { transfer: c.transfer_id, next: 0, parts: c.parts, size: c.total_bytes,
+      digest: c.digest, chunks: [], expires: this.now() + LIMITS.assemblyMs };
+    const p = this.pending;
+    if (p.next !== c.index || p.transfer !== c.transfer_id || p.parts !== c.parts || p.size !== c.total_bytes || p.digest !== c.digest) {
+      throw new Error('interleaved or reused chunk');
+    }
+    p.chunks.push(data); p.next++;
+    if (p.next !== p.parts) return undefined;
+    this.pending = undefined;
+    const bytes = Buffer.concat(p.chunks, p.size);
+    if (sha256(bytes) !== p.digest) throw new Error('chunk digest mismatch');
+    return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
+  }
+}
diff --git a/integrations/cloudroom-plugin/src/sdk.ts b/integrations/cloudroom-plugin/src/sdk.ts
new file mode 100644
index 00000000..eb9bc559
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/sdk.ts
@@ -0,0 +1,230 @@
+import type { BbPluginApi } from '@get-bb/plugin-sdk';
+import { Journal, RecoveryRequired, type CommandRecord } from './journal.js';
+import { catalogSchema, LIMITS, provider, reasoning, type Catalog, type Evidence, type Selection, type Refusal } from './protocol.js';
+import { applyNativeEvents, type TurnUpdate } from './turns.js';
+
+type SDK = BbPluginApi['sdk'];
+type ModelPage = Awaited<ReturnType<SDK['providers']['models']>>;
+type ListedThread = Awaited<ReturnType<SDK['threads']['list']>>[number];
+export class PreflightRefusal extends Error {
+  readonly reason: Refusal;
+  constructor(reason: Refusal) { super('local preflight refused'); this.reason = reason; }
+}
+export type Prepared = { selection: Selection; hostId: string; environmentProvider: string };
+export type ProviderHealth = { provider: string; status: 'available' | 'auth_required' | 'unavailable' | 'oversized' };
+export const sdkSignal = (parent: AbortSignal) => AbortSignal.any([parent, AbortSignal.timeout(LIMITS.ioMs)]);
+function missing(error: unknown): boolean { return typeof error === 'object' && error !== null && 'status' in error && error.status === 404; }
+function stateUpdate(record: CommandRecord, evidence: Evidence): TurnUpdate {
+  const previous = record.lastObservation;
+  return { kind: previous?.kind === 'agent' && JSON.stringify(previous.observation.evidence) === JSON.stringify(evidence)
+    ? 'unchanged' : 'progress', record, evidence };
+}
+
+export class CloudroomSdk {
+  readonly sdk: SDK; readonly pluginId: string; readonly journal: Journal;
+  readonly health = new Map<string, ProviderHealth>();
+  private readonly projects: () => readonly string[];
+  constructor(bb: Pick<BbPluginApi, 'sdk' | 'pluginId'>, journal: Journal, projects: () => readonly string[]) {
+    this.sdk = bb.sdk; this.pluginId = bb.pluginId; this.journal = journal; this.projects = projects;
+  }
+  async localHost(signal: AbortSignal): Promise<string> {
+    const config = await this.sdk.system.config({ signal });
+    if (!config.primaryHostId) throw new PreflightRefusal('project_unavailable');
+    const host = await this.sdk.hosts.get({ hostId: config.primaryHostId, signal });
+    if (host.status !== 'connected' || host.type !== 'persistent' || host.machineProviderId !== null
+        || host.connectMachineId !== null || !['darwin', 'linux'].includes(host.platform ?? '')
+        || host.platform !== process.platform) throw new PreflightRefusal('project_unavailable');
+    return host.id;
+  }
+  private async project(projectId: string, hostId: string, signal: AbortSignal): Promise<void> {
+    if (!this.projects().includes(projectId)) throw new PreflightRefusal('project_unavailable');
+    const project = await this.sdk.projects.get({ projectId, signal });
+    if (project.id !== projectId || !project.sources.some(source => source.type === 'local_path' && source.hostId === hostId)) {
+      throw new PreflightRefusal('project_unavailable');
+    }
+  }
+  private async models(providerId: Selection['provider'], hostId: string, signal: AbortSignal): Promise<ModelPage> {
+    const page = await this.sdk.providers.models({ providerId, hostId, signal });
+    const status = page.modelLoadError?.code === 'auth_required' ? 'auth_required'
+      : page.modelLoadError ? 'unavailable' : page.models.length > LIMITS.models ? 'oversized' : 'available';
+    this.health.set(providerId, { provider: providerId, status });
+    if (page.modelLoadError) throw new PreflightRefusal('provider_unavailable');
+    if (page.models.length > LIMITS.models) throw new PreflightRefusal('capacity');
+    return page;
+  }
+  async catalog(signal: AbortSignal): Promise<Catalog> {
+    const hostId = await this.localHost(signal); const projects = [...this.projects()];
+    if (projects.length > LIMITS.projects) throw new PreflightRefusal('capacity');
+    for (const project of projects) await this.project(project, hostId, signal);
+    const installed = await this.sdk.providers.list({ hostId, signal });
+    if (installed.length > LIMITS.providers) throw new PreflightRefusal('capacity');
+    const providers: Catalog['providers'] = [];
+    for (const id of provider.options) {
+      if (!installed.some(item => item.id === id)) { this.health.set(id, { provider: id, status: 'unavailable' }); continue; }
+      try {
+        const page = await this.models(id, hostId, signal);
+        const models = page.models.map(model => ({ model: model.model, reasoning_levels: [...new Set(
+          [...model.supportedReasoningEfforts.map(option => option.reasoningEffort), model.defaultReasoningEffort]
+            .filter(value => reasoning.safeParse(value).success))] }));
+        providers.push({ provider: id, models });
+      } catch (error) { if (signal.aborted) throw error; if (!(error instanceof PreflightRefusal)) throw error; }
+    }
+    return catalogSchema.parse({ projects, providers });
+  }
+  async prepare(record: CommandRecord, signal: AbortSignal): Promise<Prepared> {
+    const command = record.operation.command; const hostId = await this.localHost(signal);
+    let selection: Selection;
+    if (command.kind === 'create') {
+      if (this.journal.session(command.session_id)) throw new PreflightRefusal('recovery_required');
+      selection = command.selection;
+      if (selection.machine_id !== this.journal.binding().machine_id) throw new PreflightRefusal('recovery_required');
+    } else if ('session_id' in command) {
+      const mapped = this.journal.session(command.session_id);
+      if (!mapped || !('thread_id' in command) || mapped.threadId !== command.thread_id) throw new PreflightRefusal('recovery_required');
+      selection = mapped.selection;
+      const thread = await this.sdk.threads.get({ threadId: command.thread_id, signal });
+      if (thread.projectId !== selection.project_id || thread.providerId !== selection.provider) throw new PreflightRefusal('recovery_required');
+      record.threadId = command.thread_id;
+      if (thread.environmentId) {
+        const environment = await this.sdk.environments.get({ environmentId: thread.environmentId, signal });
+        if (environment.hostId !== hostId || environment.projectId !== selection.project_id) throw new PreflightRefusal('project_unavailable');
+      }
+    } else throw new PreflightRefusal('recovery_required');
+    if (command.kind === 'create' || command.kind === 'send') {
+      await this.project(selection.project_id, hostId, signal);
+      const installed = await this.sdk.providers.list({ hostId, signal });
+      if (installed.length > LIMITS.providers) throw new PreflightRefusal('capacity');
+      if (!installed.some(provider => provider.id === selection.provider)) throw new PreflightRefusal('provider_unavailable');
+      const page = await this.models(selection.provider, hostId, signal);
+      const model = page.models.find(model => model.model === selection.model);
+      if (!model) throw new PreflightRefusal('model_unavailable');
+      if (model.defaultReasoningEffort !== selection.policy.reasoning
+          && !model.supportedReasoningEfforts.some(level => level.reasoningEffort === selection.policy.reasoning)) {
+        throw new PreflightRefusal('reasoning_unavailable');
+      }
+    }
+    let environmentProvider = 'project-checkout';
+    if (command.kind === 'create') {
+      const providers = await this.sdk.environments.listProviders({ projectId: selection.project_id, hostId, signal });
+      const workspace = providers.find(item => (item.environmentProviderId ?? item.id) === 'project-checkout'
+        && item.machineProviderId === null && item.requires.projectCheckout && item.acceptsEmptyInputs);
+      const available = workspace?.machineAvailability[hostId] ?? workspace?.availability;
+      if (!workspace || (available && available.status !== 'available')) throw new PreflightRefusal('project_unavailable');
+      environmentProvider = workspace.environmentProviderId ?? workspace.id;
+    }
+    return { selection, hostId, environmentProvider };
+  }
+  metadata(record: CommandRecord) {
+    const command = record.operation.command;
+    if (!('session_id' in command)) throw new RecoveryRequired();
+    return { installation: this.journal.binding().installation_id, session: command.session_id,
+      operation: record.operation.id, digest: record.operation.payload_digest };
+  }
+  async mutate(record: CommandRecord, prepared: Prepared, signal: AbortSignal): Promise<void> {
+    const command = record.operation.command;
+    if (command.kind === 'create') {
+      const thread = await this.sdk.threads.spawn({ projectId: prepared.selection.project_id, executionTarget: 'local',
+        providerId: prepared.selection.provider, model: prepared.selection.model, reasoningLevel: prepared.selection.policy.reasoning,
+        environment: { type: 'provider', environmentProviderId: prepared.environmentProvider,
+          machine: { type: 'existing', hostId: prepared.hostId }, inputs: {} },
+        title: 'Openbot local session', prompt: record.sdkInput, pluginMetadata: this.metadata(record), signal });
+      record.threadId = thread.id;
+      this.journal.submission(record, prepared.selection, thread.status === 'pending' ? 'queued' : 'accepted');
+    } else if (command.kind === 'send') {
+      const result = await this.sdk.threads.send({ threadId: command.thread_id, mode: 'queue-if-active', model: prepared.selection.model,
+        reasoningLevel: prepared.selection.policy.reasoning, input: [{ type: 'text', text: record.sdkInput, mentions: [] }], signal });
+      record.threadId = command.thread_id;
+      if (result.delivery === 'queued') record.queueId = result.queuedMessage.id;
+      this.journal.submission(record, prepared.selection, result.delivery === 'queued' ? 'queued' : 'accepted');
+    } else if (command.kind === 'stop_thread') {
+      await this.sdk.threads.stop({ threadId: command.thread_id, signal });
+      this.journal.control(record, command.thread_id, { kind: 'stop_accepted' });
+    } else if (command.kind === 'archive_thread') {
+      await this.sdk.threads.archive({ threadId: command.thread_id, signal });
+      this.journal.control(record, command.thread_id, { kind: 'archive_accepted' });
+    } else throw new Error('not a mutation');
+  }
+  async baseline(record: CommandRecord, signal: AbortSignal): Promise<void> {
+    if (!record.threadId) return;
+    const page = await this.sdk.threads.events.list({ threadId: record.threadId, limit: '1', order: 'desc', signal });
+    if (page.length > 1) throw new Error('native baseline bound');
+    const cursor = page[0]?.seq ?? 0;
+    if (!Number.isSafeInteger(cursor) || cursor < 0) throw new Error('invalid native cursor');
+    record.cursor = cursor;
+  }
+  async recoverCreate(record: CommandRecord, signal: AbortSignal): Promise<boolean> {
+    const command = record.operation.command;
+    if (command.kind !== 'create' || record.threadId) return false;
+    const expected = this.metadata(record); const matches: ListedThread[] = [];
+    for (let offset = 0; offset < 400; offset += 100) {
+      const page = await this.sdk.threads.list({ projectId: command.selection.project_id, originPluginId: this.pluginId,
+        limit: 100, offset, signal });
+      if (page.length > 100) throw new Error('native recovery page bound');
+      for (const thread of page) {
+        if (thread.projectId !== command.selection.project_id || thread.providerId !== command.selection.provider
+            || thread.originPluginId !== this.pluginId) continue;
+        const metadata = await this.sdk.threads.getPluginMetadata({ threadId: thread.id, signal });
+        if (Object.entries(expected).every(([key, value]) => metadata[key] === value)) matches.push(thread);
+        if (matches.length > 1) return false;
+      }
+      if (page.length < 100) break;
+    }
+    const thread = matches[0];
+    if (!thread) return false;
+    record.threadId = thread.id;
+    this.journal.submission(record, command.selection, thread.status === 'pending' ? 'queued' : 'accepted');
+    return true;
+  }
+  async poll(record: CommandRecord, signal: AbortSignal): Promise<TurnUpdate> {
+    if (!record.threadId && record.operation.command.kind === 'send') {
+      const mapping = this.journal.session(record.operation.command.session_id);
+      if (mapping?.threadId === record.operation.command.thread_id) record.threadId = mapping.threadId;
+    }
+    if (!record.threadId) await this.recoverCreate(record, signal);
+    if (!record.threadId) return { kind: 'uncertain', record };
+    try { await this.sdk.threads.get({ threadId: record.threadId, signal }); }
+    catch (error) {
+      if (!missing(error)) throw error;
+      if (record.turnId) {
+        record.nativeState = 'missing'; record.stage = 'uncertain';
+        return stateUpdate(record, { kind: 'turn', thread_id: record.threadId, turn_id: record.turnId,
+          state: 'missing', output: null, truncated: record.truncated, usage: null });
+      }
+      const command = record.operation.command;
+      const selected = command.kind === 'create' ? command.selection : 'session_id' in command ? this.journal.session(command.session_id)?.selection : undefined;
+      if (selected && !(record.lastObservation?.kind === 'agent'
+          && record.lastObservation.observation.evidence.kind === 'submission'
+          && record.lastObservation.observation.evidence.state === 'missing')) this.journal.submission(record, selected, 'missing');
+      return { kind: 'unchanged', record };
+    }
+    const events = await this.sdk.threads.events.list({ threadId: record.threadId, afterSeq: String(record.cursor), limit: '100', order: 'asc', signal });
+    const update = applyNativeEvents(record, events);
+    if (update.kind !== 'terminal' && update.kind !== 'uncertain' && update.record.turnId) {
+      const interactions = await this.sdk.threads.interactions.list({ threadId: record.threadId, signal });
+      if (interactions.length > LIMITS.page) throw new Error('native interaction bound');
+      if (interactions.some(interaction => interaction.threadId === record.threadId && interaction.turnId === update.record.turnId
+          && (interaction.status === 'pending' || interaction.status === 'resolving'))) {
+        update.record.nativeState = 'waiting_for_input';
+        return stateUpdate(update.record, { kind: 'turn', thread_id: record.threadId, turn_id: update.record.turnId,
+          state: 'waiting_for_input', output: null, truncated: update.record.truncated, usage: update.record.usage });
+      }
+      if (update.record.nativeState === 'waiting_for_input' && interactions.some(interaction => interaction.threadId === record.threadId
+          && interaction.turnId === update.record.turnId && interaction.status === 'resolved')) {
+        update.record.nativeState = 'running';
+        return stateUpdate(update.record, { kind: 'turn', thread_id: record.threadId, turn_id: update.record.turnId,
+          state: 'running', output: null, truncated: update.record.truncated, usage: update.record.usage });
+      }
+    }
+    return update;
+  }
+  async inspect(threadId: string, signal: AbortSignal): Promise<Extract<CommandRecord['nativeState'], string> | null> {
+    const thread = await this.sdk.threads.get({ threadId, signal });
+    if (thread.status === 'pending') return 'queued';
+    if (thread.status === 'active' || thread.status === 'starting' || thread.status === 'stopping') return 'running';
+    const events = await this.sdk.threads.events.list({ threadId, limit: '100', order: 'desc', signal });
+    if (events.length > 100) throw new Error('native inspect bound');
+    const completed = events.find(event => event.type === 'turn/completed');
+    if (completed?.type !== 'turn/completed') return null;
+    return completed.data.status === 'completed' ? 'completed' : completed.data.status === 'interrupted' ? 'stopped' : 'failed';
+  }
+}
diff --git a/integrations/cloudroom-plugin/src/server.ts b/integrations/cloudroom-plugin/src/server.ts
new file mode 100644
index 00000000..79bfa509
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/server.ts
@@ -0,0 +1,71 @@
+import type { BbPluginApi } from '@get-bb/plugin-sdk';
+import { Connector } from './connector.js';
+import { Dispatcher } from './dispatcher.js';
+import { canonicalOrigin, ConfigurationRequired, defineSettings, recoverEnrollment, selectedProjects, type SettingsStore } from './enrollment.js';
+import { JOURNAL_SCHEMA, Journal } from './journal.js';
+import { acquireProfileLock } from './lock.js';
+import { CloudroomSdk, sdkSignal } from './sdk.js';
+
+export default async function openbot(bb: BbPluginApi): Promise<void> {
+  const settings = defineSettings(bb); const db = bb.storage.database();
+  bb.storage.migrate(db, [...JOURNAL_SCHEMA]);
+  const journal = new Journal(db);
+  let selected: string[] = []; let connector: Connector | undefined;
+  let running: AbortController | undefined;
+  const expectedSecrets = new Set<string | undefined>();
+  const enrollmentSettings: SettingsStore = { get: () => settings.get(),
+    experimental_set: async patch => {
+      running?.signal.throwIfAborted();
+      const ownSecret = Object.hasOwn(patch, 'enrollment'); const nextSecret = patch.enrollment ?? undefined;
+      if (ownSecret) expectedSecrets.add(nextSecret);
+      try { return await settings.experimental_set(patch); }
+      finally { if (ownSecret) expectedSecrets.delete(nextSecret); }
+    } };
+  const sdk = new CloudroomSdk(bb, journal, () => selected);
+  settings.onChange((next, prev) => {
+    if (next.openbotOrigin !== prev.openbotOrigin
+        || (next.enrollment !== prev.enrollment && !expectedSecrets.has(next.enrollment))
+        || next.selectedProjects !== prev.selectedProjects) running?.abort(new ConfigurationRequired('Connector settings changed; reload plugin'));
+  });
+  bb.background.service('openbot-connector', {
+    async start(signal) {
+      const release = acquireProfileLock(db.name); const stop = new AbortController();
+      const lifetime = AbortSignal.any([signal, stop.signal]);
+      running = stop;
+      try {
+        const values = await settings.get(); canonicalOrigin(values.openbotOrigin);
+        selected = selectedProjects(values.selectedProjects ?? '');
+        const paired = await recoverEnrollment(enrollmentSettings, journal, lifetime);
+        const current = await settings.get(); lifetime.throwIfAborted();
+        if (canonicalOrigin(current.openbotOrigin) !== paired.binding.origin
+            || current.selectedProjects !== values.selectedProjects || current.enrollment !== JSON.stringify(paired)) {
+          throw new ConfigurationRequired('Connector settings changed; reload plugin');
+        }
+        connector = new Connector(new Dispatcher(journal, sdk));
+        await connector.run(paired, lifetime);
+        if (stop.signal.aborted && !signal.aborted) throw new ConfigurationRequired('Connector settings changed; reload plugin');
+      } finally { running = undefined; stop.abort(); release(); }
+    },
+  });
+  bb.cli.register({ name: 'openbot-local', summary: 'Local connector status and project discovery',
+    commands: [{ name: 'status', summary: 'Connection, journal and provider status', usage: 'openbot-local status' },
+      { name: 'projects', summary: 'List local Cloudroom projects', usage: 'openbot-local projects' }],
+    async run(argv, context) {
+      if (argv.length === 1 && argv[0] === 'status') return { exitCode: 0, stdout: JSON.stringify({
+        connection: connector?.status ?? 'offline', paired: journal.initialized(),
+        recoveryRequired: journal.initialized() ? journal.recoveryRequired() : false,
+        sequence: journal.initialized() ? journal.sequence() : 0,
+        acknowledged: journal.initialized() ? journal.acknowledged() : 0, providers: [...sdk.health.values()],
+      }) };
+      if (argv.length === 1 && argv[0] === 'projects') {
+        const signal = sdkSignal(context.signal ?? AbortSignal.timeout(5_000));
+        const hostId = await sdk.localHost(signal);
+        const projects = await bb.sdk.projects.list({ signal });
+        if (projects.length > 128) return { exitCode: 1, stderr: 'Project catalog exceeds the supported bound' };
+        return { exitCode: 0, stdout: JSON.stringify(projects.filter(project => project.sources.some(source => source.type === 'local_path' && source.hostId === hostId))
+          .map(project => ({ id: project.id, name: project.name }))) };
+      }
+      return { exitCode: 1, stderr: 'Use openbot-local status or openbot-local projects' };
+    },
+  });
+}
