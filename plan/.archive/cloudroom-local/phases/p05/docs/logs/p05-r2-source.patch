+
+fn app(f: &Fixture) -> (Router, Arc<SessionAuthority>) {
+    let config = Arc::new(AppConfig::for_test());
+    let authority = Arc::new(SessionAuthority::new(&config, f.persistence.clone()));
+    let state = State {
+        machines: f.cases.clone(),
