new file mode 100644
index 00000000..905a319d
--- /dev/null
+++ b/src/adapters/http/routes/local_machine_connection/driver.rs
@@ -0,0 +1,157 @@
+use super::*;
+use axum::extract::ws::Message;
+
+pub(super) async fn send(
+    socket: &mut WebSocket,
+    message: &ServerMessage,
+    stop: &CancellationToken,
+) -> AppResult<()> {
+    let frames = framing::encode(message)?;
+    let write = async {
+        for frame in frames {
+            socket
+                .send(Message::Text(frame.into()))
+                .await
+                .map_err(|_| AppError::Internal("local transport write failed".into()))?;
+        }
+        Ok(())
+    };
+    tokio::select! {biased;
+        _=stop.cancelled()=>Err(AppError::Internal("local transport stopped".into())),
+        result=timeout(Duration::from_secs(IO_SECONDS),write)=>result.map_err(|_|AppError::Internal("local transport write timed out".into()))?,
+    }
+}
+
+pub(super) async fn initialize(
+    socket: &mut WebSocket,
+    store: &dyn LocalProtocolStore,
+    stop: &CancellationToken,
+    fence: ConnectionFence,
+) -> AppResult<bool> {
+    let mut assembler = framing::Assembler::handshake();
+    let hello = loop {
+        let message = socket
+            .recv()
+            .await
+            .ok_or(AppError::InvalidCredentials)?
+            .map_err(|_| AppError::InvalidCredentials)?;
+        match message {
+            Message::Text(text) => {
+                if let Some(bytes) = assembler.push(&text)? {
+                    let ClientMessage::Hello { hello } =
+                        serde_json::from_slice(&bytes).map_err(|_| AppError::InvalidCredentials)?
+                    else {
+                        return Err(AppError::InvalidCredentials);
+                    };
+                    break hello;
+                }
+            }
+            _ => return Err(AppError::InvalidCredentials),
+        }
+    };
+    if hello.version != PROTOCOL_VERSION {
+        super::record_issue(store, fence, ConnectionIssue::IncompatibleProtocol).await;
+    }
+    let welcome = store.connect_journal(fence, &hello).await?;
+    let ready = !welcome.recovery_required;
+    send(socket, &ServerMessage::Welcome { welcome }, stop).await?;
+    Ok(ready)
+}
+
+pub(super) async fn run(
+    socket: &mut WebSocket,
+    store: &dyn LocalProtocolStore,
+    stop: &CancellationToken,
+    fence: ConnectionFence,
+) -> AppResult<()> {
+    let identity = ConnectionIdentity::from_fence(fence)?;
+    let mut assembler = framing::Assembler::default();
+    let mut heartbeat = tokio::time::interval(Duration::from_secs(HEARTBEAT_SECONDS));
+    let mut poll = tokio::time::interval(Duration::from_millis(POLL_MILLIS));
+    heartbeat.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+    poll.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+    let mut last_received = Instant::now();
+    let mut window = Instant::now();
+    let mut frames = 0usize;
+    loop {
+        let assembly_deadline = assembler
+            .deadline()
+            .unwrap_or_else(|| Instant::now() + Duration::from_secs(REASSEMBLY_SECONDS));
+        tokio::select! {biased;
+            _=stop.cancelled()=>return Ok(()),
+            _=tokio::time::sleep_until(assembly_deadline),if assembler.deadline().is_some()=>return Err(AppError::BadRequest("local transport assembly expired".into())),
+            incoming=socket.recv()=> {
+                if window.elapsed()>=Duration::from_secs(60) {window=Instant::now();frames=0;}
+                frames+=1;
+                if frames>1024 {return Err(AppError::BadRequest("local transport frame budget exhausted".into()));}
+                let Some(incoming)=incoming else {return Ok(());};
+                let incoming=incoming.map_err(|_|AppError::BadRequest("invalid local transport".into()))?;
+                last_received=Instant::now();
+                match incoming {
+                    Message::Text(text)=>if let Some(bytes)=assembler.push(&text)? {
+                        let message=serde_json::from_slice(&bytes).map_err(|_|AppError::BadRequest("invalid local message".into()))?;
+                        process(socket,store,stop,fence,identity,message).await?;
+                    },
+                    Message::Ping(bytes)=>timeout(Duration::from_secs(IO_SECONDS),socket.send(Message::Pong(bytes))).await.map_err(|_|AppError::InvalidCredentials)?.map_err(|_|AppError::InvalidCredentials)?,
+                    Message::Pong(_)=>{},Message::Close(_)=>return Ok(()),
+                    Message::Binary(_)=>return Err(AppError::BadRequest("local transport requires text frames".into())),
+                }
+            },
+            _=heartbeat.tick()=> {
+                if last_received.elapsed()>=Duration::from_secs(CONNECTION_STALE_SECONDS) || !store.renew_connection(fence).await? {return Err(AppError::InvalidCredentials);}
+                tokio::select! {biased; _=stop.cancelled()=>return Ok(()),
+                    result=timeout(Duration::from_secs(IO_SECONDS),socket.send(Message::Ping(Vec::new().into())))=>result.map_err(|_|AppError::InvalidCredentials)?.map_err(|_|AppError::InvalidCredentials)?,}
+            },
+            _=poll.tick()=> {
+                let deliveries=tokio::select! {biased; _=stop.cancelled()=>return Ok(()), result=store.pending_commands(fence)=>result?};
+                for delivery in deliveries {
+                    if !store.renew_connection(fence).await? {return Err(AppError::InvalidCredentials);}
+                    send(socket,&ServerMessage::Command{identity,delivery:Box::new(delivery)},stop).await?;
+                }
+            },
+        }
+    }
+}
+
+async fn process(
+    socket: &mut WebSocket,
+    store: &dyn LocalProtocolStore,
+    stop: &CancellationToken,
+    fence: ConnectionFence,
+    identity: ConnectionIdentity,
+    message: ClientMessage,
+) -> AppResult<()> {
+    match message {
+        ClientMessage::Hello { .. } => {
+            return Err(AppError::BadRequest("hello already completed".into()));
+        }
+        ClientMessage::Ready { identity: received } => {
+            if received != identity {
+                return Err(AppError::InvalidCredentials);
+            }
+            let ready = store.finish_reconciliation(fence).await?;
+            send(socket, &ServerMessage::Ready { identity, ready }, stop).await?;
+        }
+        ClientMessage::Observation {
+            identity: received,
+            observation,
+        } => {
+            if received != identity {
+                return Err(AppError::InvalidCredentials);
+            }
+            let through = store.accept_observation(fence, &observation).await?;
+            send(
+                socket,
+                &ServerMessage::Acknowledged { identity, through },
+                stop,
+            )
+            .await?;
+        }
+        ClientMessage::Heartbeat { identity: received } => {
+            if received != identity || !store.renew_connection(fence).await? {
+                return Err(AppError::InvalidCredentials);
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/src/adapters/http/routes/local_machine_connection/framing.rs b/src/adapters/http/routes/local_machine_connection/framing.rs
new file mode 100644
index 00000000..8499aeb2
--- /dev/null
+++ b/src/adapters/http/routes/local_machine_connection/framing.rs
@@ -0,0 +1,156 @@
+use crate::{
+    app_error::{AppError, AppResult},
+    application::local_agents::{
+        bounds::{MAX_CHUNK_BYTES, MAX_FRAME_BYTES, PROTOCOL_VERSION, REASSEMBLY_SECONDS},
+        protocol::MAX_LOGICAL_BYTES,
+    },
+    domain::local_agents::PayloadDigest,
+};
+use base64::{Engine, engine::general_purpose::STANDARD};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use tokio::time::{Duration, Instant};
+use uuid::Uuid;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Chunk {
+    version: u16,
+    transfer_id: Uuid,
+    index: usize,
+    parts: usize,
+    total_bytes: usize,
+    digest: PayloadDigest,
+    data: String,
+}
+
+fn invalid() -> AppError {
+    AppError::BadRequest("invalid local-machine transport frame".into())
+}
+fn digest(bytes: &[u8]) -> AppResult<PayloadDigest> {
+    PayloadDigest::try_from(format!("{:x}", Sha256::digest(bytes))).map_err(|_| invalid())
+}
+
+pub(super) fn encode<T: Serialize>(message: &T) -> AppResult<Vec<String>> {
+    let bytes = serde_json::to_vec(message).map_err(|_| invalid())?;
+    if bytes.is_empty() || bytes.len() > MAX_LOGICAL_BYTES {
+        return Err(invalid());
+    }
+    let transfer_id = Uuid::new_v4();
+    let digest = digest(&bytes)?;
+    let mut frames = Vec::new();
+    for (index, data) in bytes.chunks(MAX_CHUNK_BYTES).enumerate() {
+        let chunk = Chunk {
+            version: PROTOCOL_VERSION,
+            transfer_id,
+            index,
+            parts: bytes.len().div_ceil(MAX_CHUNK_BYTES),
+            total_bytes: bytes.len(),
+            digest: digest.clone(),
+            data: STANDARD.encode(data),
+        };
+        let frame = serde_json::to_string(&chunk).map_err(|_| invalid())?;
+        if frame.len() > MAX_FRAME_BYTES {
+            return Err(invalid());
+        }
+        frames.push(frame);
+    }
+    Ok(frames)
+}
+
+struct Pending {
+    transfer_id: Uuid,
+    next: usize,
+    parts: usize,
+    total_bytes: usize,
+    digest: PayloadDigest,
+    bytes: Vec<u8>,
+    deadline: Instant,
+}
+
+pub(super) struct Assembler {
+    pending: Option<Pending>,
+    limit: usize,
+}
+impl Default for Assembler {
+    fn default() -> Self {
+        Self {
+            pending: None,
+            limit: MAX_LOGICAL_BYTES,
+        }
+    }
+}
+impl Assembler {
+    pub(super) fn handshake() -> Self {
+        Self {
+            pending: None,
+            limit: 4096,
+        }
+    }
+    pub(super) fn deadline(&self) -> Option<Instant> {
+        self.pending.as_ref().map(|p| p.deadline)
+    }
+    pub(super) fn push(&mut self, frame: &str) -> AppResult<Option<Vec<u8>>> {
+        if frame.len() > MAX_FRAME_BYTES {
+            return Err(invalid());
+        }
+        let chunk: Chunk = serde_json::from_str(frame).map_err(|_| invalid())?;
+        if chunk.version != PROTOCOL_VERSION
+            || chunk.transfer_id.is_nil()
+            || chunk.total_bytes == 0
+            || chunk.total_bytes > self.limit
+            || chunk.parts != chunk.total_bytes.div_ceil(MAX_CHUNK_BYTES)
+            || chunk.index >= chunk.parts
+            || chunk.data.len() > MAX_CHUNK_BYTES.div_ceil(3) * 4
+        {
+            return Err(invalid());
+        }
+        let bytes = STANDARD.decode(&chunk.data).map_err(|_| invalid())?;
+        let expected = if chunk.index + 1 == chunk.parts {
+            chunk.total_bytes - chunk.index * MAX_CHUNK_BYTES
+        } else {
+            MAX_CHUNK_BYTES
+        };
+        if bytes.len() != expected {
+            return Err(invalid());
+        }
+        if self.pending.is_none() {
+            if chunk.index != 0 {
+                return Err(invalid());
+            }
+            self.pending = Some(Pending {
+                transfer_id: chunk.transfer_id,
+                next: 0,
+                parts: chunk.parts,
+                total_bytes: chunk.total_bytes,
+                digest: chunk.digest.clone(),
+                bytes: Vec::with_capacity(chunk.total_bytes),
+                deadline: Instant::now() + Duration::from_secs(REASSEMBLY_SECONDS),
+            });
+        }
+        let pending = self.pending.as_mut().ok_or_else(invalid)?;
+        if Instant::now() >= pending.deadline
+            || pending.transfer_id != chunk.transfer_id
+            || pending.next != chunk.index
+            || pending.parts != chunk.parts
+            || pending.total_bytes != chunk.total_bytes
+            || pending.digest != chunk.digest
+        {
+            return Err(invalid());
+        }
+        pending.bytes.extend_from_slice(&bytes);
+        pending.next += 1;
+        if pending.next < pending.parts {
+            return Ok(None);
+        }
+        let pending = self.pending.take().ok_or_else(invalid)?;
+        if pending.bytes.len() != pending.total_bytes || digest(&pending.bytes)? != pending.digest {
+            return Err(invalid());
+        }
+        Ok(Some(pending.bytes))
+    }
+}
