+        "conversation":view.conversation.unwrap().id,"cursor":cursor,"profile":chosen.id,"name":chosen.name})
+        .to_string(),
+    )
+    .unwrap();
+}
diff --git a/src/adapters/persistence/local_agents/management/writes.rs b/src/adapters/persistence/local_agents/management/writes.rs
