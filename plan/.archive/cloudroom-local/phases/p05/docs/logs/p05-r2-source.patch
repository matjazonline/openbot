+use super::*;
+use crate::application::local_agents::protocol::{LogicalInvocationKey, OperationAdmission};
+use crate::application::local_agents::workflow::LocalRunProgress;
+use crate::application::workflow::decisions::DecisionNotices;
+
+pub(super) async fn run_on(
+    tx: &mut Transaction<'_, Postgres>,
+    claim: &ClaimedWorkflow,
+    policy: LeasePolicy,
+    dispatch: &Dispatch,
+    notices: Option<&DecisionNotices>,
+) -> AppResult<LocalRunProgress> {
+    let scope = action_scope(claim.fence.scope);
+    // A repeated handler call after COMMIT can prove the exact closed attempt's park.
+    // It cannot manufacture authority for another attempt or turn a wake into a result.
+    if let Some(call) = saved_on(tx, scope).await?
+        && let Some(wait) = call.wait_id
+        && continuation::confirm_on(tx, claim.fence, wait).await?
+    {
+        return Ok(LocalRunProgress::Suspended(WaitId::new(wait)));
+    }
+    let call = preparation::prepare_on(tx, claim, policy).await?;
+    let request = ActionDispatchRequest {
+        subject: call.subject()?,
+        fence: claim.fence,
+        lease: policy,
+    };
+    let authorized = dispatch
+        .authorize_on(tx, &request, policy.attempt_bound())
+        .await?;
+    token_budget::require_progression(tx, claim.fence.scope).await?;
+    if authorized.approval_required {
+        return decisions::approvals::park(tx, &request, &authorized.action, notices)
+            .await?
+            .map(LocalRunProgress::Suspended)
+            .ok_or_else(|| AppError::Forbidden("Local execution requires approval".into()));
+    }
+    if action_uncertainty::conflicted_on(tx, scope).await? {
+        return Err(conflict());
+    }
+    if call.dispatch_id.is_some() {
+        let result = continuation::result_on(tx, &request, &authorized.action, &call).await?;
+        lease::live_window(tx, claim.fence, tokio::time::Instant::now())
+            .await?
+            .ok_or_else(conflict)?;
+        return Ok(result);
+    }
+    knowledge_release::evaluate_on(
+        tx,
+        &authorized.action,
+        knowledge_release::MessageRecipients::Current,
+    )
+    .await?;
+    let args: FrozenLocalRun =
+        serde_json::from_value(authorized.action.request().arguments.clone())
+            .map_err(|_| invalid())?;
+    let session = session_on(tx, scope, call.invocation_id, &args).await?;
+    let admission = operation_admission(
+        scope,
+        call.invocation_id,
+        authorized.action.request().context.actor,
+        args,
+        &session,
+    )?;
+    let now = waits::now(tx).await?;
+    crate::application::local_agents::bounds::validate_deadline(
+        now,
+        admission.operation.deadline(),
+    )
+    .map_err(|_| conflict())?;
+    shared::validate_capacity_on(
+        tx,
+        scope.company,
+        session.selection.machine_id,
+        admission.operation.command(),
+    )
+    .await?;
+    let (marker, wait) = (Uuid::new_v4(), Uuid::new_v4());
+    Dispatch::insert(
+        tx,
+        &request,
+        marker,
+        "local_agent",
+        authorized.current_policy,
+    )
+    .await?;
+    crate::adapters::persistence::local_agents::protocol::commands::insert_admission_on(
+        tx,
+        &admission,
+        session.installation_id,
+        OperationOrigin::Workflow,
+    )
+    .await?;
+    park_on(tx, &request, &session, &admission, marker, wait).await?;
+    Ok(LocalRunProgress::Suspended(WaitId::new(wait)))
+}
+
+fn operation_admission(
+    scope: ActionScope,
+    invocation: Uuid,
+    actor: Uuid,
+    args: FrozenLocalRun,
+    session: &LocalAgentSession,
+) -> AppResult<OperationAdmission> {
+    let command = match &session.thread_id {
+        Some(thread) => LocalCommand::Send {
+            session_id: session.id,
+            thread_id: thread.clone(),
+            prompt: args.prompt,
+        },
+        None => LocalCommand::Create {
+            session_id: session.id,
+            selection: args.selection,
+            prompt: args.prompt,
+        },
+    };
+    let operation = LocalAgentOperation::queued(
+        OperationId::new(invocation).map_err(|_| invalid())?,
+        command,
+        args.deadline,
+    )
+    .map_err(|_| contract::invalid())?;
+    Ok(OperationAdmission {
+        company_id: scope.company.as_uuid(),
+        actor_id: actor,
+        machine_id: session.selection.machine_id,
+        logical_key: LogicalInvocationKey::parse(format!(
+            "workflow:{}:{}",
+            scope.run.as_uuid(),
+            scope.execution.as_uuid()
+        ))?,
+        operation,
+    })
+}
+
+async fn session_on(
+    db: &mut PgConnection,
+    scope: ActionScope,
+    invocation: Uuid,
+    args: &FrozenLocalRun,
+) -> AppResult<LocalAgentSession> {
+    if let Some(id) = args.session_id {
+        let session = shared::session_on(db, scope.company, id)
+            .await?
+            .ok_or_else(missing)?;
+        // prepare_on has authorized the original run before machine locking. Recheck
+        // immutable profile/selection here without acquiring a later workflow lock.
+        if session.profile_id != args.profile_id
+            || session.selection != args.selection
+            || session.thread_id.is_none()
+            || !matches!(session.association, SessionAssociation::Workflow { .. })
+        {
+            return Err(missing());
+        }
+        return Ok(session);
+    }
+    let installation: Uuid = sqlx::query_scalar("SELECT installation_id FROM local_machines WHERE company_id=$1 AND id=$2 AND state='enabled'")
+        .bind(scope.company.as_uuid()).bind(args.selection.machine_id.as_uuid()).fetch_optional(&mut *db).await?.ok_or_else(missing)?;
+    let session = LocalAgentSession {
+        id: SessionId::new(invocation).map_err(|_| invalid())?,
+        profile_id: args.profile_id,
+        company_id: scope.company.as_uuid(),
+        installation_id: InstallationId::new(installation).map_err(|_| invalid())?,
+        selection: args.selection.clone(),
+        association: SessionAssociation::Workflow {
+            run_id: scope.run.as_uuid(),
+        },
+        thread_id: None,
+    };
+    shared::insert_session_on(db, &session).await?;
+    Ok(session)
+}
+
+async fn park_on(
+    db: &mut PgConnection,
+    request: &ActionDispatchRequest,
+    session: &LocalAgentSession,
+    admission: &OperationAdmission,
+    marker: Uuid,
+    wait: Uuid,
+) -> AppResult<()> {
+    let scope = request.fence.scope;
+    let fence = request.fence;
+    let linked = sqlx::query("UPDATE workflow_local_agent_calls SET machine_id=$4,installation_id=$5,session_id=$6,operation_id=$7,wait_id=$8,dispatch_id=$9,fence_expires_at=job.lock_expires_at FROM background_tasks AS job WHERE workflow_local_agent_calls.company_id=$1 AND workflow_local_agent_calls.run_id=$2 AND workflow_local_agent_calls.execution_id=$3 AND operation_id IS NULL AND job.company_id=$1 AND job.id=$10 AND job.continuation_count<workflow_job_continuation_limit()")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(session.selection.machine_id.as_uuid())
+        .bind(session.installation_id.as_uuid()).bind(session.id.as_uuid()).bind(admission.operation.id().as_uuid()).bind(wait).bind(marker).bind(scope.job.0)
+        .execute(&mut *db).await?;
+    sqlx::query("INSERT INTO workflow_waits(company_id,run_id,execution_id,id,reason,deadline) VALUES($1,$2,$3,$4,'effect',$5)")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(wait).bind(admission.operation.deadline()).execute(&mut *db).await?;
+    let attempt = sqlx::query("UPDATE task_attempts SET status='completed',stop_reason='local_agent_parked',finished_at=clock_timestamp() WHERE task_id=$1 AND attempt_number=$2 AND worker_id=$3 AND execution_generation=$4 AND status='processing'")
+        .bind(scope.job.0).bind(fence.attempt.0).bind(fence.worker.0).bind(fence.generation.0).execute(&mut *db).await?;
+    let job = sqlx::query("UPDATE background_tasks SET status='completed',updated_at=clock_timestamp(),worker_id=NULL,execution_generation=NULL,locked_at=NULL,lock_expires_at=NULL WHERE company_id=$1 AND id=$2 AND workflow_execution_id=$3 AND status='processing' AND worker_id=$4 AND execution_generation=$5 AND attempt_ordinal=$6 AND lock_expires_at>clock_timestamp()")
+        .bind(scope.company.as_uuid()).bind(scope.job.0).bind(scope.execution.as_uuid()).bind(fence.worker.0).bind(fence.generation.0).bind(fence.attempt.0).execute(&mut *db).await?;
+    if linked.rows_affected() != 1 || attempt.rows_affected() != 1 || job.rows_affected() != 1 {
+        return Err(conflict());
+    }
+    sqlx::query("UPDATE workflow_runs SET state='waiting',waiting_reason='effect' WHERE company_id=$1 AND id=$2 AND state IN ('queued','running')")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).execute(&mut *db).await?;
+    waits::audit_wait(db, scope, wait, "wait_parked").await
+}
diff --git a/src/adapters/persistence/workflow/local_agents/continuation.rs b/src/adapters/persistence/workflow/local_agents/continuation.rs
new file mode 100644
index 00000000..e5b4c414
--- /dev/null
+++ b/src/adapters/persistence/workflow/local_agents/continuation.rs
@@ -0,0 +1,184 @@
+use super::*;
+use crate::application::local_agents::workflow::{LocalRunProgress, MAX_WORKFLOW_TEXT_BYTES};
+use crate::application::workflow::{completion::CommitDisposition, waits::WaitProgress};
+
+pub(in crate::adapters::persistence::workflow) async fn prelock_on(
+    db: &mut PgConnection,
+    scope: ActivationRequest,
+) -> AppResult<()> {
+    let owned: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM workflow_local_agent_calls WHERE company_id=$1 AND run_id=$2 AND execution_id=$3)")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).fetch_one(&mut *db).await?;
+    if owned {
+        action_authority::prelock_on(db, action_scope(scope)).await?;
+    }
+    Ok(())
+}
+
+pub(in crate::adapters::persistence::workflow) async fn resume_on(
+    tx: &mut Transaction<'_, Postgres>,
+    scope: ActivationRequest,
+    wait: Uuid,
+) -> AppResult<Option<WaitProgress>> {
+    let due: Option<bool> = sqlx::query_scalar("SELECT call.ready_at IS NOT NULL OR operation.deadline<=clock_timestamp() FROM workflow_local_agent_calls AS call JOIN local_agent_operations AS operation ON operation.company_id=call.company_id AND operation.id=call.operation_id WHERE call.company_id=$1 AND call.run_id=$2 AND call.execution_id=$3 AND call.wait_id=$4")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(wait).fetch_optional(&mut **tx).await?;
+    let Some(due) = due else {
+        return Ok(None);
+    };
+    if !due {
+        return Ok(Some(WaitProgress::Pending));
+    }
+    let call = saved_on(tx, action_scope(scope))
+        .await?
+        .ok_or_else(invalid)?;
+    let action = call.action()?;
+    // prelock_on already locks the account/company before wait_commit locks the run.
+    let actor = WorkflowActor::authenticated(action.request().context.actor)?;
+    let current =
+        delivery::current_authority_on(tx, action_scope(scope), &call.subject()?, Some(actor))
+            .await;
+    match current {
+        Ok(()) => {}
+        Err(
+            AppError::NotFound(_)
+            | AppError::Forbidden(_)
+            | AppError::BadRequest(_)
+            | AppError::Conflict(_),
+        ) => {
+            let failure = StepFailure::new(
+                FailureClass::Terminal,
+                FailureCode::parse("local_agent.refused").map_err(|_| invalid())?,
+                None,
+            )
+            .map_err(|_| invalid())?;
+            return refused_on(tx, scope, wait, &failure).await.map(Some);
+        }
+        Err(AppError::KnowledgeRelease {
+            content,
+            destination,
+        }) => {
+            return refused_on(
+                tx,
+                scope,
+                wait,
+                &StepFailure::from_knowledge_refusal(crate::domain::workflow::KnowledgeRefusal {
+                    content,
+                    destination,
+                }),
+            )
+            .await
+            .map(Some);
+        }
+        Err(error) => return Err(error),
+    }
+    let expiration = crate::adapters::persistence::local_agents::protocol::EXPIRATION_OUTCOME_SQL;
+    sqlx::query(&format!("UPDATE local_agent_operations AS operation SET outcome={expiration} WHERE company_id=$1 AND id=$2 AND outcome IS NULL AND deadline<=clock_timestamp()"))
+        .bind(scope.company.as_uuid()).bind(call.invocation_id).execute(&mut **tx).await?;
+    wait_commit::continue_delivery(tx, scope, wait)
+        .await
+        .map(Some)
+}
+
+async fn refused_on(
+    db: &mut PgConnection,
+    scope: ActivationRequest,
+    wait: Uuid,
+    failure: &StepFailure,
+) -> AppResult<WaitProgress> {
+    sqlx::query("UPDATE workflow_waits SET state='completed',settled_at=clock_timestamp() WHERE company_id=$1 AND run_id=$2 AND execution_id=$3 AND id=$4 AND state='waiting'")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(wait).execute(&mut *db).await?;
+    sqlx::query("UPDATE workflow_runs SET state='running',waiting_reason=NULL WHERE company_id=$1 AND id=$2 AND state='waiting'")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).execute(&mut *db).await?;
+    recovery::route_parked_failure(db, scope, failure).await?;
+    waits::audit_wait(db, scope, wait, "wait_completed").await?;
+    wait_commit::saved(db, scope, CommitDisposition::Committed, true).await
+}
+
+pub(super) async fn confirm_on(
+    db: &mut PgConnection,
+    fence: WorkflowFence,
+    wait: Uuid,
+) -> AppResult<bool> {
+    Ok(sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM workflow_local_agent_calls AS call JOIN workflow_action_dispatches AS marker ON marker.company_id=call.company_id AND marker.id=call.dispatch_id JOIN task_attempts AS attempt ON attempt.task_id=marker.job_id AND attempt.attempt_number=marker.attempt_number WHERE call.company_id=$1 AND call.run_id=$2 AND call.execution_id=$3 AND call.wait_id=$4 AND marker.job_id=$5 AND marker.attempt_number=$6 AND marker.worker_id=$7 AND marker.execution_generation=$8 AND marker.effect_kind='local_agent' AND attempt.status='completed' AND attempt.stop_reason='local_agent_parked' AND attempt.worker_id=marker.worker_id AND attempt.execution_generation=marker.execution_generation)")
+        .bind(fence.scope.company.as_uuid()).bind(fence.scope.run.as_uuid()).bind(fence.scope.execution.as_uuid()).bind(wait)
+        .bind(fence.scope.job.0).bind(fence.attempt.0).bind(fence.worker.0).bind(fence.generation.0).fetch_one(db).await?)
+}
+
+#[derive(sqlx::FromRow)]
+struct NativeResult {
+    operation_id: Uuid,
+    session_id: Uuid,
+    thread_id: Option<String>,
+    workflow_outcome: Option<String>,
+    output: Option<String>,
+    output_truncated: bool,
+    measured_usage: Option<Value>,
+    wait_state: String,
+}
+
+pub(super) async fn result_on(
+    db: &mut PgConnection,
+    request: &ActionDispatchRequest,
+    action: &FrozenAction,
+    call: &SavedCall,
+) -> AppResult<LocalRunProgress> {
+    if let Some(saved) = saved_result_on(db, request, action).await? {
+        return Ok(saved);
+    }
+    let scope = request.scope();
+    let result = sqlx::query_as::<_, NativeResult>("SELECT operation.id AS operation_id,call.session_id,session.thread_id,call.workflow_outcome,operation.output,operation.output_truncated,operation.measured_usage,wait.state AS wait_state FROM workflow_local_agent_calls AS call JOIN local_agent_operations AS operation ON operation.company_id=call.company_id AND operation.id=call.operation_id JOIN local_agent_sessions AS session ON session.company_id=call.company_id AND session.id=call.session_id JOIN workflow_waits AS wait ON wait.company_id=call.company_id AND wait.id=call.wait_id WHERE call.company_id=$1 AND call.run_id=$2 AND call.execution_id=$3 AND call.invocation_id=$4")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(call.invocation_id).fetch_one(&mut *db).await?;
+    if result.wait_state != "completed" {
+        return Err(conflict());
+    }
+    let outcome: OperationOutcome =
+        serde_json::from_value(json!(result.workflow_outcome.as_ref().ok_or_else(invalid)?))
+            .map_err(|_| invalid())?;
+    let result = bounded_result(result, outcome)?;
+    let result = validate_action_result(action, result)?;
+    sqlx::query("INSERT INTO workflow_action_receipts(company_id,run_id,execution_id,invocation_id,argument_digest,dispatch_id,effect_kind,result) VALUES($1,$2,$3,$4,$5,$6,'local_agent',$7) ON CONFLICT (company_id,invocation_id) DO NOTHING")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(call.invocation_id)
+        .bind(request.subject.argument_digest.as_str()).bind(call.dispatch_id.ok_or_else(invalid)?).bind(&result).execute(db).await?;
+    Ok(match outcome {
+        OperationOutcome::Succeeded => LocalRunProgress::Completed(result),
+        other => LocalRunProgress::Failed(other),
+    })
+}
+
+pub(super) async fn saved_result_on(
+    db: &mut PgConnection,
+    request: &ActionDispatchRequest,
+    action: &FrozenAction,
+) -> AppResult<Option<LocalRunProgress>> {
+    let scope = request.scope();
+    let saved: Option<Value> = sqlx::query_scalar("SELECT result FROM workflow_action_receipts WHERE company_id=$1 AND run_id=$2 AND execution_id=$3 AND invocation_id=$4 AND argument_digest=$5 AND effect_kind='local_agent'")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).bind(request.subject.invocation.as_uuid())
+        .bind(request.subject.argument_digest.as_str()).fetch_optional(db).await?;
+    saved
+        .map(|saved| {
+            let result = validate_action_result(action, saved)?;
+            let outcome: OperationOutcome =
+                serde_json::from_value(result["status"].clone()).map_err(|_| invalid())?;
+            Ok(match outcome {
+                OperationOutcome::Succeeded => LocalRunProgress::Completed(result),
+                other => LocalRunProgress::Failed(other),
+            })
+        })
+        .transpose()
+}
+
+fn bounded_result(result: NativeResult, outcome: OperationOutcome) -> AppResult<Value> {
+    let mut text = result.output.unwrap_or_default();
+    let mut length = text.len().min(MAX_WORKFLOW_TEXT_BYTES);
+    while !text.is_char_boundary(length) {
+        length -= 1;
+    }
+    let truncated = result.output_truncated || length < text.len();
+    text.truncate(length);
+    if let Some(usage) = &result.measured_usage {
+        let _: MeasuredUsage = serde_json::from_value(usage.clone()).map_err(|_| invalid())?;
+    }
+    Ok(
+        json!({"status":outcome,"operation_id":result.operation_id,"session_id":result.session_id,
+        "thread_id":result.thread_id,"text":text,"truncated":truncated,"usage":result.measured_usage}),
+    )
+}
diff --git a/src/adapters/persistence/workflow/local_agents/delivery.rs b/src/adapters/persistence/workflow/local_agents/delivery.rs
new file mode 100644
index 00000000..68985074
--- /dev/null
+++ b/src/adapters/persistence/workflow/local_agents/delivery.rs
@@ -0,0 +1,108 @@
+use super::*;
+use crate::adapters::persistence::workflow::action_dispatch::SqlActionAuthority;
+
+/// A parked call authorizes only its saved operation. This check precedes machine and
+/// operation locks; reconciliation after any attempted delivery retains protocol semantics.
+pub(in crate::adapters::persistence) async fn authorize_operation_on(
+    tx: &mut Transaction<'_, Postgres>,
+    company: CompanyId,
+    operation: OperationId,
+    actor: WorkflowActor,
+) -> AppResult<()> {
+    let (scope, subject) = parked_subject_on(tx, company, operation)
+        .await?
+        .ok_or_else(missing)?;
+    let current = action_authority::prelock_on(tx, scope).await?;
+    if current != Some(actor) {
+        return Err(missing());
+    }
+    current_authority_on(tx, scope, &subject, current).await?;
+    // This last proof also checks cancellation/deadline after lock waits.
+    if parked_subject_on(tx, company, operation).await?.is_none() {
+        return Err(conflict());
+    }
+    Ok(())
+}
+
+pub(super) async fn current_authority_on(
+    tx: &mut Transaction<'_, Postgres>,
+    scope: ActionScope,
+    subject: &ApprovalSubject,
+    actor: Option<WorkflowActor>,
+) -> AppResult<()> {
+    let authority = action_authority::load_on(
+        tx,
+        scope,
+        subject,
+        actor,
+        action_authority::RunPhase::LocalAgentWait,
+    )
+    .await?;
+    validate_run_authority(scope, subject, &authority)?;
+    let current = LocalActionAuthority.lock_current(tx, &authority).await?;
+    validate_resource(authority.action.request(), &current.resource)?;
+    let policy = validate_current_authority(authority.action.request(), &current.policy)?;
+    let activation = activation_on(tx, scope).await?;
+    if policy == ActionAccessDecision::ApprovalRequired
+        && decisions::approvals::approved(
+            tx,
+            activation,
+            subject,
+            authority.action.operation_digest().as_str(),
+        )
+        .await?
+        .is_none()
+    {
+        return Err(missing());
+    }
+    knowledge_release::evaluate_on(
+        tx,
+        &authority.action,
+        knowledge_release::MessageRecipients::Current,
+    )
+    .await?;
+    Ok(())
+}
+
+async fn activation_on(db: &mut PgConnection, scope: ActionScope) -> AppResult<ActivationRequest> {
+    let job: Uuid = sqlx::query_scalar("SELECT job.id FROM background_tasks AS job JOIN workflow_executions AS execution ON execution.company_id=job.company_id AND execution.id=job.workflow_execution_id WHERE job.company_id=$1 AND execution.run_id=$2 AND job.workflow_execution_id=$3")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid()).fetch_optional(db).await?.ok_or_else(missing)?;
+    Ok(ActivationRequest {
+        company: scope.company,
+        run: scope.run,
+        execution: scope.execution,
+        job: crate::application::workflow::activation::WorkflowJobId(job),
+    })
+}
+
+#[derive(sqlx::FromRow)]
+struct ParkedCall {
+    run_id: Uuid,
+    execution_id: Uuid,
+    invocation_id: Uuid,
+    argument_digest: String,
+}
+
+pub(super) async fn parked_subject_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    operation: OperationId,
+) -> AppResult<Option<(ActionScope, ApprovalSubject)>> {
+    let row = sqlx::query_as::<_, ParkedCall>("SELECT call.run_id,call.execution_id,call.invocation_id,call.argument_digest FROM workflow_local_agent_calls AS call JOIN workflow_waits AS wait ON wait.company_id=call.company_id AND wait.id=call.wait_id JOIN workflow_runs AS run ON run.company_id=call.company_id AND run.id=call.run_id JOIN workflow_executions AS execution ON execution.company_id=call.company_id AND execution.id=call.execution_id WHERE call.company_id=$1 AND call.operation_id=$2 AND call.dispatch_id IS NOT NULL AND wait.state='waiting' AND wait.reason='effect' AND wait.deadline>clock_timestamp() AND run.state='waiting' AND run.waiting_reason='effect' AND run.deadline>clock_timestamp() AND execution.completed_at IS NULL AND execution.committed_route IS NULL")
+        .bind(company.as_uuid()).bind(operation.as_uuid()).fetch_optional(db).await?;
+    row.map(|row| {
+        Ok((
+            ActionScope {
+                company,
+                run: RunId::new(row.run_id),
+                execution: ExecutionId::new(row.execution_id),
+            },
+            ApprovalSubject {
+                invocation: ActionInvocationId::new(row.invocation_id),
+                argument_digest: serde_json::from_value(json!(row.argument_digest))
+                    .map_err(|_| invalid())?,
+            },
+        ))
+    })
+    .transpose()
+}
diff --git a/src/adapters/persistence/workflow/local_agents/mod.rs b/src/adapters/persistence/workflow/local_agents/mod.rs
new file mode 100644
index 00000000..94e8f5be
--- /dev/null
+++ b/src/adapters/persistence/workflow/local_agents/mod.rs
@@ -0,0 +1,233 @@
+//! One frozen action per local-agent step; native execution is owned by the connection.
+use super::*;
+use crate::adapters::persistence::local_agents::shared;
+use crate::application::local_agents::workflow::{
+    self as contract, FrozenLocalRun, LocalRunInputs,
+};
+use crate::application::workflow::activation::ActivationRequest;
+use crate::application::workflow::{actions::*, lease::*, polling::WorkflowStepKind};
+use crate::domain::local_agents::*;
+use chrono::{DateTime, Utc};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+
+mod admission;
+mod continuation;
+mod delivery;
+mod preparation;
+mod resolution;
+
+pub(super) use continuation::prelock_on as prelock_wait_on;
+pub(super) use continuation::resume_on;
+pub(in crate::adapters::persistence) use delivery::authorize_operation_on;
+
+pub(super) async fn confirm_suspension(
+    persistence: &PostgresPersistence,
+    fence: WorkflowFence,
+    wait: Uuid,
+) -> AppResult<bool> {
+    tokio::time::timeout(std::time::Duration::from_secs(1), async {
+        let mut connection = persistence.pool().acquire().await?;
+        continuation::confirm_on(&mut connection, fence, wait).await
+    })
+    .await
+    .map_err(|_| lease::timed_out())?
+}
+
+type Dispatch = action_dispatch::PostgresActionDispatch<LocalActionAuthority, ()>;
+
+#[derive(Clone)]
+pub struct PostgresLocalAgentWorkflow {
+    persistence: PostgresPersistence,
+    notices: Option<crate::application::workflow::decisions::DecisionNotices>,
+}
+
+impl PostgresLocalAgentWorkflow {
+    pub fn new(
+        persistence: PostgresPersistence,
+        notices: Option<crate::application::workflow::decisions::DecisionNotices>,
+    ) -> Self {
+        Self {
+            persistence,
+            notices,
+        }
+    }
+}
+
+#[async_trait]
+impl contract::LocalAgentWorkflow for PostgresLocalAgentWorkflow {
+    async fn run_local_agent(
+        &self,
+        claim: &ClaimedWorkflow,
+        _inputs: &LocalRunInputs,
+        policy: LeasePolicy,
+    ) -> AppResult<contract::LocalRunProgress> {
+        use super::persistence_bound::{Attempt, End, WriteBound};
+        let bound = WriteBound::start("local_agent.run", policy);
+        let dispatch = Dispatch::new(self.persistence.clone(), LocalActionAuthority, ());
+        let attempted = bound
+            .attempt(Box::pin(async {
+                let mut connection = bound.acquire(self.persistence.pool()).await?;
+                let mut tx = bound.begin(&mut connection).await?;
+                let result =
+                    admission::run_on(&mut tx, claim, policy, &dispatch, self.notices.as_ref())
+                        .await;
+                bound.end(tx, result.map(End::Commit)).await
+            }))
+            .await;
+        match attempted {
+            Attempt::Done(result) => Ok(result),
+            Attempt::Failed(error) => Err(error),
+            Attempt::Ambiguous => {
+                bound
+                    .resolve(Box::pin(resolution::resolve_on(
+                        self, &dispatch, claim, policy, &bound,
+                    )))
+                    .await
+            }
+        }
+    }
+}
+
+#[derive(sqlx::FromRow)]
+struct SavedCall {
+    invocation_id: Uuid,
+    operation: Value,
+    wait_id: Option<Uuid>,
+    dispatch_id: Option<Uuid>,
+}
+
+impl SavedCall {
+    fn action(&self) -> AppResult<FrozenAction> {
+        let action = FrozenAction::restore(self.operation.clone())?;
+        // A stored matching digest alone is insufficient for this privileged builtin.
+        FrozenAction::local_agent(action.request().clone())
+    }
+
+    fn subject(&self) -> AppResult<ApprovalSubject> {
+        Ok(ApprovalSubject {
+            invocation: ActionInvocationId::new(self.invocation_id),
+            argument_digest: self.action()?.argument_digest().clone(),
+        })
+    }
+}
+
+async fn saved_on(db: &mut PgConnection, scope: ActionScope) -> AppResult<Option<SavedCall>> {
+    Ok(sqlx::query_as::<_, SavedCall>(
+        "SELECT call.invocation_id,intent.operation,call.wait_id,call.dispatch_id \
+         FROM workflow_local_agent_calls AS call JOIN workflow_action_intents AS intent \
+           ON intent.company_id=call.company_id AND intent.id=call.invocation_id \
+         WHERE call.company_id=$1 AND call.run_id=$2 AND call.execution_id=$3",
+    )
+    .bind(scope.company.as_uuid())
+    .bind(scope.run.as_uuid())
+    .bind(scope.execution.as_uuid())
+    .fetch_optional(db)
+    .await?)
+}
+
+fn action_scope(scope: ActivationRequest) -> ActionScope {
+    ActionScope {
+        company: scope.company,
+        run: scope.run,
+        execution: scope.execution,
+    }
+}
+
+/// Both current and original workflow associations must authorize session continuation.
+/// Run rows precede machine/profile locks in every caller.
+#[derive(sqlx::FromRow, PartialEq, Eq)]
+pub(in crate::adapters::persistence) struct RunAssociation {
+    channel_id: Option<Uuid>,
+    thread_id: Option<Uuid>,
+}
+
+pub(in crate::adapters::persistence) async fn authorize_run_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    run: Uuid,
+    actor: WorkflowActor,
+) -> AppResult<RunAssociation> {
+    let stored = sqlx::query_as::<_, RunAssociation>(
+        "SELECT channel_id,thread_id FROM workflow_runs WHERE company_id=$1 AND id=$2 FOR SHARE",
+    )
+    .bind(company.as_uuid())
+    .bind(run)
+    .fetch_optional(&mut *db)
+    .await?
+    .ok_or_else(missing)?;
+    let association = match (stored.channel_id, stored.thread_id) {
+        (None, None) => RelatedAssociation::Company,
+        (Some(channel), None) => RelatedAssociation::Channel(RelatedChannelId::new(channel)),
+        (Some(channel), Some(thread)) => RelatedAssociation::Thread {
+            channel_id: RelatedChannelId::new(channel),
+            thread_id: RelatedThreadId::new(thread),
+        },
+        _ => return Err(invalid()),
+    };
+    association::authorize_association(db, company, actor, association).await?;
+    Ok(stored)
+}
+
+struct LocalActionAuthority;
+
+#[async_trait]
+impl action_dispatch::SqlActionAuthority for LocalActionAuthority {
+    async fn lock_current(
+        &self,
+        tx: &mut Transaction<'_, Postgres>,
+        authority: &ActionRunAuthority,
+    ) -> AppResult<action_dispatch::LockedActionAuthority> {
+        let action = FrozenAction::local_agent(authority.action.request().clone())?;
+        authority::authorize_company(tx, action.scope().company, authority.actor).await?;
+        let args: FrozenLocalRun =
+            serde_json::from_value(action.request().arguments.clone()).map_err(|_| invalid())?;
+        authorize_run_on(
+            tx,
+            action.scope().company,
+            action.scope().run.as_uuid(),
+            authority.actor,
+        )
+        .await?;
+        if let Some(id) = args.session_id {
+            let session = shared::session_on(tx, action.scope().company, id)
+                .await?
+                .ok_or_else(missing)?;
+            preparation::validate_continuation_on(
+                tx,
+                action.scope(),
+                authority.actor,
+                args.profile_id,
+                &session,
+            )
+            .await?;
+        }
+        let locked = shared::lock_profile_on(tx, action.scope().company, args.profile_id).await?;
+        if locked.machine.state != MachineState::Enabled {
+            return Err(conflict());
+        }
+        shared::validate_selection_on(
+            tx,
+            action.scope().company,
+            locked.machine.id,
+            &args.selection,
+        )
+        .await?;
+        Ok(action_dispatch::LockedActionAuthority {
+            resource: crate::application::workflow::binding::ResourceStatus {
+                id: RuntimeResourceId::new(args.profile_id.as_uuid()),
+                company_id: action.scope().company,
+                kind: TypeName::parse(contract::RESOURCE_KIND).map_err(|_| invalid())?,
+                supported_contracts: BTreeSet::from([
+                    TypeName::parse(contract::KIND).map_err(|_| invalid())?
+                ]),
+                authorized: true,
+                readiness: crate::application::workflow::binding::ResourceReadiness::Ready,
+            },
+            policy: CurrentActionPolicy {
+                tool: contract::builtin_snapshot(action.scope().company)?,
+                approval_required: args.approval.is_some(),
+            },
+        })
+    }
+}
diff --git a/src/adapters/persistence/workflow/local_agents/preparation.rs b/src/adapters/persistence/workflow/local_agents/preparation.rs
new file mode 100644
index 00000000..4d325eeb
--- /dev/null
+++ b/src/adapters/persistence/workflow/local_agents/preparation.rs
@@ -0,0 +1,107 @@
+use super::*;
+
+/// The call and shared action intent commit together, before mutable profile defaults can
+/// be consulted by another claim. A replay always uses the saved selection and deadline.
+pub(super) async fn prepare_on(
+    tx: &mut Transaction<'_, Postgres>,
+    claim: &ClaimedWorkflow,
+    policy: LeasePolicy,
+) -> AppResult<SavedCall> {
+    let scope = action_scope(claim.fence.scope);
+    let facts = http::runtime::facts(tx, scope).await?;
+    if !lease::lock_fence(tx, claim.fence, policy.attempt_bound()).await? {
+        return Err(conflict());
+    }
+    let inputs =
+        http::runtime::frozen_inputs(tx, &facts, claim, &WorkflowStepKind(contract::KIND.into()))
+            .await?;
+    if let Some(call) = saved_on(tx, scope).await? {
+        let action = call.action()?;
+        if action.scope() != scope {
+            return Err(invalid());
+        }
+        return Ok(call);
+    }
+    let inputs: LocalRunInputs = serde_json::from_value(inputs).map_err(|_| contract::invalid())?;
+    authorize_run_on(tx, scope.company, scope.run.as_uuid(), facts.actor).await?;
+    // Resolve the original association before taking any machine lock.
+    if let Some(id) = inputs.session_id {
+        let session = shared::session_on(tx, scope.company, id)
+            .await?
+            .ok_or_else(missing)?;
+        validate_continuation_on(tx, scope, facts.actor, inputs.profile_id, &session).await?;
+    }
+    let locked = shared::lock_profile_on(tx, scope.company, inputs.profile_id).await?;
+    if locked.machine.state != MachineState::Enabled {
+        return Err(conflict());
+    }
+    shared::validate_selection_on(
+        tx,
+        scope.company,
+        locked.machine.id,
+        &locked.profile.selection,
+    )
+    .await?;
+    let deadline: DateTime<Utc> = sqlx::query_scalar(
+        "SELECT LEAST(deadline,clock_timestamp()+interval '30 minutes') FROM workflow_runs WHERE company_id=$1 AND id=$2",
+    ).bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).fetch_one(&mut **tx).await?;
+    let frozen = FrozenLocalRun {
+        profile_id: inputs.profile_id,
+        prompt: inputs.prompt,
+        session_id: inputs.session_id,
+        approval: inputs.approval,
+        selection: locked.profile.selection,
+        deadline,
+    };
+    let tool = facts
+        .bundle
+        .snapshots()
+        .tools
+        .iter()
+        .find(|tool| tool.contract.name.as_str() == contract::KIND)
+        .cloned()
+        .ok_or_else(missing)?;
+    let mut context = http::runtime::context(&facts);
+    context.approval_required = frozen.approval.is_some();
+    let action = FrozenAction::local_agent(ActionRequest {
+        scope,
+        operation_key: tool.contract.name.clone(),
+        target: ActionTarget::Local {
+            resource: frozen.profile_id.as_uuid(),
+            resource_kind: TypeName::parse(contract::RESOURCE_KIND).map_err(|_| invalid())?,
+        },
+        contract: tool,
+        arguments: serde_json::to_value(frozen).map_err(|_| invalid())?,
+        context,
+    })?;
+    let intent = actions::insert_on(tx, &action, None).await?;
+    sqlx::query("INSERT INTO workflow_local_agent_calls(company_id,run_id,execution_id,invocation_id,argument_digest,profile_id) VALUES($1,$2,$3,$4,$5,$6)")
+        .bind(scope.company.as_uuid()).bind(scope.run.as_uuid()).bind(scope.execution.as_uuid())
+        .bind(intent.invocation.as_uuid()).bind(intent.argument_digest.as_str()).bind(inputs.profile_id.as_uuid())
+        .execute(&mut **tx).await?;
+    saved_on(tx, scope).await?.ok_or_else(invalid)
+}
+
+pub(super) async fn validate_continuation_on(
+    db: &mut PgConnection,
+    scope: ActionScope,
+    actor: WorkflowActor,
+    profile: ProfileId,
+    session: &LocalAgentSession,
+) -> AppResult<()> {
+    if session.company_id != scope.company.as_uuid()
+        || session.profile_id != profile
+        || session.thread_id.is_none()
+    {
+        return Err(missing());
+    }
+    let SessionAssociation::Workflow { run_id: original } = session.association else {
+        return Err(missing());
+    };
+    let current = authorize_run_on(db, scope.company, scope.run.as_uuid(), actor).await?;
+    let original = authorize_run_on(db, scope.company, original, actor).await?;
+    if current != original {
+        return Err(missing());
+    }
+    Ok(())
+}
diff --git a/src/adapters/persistence/workflow/local_agents/resolution.rs b/src/adapters/persistence/workflow/local_agents/resolution.rs
new file mode 100644
index 00000000..957f27ba
--- /dev/null
+++ b/src/adapters/persistence/workflow/local_agents/resolution.rs
@@ -0,0 +1,53 @@
+use super::super::persistence_bound::{Evidence, WriteBound};
+use super::*;
+
+pub(super) async fn resolve_on(
+    runtime: &PostgresLocalAgentWorkflow,
+    dispatch: &Dispatch,
+    claim: &ClaimedWorkflow,
+    policy: LeasePolicy,
+    bound: &WriteBound,
+) -> AppResult<Evidence<contract::LocalRunProgress>> {
+    let mut connection = bound.acquire(runtime.persistence.pool()).await?;
+    let mut tx = bound.begin(&mut connection).await?;
+    let proof = async {
+        let actor = action_authority::prelock_on(&mut tx, action_scope(claim.fence.scope)).await?;
+        lease::lock_scope(&mut tx, claim.fence.scope, bound.server_timeout()).await?;
+        let Some(call) = saved_on(&mut tx, action_scope(claim.fence.scope)).await? else {
+            return Ok(Evidence::NotApplied);
+        };
+        let request = ActionDispatchRequest {
+            subject: call.subject()?,
+            fence: claim.fence,
+            lease: policy,
+        };
+        if let Some(wait) = decisions::approvals::parked(&mut tx, &request).await? {
+            return Ok(Evidence::Applied(contract::LocalRunProgress::Suspended(
+                wait,
+            )));
+        }
+        if let Some(wait) = call.wait_id
+            && continuation::confirm_on(&mut tx, claim.fence, wait).await?
+        {
+            return Ok(Evidence::Applied(contract::LocalRunProgress::Suspended(
+                WaitId::new(wait),
+            )));
+        }
+        let action = call.action()?;
+        // A saved receipt proves COMMIT. Return it only under the current claim and live
+        // action/resource authority; a historical marker alone never authorizes its output.
+        let saved = continuation::saved_result_on(&mut tx, &request, &action).await?;
+        if let Some(saved) = saved {
+            let authorized = dispatch
+                .authorize_prelocked_on(&mut tx, &request, bound.server_timeout(), actor)
+                .await?;
+            if authorized.approval_required {
+                return Err(conflict());
+            }
+            return Ok(Evidence::Applied(saved));
+        }
+        Ok(Evidence::NotApplied)
+    }
+    .await;
+    bound.roll_back(tx, proof).await
+}
