index 00000000..42b4c8cf
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/connector.ts
@@ -0,0 +1,167 @@
+import WebSocket from 'ws';
+import { setTimeout as delay } from 'node:timers/promises';
+import { Dispatcher } from './dispatcher.js';
+import { ConfigurationRequired, type Paired } from './enrollment.js';
+import { RecoveryRequired } from './journal.js';
+import { encodeFrames, FrameAssembler, LIMITS, observationSequence, parseServer,
+  type Delivery, type Identity, type Observation } from './protocol.js';
+
+export type ConnectionStatus = 'offline' | 'connecting' | 'recovering' | 'connected' | 'authorization_required';
+type Work = { delivery: Delivery; allowed: () => boolean; reply: (value: Observation) => void };
+
+// The dispatcher outlives a socket. Network loss must not abandon native tracking
+// or turn an ambiguous mutation into permission to submit it again.
+export class Connector {
+  readonly dispatcher: Dispatcher;
+  status: ConnectionStatus = 'offline';
+  private readonly queue = new Map<string, Work>();
+  constructor(dispatcher: Dispatcher) { this.dispatcher = dispatcher; }
+
+  async run(paired: Paired, signal: AbortSignal): Promise<void> {
+    const stop = new AbortController(); const lifetime = AbortSignal.any([signal, stop.signal]);
+    const worker = this.work(lifetime).catch(error => { stop.abort(error); throw error; });
+    // Attach immediately: cleanup always joins the worker, including a failure
+    // while the network loop is inside a handshake or reconnect delay.
+    void worker.catch(() => {});
+    try {
+      let attempt = 0;
+      while (!lifetime.aborted) {
+        try { await this.connect(paired, lifetime); attempt = 0; }
+        catch (error) {
+          if (lifetime.aborted) break;
+          if (error instanceof ConfigurationRequired || error instanceof RecoveryRequired) throw error;
+        }
+        if (!lifetime.aborted) {
+          this.status = 'offline';
+          await delay(Math.min(30_000, 500 * 2 ** Math.min(attempt++, 6)) * (0.75 + Math.random() * 0.5), undefined, { signal: lifetime });
+        }
+      }
+    } catch (error) { if (!lifetime.aborted) throw error; }
+    finally { stop.abort(); await worker; this.queue.clear(); if (this.status !== 'authorization_required') this.status = 'offline'; }
+  }
+
+  private async work(signal: AbortSignal): Promise<void> {
+    try {
+      while (!signal.aborted) {
+        const next = this.queue.entries().next().value as [string, Work] | undefined;
+        if (next) {
+          const [id, work] = next;
+          try {
+            const cached = await this.dispatcher.process(work.delivery, { signal, canDispatch: work.allowed });
+            if (cached) work.reply(cached);
+          } finally { this.queue.delete(id); }
+        } else {
+          await this.dispatcher.tick(signal);
+          await delay(250, undefined, { signal });
+        }
+      }
+    } catch (error) { if (!signal.aborted) throw error; }
+  }
+
+  private async connect(paired: Paired, signal: AbortSignal): Promise<void> {
+    this.status = 'connecting';
+    const journal = this.dispatcher.journal; const binding = paired.binding;
+    const endpoint = new URL('/v1/local-machines/connect', binding.origin); endpoint.protocol = 'wss:';
+    const socket = new WebSocket(endpoint, { headers: { authorization: `Bearer ${paired.credential}`,
+      'x-openbot-installation-id': binding.installation_id, 'x-openbot-protocol-version': '1' },
+      followRedirects: false, handshakeTimeout: LIMITS.handshakeMs, maxPayload: LIMITS.frame, perMessageDeflate: false });
+    let identity: Identity | undefined; let allowed = false; let active = true;
+    let lastReceived = performance.now(); let sent = journal.acknowledged();
+    let frames = 0; let window = performance.now(); let failure: unknown;
+    const assembler = new FrameAssembler(); const cached: Observation[] = [];
+    const stop = new AbortController(); const connected = AbortSignal.any([signal, stop.signal]);
+    const fail = (error: unknown) => { failure ??= error; allowed = false; stop.abort(); socket.terminate(); };
+    const abort = () => fail(signal.reason ?? new Error('connector stopped'));
+    signal.addEventListener('abort', abort, { once: true });
+    socket.on('error', () => fail(new Error('Openbot connection failed')));
+    socket.on('close', () => fail(new Error('Openbot connection closed')));
+    socket.on('unexpected-response', (_request, response) => {
+      response.destroy();
+      if (response.statusCode === 401 || response.statusCode === 403) {
+        this.status = 'authorization_required'; fail(new ConfigurationRequired('Machine authorization rejected; repair pairing'));
+      } else fail(new Error('Openbot handshake rejected'));
+    });
+    socket.on('ping', () => { lastReceived = performance.now(); });
+    socket.on('pong', () => { lastReceived = performance.now(); });
+    socket.on('message', (data, binary) => {
+      try {
+        if (!active || binary) throw new Error('expected text frame');
+        if (performance.now() - window >= 60_000) { frames = 0; window = performance.now(); }
+        if (++frames > 1024) throw new Error('incoming frame budget exhausted');
+        lastReceived = performance.now();
+        const value = assembler.push(Buffer.isBuffer(data) ? data : Buffer.concat(Array.isArray(data) ? data : [Buffer.from(data)]));
+        if (value === undefined) return;
+        const message = parseServer(value);
+        if (message.kind === 'welcome') {
+          if (identity || message.welcome.identity.installation_id !== binding.installation_id
+              || message.welcome.identity.credential_generation !== binding.credential_generation) throw new RecoveryRequired();
+          if (message.welcome.recovery_required) { journal.requireRecovery(); throw new RecoveryRequired(); }
+          journal.acknowledge(message.welcome.acknowledged_sequence);
+          identity = message.welcome.identity; sent = journal.acknowledged(); this.status = 'recovering';
+        } else {
+          if (!identity || JSON.stringify(message.identity) !== JSON.stringify(identity)) throw new Error('stale connection identity');
+          if (message.kind === 'acknowledged') journal.acknowledge(message.through);
+          if (message.kind === 'ready') {
+            allowed = message.ready && !journal.recoveryRequired(); this.status = allowed ? 'connected' : 'recovering';
+          }
+          if (message.kind === 'command') {
+            const id = message.delivery.operation.id; const existing = this.queue.get(id);
+            if (existing) {
+              if (existing.delivery.operation.payload_digest !== message.delivery.operation.payload_digest) throw new Error('operation identity conflict');
+              return;
+            }
+            const effect = ['create', 'send'].includes(message.delivery.operation.command.kind);
+            if (this.queue.size >= (effect ? LIMITS.queued - LIMITS.controls : LIMITS.queued)) throw new Error('incoming command capacity');
+            this.queue.set(id, { delivery: message.delivery, allowed: () => active && allowed,
+              reply: value => { if (active && cached.length < LIMITS.queued) cached.push(value); } });
+          }
+        }
+      } catch (error) { fail(error); }
+    });
+    const write = async (message: unknown) => {
+      for (const frame of encodeFrames(message)) {
+        connected.throwIfAborted();
+        await new Promise<void>((resolve, reject) => {
+          const cancel = () => { cleanup(); reject(new Error('socket write cancelled')); };
+          const timer = setTimeout(() => { cleanup(); reject(new Error('socket write timed out')); socket.terminate(); }, LIMITS.ioMs);
+          const cleanup = () => { clearTimeout(timer); connected.removeEventListener('abort', cancel); };
+          connected.addEventListener('abort', cancel, { once: true });
+          socket.send(frame, error => { cleanup(); if (error) reject(new Error('socket write failed')); else resolve(); });
+        });
+      }
+    };
+    try {
+      const opened = performance.now();
+      while (socket.readyState === WebSocket.CONNECTING) await delay(10, undefined, { signal: connected });
+      connected.throwIfAborted();
+      await write({ kind: 'hello', hello: { version: 1, installation_id: binding.installation_id,
+        journal_id: binding.journal_id, journal_sequence: journal.sequence() } });
+      while (!identity) {
+        if (performance.now() - opened >= LIMITS.handshakeMs) throw new Error('welcome timed out');
+        await delay(10, undefined, { signal: connected });
+      }
+      let heartbeat = 0; let ready = 0;
+      while (!connected.aborted) {
+        assembler.expire();
+        const now = performance.now();
+        if (now - lastReceived >= 45_000) throw new Error('Openbot heartbeat expired');
+        if (now - heartbeat >= LIMITS.heartbeatMs) { await write({ kind: 'heartbeat', identity }); heartbeat = now; }
+        const observations = journal.outbox(sent);
+        for (const observation of observations) {
+          // Keep at most one bounded page unacknowledged on this transport.
+          if (sent - journal.acknowledged() >= LIMITS.queued) break;
+          await write({ kind: 'observation', identity, observation }); sent = observationSequence(observation);
+        }
+        for (const observation of cached.splice(0)) await write({ kind: 'observation', identity, observation });
+        if (sent === journal.sequence() && journal.acknowledged() === sent && now - ready >= 500) {
+          await write({ kind: 'ready', identity }); ready = now;
+        }
+        await delay(25, undefined, { signal: connected });
+      }
+    } catch (error) { throw failure ?? error; }
+    finally {
+      active = false; allowed = false; stop.abort(); signal.removeEventListener('abort', abort);
+      socket.terminate();
+    }
+  }
+}
diff --git a/integrations/cloudroom-plugin/src/dispatcher.ts b/integrations/cloudroom-plugin/src/dispatcher.ts
new file mode 100644
index 00000000..07e4b332
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/dispatcher.ts
@@ -0,0 +1,87 @@
+import { Journal, type CommandRecord } from './journal.js';
+import { CloudroomSdk, PreflightRefusal, sdkSignal } from './sdk.js';
+import { isEffect, LIMITS, observationSequence, type Delivery, type Observation, type Refusal } from './protocol.js';
+export type DispatchContext = { signal: AbortSignal; canDispatch: () => boolean };
+
+export class Dispatcher {
+  readonly journal: Journal; readonly sdk: CloudroomSdk;
+  constructor(journal: Journal, sdk: CloudroomSdk) { this.journal = journal; this.sdk = sdk; }
+  private cached(record: CommandRecord): Observation | undefined {
+    return record.lastObservation && observationSequence(record.lastObservation) <= this.journal.acknowledged()
+      ? record.lastObservation : undefined;
+  }
+  private refuse(record: CommandRecord, reason: Refusal): void {
+    record.stage = 'terminal'; this.journal.evidence(record, { kind: 'refused', reason }, 'terminal');
+  }
+  private uncertain(record: CommandRecord): void {
+    if (record.stage === 'terminal') return;
+    record.stage = isEffect(record.operation.command) ? 'uncertain' : 'terminal';
+    const old = record.lastObservation;
+    if (old?.kind === 'agent' && old.observation.evidence.kind === 'uncertain') { this.journal.save(record); return; }
+    this.journal.evidence(record, { kind: 'uncertain' }, record.stage === 'terminal' ? 'terminal' : 'critical');
+  }
+  private blocked(record: CommandRecord, context: DispatchContext): Refusal | undefined {
+    if (Date.parse(record.operation.deadline) <= Date.now()) return 'expired';
+    if (this.journal.recoveryRequired() || !context.canDispatch() || context.signal.aborted) return 'recovery_required';
+    const counts = this.journal.capacity(); const effect = isEffect(record.operation.command);
+    if (counts.queued > (effect ? LIMITS.queued - LIMITS.controls : LIMITS.queued)
+        || (effect && counts.effects > LIMITS.effects)) return 'capacity';
+    return undefined;
+  }
+  async process(delivery: Delivery, context: DispatchContext): Promise<Observation | undefined> {
+    const admitted = this.journal.admit(delivery); const record = admitted.record;
+    if (record.stage === 'terminal') return this.cached(record);
+    const command = record.operation.command;
+    try {
+      if (command.kind === 'refresh_catalog' && record.sdkCalls === 0) {
+        this.journal.catalog(record, await this.sdk.catalog(sdkSignal(context.signal)));
+      } else if (command.kind === 'inspect' && record.sdkCalls === 0) {
+        await this.sdk.prepare(record, sdkSignal(context.signal));
+        const state = await this.sdk.inspect(command.thread_id, sdkSignal(context.signal));
+        if (state) this.journal.control(record, command.thread_id, { kind: 'snapshot', state });
+        else this.uncertain(record);
+      } else if (record.sdkCalls !== 0) {
+        await this.reconcile(record, context.signal);
+      } else if (delivery.mode === 'reconcile' || record.stage !== 'received') {
+        if (record.stage === 'received') this.refuse(record, 'recovery_required');
+      } else {
+        const blocked = this.blocked(record, context);
+        if (blocked) { this.refuse(record, blocked); return this.cached(record); }
+        const prepared = await this.sdk.prepare(record, sdkSignal(context.signal));
+        await this.sdk.baseline(record, sdkSignal(context.signal));
+        const withdrawn = this.blocked(record, context);
+        if (withdrawn) { this.refuse(record, withdrawn); return this.cached(record); }
+        this.journal.beginIntent(record);
+        const signal = sdkSignal(context.signal);
+        signal.throwIfAborted();
+        await this.sdk.mutate(record, prepared, signal);
+      }
+    } catch (error) {
+      // Reload current durable state: a failed local commit after SDK acceptance is
+      // still an intent gap, never permission to repeat the SDK call.
+      const current = this.journal.get(record.operation.id)!;
+      if (current.stage !== 'terminal') {
+        if (current.sdkCalls === 0 && current.stage === 'received') {
+          this.refuse(current, error instanceof PreflightRefusal ? error.reason : 'provider_unavailable');
+        } else this.uncertain(current);
+      }
+    }
+    return this.cached(this.journal.get(record.operation.id)!);
+  }
+  private async reconcile(record: CommandRecord, signal: AbortSignal): Promise<void> {
+    if (!isEffect(record.operation.command)) { this.uncertain(record); return; }
+    const update = await this.sdk.poll(record, sdkSignal(signal));
+    if (update.kind === 'uncertain') { this.uncertain(update.record); return; }
+    if (update.evidence && update.kind !== 'unchanged') {
+      this.journal.evidence(update.record, update.evidence, update.kind === 'terminal' ? 'terminal' : 'progress');
+    } else this.journal.save(update.record);
+  }
+  async tick(signal: AbortSignal): Promise<void> {
+    for (const record of this.journal.pending()) {
+      if (signal.aborted) break;
+      if (record.sdkCalls !== 1 || !isEffect(record.operation.command)) continue;
+      try { await this.reconcile(record, signal); }
+      catch { this.uncertain(this.journal.get(record.operation.id)!); }
+    }
+  }
+}
diff --git a/integrations/cloudroom-plugin/src/enrollment.ts b/integrations/cloudroom-plugin/src/enrollment.ts
new file mode 100644
index 00000000..bdbd4f7e
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/enrollment.ts
@@ -0,0 +1,152 @@
+import type { BbPluginApi } from '@get-bb/plugin-sdk';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { z } from 'zod';
+import { Journal, RecoveryRequired, bindingSchema, type Binding } from './journal.js';
+import { external, LIMITS, sha256, uuid } from './protocol.js';
+
+export const settingDescriptors = {
+  openbotOrigin: { type: 'string', label: 'Openbot HTTPS origin' },
+  machineName: { type: 'string', label: 'Machine name', default: 'Local machine' },
+  selectedProjects: { type: 'string', label: 'Selected project IDs', description: 'One local project ID per line.', experimental_multiline: true, default: '' },
+  pairingCode: { type: 'string', label: 'Pairing code', secret: true },
+  enrollment: { type: 'string', label: 'Connection credential (managed automatically)', secret: true },
+} as const;
+export function defineSettings(bb: Pick<BbPluginApi, 'settings'>) { return bb.settings.define(settingDescriptors); }
+export type SettingsHandle = ReturnType<typeof defineSettings>;
+export type SettingsStore = Pick<SettingsHandle, 'get' | 'experimental_set'>;
+export class ConfigurationRequired extends Error {
+  constructor(message: string) { super(message); this.name = 'NeedsConfigurationError'; }
+}
+const secret = z.string().regex(/^[0-9a-f]{64}$/);
+const nameSchema = z.string().refine(value => value.trim().length > 0 && Buffer.byteLength(value) <= 128 && !/[\p{Cc}]/u.test(value));
+const requestSchema = z.object({ code: z.string().regex(/^[0-9a-f]{32}$/), installation_id: uuid,
+  name: nameSchema, claim_verifier: secret, credential_verifier: secret }).strict();
+const pendingSchema = z.object({ state: z.literal('pending'), version: z.literal(1), origin: z.string(),
+  installation_id: uuid, journal_id: uuid, claim_secret: secret, credential: secret, request: requestSchema }).strict();
+const pairedSchema = z.object({ state: z.literal('paired'), version: z.literal(1), binding: bindingSchema, credential: secret }).strict();
+export const enrollmentSchema = z.discriminatedUnion('state', [pendingSchema, pairedSchema]);
+export type Paired = z.infer<typeof pairedSchema>;
+type Pending = z.infer<typeof pendingSchema>;
+const receiptSchema = z.object({ company_id: uuid, company_name: z.string().max(8192),
+  machine: z.object({ id: uuid, company_id: uuid, installation_id: uuid, name: nameSchema,
+    state: z.enum(['enabled', 'disabled', 'revoked']), credential_generation: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+    last_seen_at: z.string().nullable(), capabilities_sequence: z.number().int().positive().max(Number.MAX_SAFE_INTEGER).nullable() }).strict() }).strict();
+
+export function canonicalOrigin(value: string | undefined): string {
+  if (!value || value.length > 2048) throw new ConfigurationRequired('Configure the Openbot HTTPS origin');
+  let url: URL;
+  try { url = new URL(value); } catch { throw new ConfigurationRequired('Configure a valid Openbot HTTPS origin'); }
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash || url.pathname !== '/') {
+    throw new ConfigurationRequired('Openbot origin must use HTTPS without credentials, path or query');
+  }
+  return url.origin;
+}
+export function selectedProjects(value: string): string[] {
+  if (Buffer.byteLength(value) > LIMITS.projects * 130) throw new ConfigurationRequired('Too many selected projects');
+  const ids = value.split(/\r?\n/).map(value => value.trim()).filter(Boolean);
+  if (ids.length > LIMITS.projects || new Set(ids).size !== ids.length || !ids.every(value => external.safeParse(value).success)) {
+    throw new ConfigurationRequired('Select at most 128 unique local project IDs');
+  }
+  return ids;
+}
+async function readBoundedBody(response: Response, limit: number): Promise<Buffer> {
+  if (!response.body) return Buffer.alloc(0);
+  const declared = Number(response.headers.get('content-length'));
+  if (declared > limit) { await response.body.cancel(); throw new Error('HTTP response bound'); }
+  const reader = response.body.getReader(); const parts: Uint8Array[] = []; let bytes = 0;
+  try {
+    while (true) {
+      const result = await reader.read();
+      if (result.done) break;
+      bytes += result.value.byteLength;
+      if (bytes > limit) throw new Error('HTTP response bound');
+      parts.push(result.value);
+    }
+    return Buffer.concat(parts);
+  } catch (error) { await reader.cancel().catch(() => {}); throw error; }
+  finally { reader.releaseLock(); }
+}
+export async function readBoundedJson(response: Response, limit: number): Promise<unknown> {
+  return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await readBoundedBody(response, limit)));
+}
+function validatePending(value: Pending): void {
+  if (canonicalOrigin(value.origin) !== value.origin || value.request.installation_id !== value.installation_id
+      || sha256(value.claim_secret) !== value.request.claim_verifier || sha256(value.credential) !== value.request.credential_verifier) {
+    throw new RecoveryRequired();
+  }
+}
+async function currentCandidate(settings: SettingsStore, candidate: Pending): Promise<void> {
+  const current = await settings.get();
+  if (canonicalOrigin(current.openbotOrigin) !== candidate.origin || current.enrollment !== JSON.stringify(candidate)) {
+    throw new ConfigurationRequired('Pairing settings changed; restore the approved origin or repair pairing');
+  }
+}
+async function exchange(settings: SettingsStore, journal: Journal, candidate: Pending, signal: AbortSignal, fetcher: typeof fetch) {
+  await currentCandidate(settings, candidate);
+  signal.throwIfAborted();
+  const bounded = AbortSignal.any([signal, AbortSignal.timeout(LIMITS.handshakeMs)]);
+  const status = await fetcher(`${candidate.origin}/v1/local-machines/pair-status`, { redirect: 'error', signal: bounded,
+    headers: { 'x-openbot-pair-claim': candidate.claim_secret, 'x-openbot-installation-id': candidate.installation_id } });
+  if (status.ok) return receiptSchema.parse(await readBoundedJson(status, 16 * 1024));
+  await status.body?.cancel();
+  if (status.status !== 401 && status.status !== 404) throw new Error('pairing status unavailable');
+  await currentCandidate(settings, candidate);
+  signal.throwIfAborted();
+  const enrolled = await fetcher(`${candidate.origin}/v1/local-machines/pair`, { method: 'POST', redirect: 'error', signal: bounded,
+    headers: { 'content-type': 'application/json' }, body: JSON.stringify(candidate.request) });
+  if (!enrolled.ok) {
+    // Only a completely received rejection disposes an initial candidate. A
+    // truncated/failed response retains its exact original recovery identity.
+    await readBoundedBody(enrolled, 16 * 1024);
+    if (enrolled.status === 400 || enrolled.status === 401 || enrolled.status === 403 || enrolled.status === 404) {
+      await currentCandidate(settings, candidate); signal.throwIfAborted();
+      if (journal.initialized()) throw new RecoveryRequired();
+      // Clear input before the authoritative candidate: an interruption between
+      // these separate secret writes cannot accidentally enroll the old code as
+      // a new installation. An ambiguous Pending record is never cleared here.
+      await settings.experimental_set({ pairingCode: null });
+      await currentCandidate(settings, candidate); signal.throwIfAborted();
+      await settings.experimental_set({ enrollment: null });
+      throw new ConfigurationRequired('Pairing was not accepted; enter a new pairing code to retry');
+    }
+    throw new Error('pairing unavailable');
+  }
+  return receiptSchema.parse(await readBoundedJson(enrolled, 16 * 1024));
+}
+export async function recoverEnrollment(settings: SettingsStore, journal: Journal, signal: AbortSignal,
+  fetcher: typeof fetch = fetch): Promise<Paired> {
+  const values = await settings.get(); const origin = canonicalOrigin(values.openbotOrigin);
+  let state: z.infer<typeof enrollmentSchema>;
+  if (values.enrollment === undefined) {
+    if (journal.initialized()) throw new RecoveryRequired();
+    const credential = randomBytes(32).toString('hex'); const claim_secret = randomBytes(32).toString('hex');
+    const installation_id = randomUUID(); const journal_id = randomUUID();
+    const request = requestSchema.safeParse({ code: values.pairingCode, installation_id, name: values.machineName,
+      claim_verifier: sha256(claim_secret), credential_verifier: sha256(credential) });
+    if (!request.success) throw new ConfigurationRequired('Enter a valid pairing code and machine name');
+    state = { state: 'pending', version: 1, origin, installation_id, journal_id, claim_secret, credential, request: request.data };
+    await settings.experimental_set({ enrollment: JSON.stringify(state) });
+  } else {
+    try { state = enrollmentSchema.parse(JSON.parse(values.enrollment)); } catch { throw new RecoveryRequired(); }
+  }
+  if (state.state === 'paired') {
+    if (origin !== state.binding.origin) throw new ConfigurationRequired('Approved Openbot origin changed; repair pairing explicitly');
+    journal.validateBinding(state.binding);
+    if (values.pairingCode !== undefined) await settings.experimental_set({ pairingCode: null });
+    return state;
+  }
+  validatePending(state);
+  if (origin !== state.origin) throw new ConfigurationRequired('Pending enrollment belongs to the original approved origin');
+  const receipt = await exchange(settings, journal, state, signal, fetcher);
+  if (receipt.company_id !== receipt.machine.company_id || receipt.machine.installation_id !== state.installation_id
+      || receipt.machine.state === 'revoked') throw new RecoveryRequired();
+  await currentCandidate(settings, state);
+  signal.throwIfAborted();
+  const binding: Binding = { origin, installation_id: state.installation_id, journal_id: state.journal_id,
+    machine_id: receipt.machine.id, company_id: receipt.company_id, credential_generation: receipt.machine.credential_generation };
+  journal.initialize(binding);
+  const paired: Paired = { state: 'paired', version: 1, binding, credential: state.credential };
+  await settings.experimental_set({ enrollment: JSON.stringify(paired) });
+  await settings.experimental_set({ pairingCode: null });
+  return paired;
+}
diff --git a/integrations/cloudroom-plugin/src/journal.ts b/integrations/cloudroom-plugin/src/journal.ts
new file mode 100644
index 00000000..3a872415
--- /dev/null
+++ b/integrations/cloudroom-plugin/src/journal.ts
@@ -0,0 +1,231 @@
+import type Database from 'better-sqlite3';
+import { z } from 'zod';
+import { catalogSchema, evidenceSchema, isEffect, LIMITS, nativeInput, observationSchema,
+  observationSequence, parseOperation, selectionSchema, turnState, external, uuid, type Catalog, type Delivery,
+  type Evidence, type Observation, type Operation, type Selection } from './protocol.js';
+
+export const JOURNAL_SCHEMA = [
+  `CREATE TABLE journal_meta(id INTEGER PRIMARY KEY CHECK(id=1),binding TEXT NOT NULL,
+    allocated INTEGER NOT NULL DEFAULT 0 CHECK(allocated>=0 AND allocated<=9007199254740991),
+    acknowledged INTEGER NOT NULL DEFAULT 0 CHECK(acknowledged>=0 AND acknowledged<=allocated),
+    recovery_required INTEGER NOT NULL DEFAULT 0 CHECK(recovery_required IN (0,1)))`,
+  `CREATE TABLE commands(id TEXT PRIMARY KEY,digest TEXT NOT NULL,state TEXT NOT NULL,
+    reserve INTEGER NOT NULL CHECK(reserve>=0),terminal INTEGER NOT NULL CHECK(terminal IN (0,1)))`,
+  `CREATE TABLE sessions(id TEXT PRIMARY KEY,thread_id TEXT NOT NULL UNIQUE,selection TEXT NOT NULL)`,
+  `CREATE TABLE outbox(sequence INTEGER PRIMARY KEY,operation_id TEXT NOT NULL REFERENCES commands(id),
+    payload TEXT NOT NULL,bytes INTEGER NOT NULL CHECK(bytes>0))`,
+];
+export const bindingSchema = z.object({ origin: z.string().url(), installation_id: uuid,
+  journal_id: uuid, machine_id: uuid, company_id: uuid, credential_generation: z.number().int().positive().max(Number.MAX_SAFE_INTEGER) }).strict();
+export type Binding = z.infer<typeof bindingSchema>;
+const stored = z.object({ operation: z.unknown().transform(parseOperation),
+  stage: z.enum(['received', 'intent', 'observing', 'uncertain', 'terminal']),
+  sdkInput: z.string().max(LIMITS.prompt + 57), sdkCalls: z.number().int().min(0).max(1),
+  threadId: external.nullable(), requestId: external.nullable(),
+  turnId: external.nullable(), queueId: external.nullable(),
+  cursor: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
+  items: z.array(z.object({ id: z.string().max(128), text: z.string() }).strict()).max(1024),
+  truncated: z.boolean(), correlationConflict: z.boolean(), nativeState: turnState.nullable(),
+  usage: z.object({ input_tokens: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
+    output_tokens: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER) }).strict().nullable(),
+  lastObservation: observationSchema.nullable(),
+}).strict().refine(value => value.items.reduce((sum, item) => sum + Buffer.byteLength(item.text), 0) <= LIMITS.output);
+export type CommandRecord = z.infer<typeof stored>;
+export type Importance = 'progress' | 'critical' | 'terminal';
+type Row = { id: string; digest: string; state: string; reserve: number; terminal: number };
+type Meta = { binding: string; allocated: number; acknowledged: number; recovery_required: number };
+export class RecoveryRequired extends Error { constructor() { super('local journal recovery required'); } }
+export class JournalCapacity extends Error { constructor() { super('local journal capacity reached'); } }
+
+export class Journal {
+  readonly db: Database.Database;
+  constructor(db: Database.Database) {
+    this.db = db;
+    db.pragma('foreign_keys = ON');
+    db.pragma('synchronous = FULL');
+    if (db.pragma('synchronous', { simple: true }) !== 2) throw new Error('durable journal unavailable');
+  }
+  initialize(binding: Binding): void {
+    const exact = bindingSchema.parse(binding);
+    this.db.transaction(() => {
+      const old = this.db.prepare('SELECT binding FROM journal_meta WHERE id=1').get() as { binding: string } | undefined;
+      if (old) { if (old.binding !== JSON.stringify(exact)) throw new RecoveryRequired(); return; }
+      const residue = this.db.prepare('SELECT (SELECT count(*) FROM commands)+(SELECT count(*) FROM outbox)+(SELECT count(*) FROM sessions) AS count').get() as { count: number };
+      if (residue.count !== 0) throw new RecoveryRequired();
+      this.db.prepare('INSERT INTO journal_meta(id,binding) VALUES(1,?)').run(JSON.stringify(exact));
+    })();
+  }
+  private meta(): Meta {
+    const meta = this.db.prepare('SELECT binding,allocated,acknowledged,recovery_required FROM journal_meta WHERE id=1').get() as Meta | undefined;
+    if (!meta) throw new RecoveryRequired();
+    bindingSchema.parse(JSON.parse(meta.binding));
+    if (!Number.isSafeInteger(meta.allocated) || meta.acknowledged > meta.allocated || meta.acknowledged < 0) throw new RecoveryRequired();
+    return meta;
+  }
+  initialized(): boolean { return Boolean(this.db.prepare('SELECT 1 FROM journal_meta WHERE id=1').get()); }
+  binding(): Binding { return bindingSchema.parse(JSON.parse(this.meta().binding)); }
+  validateBinding(binding: Binding): void { if (JSON.stringify(this.binding()) !== JSON.stringify(bindingSchema.parse(binding))) throw new RecoveryRequired(); }
+  sequence(): number { return this.meta().allocated; }
+  acknowledged(): number { return this.meta().acknowledged; }
+  recoveryRequired(): boolean { return this.meta().recovery_required !== 0; }
+  requireRecovery(): void { this.db.prepare('UPDATE journal_meta SET recovery_required=1 WHERE id=1').run(); }
+  private row(id: string): Row | undefined {
+    return this.db.prepare('SELECT id,digest,state,reserve,terminal FROM commands WHERE id=?').get(id) as Row | undefined;
+  }
+  get(id: string): CommandRecord | undefined {
+    const row = this.row(id);
+    if (!row) return undefined;
+    const record = stored.parse(JSON.parse(row.state));
+    if (record.operation.id !== row.id || record.operation.payload_digest !== row.digest
+        || (record.stage === 'terminal') !== Boolean(row.terminal)
+        || record.sdkInput !== (isEffect(record.operation.command) ? nativeInput(record.operation) : '')) throw new RecoveryRequired();
+    return record;
+  }
+  private budget(): { used: number; reserved: number } {
+    return this.db.prepare('SELECT COALESCE((SELECT sum(bytes) FROM outbox),0) AS used,COALESCE((SELECT sum(reserve) FROM commands),0) AS reserved').get() as { used: number; reserved: number };
+  }
+  private append(record: CommandRecord, observation: Observation, importance: Importance): void {
+    const row = this.row(record.operation.id);
+    if (!row || row.digest !== record.operation.payload_digest) throw new RecoveryRequired();
+    const exact = observationSchema.parse(observation);
+    if ((importance === 'terminal') !== (record.stage === 'terminal')) throw new RecoveryRequired();
+    const meta = this.meta();
+    if (meta.allocated >= Number.MAX_SAFE_INTEGER || observationSequence(exact) !== meta.allocated + 1) throw new JournalCapacity();
+    const payload = JSON.stringify(exact); const bytes = Buffer.byteLength(payload);
+    if (bytes > LIMITS.logical - 256) throw new JournalCapacity();
+    const budget = this.budget();
+    let reserve = row.reserve;
+    if (importance === 'progress') {
+      if (budget.used + budget.reserved + bytes > LIMITS.outbox) { this.write(record); return; }
+    } else {
+      if (bytes > reserve) throw new JournalCapacity();
+      reserve = importance === 'terminal' ? 0 : reserve - bytes;
+    }
+    if (budget.used + bytes + budget.reserved - row.reserve + reserve > LIMITS.outbox) throw new JournalCapacity();
+    this.db.prepare('INSERT INTO outbox(sequence,operation_id,payload,bytes) VALUES(?,?,?,?)').run(meta.allocated + 1, record.operation.id, payload, bytes);
+    this.db.prepare('UPDATE journal_meta SET allocated=? WHERE id=1').run(meta.allocated + 1);
+    record.lastObservation = exact;
+    this.write(record, reserve);
+  }
+  private write(record: CommandRecord, reserve?: number): void {
+    const exact = stored.parse(record);
+    const old = this.row(exact.operation.id);
+    if (!old || old.digest !== exact.operation.payload_digest) throw new RecoveryRequired();
+    const previous = stored.parse(JSON.parse(old.state));
+    if ((old.terminal && exact.stage !== 'terminal') || previous.sdkCalls > exact.sdkCalls
+        || previous.sdkInput !== exact.sdkInput || previous.cursor > exact.cursor
+        || (previous.correlationConflict && !exact.correlationConflict)
+        || (previous.threadId !== null && previous.threadId !== exact.threadId)
+        || (previous.requestId !== null && previous.requestId !== exact.requestId)
+        || (previous.turnId !== null && previous.turnId !== exact.turnId)) throw new RecoveryRequired();
+    this.db.prepare('UPDATE commands SET state=?,terminal=?,reserve=? WHERE id=?').run(JSON.stringify(exact),
+      Number(exact.stage === 'terminal'), exact.stage === 'terminal' ? 0 : (reserve ?? old.reserve), exact.operation.id);
+  }
+  admit(delivery: Delivery): { record: CommandRecord; fresh: boolean } {
+    const operation = parseOperation(delivery.operation);
+    return this.db.transaction(() => {
+      const old = this.get(operation.id);
+      if (old) {
+        if (old.operation.payload_digest !== operation.payload_digest) throw new Error('operation identity conflict');
+        return { record: old, fresh: false };
+      }
+      const count = this.db.prepare('SELECT count(*) AS count FROM commands').get() as { count: number };
+      const budget = this.budget();
+      if (count.count >= LIMITS.history || budget.used + budget.reserved + LIMITS.terminalReserve > LIMITS.outbox) throw new JournalCapacity();
+      const record: CommandRecord = { operation, stage: 'received', sdkInput: isEffect(operation.command) ? nativeInput(operation) : '',
+        sdkCalls: 0, threadId: null, requestId: null, turnId: null, queueId: null, cursor: 0,
+        items: [], truncated: false, correlationConflict: false, nativeState: null, usage: null, lastObservation: null };
+      this.db.prepare('INSERT INTO commands(id,digest,state,reserve,terminal) VALUES(?,?,?,?,0)').run(operation.id, operation.payload_digest,
+        JSON.stringify(record), LIMITS.terminalReserve);
+      this.append(record, { kind: 'agent', observation: { sequence: this.sequence() + 1,
+        operation_id: operation.id, evidence: { kind: 'receipt' } } }, 'critical');
+      if (delivery.mode === 'reconcile' || operation.outcome !== null || operation.dispatch.kind !== 'not_dispatched') {
+        this.requireRecovery();
+        record.stage = 'uncertain';
+        this.append(record, { kind: 'agent', observation: { sequence: this.sequence() + 1,
+          operation_id: operation.id, evidence: { kind: 'uncertain' } } }, 'critical');
+      }
+      return { record, fresh: true };
+    })();
+  }
+  save(record: CommandRecord): void {
+    this.db.transaction(() => {
+      if (record.stage === 'terminal' && !this.row(record.operation.id)?.terminal) throw new RecoveryRequired();
+      this.write(record);
+    })();
+  }
+  evidence(record: CommandRecord, evidence: Evidence, importance: Importance): void {
+    this.db.transaction(() => {
+      evidenceSchema.parse(evidence);
+      if (evidence.kind === 'refused' && record.sdkCalls !== 0) throw new RecoveryRequired();
+      this.append(record, { kind: 'agent', observation: { sequence: this.sequence() + 1,
+        operation_id: record.operation.id, evidence } }, importance);
+    })();
+  }
+  beginIntent(record: CommandRecord): void {
+    this.db.transaction(() => {
+      const current = this.get(record.operation.id);
+      if (!current || current.stage !== 'received' || current.sdkCalls !== 0) throw new RecoveryRequired();
+      record.stage = 'intent'; record.sdkCalls = 1;
+      this.evidence(record, { kind: 'submission_intent' }, 'critical');
+    })();
+  }
+  catalog(record: CommandRecord, catalog: Catalog): void {
+    this.db.transaction(() => {
+      record.stage = 'terminal';
+      this.append(record, { kind: 'catalog', sequence: this.sequence() + 1,
+        operation_id: record.operation.id, catalog: catalogSchema.parse(catalog) }, 'terminal');
+    })();
+  }
+  control(record: CommandRecord, thread_id: string, evidence: Extract<Observation, { kind: 'control' }>['evidence']): void {
+    this.db.transaction(() => {
+      record.stage = 'terminal';
+      this.append(record, { kind: 'control', sequence: this.sequence() + 1,
+        operation_id: record.operation.id, thread_id, evidence }, 'terminal');
+    })();
+  }
+  bindSession(session: string, thread: string, selection: Selection): void {
+    this.db.transaction(() => {
+      const exact = selectionSchema.parse(selection);
+      external.parse(thread);
+      if (exact.machine_id !== this.binding().machine_id) throw new RecoveryRequired();
+      const old = this.session(session);
+      if (old) { if (old.threadId !== thread || JSON.stringify(old.selection) !== JSON.stringify(exact)) throw new RecoveryRequired(); return; }
+      const count = this.db.prepare('SELECT count(*) AS count FROM sessions').get() as { count: number };
+      if (count.count >= LIMITS.history) throw new JournalCapacity();
+      this.db.prepare('INSERT INTO sessions(id,thread_id,selection) VALUES(?,?,?)').run(uuid.parse(session), thread, JSON.stringify(exact));
+    })();
+  }
+  session(id: string): { threadId: string; selection: Selection } | undefined {
+    const row = this.db.prepare('SELECT thread_id,selection FROM sessions WHERE id=?').get(id) as { thread_id: string; selection: string } | undefined;
+    return row ? { threadId: external.parse(row.thread_id), selection: selectionSchema.parse(JSON.parse(row.selection)) } : undefined;
+  }
+  submission(record: CommandRecord, selection: Selection, state: 'accepted' | 'queued' | 'missing'): void {
+    this.db.transaction(() => {
+      if (!record.threadId || !('session_id' in record.operation.command)) throw new RecoveryRequired();
+      this.bindSession(record.operation.command.session_id, record.threadId, selection);
+      record.stage = state === 'missing' ? 'uncertain' : 'observing';
+      this.evidence(record, { kind: 'submission', thread_id: record.threadId, state }, 'critical');
+    })();
+  }
+  pending(): CommandRecord[] {
+    const rows = this.db.prepare('SELECT id FROM commands WHERE terminal=0 ORDER BY rowid LIMIT ?').all(LIMITS.queued) as { id: string }[];
+    return rows.map(row => this.get(row.id)!);
+  }
+  capacity(): { effects: number; queued: number } {
+    const pending = this.pending();
+    return { queued: pending.length, effects: pending.filter(record => isEffect(record.operation.command)).length };
+  }
+  outbox(after = this.acknowledged()): Observation[] {
+    const rows = this.db.prepare('SELECT payload FROM outbox WHERE sequence>? ORDER BY sequence LIMIT ?').all(after, LIMITS.queued) as { payload: string }[];
+    return rows.map(row => observationSchema.parse(JSON.parse(row.payload)));
+  }
+  acknowledge(through: number): void {
+    this.db.transaction(() => {
+      const meta = this.meta();
+      if (!Number.isSafeInteger(through) || through < meta.acknowledged || through > meta.allocated) throw new RecoveryRequired();
+      this.db.prepare('UPDATE journal_meta SET acknowledged=? WHERE id=1').run(through);
+      this.db.prepare('DELETE FROM outbox WHERE sequence<=?').run(through);
+    })();
+  }
+}
