index 00000000..94b52608
--- /dev/null
+++ b/src/adapters/persistence/local_agents/protocol/submission_tests.rs
@@ -0,0 +1,263 @@
+use super::{test_support::*, *};
+
+fn submitted(
+    sequence: u64,
+    id: OperationId,
+    thread: &str,
+    state: SubmissionState,
+) -> JournalObservation {
+    agent(
+        sequence,
+        id,
+        LocalEvidence::Submission {
+            thread_id: CloudroomThreadId::try_from(thread.to_owned()).unwrap(),
+            state,
+        },
+    )
+}
+
+async fn intent(c: &Context, operation: &LocalAgentOperation) {
+    c.f.persistence.pending_commands(c.fence).await.unwrap();
+    for observation in [
+        agent(3, operation.id(), LocalEvidence::Receipt {}),
+        agent(4, operation.id(), LocalEvidence::SubmissionIntent {}),
+    ] {
+        c.f.persistence
+            .accept_observation(c.fence, &observation)
+            .await
+            .unwrap();
+    }
+}
+
+#[tokio::test]
+async fn cloudroom_submission_queued_thread_maps_once_without_completing_native_work() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let session = c.unmapped_session().await;
+    let create = c.create(session);
+    let operation =
+        c.f.persistence
+            .enqueue_operation(&c.admission(create))
+            .await
+            .unwrap();
+    intent(&c, &operation).await;
+    let queued = submitted(5, operation.id(), "thr_queued", SubmissionState::Queued);
+    assert_eq!(
+        c.f.persistence
+            .accept_observation(c.fence, &queued)
+            .await
+            .unwrap(),
+        5
+    );
+    assert_eq!(
+        c.f.persistence
+            .accept_observation(c.fence, &queued)
+            .await
+            .unwrap(),
+        5
+    );
+    let stored =
+        c.f.persistence
+            .session(c.f.company, session)
+            .await
+            .unwrap()
+            .unwrap();
+    assert_eq!(stored.thread_id.unwrap().as_str(), "thr_queued");
+    let saved: (Option<String>, String, Value) = sqlx::query_as("SELECT outcome,observed_turn_state,dispatch FROM local_agent_operations WHERE company_id=$1 AND id=$2")
+        .bind(c.f.company).bind(operation.id().as_uuid()).fetch_one(&c.f.database.pool).await.unwrap();
+    assert_eq!(saved.0, None);
+    assert_eq!(saved.1, "queued");
+    assert!(saved.2["turn_id"].is_null());
+    let control = LocalCommand::StopThread {
+        session_id: session,
+        thread_id: CloudroomThreadId::try_from("thr_queued".to_owned()).unwrap(),
+    };
+    c.f.persistence
+        .enqueue_operation(&c.admission(control))
+        .await
+        .expect("explicit control can target the known queued thread");
+    assert!(matches!(
+        c.f.persistence
+            .accept_observation(
+                c.fence,
+                &submitted(6, operation.id(), "thr_other", SubmissionState::Accepted)
+            )
+            .await,
+        Err(AppError::BadRequest(_))
+    ));
+    let mut completed = turn(
+        6,
+        operation.id(),
+        "turn_after_queue",
+        TurnState::Completed,
+        Some("correct result"),
+    );
+    if let JournalObservation::Agent { observation } = &mut completed
+        && let LocalEvidence::Turn { thread_id, .. } = &mut observation.evidence
+    {
+        *thread_id = CloudroomThreadId::try_from("thr_queued".to_owned()).unwrap();
+    }
+    c.f.persistence
+        .accept_observation(c.fence, &completed)
+        .await
+        .unwrap();
+    let result: String = sqlx::query_scalar(
+        "SELECT outcome FROM local_agent_operations WHERE company_id=$1 AND id=$2",
+    )
+    .bind(c.f.company)
+    .bind(operation.id().as_uuid())
+    .fetch_one(&c.f.database.pool)
+    .await
+    .unwrap();
+    assert_eq!(result, "succeeded");
+}
+
+#[tokio::test]
+async fn cloudroom_submission_requires_intent_and_preserves_known_turn_and_foreign_binding() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let operation =
+        c.f.persistence
+            .enqueue_operation(&c.admission(c.send()))
+            .await
+            .unwrap();
+    c.f.persistence.pending_commands(c.fence).await.unwrap();
+    let accepted = submitted(3, operation.id(), "thr_frozen", SubmissionState::Accepted);
+    assert!(matches!(
+        c.f.persistence.accept_observation(c.fence, &accepted).await,
+        Err(AppError::BadRequest(_))
+    ));
+    for observation in [
+        agent(3, operation.id(), LocalEvidence::Receipt {}),
+        agent(4, operation.id(), LocalEvidence::SubmissionIntent {}),
+    ] {
+        c.f.persistence
+            .accept_observation(c.fence, &observation)
+            .await
+            .unwrap();
+    }
+    assert!(matches!(
+        c.f.persistence
+            .accept_observation(
+                c.fence,
+                &submitted(5, operation.id(), "thr_foreign", SubmissionState::Accepted)
+            )
+            .await,
+        Err(AppError::NotFound(_))
+    ));
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &submitted(5, operation.id(), "thr_frozen", SubmissionState::Accepted),
+        )
+        .await
+        .unwrap();
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &turn(6, operation.id(), "turn_bound", TurnState::Running, None),
+        )
+        .await
+        .unwrap();
+    assert!(matches!(
+        c.f.persistence
+            .accept_observation(
+                c.fence,
+                &submitted(7, operation.id(), "thr_frozen", SubmissionState::Queued)
+            )
+            .await,
+        Err(AppError::BadRequest(_))
+    ));
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &turn(
+                7,
+                operation.id(),
+                "turn_bound",
+                TurnState::Completed,
+                Some("native completion"),
+            ),
+        )
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn cloudroom_submission_missing_and_late_identity_preserve_uncertainty_and_capacity() {
+    let Some(c) = Context::new().await else {
+        return;
+    };
+    let mut admission = c.admission(c.send());
+    admission.operation = LocalAgentOperation::queued(
+        admission.operation.id(),
+        c.send(),
+        Utc::now() + chrono::Duration::seconds(2),
+    )
+    .unwrap();
+    let operation = c.f.persistence.enqueue_operation(&admission).await.unwrap();
+    intent(&c, &operation).await;
+    c.expire(&operation).await;
+    for (sequence, state) in [
+        (5, SubmissionState::Accepted),
+        (6, SubmissionState::Queued),
+        (7, SubmissionState::Missing),
+    ] {
+        c.f.persistence
+            .accept_observation(
+                c.fence,
+                &submitted(sequence, operation.id(), "thr_frozen", state),
+            )
+            .await
+            .unwrap();
+        let outcome: String = sqlx::query_scalar(
+            "SELECT outcome FROM local_agent_operations WHERE company_id=$1 AND id=$2",
+        )
+        .bind(c.f.company)
+        .bind(operation.id().as_uuid())
+        .fetch_one(&c.f.database.pool)
+        .await
+        .unwrap();
+        assert_eq!(outcome, "uncertain");
+        let mut db = c.f.database.pool.acquire().await.unwrap();
+        assert_eq!(
+            capacity(&mut db, c.f.company, c.paired.receipt.machine.id)
+                .await
+                .unwrap()
+                .unsettled,
+            1
+        );
+    }
+    c.f.persistence
+        .accept_observation(
+            c.fence,
+            &turn(
+                8,
+                operation.id(),
+                "turn_late_submission",
+                TurnState::Completed,
+                Some("late evidence"),
+            ),
+        )
+        .await
+        .unwrap();
+    let mut db = c.f.database.pool.acquire().await.unwrap();
+    assert_eq!(
+        capacity(&mut db, c.f.company, c.paired.receipt.machine.id)
+            .await
+            .unwrap()
+            .unsettled,
+        0
+    );
+    let outcome: String = sqlx::query_scalar(
+        "SELECT outcome FROM local_agent_operations WHERE company_id=$1 AND id=$2",
+    )
+    .bind(c.f.company)
+    .bind(operation.id().as_uuid())
+    .fetch_one(&mut *db)
+    .await
+    .unwrap();
+    assert_eq!(outcome, "uncertain");
+}
diff --git a/src/adapters/persistence/local_agents/protocol/test_support.rs b/src/adapters/persistence/local_agents/protocol/test_support.rs
new file mode 100644
index 00000000..cd4621e7
--- /dev/null
+++ b/src/adapters/persistence/local_agents/protocol/test_support.rs
@@ -0,0 +1,194 @@
+use super::*;
+use crate::adapters::persistence::local_agents::test_support::{
+    Fixture, Paired, SessionSetup, prepare_session,
+};
+
+pub(crate) struct Context {
+    pub f: Fixture,
+    pub paired: Paired,
+    pub session: SessionSetup,
+    pub journal: Uuid,
+    pub fence: ConnectionFence,
+}
+
+impl Context {
+    pub async fn new() -> Option<Self> {
+        let f = Fixture::new().await?;
+        let paired = f.pair(f.company).await;
+        let journal = Uuid::new_v4();
+        let fence = f
+            .persistence
+            .acquire_connection(
+                paired.candidate.credential.verifier(),
+                paired.receipt.machine.installation_id,
+                Uuid::new_v4(),
+            )
+            .await
+            .unwrap()
+            .unwrap();
+        let hello = JournalHello {
+            version: 1,
+            installation_id: fence.machine.installation_id,
+            journal_id: journal,
+            journal_sequence: 0,
+        };
+        assert!(
+            !f.persistence
+                .connect_journal(fence, &hello)
+                .await
+                .unwrap()
+                .recovery_required
+        );
+        let session = prepare_session(&f, &paired).await;
+        assert!(f.persistence.finish_reconciliation(fence).await.unwrap());
+        let deliveries = f.persistence.pending_commands(fence).await.unwrap();
+        assert_eq!(deliveries.len(), 1);
+        assert!(matches!(
+            deliveries[0].operation.command(),
+            LocalCommand::RefreshCatalog {}
+        ));
+        let id = deliveries[0].operation.id();
+        let receipt = agent(1, id, LocalEvidence::Receipt {});
+        assert_eq!(
+            f.persistence
+                .accept_observation(fence, &receipt)
+                .await
+                .unwrap(),
+            1
+        );
+        let catalog = f
+            .persistence
+            .capabilities(
+                f.company,
+                paired.receipt.machine.id,
+                EventSequence::try_from(1).unwrap(),
+            )
+            .await
+            .unwrap()
+            .unwrap()
+            .catalog;
+        let observation = JournalObservation::Catalog {
+            sequence: EventSequence::try_from(2).unwrap(),
+            operation_id: id,
+            catalog,
+        };
+        assert_eq!(
+            f.persistence
+                .accept_observation(fence, &observation)
+                .await
+                .unwrap(),
+            2
+        );
+        Some(Self {
+            f,
+            paired,
+            session,
+            journal,
+            fence,
+        })
+    }
+    pub fn send(&self) -> LocalCommand {
+        LocalCommand::Send {
+            session_id: self.session.id,
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+            prompt: LocalPrompt::try_from("bounded protocol proof".to_owned()).unwrap(),
+        }
+    }
+    pub fn create(&self, session_id: SessionId) -> LocalCommand {
+        LocalCommand::Create {
+            session_id,
+            selection: self.session.profile.selection.clone(),
+            prompt: LocalPrompt::try_from("new native thread".to_owned()).unwrap(),
+        }
+    }
+    pub async fn expire(&self, operation: &LocalAgentOperation) {
+        let wait = operation
+            .deadline()
+            .signed_duration_since(Utc::now())
+            .to_std()
+            .unwrap_or_default()
+            + std::time::Duration::from_millis(30);
+        tokio::time::sleep(wait).await;
+        assert_eq!(self.f.persistence.expire_operations(100).await.unwrap(), 1);
+    }
+    pub fn admission(&self, command: LocalCommand) -> OperationAdmission {
+        let id = OperationId::new(Uuid::new_v4()).unwrap();
+        OperationAdmission {
+            company_id: self.f.company,
+            actor_id: self.f.owner,
+            machine_id: self.paired.receipt.machine.id,
+            logical_key: LogicalInvocationKey::parse(id.to_string()).unwrap(),
+            operation: LocalAgentOperation::queued(
+                id,
+                command,
+                Utc::now() + chrono::Duration::minutes(30),
+            )
+            .unwrap(),
+        }
+    }
+    pub async fn unmapped_session(&self) -> SessionId {
+        let session = SessionId::new(Uuid::new_v4()).unwrap();
+        sqlx::query("INSERT INTO local_agent_sessions(company_id,id,machine_id,installation_id,profile_id,selection,conversation_id) SELECT company_id,$3,machine_id,installation_id,profile_id,selection,conversation_id FROM local_agent_sessions WHERE company_id=$1 AND id=$2")
+            .bind(self.f.company).bind(self.session.id.as_uuid()).bind(session.as_uuid()).execute(&self.f.database.pool).await.unwrap();
+        session
+    }
+    pub async fn reconnect(&self, journal: Uuid, sequence: u64) -> (ConnectionFence, Welcome) {
+        let fence = self
+            .f
+            .persistence
+            .acquire_connection(
+                self.paired.candidate.credential.verifier(),
+                self.paired.receipt.machine.installation_id,
+                Uuid::new_v4(),
+            )
+            .await
+            .unwrap()
+            .unwrap();
+        let welcome = self
+            .f
+            .persistence
+            .connect_journal(
+                fence,
+                &JournalHello {
+                    version: 1,
+                    installation_id: fence.machine.installation_id,
+                    journal_id: journal,
+                    journal_sequence: sequence,
+                },
+            )
+            .await
+            .unwrap();
+        (fence, welcome)
+    }
+}
+
+pub(crate) fn agent(sequence: u64, id: OperationId, evidence: LocalEvidence) -> JournalObservation {
+    JournalObservation::Agent {
+        observation: LocalAgentObservation {
+            sequence: EventSequence::try_from(sequence).unwrap(),
+            operation_id: id,
+            evidence,
+        },
+    }
+}
+
+pub(crate) fn turn(
+    sequence: u64,
+    id: OperationId,
+    turn_id: &str,
+    state: TurnState,
+    output: Option<&str>,
+) -> JournalObservation {
+    agent(
+        sequence,
+        id,
+        LocalEvidence::Turn {
+            thread_id: CloudroomThreadId::try_from("thr_frozen".to_owned()).unwrap(),
+            turn_id: CloudroomTurnId::try_from(turn_id.to_owned()).unwrap(),
+            state,
+            output: output.map(|v| LocalOutput::try_from(v.to_owned()).unwrap()),
+            truncated: false,
+            usage: None,
+        },
+    )
+}
diff --git a/src/adapters/persistence/local_agents/shared.rs b/src/adapters/persistence/local_agents/shared.rs
new file mode 100644
index 00000000..f4d28eb7
--- /dev/null
+++ b/src/adapters/persistence/local_agents/shared.rs
@@ -0,0 +1,133 @@
+//! Same-transaction primitives for manual and workflow admission. Callers authorize first.
+use super::*;
+
+#[derive(sqlx::FromRow)]
+struct ProfileRow {
+    id: Uuid,
+    name: String,
+    selection: Value,
+}
+impl ProfileRow {
+    fn entity(self, company: CompanyId) -> AppResult<LocalAgentProfile> {
+        decode(
+            json!({"id":self.id,"company_id":company.as_uuid(),"name":self.name,"selection":self.selection}),
+            "profile",
+        )
+    }
+}
+pub(in crate::adapters::persistence) async fn profile_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    id: ProfileId,
+) -> AppResult<Option<LocalAgentProfile>> {
+    sqlx::query_as::<_, ProfileRow>(
+        "SELECT id,name,selection FROM local_agent_profiles WHERE company_id=$1 AND id=$2",
+    )
+    .bind(company.as_uuid())
+    .bind(id.as_uuid())
+    .fetch_optional(db)
+    .await?
+    .map(|row| row.entity(company))
+    .transpose()
+}
+
+pub(in crate::adapters::persistence) struct LockedProfile {
+    pub profile: LocalAgentProfile,
+    pub machine: LocalMachine,
+}
+pub(in crate::adapters::persistence) async fn lock_profile_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    id: ProfileId,
+) -> AppResult<LockedProfile> {
+    let observed = profile_on(db, company, id).await?.ok_or_else(missing)?;
+    let machine = lock_machine(db, company.as_uuid(), observed.selection.machine_id)
+        .await?
+        .entity()?;
+    let profile = sqlx::query_as::<_,ProfileRow>("SELECT id,name,selection FROM local_agent_profiles WHERE company_id=$1 AND id=$2 FOR SHARE")
+        .bind(company.as_uuid()).bind(id.as_uuid()).fetch_optional(&mut *db).await?.ok_or_else(missing)?.entity(company)?;
+    if profile.selection != observed.selection {
+        return Err(AppError::Conflict(
+            "Local profile changed during admission".into(),
+        ));
+    }
+    Ok(LockedProfile { profile, machine })
+}
+
+pub(in crate::adapters::persistence) async fn validate_selection_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    machine: MachineId,
+    selection: &ExecutionSelection,
+) -> AppResult<()> {
+    if selection.machine_id != machine {
+        return Err(missing());
+    }
+    let allowed: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM local_machine_projects WHERE company_id=$1 AND machine_id=$2 AND project_id=$3)")
+        .bind(company.as_uuid()).bind(machine.as_uuid()).bind(selection.project_id.as_str()).fetch_one(&mut *db).await?;
+    if !allowed {
+        return Err(AppError::Conflict("project is not enabled".into()));
+    }
+    current_catalog(db, company.as_uuid(), machine)
+        .await?
+        .validate_selection(selection)
+        .map_err(|error| AppError::Conflict(error.into()))
+}
+pub(in crate::adapters::persistence) async fn validate_capacity_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    machine: MachineId,
+    command: &LocalCommand,
+) -> AppResult<()> {
+    let counts = protocol::capacity(db, company.as_uuid(), machine).await?;
+    validate_capacity(counts.unsettled as usize, counts.queued as usize, command)
+        .map_err(|error| AppError::Conflict(error.into()))
+}
+
+#[derive(sqlx::FromRow)]
+struct SessionRow {
+    id: Uuid,
+    profile_id: Uuid,
+    installation_id: Uuid,
+    selection: Value,
+    conversation_id: Option<Uuid>,
+    workflow_run_id: Option<Uuid>,
+    thread_id: Option<String>,
+}
+pub(in crate::adapters::persistence) async fn session_on(
+    db: &mut PgConnection,
+    company: CompanyId,
+    id: SessionId,
+) -> AppResult<Option<LocalAgentSession>> {
+    let row = sqlx::query_as::<_,SessionRow>("SELECT id,profile_id,installation_id,selection,conversation_id,workflow_run_id,thread_id FROM local_agent_sessions WHERE company_id=$1 AND id=$2")
+        .bind(company.as_uuid()).bind(id.as_uuid()).fetch_optional(db).await?;
+    row.map(|row| {
+        let association = match (row.conversation_id,row.workflow_run_id) {
+            (Some(id),None) => json!({"kind":"conversation","conversation_id":id}),
+            (None,Some(id)) => json!({"kind":"workflow","run_id":id}),
+            _ => return Err(invalid("session association")),
+        };
+        decode(json!({"id":row.id,"profile_id":row.profile_id,"company_id":company.as_uuid(),"installation_id":row.installation_id,
+            "selection":row.selection,"association":association,"thread_id":row.thread_id}), "session")
+    }).transpose()
+}
+pub(in crate::adapters::persistence) async fn insert_session_on(
+    db: &mut PgConnection,
+    session: &LocalAgentSession,
+) -> AppResult<()> {
+    let mut conversation = None;
+    let mut workflow_run = None;
+    match session.association {
+        SessionAssociation::Conversation { conversation_id } => {
+            conversation = Some(conversation_id)
+        }
+        SessionAssociation::Workflow { run_id } => workflow_run = Some(run_id),
+    }
+    sqlx::query("INSERT INTO local_agent_sessions(company_id,id,machine_id,installation_id,profile_id,selection,conversation_id,workflow_run_id) VALUES($1,$2,$3,$4,$5,$6,$7,$8)")
+        .bind(session.company_id).bind(session.id.as_uuid()).bind(session.selection.machine_id.as_uuid()).bind(session.installation_id.as_uuid())
+        .bind(session.profile_id.as_uuid()).bind(encode(&session.selection)?).bind(conversation).bind(workflow_run).execute(db).await
+        .map_err(|error| if error.as_database_error().is_some_and(|error| error.is_unique_violation()) {
+            AppError::Conflict("Local session identity already exists".into())
+        } else { error.into() })?;
+    Ok(())
+}
