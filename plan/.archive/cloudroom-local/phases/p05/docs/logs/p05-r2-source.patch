@@ -0,0 +1,322 @@
+use super::{
+    CapabilitySnapshot, ClaimVerifier, CredentialVerifier, PairingClaimSecret, PairingCode,
+    PairingCodeHash,
+};
+use crate::{
+    app_error::{AppError, AppResult},
+    domain::local_agents::*,
+    use_cases::{
+        company::{CompanyPersistence, managed_company},
+        user::{AuthAttemptKey, AuthAttemptSecret, auth_attempt_key},
+    },
+};
+use async_trait::async_trait;
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use std::{net::IpAddr, sync::Arc};
+use uuid::Uuid;
+
+use super::ports::LocalAgentRead;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct PairingAttempt {
+    pub id: PairingId,
+    pub company_id: Uuid,
+    pub expires_at: DateTime<Utc>,
+    pub consumed_at: Option<DateTime<Utc>>,
+    pub revoked_at: Option<DateTime<Utc>>,
+    pub machine_id: Option<MachineId>,
+}
+
+pub struct CreatedPairing {
+    pub code: PairingCode,
+    pub attempt: PairingAttempt,
+}
+
+pub struct PairingCreate {
+    pub id: PairingId,
+    pub company_id: Uuid,
+    pub actor_id: Uuid,
+    pub code_hash: PairingCodeHash,
+    pub replace_machine: Option<MachineId>,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PairingClaim {
+    pub code: PairingCode,
+    pub installation_id: InstallationId,
+    pub name: String,
+    pub claim_verifier: ClaimVerifier,
+    pub credential_verifier: CredentialVerifier,
+}
+
+impl PairingClaim {
+    pub fn validate(&self) -> AppResult<()> {
+        validate_name(&self.name)
+    }
+}
+
+pub fn validate_name(name: &str) -> AppResult<()> {
+    if name.is_empty()
+        || name.len() > 128
+        || name.trim() != name
+        || name.chars().any(char::is_control)
+    {
+        return Err(AppError::BadRequest(
+            "name must be 1–128 UTF-8 bytes without surrounding whitespace or controls".into(),
+        ));
+    }
+    Ok(())
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct PairingReceipt {
+    pub company_id: Uuid,
+    pub company_name: String,
+    pub machine: LocalMachine,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct MachineDetails {
+    pub machine: LocalMachine,
+    pub capabilities: Option<CapabilitySnapshot>,
+}
+
+#[derive(Debug, Clone, Copy, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum MachineChange {
+    Enable,
+    Disable,
+    Revoke,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct MachineAuthentication {
+    pub company_id: Uuid,
+    pub machine_id: MachineId,
+    pub installation_id: InstallationId,
+    pub credential_generation: CredentialGeneration,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct ConnectionFence {
+    pub machine: MachineAuthentication,
+    pub generation: ConnectionGeneration,
+    pub owner_id: Uuid,
+}
+
+#[async_trait]
+pub trait LocalMachineStore: LocalAgentRead {
+    async fn create_pairing(&self, write: PairingCreate) -> AppResult<PairingAttempt>;
+    async fn list_pairings(
+        &self,
+        company: Uuid,
+        after: Option<PairingId>,
+    ) -> AppResult<Vec<PairingAttempt>>;
+    async fn cancel_pairing(&self, actor: Uuid, company: Uuid, id: PairingId) -> AppResult<()>;
+    async fn reserve_pairing_budget(&self, keys: &[AuthAttemptKey]) -> AppResult<bool>;
+    async fn claim_pairing(&self, claim: &PairingClaim) -> AppResult<Option<PairingReceipt>>;
+    async fn pairing_status(
+        &self,
+        installation: InstallationId,
+        claim: ClaimVerifier,
+    ) -> AppResult<Option<PairingReceipt>>;
+    async fn list_machines(
+        &self,
+        company: Uuid,
+        after: Option<MachineId>,
+    ) -> AppResult<Vec<LocalMachine>>;
+    async fn change_machine(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        change: MachineChange,
+    ) -> AppResult<LocalMachine>;
+    async fn set_projects(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        projects: &[CloudroomProjectId],
+    ) -> AppResult<()>;
+    async fn save_profile(&self, actor: Uuid, profile: &LocalAgentProfile) -> AppResult<()>;
+    async fn acquire_connection(
+        &self,
+        verifier: CredentialVerifier,
+        installation: InstallationId,
+        owner: Uuid,
+    ) -> AppResult<Option<ConnectionFence>>;
+    async fn renew_connection(&self, fence: ConnectionFence) -> AppResult<bool>;
+    async fn release_connection(&self, fence: ConnectionFence) -> AppResult<()>;
+}
+
+#[derive(Clone)]
+pub struct LocalMachineUseCases {
+    companies: Arc<dyn CompanyPersistence>,
+    store: Arc<dyn LocalMachineStore>,
+    attempt_secret: AuthAttemptSecret,
+}
+
+impl LocalMachineUseCases {
+    pub fn new(
+        companies: Arc<dyn CompanyPersistence>,
+        store: Arc<dyn LocalMachineStore>,
+        attempt_secret: AuthAttemptSecret,
+    ) -> Self {
+        Self {
+            companies,
+            store,
+            attempt_secret,
+        }
+    }
+
+    pub async fn create_pairing(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        replace_machine: Option<MachineId>,
+    ) -> AppResult<CreatedPairing> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        let code = PairingCode::generate()?;
+        let attempt = self
+            .store
+            .create_pairing(PairingCreate {
+                id: PairingId::new(Uuid::new_v4()).map_err(|e| AppError::Internal(e.into()))?,
+                company_id: company,
+                actor_id: actor,
+                code_hash: code.verifier(),
+                replace_machine,
+            })
+            .await?;
+        Ok(CreatedPairing { code, attempt })
+    }
+
+    pub async fn list_pairings(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        after: Option<PairingId>,
+    ) -> AppResult<Vec<PairingAttempt>> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        self.store.list_pairings(company, after).await
+    }
+
+    pub async fn cancel_pairing(&self, actor: Uuid, company: Uuid, id: PairingId) -> AppResult<()> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        self.store.cancel_pairing(actor, company, id).await
+    }
+
+    fn budget(&self, domain: &str, value: &[u8]) -> AuthAttemptKey {
+        auth_attempt_key(self.attempt_secret.expose_secret(), domain, &[value])
+    }
+
+    pub async fn pair(&self, source: IpAddr, claim: PairingClaim) -> AppResult<PairingReceipt> {
+        claim.validate()?;
+        let code_hash = claim.code.verifier();
+        let keys = [
+            self.budget("local-pair-source:v1", source.to_string().as_bytes()),
+            self.budget("local-pair-code:v1", code_hash.as_bytes()),
+            self.budget("local-pair-claim:v1", claim.claim_verifier.as_bytes()),
+        ];
+        if !self.store.reserve_pairing_budget(&keys).await? {
+            return Err(AppError::InvalidCredentials);
+        }
+        self.store
+            .claim_pairing(&claim)
+            .await?
+            .ok_or(AppError::InvalidCredentials)
+    }
+
+    pub async fn pair_status(
+        &self,
+        source: IpAddr,
+        installation: InstallationId,
+        secret: PairingClaimSecret,
+    ) -> AppResult<PairingReceipt> {
+        let claim = secret.verifier();
+        let keys = [
+            self.budget("local-pair-source:v1", source.to_string().as_bytes()),
+            self.budget("local-pair-claim:v1", claim.as_bytes()),
+        ];
+        if !self.store.reserve_pairing_budget(&keys).await? {
+            return Err(AppError::InvalidCredentials);
+        }
+        self.store
+            .pairing_status(installation, claim)
+            .await?
+            .ok_or(AppError::InvalidCredentials)
+    }
+
+    pub async fn machines(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        after: Option<MachineId>,
+    ) -> AppResult<Vec<LocalMachine>> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        self.store.list_machines(company, after).await
+    }
+
+    pub async fn machine(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+    ) -> AppResult<LocalMachine> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        self.store
+            .machine(company, id)
+            .await?
+            .ok_or_else(|| AppError::NotFound("local machine".into()))
+    }
+
+    pub async fn change(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        change: MachineChange,
+    ) -> AppResult<LocalMachine> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        self.store.change_machine(actor, company, id, change).await
+    }
+
+    pub async fn set_projects(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+        projects: &[CloudroomProjectId],
+    ) -> AppResult<()> {
+        managed_company(self.companies.as_ref(), actor, company).await?;
+        if projects.len() > super::bounds::MAX_PROJECTS {
+            return Err(AppError::BadRequest("too many projects".into()));
+        }
+        self.store.set_projects(actor, company, id, projects).await
+    }
+
+    pub async fn save_profile(&self, actor: Uuid, profile: &LocalAgentProfile) -> AppResult<()> {
+        managed_company(self.companies.as_ref(), actor, profile.company_id).await?;
+        validate_name(&profile.name)?;
+        self.store.save_profile(actor, profile).await
+    }
+
+    pub async fn details(
+        &self,
+        actor: Uuid,
+        company: Uuid,
+        id: MachineId,
+    ) -> AppResult<MachineDetails> {
+        let machine = self.machine(actor, company, id).await?;
+        let capabilities = match machine.capabilities_sequence {
+            Some(sequence) => self.store.capabilities(company, id, sequence).await,
+            None => Ok(None),
+        }?;
+        Ok(MachineDetails {
+            machine,
+            capabilities,
+        })
+    }
+}
diff --git a/src/application/local_agents/ports.rs b/src/application/local_agents/ports.rs
new file mode 100644
index 00000000..0cbaf732
--- /dev/null
+++ b/src/application/local_agents/ports.rs
@@ -0,0 +1,33 @@
+use super::CapabilitySnapshot;
+use crate::domain::local_agents::EventSequence;
+use crate::{
+    application::app_error::AppResult,
+    domain::local_agents::{
+        LocalAgentProfile, LocalAgentSession, LocalMachine, MachineId, ProfileId, SessionId,
+    },
+};
+use async_trait::async_trait;
+use uuid::Uuid;
+
+/// Every lookup carries its company scope; application use cases also authorize the
+/// session's original conversation/workflow association before returning its data.
+#[async_trait]
+pub trait LocalAgentRead: Send + Sync {
+    async fn machine(&self, company_id: Uuid, id: MachineId) -> AppResult<Option<LocalMachine>>;
+    async fn profile(
+        &self,
+        company_id: Uuid,
+        id: ProfileId,
+    ) -> AppResult<Option<LocalAgentProfile>>;
+    async fn session(
+        &self,
+        company_id: Uuid,
+        id: SessionId,
+    ) -> AppResult<Option<LocalAgentSession>>;
+    async fn capabilities(
+        &self,
+        company_id: Uuid,
+        machine: MachineId,
+        sequence: EventSequence,
+    ) -> AppResult<Option<CapabilitySnapshot>>;
+}
diff --git a/src/application/local_agents/protocol.rs b/src/application/local_agents/protocol.rs
new file mode 100644
index 00000000..968097d9
--- /dev/null
+++ b/src/application/local_agents/protocol.rs
@@ -0,0 +1,250 @@
+//! Logical protocol contracts; transport framing and SQL stay in adapters.
+use super::{ConnectionFence, LocalCatalog, LocalMachineStore};
+use crate::{
+    app_error::{AppError, AppResult},
+    domain::local_agents::*,
+};
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use uuid::Uuid;
+
+pub const MAX_LOGICAL_BYTES: usize = 2 * 1024 * 1024;
+pub const MAX_CONNECTIONS: usize = 32;
+pub const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+pub const POLL_MILLIS: u64 = 500;
+pub const IO_SECONDS: u64 = 5;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ConnectionIdentity {
+    pub installation_id: InstallationId,
+    pub credential_generation: CredentialGeneration,
+    pub connection_generation: ConnectionGeneration,
+}
+
+impl ConnectionIdentity {
+    pub fn from_fence(fence: ConnectionFence) -> AppResult<Self> {
+        if fence.machine.credential_generation.get() > MAX_SAFE_INTEGER
+            || fence.generation.get() > MAX_SAFE_INTEGER
+        {
+            return Err(AppError::Conflict("connection generation exhausted".into()));
+        }
+        Ok(Self {
+            installation_id: fence.machine.installation_id,
+            credential_generation: fence.machine.credential_generation,
+            connection_generation: fence.generation,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct JournalHello {
+    pub version: u16,
+    pub installation_id: InstallationId,
+    pub journal_id: Uuid,
+    pub journal_sequence: u64,
+}
+
+impl JournalHello {
+    pub fn validate(&self, fence: ConnectionFence) -> AppResult<()> {
+        if self.version != super::bounds::PROTOCOL_VERSION
+            || self.installation_id != fence.machine.installation_id
+            || self.journal_id.is_nil()
+            || self.journal_sequence > MAX_SAFE_INTEGER
+        {
+            return Err(AppError::BadRequest(
+                "unsupported local-machine hello".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Welcome {
+    pub identity: ConnectionIdentity,
+    pub acknowledged_sequence: u64,
+    pub recovery_required: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DeliveryMode {
+    Reconcile,
+    Dispatch,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommandDelivery {
+    pub operation: LocalAgentOperation,
+    pub mode: DeliveryMode,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ControlEvidence {
+    Snapshot { state: TurnState },
+    StopAccepted {},
+    ArchiveAccepted {},
+}
+
+/// The canonical typed journal payload, excluding every connection/transfer field.
+/// Catalogs remain application-owned; the core agent evidence remains domain-owned.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum JournalObservation {
+    Agent {
+        observation: LocalAgentObservation,
+    },
+    Catalog {
+        sequence: EventSequence,
+        operation_id: OperationId,
+        catalog: LocalCatalog,
+    },
+    Control {
+        sequence: EventSequence,
+        operation_id: OperationId,
+        thread_id: CloudroomThreadId,
+        evidence: ControlEvidence,
+    },
+}
+
+impl JournalObservation {
+    pub fn sequence(&self) -> EventSequence {
+        match self {
+            Self::Agent { observation } => observation.sequence,
+            Self::Catalog { sequence, .. } | Self::Control { sequence, .. } => *sequence,
+        }
+    }
+    pub fn operation_id(&self) -> OperationId {
+        match self {
+            Self::Agent { observation } => observation.operation_id,
+            Self::Catalog { operation_id, .. } | Self::Control { operation_id, .. } => {
+                *operation_id
+            }
+        }
+    }
+    pub fn canonical_digest(&self) -> AppResult<PayloadDigest> {
+        let data = serde_json::to_vec(self)
+            .map_err(|_| AppError::BadRequest("invalid observation".into()))?;
+        if data.len() > MAX_LOGICAL_BYTES || self.sequence().get() > MAX_SAFE_INTEGER {
+            return Err(AppError::BadRequest(
+                "observation exceeds protocol bounds".into(),
+            ));
+        }
+        PayloadDigest::try_from(format!("{:x}", Sha256::digest(data)))
+            .map_err(|e| AppError::Internal(e.into()))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ClientMessage {
+    Hello {
+        hello: JournalHello,
+    },
+    Ready {
+        identity: ConnectionIdentity,
+    },
+    Observation {
+        identity: ConnectionIdentity,
+        observation: JournalObservation,
+    },
+    Heartbeat {
+        identity: ConnectionIdentity,
+    },
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ServerMessage {
+    Welcome {
+        welcome: Welcome,
+    },
+    Command {
+        identity: ConnectionIdentity,
+        // Bound the state held across asynchronous transport waits.
+        delivery: Box<CommandDelivery>,
+    },
+    Acknowledged {
+        identity: ConnectionIdentity,
+        through: u64,
+    },
+    Ready {
+        identity: ConnectionIdentity,
+        ready: bool,
+    },
+}
+
+#[derive(Debug, Clone)]
+pub struct OperationAdmission {
+    pub company_id: Uuid,
+    pub actor_id: Uuid,
+    pub machine_id: MachineId,
+    pub logical_key: LogicalInvocationKey,
+    pub operation: LocalAgentOperation,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LogicalInvocationKey(String);
+impl LogicalInvocationKey {
+    pub fn parse(value: String) -> AppResult<Self> {
+        if value.is_empty() || value.len() > 256 || value.contains('\0') {
+            return Err(AppError::BadRequest(
+                "invalid logical invocation key".into(),
+            ));
+        }
+        Ok(Self(value))
+    }
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// Operational diagnostics only; these values never grant delivery or continuation authority.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ConnectionIssue {
+    IncompatibleProtocol,
+    RecoveryRequired,
+    ConnectionFailed,
+}
+impl ConnectionIssue {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::IncompatibleProtocol => "incompatible_protocol",
+            Self::RecoveryRequired => "recovery_required",
+            Self::ConnectionFailed => "connection_failed",
+        }
+    }
+}
+
+#[async_trait]
+pub trait LocalProtocolStore: LocalMachineStore {
+    async fn record_connection_issue(
+        &self,
+        fence: ConnectionFence,
+        issue: ConnectionIssue,
+    ) -> AppResult<bool>;
+    async fn connect_journal(
+        &self,
+        fence: ConnectionFence,
+        hello: &JournalHello,
+    ) -> AppResult<Welcome>;
+    async fn finish_reconciliation(&self, fence: ConnectionFence) -> AppResult<bool>;
+    async fn pending_commands(&self, fence: ConnectionFence) -> AppResult<Vec<CommandDelivery>>;
+    async fn accept_observation(
+        &self,
+        fence: ConnectionFence,
+        observation: &JournalObservation,
+    ) -> AppResult<u64>;
+    async fn enqueue_operation(
+        &self,
+        admission: &OperationAdmission,
+    ) -> AppResult<LocalAgentOperation>;
+    async fn expire_operations(&self, limit: u16) -> AppResult<u16>;
+}
