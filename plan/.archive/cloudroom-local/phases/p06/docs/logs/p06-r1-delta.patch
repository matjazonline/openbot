+    assert_eq!(one.unwrap().archived_calls + two.unwrap().archived_calls, 4);
+    for root in roots {
+        assert!(p.retire_tree(root).await.unwrap().is_some());
+    }
+    let left: i64 = sqlx::query_scalar(
