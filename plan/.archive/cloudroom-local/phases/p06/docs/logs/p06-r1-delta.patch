+        .completed_result()
+        .unwrap();
+    let session =
+        SessionId::new(Uuid::parse_str(output["session_id"].as_str().unwrap()).unwrap()).unwrap();
+    let done = p
+        .complete_io(FencedWorkflowResult {
+            fence: claim.fence,
+            output,
+            policy: lease(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
