+CREATE FUNCTION public.workflow_local_agent_retention_proof_guard() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        RAISE EXCEPTION 'native retention proof is immutable' USING ERRCODE='23514';
+    END IF;
+    IF NOT EXISTS (
+        SELECT 1 FROM workflow_local_agent_calls AS call
+        JOIN workflow_runs AS run ON run.company_id=call.company_id AND run.id=call.run_id
+        JOIN local_agent_operations AS operation ON operation.company_id=call.company_id AND operation.id=call.operation_id
+        WHERE (call.company_id,call.run_id,call.execution_id,call.invocation_id,call.argument_digest,call.dispatch_id)
+            =(NEW.company_id,NEW.run_id,NEW.execution_id,NEW.invocation_id,NEW.argument_digest,NEW.dispatch_id)
