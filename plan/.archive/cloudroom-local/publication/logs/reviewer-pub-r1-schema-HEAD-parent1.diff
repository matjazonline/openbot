+CREATE TABLE public.agent_history_conversations (
+    company_id uuid NOT NULL REFERENCES public.companies(id) ON DELETE CASCADE,
+    id uuid NOT NULL,
+    agent_id uuid NOT NULL,
+    scope_kind text NOT NULL CHECK (scope_kind IN ('thread','private_session','child_branch')),
+    channel_id uuid,
+    thread_id uuid,
+    session_id uuid,
+    child_run_id uuid,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    last_exchange_order bigint NOT NULL DEFAULT 0 CHECK (last_exchange_order >= 0),
+    active_exchange_id uuid,
+    expired_count bigint NOT NULL DEFAULT 0 CHECK (expired_count BETWEEN 0 AND last_exchange_order),
+    expired_through_order bigint NOT NULL DEFAULT 0 CHECK (expired_through_order BETWEEN 0 AND last_exchange_order),
+    PRIMARY KEY (company_id,id),
+    UNIQUE (company_id,agent_id,id),
+    FOREIGN KEY (company_id,agent_id) REFERENCES public.agents(company_id,id),
+    FOREIGN KEY (company_id,channel_id,thread_id) REFERENCES public.threads(company_id,channel_id,id),
+    FOREIGN KEY (company_id,session_id) REFERENCES public.agent_history_sessions(company_id,id),
+    FOREIGN KEY (company_id,child_run_id) REFERENCES public.workflow_runs(company_id,id) ON DELETE CASCADE,
+    CHECK ((scope_kind='thread' AND channel_id IS NOT NULL AND thread_id IS NOT NULL
+            AND session_id IS NULL AND child_run_id IS NULL)
