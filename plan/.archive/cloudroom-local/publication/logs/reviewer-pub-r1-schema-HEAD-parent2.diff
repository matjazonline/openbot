+-- This physical-state predicate owns capacity, reconciliation and retention semantics.
+CREATE FUNCTION public.local_operation_is_outstanding(operation_command jsonb, operation_outcome text, native_state text)
+RETURNS boolean LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $$
+    SELECT operation_outcome IS NULL OR (operation_outcome='uncertain'
+        AND operation_command->>'kind' IN ('create','send')
+        AND COALESCE(native_state NOT IN ('completed','failed','stopped'),true))
+$$;
+
+CREATE TABLE public.local_agent_operations (
+    id uuid NOT NULL,
+    company_id uuid NOT NULL,
+    machine_id uuid NOT NULL,
+    installation_id uuid NOT NULL,
+    session_id uuid,
+    logical_key text NOT NULL CHECK (octet_length(logical_key) BETWEEN 1 AND 256),
+    actor_id uuid REFERENCES public.users(id) ON DELETE SET NULL,
+    origin text NOT NULL DEFAULT 'direct' CHECK (origin IN ('direct','workflow')),
+    command jsonb NOT NULL CHECK (jsonb_typeof(command) = 'object'),
+    payload_digest text NOT NULL CHECK (payload_digest ~ '^[0-9a-f]{64}$'),
+    deadline timestamptz NOT NULL,
+    -- Set before the first transport write; a lost receipt does not prove non-delivery.
+    delivery_attempted_at timestamptz,
+    last_observed_generation bigint NOT NULL DEFAULT 0 CHECK (last_observed_generation >= 0),
+    dispatch jsonb NOT NULL DEFAULT '{"kind":"not_dispatched"}'::jsonb,
+    outcome text CHECK (outcome IN ('succeeded','failed','cancelled','expired','uncertain')),
+    output text CHECK (octet_length(output) <= 262144),
+    output_truncated boolean NOT NULL DEFAULT false,
+    observed_turn_state text CHECK (observed_turn_state IN ('queued','running','waiting_for_input','completed','failed','stopped','missing')),
+    measured_usage jsonb CHECK (jsonb_typeof(measured_usage) = 'object'),
+    settled_at timestamptz,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    PRIMARY KEY (company_id,id),
+    UNIQUE (company_id,machine_id,logical_key),
+    UNIQUE (company_id,machine_id,installation_id,id),
+    UNIQUE (company_id,machine_id,installation_id,id,origin),
+    FOREIGN KEY (company_id,machine_id,installation_id) REFERENCES public.local_machines(company_id,id,installation_id) ON DELETE CASCADE,
+    FOREIGN KEY (company_id,machine_id,installation_id,session_id) REFERENCES public.local_agent_sessions(company_id,machine_id,installation_id,id),
+    CHECK (origin<>'workflow' OR command->>'kind' IN ('create','send')),
+    CHECK ((command->>'kind' IN ('create','send','inspect','stop_thread','archive_thread','refresh_catalog')) IS TRUE),
+    CHECK (((command->>'kind' = 'refresh_catalog') = (session_id IS NULL)) IS TRUE),
+    CONSTRAINT local_operation_command_session CHECK ((command->>'kind'='refresh_catalog' OR command->>'session_id'=session_id::text) IS TRUE),
+    CONSTRAINT local_operation_create_machine CHECK ((command->>'kind'<>'create' OR command->'selection'->>'machine_id'=machine_id::text) IS TRUE),
+    CHECK ((dispatch->>'kind' IN ('not_dispatched','accepted_locally','submission_intent','native_identity','catalog_snapshot')) IS TRUE),
+    CHECK ((settled_at IS NULL)=public.local_operation_is_outstanding(command,outcome,observed_turn_state))
+);
+
+CREATE FUNCTION public.local_operation_settlement() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' AND NEW.settled_at IS DISTINCT FROM OLD.settled_at THEN
+        RAISE EXCEPTION 'native settlement time is server owned' USING ERRCODE='23514';
+    END IF;
+    IF public.local_operation_is_outstanding(NEW.command,NEW.outcome,NEW.observed_turn_state) THEN
+        IF TG_OP='UPDATE' AND OLD.settled_at IS NOT NULL THEN
+            RAISE EXCEPTION 'physically settled native work cannot reopen' USING ERRCODE='23514';
+        END IF;
+        NEW.settled_at := NULL;
+    ELSE
+        IF TG_OP='UPDATE' THEN NEW.settled_at := COALESCE(OLD.settled_at,clock_timestamp());
+        ELSE NEW.settled_at := clock_timestamp(); END IF;
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_operation_settlement BEFORE INSERT OR UPDATE ON public.local_agent_operations
+    FOR EACH ROW EXECUTE FUNCTION public.local_operation_settlement();
+CREATE INDEX local_agent_settlement_retention ON public.local_agent_operations(settled_at,company_id,id)
+    WHERE settled_at IS NOT NULL;
+
+CREATE FUNCTION public.local_machine_native_success() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.settled_at IS NOT NULL AND NEW.command->>'kind' IN ('create','send')
+        AND NEW.dispatch->>'kind'='native_identity' AND NEW.observed_turn_state='completed' THEN
+        UPDATE local_machines SET last_native_success_at=NEW.settled_at
+            WHERE company_id=NEW.company_id AND id=NEW.machine_id
+                AND (last_native_success_at IS NULL OR last_native_success_at<NEW.settled_at);
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_machine_native_success AFTER INSERT OR UPDATE ON public.local_agent_operations
+    FOR EACH ROW EXECUTE FUNCTION public.local_machine_native_success();
+
