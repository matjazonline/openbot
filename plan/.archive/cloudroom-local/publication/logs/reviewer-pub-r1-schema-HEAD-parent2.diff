+    UNIQUE (company_id,invocation_id),
+    UNIQUE (company_id,operation_id),
+    UNIQUE (company_id,wait_id),
+    FOREIGN KEY (company_id,run_id,execution_id,invocation_id,argument_digest)
+        REFERENCES public.workflow_action_intents(company_id,run_id,execution_id,id,argument_digest) ON DELETE CASCADE,
+    FOREIGN KEY (company_id,profile_id) REFERENCES public.local_agent_profiles(company_id,id),
+    FOREIGN KEY (company_id,machine_id,installation_id,operation_id,operation_origin)
+        REFERENCES public.local_agent_operations(company_id,machine_id,installation_id,id,origin),
+    FOREIGN KEY (company_id,machine_id,installation_id,session_id)
+        REFERENCES public.local_agent_sessions(company_id,machine_id,installation_id,id),
+    FOREIGN KEY (company_id,profile_id,session_id) REFERENCES public.local_agent_sessions(company_id,profile_id,id),
+    -- Link the scoped call before the wait's immediate owner guard runs. The cycle
+    -- must be complete at COMMIT; the dispatch commit guard proves the atomic park.
+    FOREIGN KEY (company_id,run_id,execution_id,wait_id)
+        REFERENCES public.workflow_waits(company_id,run_id,execution_id,id) DEFERRABLE INITIALLY DEFERRED,
+    FOREIGN KEY (company_id,run_id,execution_id,invocation_id,argument_digest,dispatch_id,effect_kind)
+        REFERENCES public.workflow_action_dispatches(company_id,run_id,execution_id,invocation_id,argument_digest,id,effect_kind),
+    CHECK (num_nonnulls(machine_id,installation_id,session_id,operation_id,wait_id,dispatch_id,fence_expires_at) IN (0,7)),
+    CHECK (operation_id IS NULL OR operation_id=invocation_id),
+    CHECK (ready_at IS NULL OR operation_id IS NOT NULL),
+    CHECK ((ready_at IS NULL)=(workflow_outcome IS NULL))
+);
+
+-- Terminal call archival breaks closed cross-tree references without granting an effect receipt.
+CREATE TABLE public.workflow_local_agent_retention_proofs (
+    company_id uuid NOT NULL,
+    run_id uuid NOT NULL,
+    execution_id uuid NOT NULL,
+    invocation_id uuid NOT NULL,
+    argument_digest text NOT NULL,
+    dispatch_id uuid NOT NULL,
+    effect_kind text NOT NULL DEFAULT 'local_agent' CHECK (effect_kind='local_agent'),
+    settled_at timestamptz NOT NULL,
+    PRIMARY KEY (company_id,invocation_id),
+    FOREIGN KEY (company_id,run_id,execution_id,invocation_id,argument_digest,dispatch_id,effect_kind)
+        REFERENCES public.workflow_action_dispatches(company_id,run_id,execution_id,invocation_id,argument_digest,id,effect_kind)
+        ON DELETE CASCADE
+);
+CREATE FUNCTION public.workflow_local_agent_retention_proof_guard() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        RAISE EXCEPTION 'native retention proof is immutable' USING ERRCODE='23514';
+    END IF;
+    IF NOT EXISTS (
+        SELECT 1 FROM workflow_local_agent_calls AS call
+        JOIN workflow_runs AS run ON run.company_id=call.company_id AND run.id=call.run_id
+        JOIN local_agent_operations AS operation ON operation.company_id=call.company_id AND operation.id=call.operation_id
+        WHERE (call.company_id,call.run_id,call.execution_id,call.invocation_id,call.argument_digest,call.dispatch_id)
+            =(NEW.company_id,NEW.run_id,NEW.execution_id,NEW.invocation_id,NEW.argument_digest,NEW.dispatch_id)
+            AND run.state IN ('succeeded','failed','cancelled') AND run.finished_at<clock_timestamp()-interval '90 days'
+            AND operation.settled_at=NEW.settled_at AND operation.settled_at<clock_timestamp()-interval '90 days'
+            AND NOT public.local_operation_is_outstanding(operation.command,operation.outcome,operation.observed_turn_state)
+    ) THEN RAISE EXCEPTION 'native retention proof requires its old terminal owner and physical evidence' USING ERRCODE='23514'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER workflow_local_agent_retention_proof_guard BEFORE INSERT OR UPDATE ON public.workflow_local_agent_retention_proofs
+    FOR EACH ROW EXECUTE FUNCTION public.workflow_local_agent_retention_proof_guard();
+
+CREATE FUNCTION public.workflow_local_agent_call_guard() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        IF (NEW.company_id,NEW.run_id,NEW.execution_id,NEW.invocation_id,NEW.argument_digest,NEW.profile_id,NEW.created_at)
+            IS DISTINCT FROM (OLD.company_id,OLD.run_id,OLD.execution_id,OLD.invocation_id,OLD.argument_digest,OLD.profile_id,OLD.created_at)
+            OR (OLD.operation_id IS NOT NULL AND (NEW.machine_id,NEW.installation_id,NEW.session_id,NEW.operation_id,NEW.wait_id,NEW.dispatch_id,NEW.fence_expires_at)
+                IS DISTINCT FROM (OLD.machine_id,OLD.installation_id,OLD.session_id,OLD.operation_id,OLD.wait_id,OLD.dispatch_id,OLD.fence_expires_at))
+            OR (OLD.ready_at IS NOT NULL AND ROW(NEW.ready_at,NEW.workflow_outcome) IS DISTINCT FROM ROW(OLD.ready_at,OLD.workflow_outcome))
+        THEN RAISE EXCEPTION 'local workflow call identity is immutable' USING ERRCODE='23514', CONSTRAINT='workflow_guard:local_agent_identity'; END IF;
+    END IF;
+    IF NEW.ready_at IS NOT NULL AND NOT EXISTS (
+        SELECT 1 FROM local_agent_operations AS operation WHERE operation.company_id=NEW.company_id
+            AND operation.id=NEW.operation_id AND operation.outcome IS NOT NULL
+    ) THEN RAISE EXCEPTION 'local workflow wake requires a settled operation' USING ERRCODE='23514', CONSTRAINT='workflow_guard:local_agent_wake'; END IF;
+    IF NEW.ready_at IS NOT NULL AND (TG_OP='INSERT' OR OLD.ready_at IS NULL) AND NOT EXISTS (
+        SELECT 1 FROM local_agent_operations AS operation WHERE operation.company_id=NEW.company_id AND operation.id=NEW.operation_id
+            AND NEW.workflow_outcome=CASE WHEN operation.deadline<=NEW.ready_at THEN 'expired' ELSE operation.outcome END
+    ) THEN RAISE EXCEPTION 'local workflow disposition must match its first terminal observation' USING ERRCODE='23514', CONSTRAINT='workflow_guard:local_agent_disposition'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER workflow_local_agent_call_guard BEFORE INSERT OR UPDATE ON public.workflow_local_agent_calls
+    FOR EACH ROW EXECUTE FUNCTION public.workflow_local_agent_call_guard();
+
+-- Receipt/output and wake readiness share the operation writer's transaction, including expiry.
+CREATE FUNCTION public.workflow_local_agent_outcome_wake() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE observed_at timestamptz := clock_timestamp();
+BEGIN
+    UPDATE workflow_local_agent_calls AS call SET ready_at=observed_at,
+        workflow_outcome=CASE WHEN NEW.deadline<=observed_at THEN 'expired' ELSE NEW.outcome END
+        WHERE call.company_id=NEW.company_id AND call.operation_id=NEW.id AND call.ready_at IS NULL;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER workflow_local_agent_outcome_wake AFTER UPDATE OF outcome ON public.local_agent_operations
+    FOR EACH ROW WHEN (NEW.outcome IS NOT NULL AND OLD.outcome IS DISTINCT FROM NEW.outcome)
+    EXECUTE FUNCTION public.workflow_local_agent_outcome_wake();
+
+-- A native effect turn cannot settle another operation; this enforces identity, not a query optimization.
+CREATE UNIQUE INDEX local_agent_effect_turn_identity ON public.local_agent_operations
+    (installation_id,(dispatch->>'thread_id'),(dispatch->>'turn_id'))
+    WHERE command->>'kind' IN ('create','send') AND dispatch->>'kind'='native_identity'
+        AND dispatch->>'turn_id' IS NOT NULL;
+CREATE UNIQUE INDEX local_agent_session_creation ON public.local_agent_operations(company_id,session_id)
+    WHERE command->>'kind'='create';
+
+CREATE TABLE public.local_pair_budgets (
+    identity_key bytea PRIMARY KEY CHECK (octet_length(identity_key) = 32),
+    attempts smallint NOT NULL CHECK (attempts BETWEEN 1 AND 12),
+    window_ends_at timestamptz NOT NULL
+);
+
+CREATE FUNCTION public.local_installation_identity_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'installation reservations cannot be changed or released' USING ERRCODE='23514';
+END $$;
+CREATE TRIGGER local_installation_identity_immutable BEFORE UPDATE OR DELETE ON public.local_installations
+    FOR EACH ROW EXECUTE FUNCTION public.local_installation_identity_immutable();
+
+CREATE FUNCTION public.local_operation_inputs_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.company_id,NEW.machine_id,NEW.installation_id,NEW.session_id,NEW.logical_key,NEW.origin,NEW.command,NEW.payload_digest,NEW.deadline)
+        IS DISTINCT FROM ROW(OLD.company_id,OLD.machine_id,OLD.installation_id,OLD.session_id,OLD.logical_key,OLD.origin,OLD.command,OLD.payload_digest,OLD.deadline)
+        OR (OLD.delivery_attempted_at IS NOT NULL AND NEW.delivery_attempted_at IS DISTINCT FROM OLD.delivery_attempted_at)
+        OR (NEW.actor_id IS DISTINCT FROM OLD.actor_id AND NEW.actor_id IS NOT NULL)
+    THEN RAISE EXCEPTION 'local operation inputs are immutable' USING ERRCODE='23514'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_operation_inputs_immutable BEFORE UPDATE ON public.local_agent_operations
+    FOR EACH ROW EXECUTE FUNCTION public.local_operation_inputs_immutable();
+
+CREATE FUNCTION public.local_session_inputs_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.company_id,NEW.machine_id,NEW.installation_id,NEW.profile_id,NEW.selection,NEW.conversation_id,NEW.workflow_run_id)
+        IS DISTINCT FROM ROW(OLD.company_id,OLD.machine_id,OLD.installation_id,OLD.profile_id,OLD.selection,OLD.conversation_id,OLD.workflow_run_id)
+        OR (OLD.thread_id IS NOT NULL AND NEW.thread_id IS DISTINCT FROM OLD.thread_id)
+    THEN RAISE EXCEPTION 'local session inputs and native identity are immutable' USING ERRCODE='23514'; END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER local_session_inputs_immutable BEFORE UPDATE ON public.local_agent_sessions
+    FOR EACH ROW EXECUTE FUNCTION public.local_session_inputs_immutable();
+
+
+CREATE FUNCTION public.local_workflow_operation_owner() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.origin='workflow' AND NOT EXISTS (
+        SELECT 1 FROM workflow_local_agent_calls AS call
+        JOIN workflow_action_dispatches AS marker ON marker.company_id=call.company_id AND marker.id=call.dispatch_id
+        JOIN workflow_action_intents AS intent ON intent.company_id=call.company_id AND intent.id=call.invocation_id
+        JOIN workflow_waits AS wait ON wait.company_id=call.company_id AND wait.id=call.wait_id
+        JOIN local_agent_sessions AS session ON session.company_id=call.company_id AND session.id=call.session_id
+        WHERE call.company_id=NEW.company_id AND call.machine_id=NEW.machine_id AND call.installation_id=NEW.installation_id
+            AND call.operation_id=NEW.id AND call.operation_origin=NEW.origin AND call.session_id=NEW.session_id
+            AND marker.effect_kind='local_agent' AND wait.run_id=call.run_id AND wait.execution_id=call.execution_id
+            AND session.workflow_run_id IS NOT NULL AND intent.operation_key='local_agent.run'
+            AND intent.operation#>>'{context,actor}'=NEW.actor_id::text
+    ) THEN RAISE EXCEPTION 'workflow native operation requires its atomic shared action owner' USING ERRCODE='23514', CONSTRAINT='workflow_guard:local_workflow_operation_owner'; END IF;
+    RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER local_workflow_operation_owner AFTER INSERT ON public.local_agent_operations
+    DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.local_workflow_operation_owner();
+
 -- Response/delivery changes wake existing readers; events carry identities, never payloads.
