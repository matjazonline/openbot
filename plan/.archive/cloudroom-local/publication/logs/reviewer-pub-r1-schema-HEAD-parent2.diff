+-- Cloudroom installation reservations survive company deletion. The historical company UUID
+-- is an immutable tombstone, not a live authorization reference; live resources have company FKs.
+CREATE TABLE public.local_installations (
+    installation_id uuid PRIMARY KEY CHECK (installation_id <> '00000000-0000-0000-0000-000000000000'),
+    company_id uuid NOT NULL,
+    paired_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    UNIQUE (company_id, installation_id)
+);
+
+CREATE TABLE public.local_machines (
+    id uuid PRIMARY KEY,
+    company_id uuid NOT NULL REFERENCES public.companies(id) ON DELETE CASCADE,
+    installation_id uuid NOT NULL UNIQUE,
+    name text NOT NULL CHECK (octet_length(name) BETWEEN 1 AND 128 AND name = btrim(name)),
+    state text NOT NULL DEFAULT 'enabled' CHECK (state IN ('enabled','disabled','revoked')),
+    credential_generation bigint NOT NULL DEFAULT 1 CHECK (credential_generation > 0),
+    last_seen_at timestamptz,
+    last_native_success_at timestamptz,
+    last_connection_issue text CHECK (last_connection_issue IN ('incompatible_protocol','recovery_required','connection_failed')),
+    capabilities_sequence bigint CHECK (capabilities_sequence > 0),
+    connection_generation bigint NOT NULL DEFAULT 0 CHECK (connection_generation >= 0),
+    connection_owner uuid,
+    connection_expires_at timestamptz,
+    acknowledged_sequence bigint NOT NULL DEFAULT 0 CHECK (acknowledged_sequence >= 0),
+    journal_id uuid CHECK (journal_id <> '00000000-0000-0000-0000-000000000000'),
+    reconciled_generation bigint NOT NULL DEFAULT 0 CHECK (reconciled_generation >= 0),
+    journal_generation bigint NOT NULL DEFAULT 0 CHECK (journal_generation >= 0),
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    revoked_at timestamptz,
+    UNIQUE (company_id, id),
+    UNIQUE (company_id, id, installation_id),
+    FOREIGN KEY (company_id, installation_id) REFERENCES public.local_installations(company_id, installation_id),
+    CHECK ((connection_owner IS NULL) = (connection_expires_at IS NULL)),
+    CHECK (connection_owner IS NULL OR connection_generation > 0),
+    CHECK (reconciled_generation <= connection_generation),
+    CHECK (journal_generation <= connection_generation),
+    CHECK ((state = 'revoked') = (revoked_at IS NOT NULL)),
+    CHECK (state <> 'revoked' OR connection_owner IS NULL)
