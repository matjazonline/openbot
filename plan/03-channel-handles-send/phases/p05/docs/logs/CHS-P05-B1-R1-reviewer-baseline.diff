+    );
+    let WaitProgress::Completed(done) = s.p().resume_wait(first.answer).await.unwrap() else {
+        panic!("first reply");
+    };
+    let scope = done.successor.unwrap();
+    let claim = s
+        .p()
+        .claim_io(scope, WorkflowWorkerId(Uuid::new_v4()), lease())
