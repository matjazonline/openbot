+        .await
+        .unwrap();
+    assert_eq!(
+        final_step.response_disposition,
+        Some(crate::domain::workflow::ResponseDisposition::Suppressed)
+    );
+    let c = counts(&s, first.run).await;
+    assert_eq!(c.questions, 2);
+    assert_eq!(c.destinations, 2);
