+        .p()
+        .claim_io(scope, WorkflowWorkerId(Uuid::new_v4()), lease())
+        .await
+        .unwrap()
+        .unwrap();
+    let asked = Box::pin(published(s, &PendingQuestion { scope, claim })).await;
+    ChildQuestion { parent, asked }
+}
