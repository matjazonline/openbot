+fn schema_input(inputs: &Value, name: &str) -> AppResult<Value> {
+    inputs
+        .get(name)
+        .cloned()
+        .ok_or_else(|| invalid("Model step input schema is missing"))
+}
+
+fn invalid(message: &str) -> AppError {
+    AppError::BadRequest(message.into())
+}
