+    offered.sort();
+    assert_eq!(offered, reachable, "the owner authoring a Sales agent");
+    // Connections: one in Sales is offered, one in Support is not.
+    let mut ids = Vec::new();
+    for (slug, unit) in [("sales-crm", m.d.unit.id), ("support-crm", m.d.sibling.id)] {
