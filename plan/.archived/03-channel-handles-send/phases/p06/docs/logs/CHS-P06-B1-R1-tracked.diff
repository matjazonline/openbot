+## Channel response verification
+
+Use disposable PostgreSQL18 databases and the loopback network guard. The focused response groups
+are `channel_reply_authoring_`, `channel_reply_views_` and `channel_reply_controls_`:
+
+```sh
+scripts/test-network-isolation.sh cargo test --locked --offline --lib channel_reply_authoring_
+scripts/test-network-isolation.sh cargo test --locked --offline --lib channel_reply_views_
+scripts/test-network-isolation.sh cargo test --locked --offline --lib channel_reply_controls_
+```
+
+Authoring coverage includes settings authorization/CAS, invalid projection, preserved and escaped
+stale input, native create replay after explicit clear, competing create claimants, rollback of
+invalid custom terminal routes, edited approval/rejection, all five compiling/executing examples,
+and sealed sample response identity. Views cover independent execution/publication/transport states,
+source identity outside the message window, response pagination, current classification/tenant
+visibility and real transaction-only delivery wakeups. Controls retain accepted/unknown truth and
+provide no blind resend or completed-business retry button.
+
+Affected checks also include native provisioning/onboarding, template/fixture composition, registry
+terminal routes, authoring/sample/run/conversation/decision browser protocols, capability-boundary
+checks, `npm run check:css`, formatting, locked offline compilation/Clippy, fresh migrations and
+actual `cargo sqlx prepare` followed by `cargo sqlx prepare --check -- --all-targets`. Set owned
+`DATABASE_URL` and `TEST_DATABASE_URL`; never use a development/production reset for this purpose.
+Keep stock2MiB test stacks for focused runtime evidence. Run only affected tests during this task,
+including final integration, per the explicit targeted-only instruction; do not claim a full-suite
+pass. Exact executed commands, nonzero selected counts, failures and independent review identities
+belong in plan03 phase records. A test name in this map alone is not passing evidence.
diff --git a/migrations/20260817000000_init_schema.sql b/migrations/20260817000000_init_schema.sql
index d93d1990..79a32d5e 100644
--- a/migrations/20260817000000_init_schema.sql
+++ b/migrations/20260817000000_init_schema.sql
@@ -13518,3 +13518,52 @@ CREATE CONSTRAINT TRIGGER workflow_question_provider_entry_guard AFTER UPDATE ON
     DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
     WHEN (NEW.status='sending' AND OLD.status IN ('prepared','retryable'))
     EXECUTE FUNCTION public.workflow_question_provider_entry_guard();
+
+-- Response/delivery changes wake existing readers; events carry identities, never payloads.
+CREATE FUNCTION public.notify_channel_response_run(tenant uuid, responding_run uuid) RETURNS void
+LANGUAGE plpgsql AS $$
+DECLARE related record;
+BEGIN
+    FOR related IN
+        SELECT run.company_id,run.id,run.channel_id,run.thread_id,run.state,run.waiting_reason
+        FROM public.workflow_runs AS run
+        WHERE run.company_id=tenant AND (run.id=responding_run OR run.id=(
+            SELECT budget.root_run_id FROM public.workflow_run_budgets AS budget
+            WHERE budget.company_id=tenant AND budget.run_id=responding_run))
+        ORDER BY run.id LIMIT 2
+    LOOP
+        PERFORM pg_notify('workflow_run_changed',json_build_object(
+            'company_id',related.company_id,'channel_id',related.channel_id,'thread_id',related.thread_id,
+            'run_id',related.id,'state',related.state,'waiting_reason',related.waiting_reason)::text);
+        IF related.thread_id IS NOT NULL THEN
+            PERFORM pg_notify('thread_activity',json_build_object(
+                'company_id',related.company_id,'channel_id',related.channel_id,'thread_id',related.thread_id)::text);
+        END IF;
+    END LOOP;
+END $$;
+
+CREATE FUNCTION public.notify_channel_reply_decision_changed() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    PERFORM public.notify_channel_response_run(NEW.company_id,NEW.run_id);
+    RETURN NULL;
+END $$;
+CREATE TRIGGER channel_reply_decision_notify_inserted AFTER INSERT ON public.channel_reply_decisions
+    FOR EACH ROW EXECUTE FUNCTION public.notify_channel_reply_decision_changed();
+CREATE TRIGGER channel_reply_decision_notify_changed AFTER UPDATE OF state ON public.channel_reply_decisions
+    FOR EACH ROW WHEN (OLD.state IS DISTINCT FROM NEW.state)
+    EXECUTE FUNCTION public.notify_channel_reply_decision_changed();
+
+CREATE FUNCTION public.notify_channel_response_delivery_changed() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE owner_run uuid;
+BEGIN
+    SELECT owner.run_id INTO owner_run
+        FROM public.workflow_channel_message_owner(NEW.company_id,NEW.message_id) AS owner
+        WHERE owner.delivery_id=NEW.id LIMIT 1;
+    IF owner_run IS NOT NULL THEN
+        PERFORM public.notify_channel_response_run(NEW.company_id,owner_run);
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE TRIGGER channel_response_delivery_notify_changed AFTER UPDATE OF status ON public.message_deliveries
+    FOR EACH ROW WHEN (OLD.status IS DISTINCT FROM NEW.status)
+    EXECUTE FUNCTION public.notify_channel_response_delivery_changed();
