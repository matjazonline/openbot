+        responses_published(&d,1).await && d.count("SELECT count(*) FROM workflow_message_intents WHERE company_id=$1 AND outcome IS NOT NULL").await==3
+    })).await;
+    let provider = delivery.stop().await;
+    let rows = finals(&d).await;
