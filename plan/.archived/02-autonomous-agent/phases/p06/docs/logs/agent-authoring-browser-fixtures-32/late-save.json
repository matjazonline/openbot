{"body":"\n        <section id=\"agent-pane\" data-skeleton=\"pane\" class=\"ui-pane-detail flex min-w-0 flex-1 flex-col bg-base-100\">\n            <div class=\"border-b border-base-300 px-4 py-4 sm:px-6\">\n                <div class=\"flex flex-wrap items-start justify-between gap-3\">\n                    <div class=\"flex min-w-0 grow basis-48 items-center gap-3\">\n                        <div class=\"avatar avatar-placeholder shrink-0\">\n                    <div class=\"relative w-12 rounded-full bg-primary text-primary-content\">\n                        <span class=\"text-lg font-bold\">D</span>\n                        \n                    </div>\n                </div>\n                        <div class=\"min-w-0\">\n                            <h2 class=\"truncate text-xl font-bold\">Draft &lt;browser&gt;</h2>\n                            <p class=\"truncate font-mono text-xs opacity-60\">@authoring · openai / gpt-test</p>\n                            <p class=\"truncate text-xs opacity-50\">Created by System</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"flex-1 overflow-y-auto px-4 py-4 sm:px-6\">\n                \n                <form method=\"post\" action=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-disabled-elt=\"find button[type='submit']\" hx-put=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-target=\"#agent-pane\" hx-swap=\"outerHTML\"\n                    hx-params=\"not avatar_file\" class=\"space-y-4\">\n                    <input type=\"hidden\" name=\"form_mode\" value=\"advanced\">\n                    <input type=\"hidden\" name=\"expected_revision\" value=\"4\">\n                    \n                    <div class=\"grid grid-cols-1 gap-4 md:grid-cols-2\">\n                        <label class=\"form-control w-full\">\n                            <div class=\"label\"><span class=\"text-xs opacity-70\">Agent Name</span></div>\n                            <input type=\"text\" name=\"name\" required value=\"Draft &lt;browser&gt;\" placeholder=\"Support Triage\"\n                                data-input=\"slugify\"\n                                class=\"input w-full\">\n                        </label>\n                        <label class=\"form-control w-full\">\n                            <div class=\"label\"><span class=\"text-xs opacity-70\">Handle</span></div>\n                            <input type=\"text\" name=\"slug\" required value=\"authoring\" placeholder=\"support-triage\"\n                                data-input=\"agent-address-preview\" data-address-preview=\"agent-address-preview\"\n                                class=\"input w-full font-mono\">\n                        </label>\n                    </div>\n                    \n                    <div id=\"agent-avatar-068f257a-c863-427c-8a75-8202ad17984b\" class=\"form-control w-full\">\n                        <div class=\"label\"><span class=\"text-xs opacity-70\">Agent Picture</span></div>\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"avatar avatar-placeholder shrink-0\">\n                    <div class=\"relative w-12 rounded-full bg-primary text-primary-content\">\n                        <span class=\"text-lg font-bold\">D</span>\n                        \n                    </div>\n                </div>\n                            <input type=\"hidden\" name=\"avatar_url\" value=\"\">\n                            <input type=\"file\" name=\"avatar_file\" accept=\"image/png,image/jpeg,image/gif,image/webp\"\n                                class=\"file-input file-input-sm w-full max-w-xs\"\n                                hx-post=\"/ui/uploads/avatar\" hx-encoding=\"multipart/form-data\"\n                                hx-target=\"#agent-avatar-068f257a-c863-427c-8a75-8202ad17984b\" hx-swap=\"outerHTML\"\n                                hx-params=\"avatar_file,avatar_url,avatar_field_id,avatar_name\" hx-vals=\"{&quot;avatar_field_id&quot;:&quot;agent-avatar-068f257a-c863-427c-8a75-8202ad17984b&quot;,&quot;avatar_name&quot;:&quot;Draft &lt;browser&gt;&quot;}\"\n                                hx-disabled-elt=\"this\" hx-indicator=\"#agent-avatar-068f257a-c863-427c-8a75-8202ad17984b-spinner\">\n                            <span id=\"agent-avatar-068f257a-c863-427c-8a75-8202ad17984b-spinner\" class=\"htmx-indicator loading loading-spinner loading-sm\"></span>\n                            \n                        </div>\n                        <div class=\"label\"><span class=\"text-[11px] opacity-60\">PNG, JPEG, GIF or WebP, up to 5 MB. Saved when you save this form.</span></div>\n                    </div>\n        \n                    <div class=\"form-control w-full\">\n                        <div class=\"label justify-between\">\n                            <span class=\"text-xs opacity-70\">System Prompt</span>\n                            <button type=\"button\" class=\"btn btn-ghost btn-xs\"\n                                data-action=\"toggle-agent-prompt\" data-prefix=\"068f257a-c863-427c-8a75-8202ad17984b\"><svg class=\"inline-block shrink-0 h-4 w-4\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M7.53 1.282a.5.5 0 0 1 .94 0l.478 1.306a7.492 7.492 0 0 0 4.464 4.464l1.305.478a.5.5 0 0 1 0 .94l-1.305.478a7.492 7.492 0 0 0-4.464 4.464l-.478 1.305a.5.5 0 0 1-.94 0l-.478-1.305a7.492 7.492 0 0 0-4.464-4.464L1.282 8.47a.5.5 0 0 1 0-.94l1.306-.478a7.492 7.492 0 0 0 4.464-4.464Z\"/></svg> Generate with AI</button>\n                        </div>\n                        \n                        <div id=\"agent-generator-068f257a-c863-427c-8a75-8202ad17984b\" class=\"mb-2 hidden space-y-2 rounded-box border border-base-300 bg-base-200 p-3\">\n                            <p class=\"text-xs opacity-70\">Describe what this agent should do. The instructions are expanded into a full system prompt, replacing what is in the field below.</p>\n                            <textarea id=\"agent-instructions-068f257a-c863-427c-8a75-8202ad17984b\" name=\"instructions\" rows=\"3\"\n                                placeholder=\"Answer billing questions politely, and escalate anything about refunds.\"\n                                class=\"textarea w-full text-xs\"></textarea>\n                            <div class=\"flex items-center gap-3\">\n                                <button type=\"button\" class=\"btn btn-primary btn-outline btn-sm\"\n                                    method=\"post\" action=\"/ui/agents/generate-prompt?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-post=\"/ui/agents/generate-prompt?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                                    hx-include=\"#agent-instructions-068f257a-c863-427c-8a75-8202ad17984b, #agent-provider-068f257a-c863-427c-8a75-8202ad17984b, #agent-model-068f257a-c863-427c-8a75-8202ad17984b, #agent-api-key-068f257a-c863-427c-8a75-8202ad17984b\" hx-vals='{\"id_prefix\": \"068f257a-c863-427c-8a75-8202ad17984b\"}'\n                                    hx-target=\"#agent-generator-status-068f257a-c863-427c-8a75-8202ad17984b\" hx-swap=\"innerHTML\"\n                                    hx-disabled-elt=\"this\">\n                                    <span class=\"loading loading-spinner loading-sm hidden [.htmx-request_&]:inline-block\"></span>\n                                    <span class=\"[.htmx-request_&]:hidden\">Generate</span>\n                                    <span class=\"hidden [.htmx-request_&]:inline\">Writing prompt...</span>\n                                </button>\n                                <div id=\"agent-generator-status-068f257a-c863-427c-8a75-8202ad17984b\" class=\"min-w-0 flex-1 text-xs\"></div>\n                            </div>\n                        </div>\n        \n                        <textarea id=\"agent-prompt-068f257a-c863-427c-8a75-8202ad17984b\" name=\"system_prompt\" rows=\"10\"\n                            placeholder=\"You are a support triage agent. Read the incoming mail, decide...\"\n                            class=\"textarea w-full font-mono text-xs\">browser unsaved prompt marker</textarea>\n                    </div>\n                    <details class=\"collapse-arrow collapse border border-base-300 bg-base-200\" open>\n                        <summary class=\"collapse-title text-sm font-medium\">Capabilities &amp; advanced options</summary>\n                        <div class=\"collapse-content space-y-4\">\n                            <section class=\"space-y-5 rounded-box border border-base-300 bg-base-100 p-4\" data-agent-capability-picker>\n            <div><h3 class=\"font-semibold\">Agent capabilities</h3><p class=\"text-xs opacity-60\">Explicitly choose what this agent may use.</p></div>\n            <section class=\"space-y-2\" data-capability-multi-select>\n            <input type=\"hidden\" name=\"skill_ids\" value=\"fcc122f2-f217-4c32-909f-1f03cb68a5d9,f6e8950a-4a56-468f-837c-9983d5711a65\">\n            <div class=\"flex items-center justify-between\"><h4 class=\"text-sm font-semibold\">Skills</h4><a class=\"btn btn-ghost btn-xs\" href=\"/ui/companies?company_id=790faccc-7b29-4ba2-99c7-c33038704229&amp;tab=skills\">Browse library</a></div>\n            <p class=\"text-xs opacity-60\">Selected skills are applied in the order shown. Use the arrow buttons to reorder them; their current text is copied when you publish.</p><div class=\"grid grid-cols-1 gap-2\"><div class=\"flex items-start gap-3 rounded-box border border-base-300 p-3\" data-agent-skill-row>\n            <label class=\"flex cursor-pointer items-start gap-3 grow\"><input type=\"checkbox\" class=\"checkbox checkbox-primary mt-0.5\" value=\"fcc122f2-f217-4c32-909f-1f03cb68a5d9\" data-action=\"capability-multi-select\" checked>\n            <span><span class=\"font-medium\">alpha</span><span class=\"block text-xs opacity-60\">Use alpha</span></span></label>\n            <div class=\"flex flex-col gap-1\"><button type=\"button\" class=\"btn btn-ghost btn-xs\" data-agent-skill-move=\"up\" aria-label=\"Move skill alpha earlier\">↑</button><button type=\"button\" class=\"btn btn-ghost btn-xs\" data-agent-skill-move=\"down\" aria-label=\"Move skill alpha later\">↓</button></div></div><div class=\"flex items-start gap-3 rounded-box border border-base-300 p-3\" data-agent-skill-row>\n            <label class=\"flex cursor-pointer items-start gap-3 grow\"><input type=\"checkbox\" class=\"checkbox checkbox-primary mt-0.5\" value=\"f6e8950a-4a56-468f-837c-9983d5711a65\" data-action=\"capability-multi-select\" checked>\n            <span><span class=\"font-medium\">zeta</span><span class=\"block text-xs opacity-60\">Use zeta</span></span></label>\n            <div class=\"flex flex-col gap-1\"><button type=\"button\" class=\"btn btn-ghost btn-xs\" data-agent-skill-move=\"up\" aria-label=\"Move skill zeta earlier\">↑</button><button type=\"button\" class=\"btn btn-ghost btn-xs\" data-agent-skill-move=\"down\" aria-label=\"Move skill zeta later\">↓</button></div></div></div></section>\n        </section>\n                            <div class=\"grid grid-cols-1 gap-4 md:grid-cols-2\">\n            <label class=\"form-control w-full\"><div class=\"label\"><span class=\"text-xs opacity-70\">Provider</span></div>\n                <select id=\"agent-provider-068f257a-c863-427c-8a75-8202ad17984b\" name=\"provider\" class=\"select w-full font-mono text-sm\">\n                    <option value=\"\">Inherit company default</option><option value=\"openai\" selected>openai</option>\n                </select>\n            </label>\n            <label class=\"form-control w-full\"><div class=\"label\"><span class=\"text-xs opacity-70\">Model</span></div>\n                <select id=\"agent-model-068f257a-c863-427c-8a75-8202ad17984b\" name=\"model\" class=\"select w-full font-mono text-sm\">\n                    <option value=\"\">Inherit company default</option><option value=\"gpt-test\" data-provider=\"openai\" selected>openai / gpt-test</option>\n                </select>\n                <div class=\"label\"><span class=\"text-[11px] opacity-60\">Select a model belonging to the provider; invalid pairs are refused on save.</span></div>\n            </label>\n        </div>\n                            <label class=\"form-control w-full\">\n                                <div class=\"label\">\n                                    <span class=\"text-xs opacity-70\">Description</span>\n                                    <span class=\"text-xs opacity-50\">Shown to other agents in this company</span>\n                                </div>\n                                <input type=\"text\" id=\"agent-description-068f257a-c863-427c-8a75-8202ad17984b\" name=\"description\" value=\"\" placeholder=\"Answers supplier capacity and delivery-date questions\"\n                                    class=\"input w-full text-sm\">\n                            </label>\n\n                        </div>\n                    </details>\n        \n                    <section class=\"space-y-3 rounded-box border border-base-300 p-4\" data-agent-tools-editor>\n        <h3 class=\"font-semibold\">Tools for this agent</h3>\n        <p class=\"text-xs opacity-70\">Aliases are the names the agent sees. Each tool has an explicit target. Selecting a tool does not grant a connection or approve its operation. Builder provisioning tools can only be kept or removed.</p>\n        <input type=\"hidden\" name=\"tool_assignments\" value=\"[{&quot;binding&quot;:&quot;6c610594-6b7f-465d-b72b-dfee20a7a115&quot;,&quot;alias&quot;:&quot;respond&quot;,&quot;choice&quot;:{&quot;kind&quot;:&quot;builtin&quot;,&quot;tool&quot;:&quot;message_reply&quot;}}]\">\n        <div data-agent-tool-rows><div class=\"my-2 rounded border border-base-300 p-3\" data-agent-tool-row data-assignment=\"{&quot;binding&quot;:&quot;6c610594-6b7f-465d-b72b-dfee20a7a115&quot;,&quot;alias&quot;:&quot;respond&quot;,&quot;choice&quot;:{&quot;kind&quot;:&quot;builtin&quot;,&quot;tool&quot;:&quot;message_reply&quot;}}\">\n        <label class=\"form-control\">Agent-visible alias<input class=\"input input-sm\" data-agent-tool-alias value=\"respond\" maxlength=\"64\" required aria-label=\"Tool 1 alias\"></label>\n        <p class=\"break-all text-xs opacity-70\" data-agent-tool-target>Built-in message.reply</p>\n        <p class=\"break-all font-mono text-xs\">Binding: 6c610594-6b7f-465d-b72b-dfee20a7a115</p>\n        <button type=\"button\" class=\"btn btn-ghost btn-xs\" data-agent-tool-remove>Remove from draft</button></div></div><p data-agent-tool-error role=\"alert\"></p>\n        <div id=\"agent-tool-catalog-068f257a-c863-427c-8a75-8202ad17984b\" hx-get=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b/tool-catalog?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-trigger=\"load\" hx-params=\"none\" hx-target=\"this\" hx-swap=\"outerHTML\" hx-sync=\"this:replace\"><span class=\"loading loading-spinner loading-sm\"></span> Loading tool catalog</div>\n        </section>\n                    <div class=\"flex items-center gap-3 border-t border-base-300 pt-4\">\n                        <button type=\"submit\" class=\"btn btn-primary\">\n                            <span class=\"loading loading-spinner loading-sm hidden [.htmx-request_&]:inline-block\"></span>\n                            <span class=\"[.htmx-request_&]:hidden\">Save Changes</span>\n                            <span class=\"hidden [.htmx-request_&]:inline\">Saving...</span>\n                        </button>\n                        <button type=\"button\" class=\"btn btn-ghost\"\n                            hx-get=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                            hx-target=\"#agent-pane\" hx-swap=\"outerHTML\" hx-sync=\"#agent-pane:replace\">Cancel</button>\n                        <button type=\"button\" class=\"btn btn-error btn-outline ml-auto\"\n                            hx-delete=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                            hx-target=\"#agent-pane\" hx-swap=\"outerHTML\"\n                            hx-confirm=\"Delete agent 'Draft &lt;browser&gt;'? This cannot be undone.\"\n                            hx-push-url=\"/ui/agents?company_id=790faccc-7b29-4ba2-99c7-c33038704229\">Delete Agent</button>\n                    </div>\n                </form>\n                <form id=\"agent-catalog-form-068f257a-c863-427c-8a75-8202ad17984b\" class=\"hidden\"></form>\n                \n                <section id=\"assistant-channel-card\" class=\"mt-6 space-y-3 rounded-box border border-base-300 p-4\">\n                    <div>\n                        <h3 class=\"font-semibold\">Assistant channel</h3>\n                        <p class=\"text-sm opacity-70\">Create a team channel (never public) that this agent answers. Autonomous replies send the agent's answer directly; reviewed replies wait for your approval first.</p>\n                    </div>\n                    \n                    <form hx-post=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b/assistant-channel?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                        hx-target=\"#assistant-channel-card\" hx-swap=\"outerHTML\"\n                        hx-disabled-elt=\"find button[type='submit']\" class=\"grid gap-3 sm:grid-cols-2\">\n                        <input type=\"hidden\" name=\"command_key\" value=\"c19bc028-14d6-4d7c-beea-6cee6f0de398\">\n                        <label class=\"form-control w-full\">\n                            <div class=\"label\"><span class=\"text-xs opacity-70\">Channel name</span></div>\n                            <input class=\"input w-full\" name=\"channel_name\" required maxlength=\"120\" value=\"Draft &lt;browser&gt;\">\n                        </label>\n                        <label class=\"form-control w-full\">\n                            <div class=\"label\"><span class=\"text-xs opacity-70\">Channel address</span></div>\n                            <input class=\"input w-full font-mono\" name=\"channel_slug\" required maxlength=\"64\" placeholder=\"authoring-assistant\">\n                        </label>\n                        <label class=\"form-control w-full\">\n                            <div class=\"label\"><span class=\"text-xs opacity-70\">Replies</span></div>\n                            <select class=\"select w-full\" name=\"reply_mode\">\n                                <option value=\"autonomous\">Autonomous</option>\n                                <option value=\"reviewed\">Reviewed by me</option>\n                            </select>\n                        </label>\n                        <div class=\"flex items-end\">\n                            <button type=\"submit\" class=\"btn btn-outline\">Create assistant channel</button>\n                        </div>\n                    </form>\n                </section>\n        \n                <section id=\"agent-publication-068f257a-c863-427c-8a75-8202ad17984b\" class=\"mt-6 space-y-4 rounded-box border border-base-300 p-4\" hx-sync=\"this:queue all\" hx-disabled-elt=\"#agent-publication-068f257a-c863-427c-8a75-8202ad17984b button\">\n        <h3 class=\"font-semibold\">Saved draft and publication</h3>\n        <p>Saved draft: <span data-agent-saved-draft>4</span></p><p class=\"break-all\">Active revision: <span data-agent-active-revision>Inactive — publish a valid draft before using this agent in a new run</span></p>\n        <p class=\"text-sm opacity-70\">Future runs use the active revision. Running work and retries keep the revision they selected. Removing or revoking access may stop running work. Changes to shared skills enter this agent when you publish again.</p>\n        <p class=\"text-xs opacity-70\">Publication uses the saved draft. Save your editor changes first.</p>\n        <div class=\"flex flex-wrap gap-2\"><form hx-post=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b/preview?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-target=\"#agent-publication-068f257a-c863-427c-8a75-8202ad17984b\" hx-swap=\"outerHTML\"><button class=\"btn btn-outline btn-sm\">Validate saved draft</button></form>\n        <form hx-post=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b/publish?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-target=\"#agent-publication-068f257a-c863-427c-8a75-8202ad17984b\" hx-swap=\"outerHTML\"><input type=\"hidden\" name=\"expected_draft_revision\" value=\"4\"><input type=\"hidden\" name=\"expected_active_revision\" value=\"\"><input type=\"hidden\" name=\"key\" value=\"e0e5e17b-e112-48db-a954-ea5f1d096bd1\"><button class=\"btn btn-primary btn-sm\">Publish saved draft</button></form>\n        <button type=\"button\" class=\"btn btn-ghost btn-sm\" hx-get=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b/publication?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-params=\"none\" hx-target=\"#agent-publication-068f257a-c863-427c-8a75-8202ad17984b\" hx-swap=\"outerHTML\">Reload publication status</button></div>\n        <div class=\"space-y-2\"></div><section id=\"agent-history-068f257a-c863-427c-8a75-8202ad17984b\" class=\"space-y-2\"><h4 class=\"font-semibold\">Revision history</h4><p class=\"text-xs opacity-60\">Up to 20 revisions per page, newest first.</p><ol class=\"space-y-2\"></ol></section></section>\n                <div class=\"mt-6 rounded-box border border-dashed border-base-300 p-4 text-xs opacity-70\" aria-busy=\"true\"\n            hx-get=\"/ui/workflows/agents/068f257a-c863-427c-8a75-8202ad17984b/usage?company_id=790faccc-7b29-4ba2-99c7-c33038704229\" hx-trigger=\"load\" hx-swap=\"outerHTML\" data-lazy-card=\"Where this agent is used could not be loaded.\">Loading where this agent is used…</div>\n            </div>\n        \n        </section>\n        <ul id=\"agent-menu\" class=\"menu w-full flex-1 flex-nowrap gap-1 overflow-y-auto px-2\" hx-swap-oob=\"outerHTML\">\n                <li>\n                    <a class=\"flex items-center gap-3 \"\n                        hx-get=\"/ui/agents/a4e6eb88-e549-477d-a494-60e875d0b9af?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                        hx-target=\"#agent-pane\" hx-swap=\"outerHTML\"\n                        hx-sync=\"#agent-pane:replace\"\n                        hx-push-url=\"/ui/agents?company_id=790faccc-7b29-4ba2-99c7-c33038704229&agent_id=a4e6eb88-e549-477d-a494-60e875d0b9af\"\n                        data-action=\"select-sidebar-item\">\n                        <div class=\"avatar avatar-placeholder shrink-0\">\n                    <div class=\"relative w-8 rounded-full bg-primary text-primary-content\">\n                        <span class=\"text-xs font-bold\">N</span>\n                        \n                    </div>\n                </div>\n                        <span class=\"flex min-w-0 flex-1 flex-col items-start gap-0.5\">\n                            <span class=\"flex w-full min-w-0 flex-wrap items-center gap-2\">\n                                <span class=\"min-w-0 truncate\">Navigator</span>\n                            </span>\n                            <span class=\"w-full truncate font-mono text-[11px] opacity-60\">@navigator</span>\n                            <span class=\"w-full truncate font-mono text-[11px] opacity-60\">company default model</span>\n                        </span>\n                    </a>\n                </li>\n        \n                <li>\n                    <a class=\"flex items-center gap-3 menu-active\"\n                        hx-get=\"/ui/agents/068f257a-c863-427c-8a75-8202ad17984b?company_id=790faccc-7b29-4ba2-99c7-c33038704229\"\n                        hx-target=\"#agent-pane\" hx-swap=\"outerHTML\"\n                        hx-sync=\"#agent-pane:replace\"\n                        hx-push-url=\"/ui/agents?company_id=790faccc-7b29-4ba2-99c7-c33038704229&agent_id=068f257a-c863-427c-8a75-8202ad17984b\"\n                        data-action=\"select-sidebar-item\">\n                        <div class=\"avatar avatar-placeholder shrink-0\">\n                    <div class=\"relative w-8 rounded-full bg-primary text-primary-content\">\n                        <span class=\"text-xs font-bold\">D</span>\n                        \n                    </div>\n                </div>\n                        <span class=\"flex min-w-0 flex-1 flex-col items-start gap-0.5\">\n                            <span class=\"flex w-full min-w-0 flex-wrap items-center gap-2\">\n                                <span class=\"min-w-0 truncate\">Draft &lt;browser&gt;</span>\n                            </span>\n                            <span class=\"w-full truncate font-mono text-[11px] opacity-60\">@authoring</span>\n                            <span class=\"w-full truncate font-mono text-[11px] opacity-60\">openai / gpt-test</span>\n                        </span>\n                    </a>\n                </li>\n        </ul>","headers":[["content-type","text/html; charset=utf-8"],["hx-push-url","/ui/agents?company_id=790faccc-7b29-4ba2-99c7-c33038704229&agent_id=068f257a-c863-427c-8a75-8202ad17984b"]]}