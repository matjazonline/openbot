#[instrument(skip_all)]
async fn delete_company(
    State(company_use_cases): State<Arc<CompanyUseCases>>,
    _user: AuthenticatedUser,
    Path(id): Path<Uuid>,
) -> impl IntoResponse {
    let _ = company_use_cases
        .delete_company_for_user(_user.id, id)
        .await;
    Html(String::new())
}

