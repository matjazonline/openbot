index 0000000..7bf67d9
--- /dev/null
+++ b/src/adapters/persistence/workflow/storage_retention.rs
@@ -0,0 +1,111 @@
+use super::*;
+use crate::application::workflow::storage::{RetentionRoot, RetiredTree};
+use crate::domain::workflow::BudgetResource;
+
+pub(super) async fn retire_on(
+    db: &mut PgConnection,
+    root: RetentionRoot,
+) -> AppResult<Option<RetiredTree>> {
+    let company = root.company.as_uuid();
+    let root_id = root.run.as_uuid();
+    if sqlx::query_scalar::<_, Uuid>("SELECT id FROM companies WHERE id=$1 FOR KEY SHARE")
+        .bind(company)
+        .fetch_optional(&mut *db)
+        .await?
+        .is_none()
+    {
+        return Ok(None);
+    }
+    let owned: Option<Uuid> = sqlx::query_scalar(
+        "SELECT id FROM workflow_runs WHERE company_id=$1 AND id=$2
+        AND parent_run_id IS NULL AND state IN ('succeeded','failed','cancelled')
+        AND finished_at<clock_timestamp()-interval '90 days' FOR UPDATE SKIP LOCKED",
+    )
+    .bind(company)
+    .bind(root_id)
+    .fetch_optional(&mut *db)
+    .await?;
+    if owned.is_none() {
+        return Ok(None);
+    }
+    let runs: Vec<Uuid> = sqlx::query_scalar("SELECT run.id FROM workflow_runs AS run
+        JOIN workflow_run_budgets AS link ON link.company_id=run.company_id AND link.run_id=run.id
+        WHERE link.company_id=$1 AND link.root_run_id=$2 ORDER BY run.id LIMIT $3 FOR UPDATE OF run NOWAIT")
+        .bind(company).bind(root_id).bind(i64::from(BudgetResource::Activation.maximum())+1).fetch_all(&mut *db).await?;
+    if runs.is_empty() || runs.len() > BudgetResource::Activation.maximum() as usize {
+        return Err(AppError::Internal(
+            "Invalid retained workflow tree budget links".into(),
+        ));
+    }
+    let jobs = lock_dependents(db, company, root_id, &runs).await?;
+    let eligible: bool = sqlx::query_scalar(include_str!("storage_retention_eligible.sql"))
+        .bind(company)
+        .bind(&runs)
+        .fetch_one(&mut *db)
+        .await?;
+    if !eligible {
+        return Ok(None);
+    }
+    let calls = archive_usage(db, company, &runs).await?;
+    let removed = sqlx::query("DELETE FROM workflow_runs WHERE company_id=$1 AND id=ANY($2)")
+        .bind(company)
+        .bind(&runs)
+        .execute(&mut *db)
+        .await?
+        .rows_affected();
+    if removed != runs.len() as u64 {
+        return Err(AppError::Internal(
+            "Workflow retention lost a locked run".into(),
+        ));
+    }
+    // Run-owned cascades must precede job-owned append-only fact cascades. The job's
+    // execution FK is deferred until both statements have committed together.
+    let removed_jobs = sqlx::query(
+        "DELETE FROM background_tasks WHERE company_id=$1 AND id=ANY($2) AND queue_kind='workflow'",
+    )
+    .bind(company)
+    .bind(&jobs)
+    .execute(db)
+    .await?
+    .rows_affected();
+    if removed_jobs != jobs.len() as u64 {
+        return Err(AppError::Internal(
+            "Workflow retention lost a captured job".into(),
+        ));
+    }
+    Ok(Some(RetiredTree {
+        runs: removed,
+        jobs: removed_jobs,
+        calls,
+    }))
+}
+
+async fn lock_dependents(
+    db: &mut PgConnection,
+    company: Uuid,
+    root: Uuid,
+    runs: &[Uuid],
+) -> AppResult<Vec<Uuid>> {
+    let executions: Vec<Uuid> = sqlx::query_scalar("SELECT id FROM workflow_executions WHERE company_id=$1 AND run_id=ANY($2) ORDER BY id FOR UPDATE NOWAIT")
+        .bind(company).bind(runs).fetch_all(&mut *db).await?;
+    let jobs: Vec<Uuid> = sqlx::query_scalar("SELECT id FROM background_tasks WHERE company_id=$1 AND workflow_execution_id=ANY($2) ORDER BY id FOR UPDATE NOWAIT")
+        .bind(company).bind(&executions).fetch_all(&mut *db).await?;
+    sqlx::query("SELECT id FROM task_attempts WHERE task_id=ANY($1) ORDER BY id FOR UPDATE NOWAIT")
+        .bind(&jobs)
+        .fetch_all(&mut *db)
+        .await?;
+    sqlx::query("SELECT root_run_id FROM workflow_root_budget_usage WHERE company_id=$1 AND root_run_id=$2 FOR UPDATE NOWAIT")
+        .bind(company).bind(root).fetch_all(&mut *db).await?;
+    sqlx::query("SELECT request_id FROM model_usage_calls WHERE company_id=$1 AND run_id=ANY($2) ORDER BY request_id FOR UPDATE NOWAIT")
+        .bind(company).bind(runs).fetch_all(db).await?;
+    Ok(jobs)
+}
+
+async fn archive_usage(db: &mut PgConnection, company: Uuid, runs: &[Uuid]) -> AppResult<u64> {
+    Ok(sqlx::query("INSERT INTO model_usage_history(company_id,request_id,agent_id,workflow_id,version_id,provider,model,
+        requested_at,reserved_input,reserved_output,input_tokens,output_tokens,usage_source,settled_at)
+        SELECT company_id,request_id,agent_id,workflow_id,version_id,provider,model,
+        requested_at,reserved_input,reserved_output,input_tokens,output_tokens,usage_source,settled_at
+        FROM model_usage_calls WHERE company_id=$1 AND run_id=ANY($2)")
+        .bind(company).bind(runs).execute(db).await?.rows_affected())
+}
diff --git a/src/adapters/persistence/workflow/storage_retention_eligible.sql b/src/adapters/persistence/workflow/storage_retention_eligible.sql
new file mode 100644
index 0000000..50ec717
--- /dev/null
+++ b/src/adapters/persistence/workflow/storage_retention_eligible.sql
@@ -0,0 +1,25 @@
+SELECT
+    NOT EXISTS(SELECT 1 FROM workflow_runs WHERE company_id=$1 AND id=ANY($2) AND state NOT IN ('succeeded','failed','cancelled'))
+    AND NOT EXISTS(SELECT 1 FROM background_tasks AS job JOIN workflow_executions AS execution
+        ON execution.company_id=job.company_id AND execution.id=job.workflow_execution_id
+        WHERE execution.company_id=$1 AND execution.run_id=ANY($2) AND job.status IN ('pending','processing'))
+    AND NOT EXISTS(SELECT 1 FROM task_attempts AS attempt JOIN background_tasks AS job ON job.id=attempt.task_id
+        JOIN workflow_executions AS execution ON execution.company_id=job.company_id AND execution.id=job.workflow_execution_id
+        WHERE execution.company_id=$1 AND execution.run_id=ANY($2) AND attempt.status='processing')
+    AND NOT EXISTS(SELECT 1 FROM workflow_decisions AS decision JOIN workflow_waits AS wait
+        ON wait.company_id=decision.company_id AND wait.run_id=decision.run_id AND wait.id=decision.wait_id
+        WHERE decision.company_id=$1 AND decision.run_id=ANY($2) AND decision.submitted_at IS NULL AND wait.state='waiting')
+    AND NOT EXISTS(SELECT 1 FROM workflow_message_actions WHERE company_id=$1 AND run_id=ANY($2) AND state IN ('pending','uncertain','stalled'))
+    AND NOT EXISTS(SELECT 1 FROM workflow_runs WHERE company_id=$1 AND rerun_of_run_id=ANY($2) AND NOT (id=ANY($2)))
+    AND NOT EXISTS(SELECT 1 FROM workflow_action_evidence_conflicts WHERE company_id=$1 AND run_id=ANY($2))
+    AND NOT EXISTS(SELECT 1 FROM workflow_action_dispatches AS marker WHERE marker.company_id=$1 AND marker.run_id=ANY($2)
+        AND NOT EXISTS(SELECT 1 FROM workflow_action_receipts WHERE company_id=marker.company_id AND invocation_id=marker.invocation_id)
+        AND NOT EXISTS(SELECT 1 FROM workflow_action_evidence WHERE company_id=marker.company_id AND invocation_id=marker.invocation_id AND disposition='applied')
+        AND NOT (marker.effect_kind='remote' AND EXISTS(
+            SELECT 1 FROM workflow_action_evidence AS proof WHERE proof.company_id=marker.company_id AND proof.invocation_id=marker.invocation_id
+                AND proof.disposition='final_not_applied' AND proof.grant_eligible
+                -- Historical closure survives grant expiry, but cannot cover a later entry.
+                AND NOT EXISTS(SELECT 1 FROM workflow_action_remote_entries AS entry
+                    WHERE entry.company_id=marker.company_id AND entry.invocation_id=marker.invocation_id
+                    AND NOT EXISTS(SELECT 1 FROM workflow_action_evidence_coverage AS coverage
+                        WHERE coverage.company_id=proof.company_id AND coverage.evidence_id=proof.id AND coverage.remote_entry_id=entry.id)))))
diff --git a/src/adapters/persistence/workflow/storage_tests.rs b/src/adapters/persistence/workflow/storage_tests.rs
