+-- Agent conversations are independent of workflow disposition and delivery.
+-- Default private identities use their genuine root admission UUID, in a distinct type.
+CREATE TABLE public.agent_history_sessions (
+    company_id uuid NOT NULL REFERENCES public.companies(id) ON DELETE CASCADE,
+    id uuid NOT NULL,
+    creator_principal_id uuid NOT NULL,
+    live_creator_principal_id uuid,
+    creator_user_id uuid NOT NULL,
+    channel_id uuid,
+    thread_id uuid,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    PRIMARY KEY (company_id,id),
+    CONSTRAINT agent_history_sessions_live_creator_fk
+        FOREIGN KEY (company_id,live_creator_principal_id) REFERENCES public.principals(company_id,id)
+        ON DELETE SET NULL (live_creator_principal_id) DEFERRABLE INITIALLY DEFERRED,
+    FOREIGN KEY (company_id,channel_id) REFERENCES public.channels(company_id,id),
+    FOREIGN KEY (company_id,channel_id,thread_id) REFERENCES public.threads(company_id,channel_id,id),
+    CHECK (thread_id IS NULL OR channel_id IS NOT NULL)
+);
+CREATE TABLE public.workflow_agent_sessions (
+    company_id uuid NOT NULL,
+    run_id uuid NOT NULL,
+    session_id uuid NOT NULL,
+    thread_input_proven boolean NOT NULL DEFAULT false,
+    PRIMARY KEY (company_id,run_id),
+    FOREIGN KEY (company_id,run_id) REFERENCES public.workflow_runs(company_id,id) ON DELETE CASCADE,
+    FOREIGN KEY (company_id,session_id) REFERENCES public.agent_history_sessions(company_id,id)
+        DEFERRABLE INITIALLY DEFERRED
+);
+CREATE INDEX workflow_agent_sessions_by_session ON public.workflow_agent_sessions(company_id,session_id);
+CREATE TABLE public.agent_history_conversations (
+    company_id uuid NOT NULL REFERENCES public.companies(id) ON DELETE CASCADE,
+    id uuid NOT NULL,
+    agent_id uuid NOT NULL,
+    scope_kind text NOT NULL CHECK (scope_kind IN ('thread','private_session','child_branch')),
+    channel_id uuid,
+    thread_id uuid,
+    session_id uuid,
+    child_run_id uuid,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    last_exchange_order bigint NOT NULL DEFAULT 0 CHECK (last_exchange_order >= 0),
+    active_exchange_id uuid,
+    expired_count bigint NOT NULL DEFAULT 0 CHECK (expired_count BETWEEN 0 AND last_exchange_order),
+    expired_through_order bigint NOT NULL DEFAULT 0 CHECK (expired_through_order BETWEEN 0 AND last_exchange_order),
+    PRIMARY KEY (company_id,id),
+    UNIQUE (company_id,agent_id,id),
+    FOREIGN KEY (company_id,agent_id) REFERENCES public.agents(company_id,id),
+    FOREIGN KEY (company_id,channel_id,thread_id) REFERENCES public.threads(company_id,channel_id,id),
+    FOREIGN KEY (company_id,session_id) REFERENCES public.agent_history_sessions(company_id,id),
+    FOREIGN KEY (company_id,child_run_id) REFERENCES public.workflow_runs(company_id,id) ON DELETE CASCADE,
+    CHECK ((scope_kind='thread' AND channel_id IS NOT NULL AND thread_id IS NOT NULL
+            AND session_id IS NULL AND child_run_id IS NULL)
+        OR (scope_kind='private_session' AND session_id IS NOT NULL
+            AND channel_id IS NULL AND thread_id IS NULL AND child_run_id IS NULL)
+        OR (scope_kind='child_branch' AND child_run_id IS NOT NULL
+            AND channel_id IS NULL AND thread_id IS NULL AND session_id IS NULL))
+);
+CREATE UNIQUE INDEX agent_history_conversations_thread ON public.agent_history_conversations
+    (company_id,agent_id,channel_id,thread_id) WHERE scope_kind='thread';
+CREATE UNIQUE INDEX agent_history_conversations_private ON public.agent_history_conversations
+    (company_id,agent_id,session_id) WHERE scope_kind='private_session';
+CREATE UNIQUE INDEX agent_history_conversations_child ON public.agent_history_conversations
+    (company_id,agent_id,child_run_id) WHERE scope_kind='child_branch';
