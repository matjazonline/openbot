+-- Bounded private external-app consent; never Openbot sign-in state.
+CREATE TABLE integration_connect_attempts (
+    id UUID PRIMARY KEY,
+    owner_namespace TEXT NOT NULL,
+    owner_subject TEXT NOT NULL,
+    facts TEXT NOT NULL CHECK(octet_length(facts)<=4096 AND jsonb_typeof(facts::jsonb)='object'),
+    status TEXT NOT NULL CHECK(status IN ('pending','processing','connected','denied','expired','cancelled','missing_permissions','missing_refresh','identity_mismatch','conflict','provider_error','configuration','admin_blocked')),
+    envelope TEXT CHECK(octet_length(envelope)<=23000),
+    account_id UUID,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
+    expires_at TIMESTAMPTZ NOT NULL,
+    FOREIGN KEY(owner_namespace,owner_subject) REFERENCES integration_owner_states(owner_namespace,owner_subject),
+    FOREIGN KEY(owner_namespace,owner_subject,account_id) REFERENCES integration_accounts(owner_namespace,owner_subject,id) ON DELETE SET NULL(account_id),
+    CHECK(expires_at>created_at AND expires_at<=created_at+interval '10 minutes'),
+    CHECK((status='pending')=(envelope IS NOT NULL)),
+    CHECK(account_id IS NULL OR status='connected')
+);
+CREATE INDEX integration_connect_owner ON integration_connect_attempts(owner_namespace,owner_subject,created_at,id);
+CREATE FUNCTION integration_connect_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE retired_owner BOOLEAN; active_count BIGINT; terminal_count BIGINT; total_count BIGINT;
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        IF (NEW.id,NEW.owner_namespace,NEW.owner_subject,NEW.facts,NEW.created_at,NEW.expires_at)
+           IS DISTINCT FROM (OLD.id,OLD.owner_namespace,OLD.owner_subject,OLD.facts,OLD.created_at,OLD.expires_at) THEN
+            RAISE EXCEPTION 'immutable connect facts' USING ERRCODE='23514';
+        END IF;
+        IF NEW.status IS DISTINCT FROM OLD.status AND
+           NOT ((OLD.status='pending' AND NEW.status IN ('processing','expired','cancelled')) OR
+                (OLD.status='processing' AND NEW.status NOT IN ('pending','processing'))) THEN
+            RAISE EXCEPTION 'invalid connect transition' USING ERRCODE='23514';
+        END IF;
+        IF NEW.account_id IS DISTINCT FROM OLD.account_id AND
+           NOT ((OLD.status='processing' AND NEW.status='connected') OR NEW.account_id IS NULL) THEN
+            RAISE EXCEPTION 'invalid connect account' USING ERRCODE='23514';
+        END IF;
+        -- Rewrapping takes only this row. Never invert owner -> attempt locking.
+        IF NEW.status=OLD.status THEN RETURN NEW; END IF;
+    ELSE
+        INSERT INTO integration_owner_states(owner_namespace,owner_subject,retired)
+            VALUES(NEW.owner_namespace,NEW.owner_subject,FALSE) ON CONFLICT DO NOTHING;
+        IF NEW.status<>'pending' OR NEW.account_id IS NOT NULL THEN
+            RAISE EXCEPTION 'invalid initial connect state' USING ERRCODE='23514';
+        END IF;
+    END IF;
+    SELECT retired INTO retired_owner FROM integration_owner_states
+        WHERE owner_namespace=NEW.owner_namespace AND owner_subject=NEW.owner_subject FOR UPDATE;
+    IF retired_owner IS DISTINCT FROM FALSE THEN
+        RAISE EXCEPTION 'owner retired' USING ERRCODE='23514',CONSTRAINT='integration_owner_retired';
+    END IF;
+    SELECT count(*),count(*) FILTER(WHERE status IN ('pending','processing') AND expires_at>clock_timestamp()),
+           count(*) FILTER(WHERE status NOT IN ('pending','processing'))
+      INTO total_count,active_count,terminal_count FROM integration_connect_attempts
+      WHERE owner_namespace=NEW.owner_namespace AND owner_subject=NEW.owner_subject AND id<>NEW.id;
+    IF total_count>=40 OR (NEW.status IN ('pending','processing') AND active_count>=8) OR
+       (NEW.status NOT IN ('pending','processing') AND terminal_count>=32) THEN
+        RAISE EXCEPTION 'connect cap reached' USING ERRCODE='23514',CONSTRAINT='integration_connect_cap';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER integration_connect_guard BEFORE INSERT OR UPDATE ON integration_connect_attempts
+    FOR EACH ROW EXECUTE FUNCTION integration_connect_guard();
