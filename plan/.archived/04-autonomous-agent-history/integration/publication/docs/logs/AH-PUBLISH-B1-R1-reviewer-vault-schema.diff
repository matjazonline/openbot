+-- Owner consent is module-owned. Host identities remain opaque, with no host FK.
+ALTER TABLE public.integration_accounts ADD UNIQUE (owner_namespace,owner_subject,id);
+CREATE TABLE public.integration_use_grants (
+    id uuid PRIMARY KEY,
+    account_id uuid NOT NULL,
+    owner_namespace text NOT NULL,
+    owner_subject text NOT NULL,
+    host_scope text NOT NULL CHECK (octet_length(host_scope) BETWEEN 1 AND 256),
+    host_binding text NOT NULL CHECK (octet_length(host_binding) BETWEEN 1 AND 256),
+    app_id text NOT NULL CHECK (octet_length(app_id) BETWEEN 1 AND 128),
+    app_policy text NOT NULL CHECK (app_policy ~ '^[0-9a-f]{64}$'),
+    destination text NOT NULL CHECK (octet_length(destination) BETWEEN 8 AND 2048),
+    purpose text NOT NULL CHECK (purpose IN ('http','mcp')),
+    account_authorization bigint NOT NULL CHECK (account_authorization>0),
+    revision bigint NOT NULL CHECK (revision>0),
+    enabled boolean NOT NULL,
+    confirmed_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    FOREIGN KEY (owner_namespace,owner_subject,account_id)
+        REFERENCES public.integration_accounts(owner_namespace,owner_subject,id) ON DELETE CASCADE,
+    UNIQUE (account_id,host_binding)
+);
+CREATE FUNCTION public.guard_integration_grant() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    PERFORM id FROM public.integration_accounts WHERE id=NEW.account_id FOR UPDATE;
+    IF TG_OP='INSERT' THEN
+        IF NOT EXISTS(SELECT 1 FROM public.integration_use_grants WHERE account_id=NEW.account_id AND host_binding=NEW.host_binding)
+            AND (SELECT count(*) FROM public.integration_use_grants WHERE account_id=NEW.account_id)>=128 THEN
+            RAISE EXCEPTION USING ERRCODE='23514',CONSTRAINT='integration_grant_cap',MESSAGE='Integration grant limit';
+        END IF;
+    ELSIF ROW(NEW.id,NEW.account_id,NEW.owner_namespace,NEW.owner_subject,NEW.host_scope,NEW.host_binding)
+            IS DISTINCT FROM ROW(OLD.id,OLD.account_id,OLD.owner_namespace,OLD.owner_subject,OLD.host_scope,OLD.host_binding)
+        OR NEW.revision<>OLD.revision+1 THEN
+        RAISE EXCEPTION USING ERRCODE='23514',CONSTRAINT='integration_grant_revision',MESSAGE='Invalid grant transition';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER integration_grant_guard BEFORE INSERT OR UPDATE ON public.integration_use_grants
+    FOR EACH ROW EXECUTE FUNCTION public.guard_integration_grant();
