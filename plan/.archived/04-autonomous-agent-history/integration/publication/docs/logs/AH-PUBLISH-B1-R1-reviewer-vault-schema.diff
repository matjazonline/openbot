+-- Private connected accounts. Owners are stable client references, never host-table FKs.
+CREATE TABLE public.integration_owner_states (
+    owner_namespace text NOT NULL CHECK (octet_length(owner_namespace) BETWEEN 1 AND 256),
+    owner_subject text NOT NULL CHECK (octet_length(owner_subject) BETWEEN 1 AND 256),
+    retired boolean NOT NULL DEFAULT false,
+    PRIMARY KEY (owner_namespace, owner_subject)
+);
+CREATE TABLE public.integration_accounts (
+    id uuid PRIMARY KEY,
+    owner_namespace text NOT NULL,
+    owner_subject text NOT NULL,
+    key text NOT NULL CHECK (octet_length(key) BETWEEN 1 AND 128 AND key = btrim(key)),
+    provider_id text NOT NULL CHECK (octet_length(provider_id) BETWEEN 1 AND 128),
+    auth_config_id text NOT NULL CHECK (octet_length(auth_config_id) BETWEEN 1 AND 128),
+    auth_method text NOT NULL,
+    credential_schema text NOT NULL,
+    external_identity text CHECK (octet_length(external_identity) <= 2048 AND jsonb_typeof(external_identity::jsonb) = 'object'),
+    authorization_key text CHECK (octet_length(authorization_key) BETWEEN 1 AND 256),
+    envelope text CHECK (octet_length(envelope) <= 23000 AND envelope LIKE 'enc:v2:%'),
+    revision bigint NOT NULL DEFAULT 1 CHECK (revision > 0),
+    authorization_revision bigint NOT NULL DEFAULT 1 CHECK (authorization_revision > 0),
+    credential_generation bigint NOT NULL DEFAULT 1 CHECK (credential_generation > 0),
+    renewal_attempt_id uuid,
+    renewal_generation bigint,
+    renewal_started_at timestamptz,
+    renewal_deadline timestamptz,
+    status text NOT NULL CHECK (status IN ('ready', 'reconnect_required', 'disconnected')),
+    metadata text NOT NULL CHECK (octet_length(metadata) <= 4096 AND jsonb_typeof(metadata::jsonb) = 'object'
+        AND (metadata::jsonb ? 'label') AND jsonb_typeof(metadata::jsonb->'label') = 'string'
+        AND octet_length(metadata::jsonb->>'label') BETWEEN 1 AND 256
+        AND btrim(metadata::jsonb->>'label') <> ''
+        AND metadata::jsonb - ARRAY['label','description'] = '{}'::jsonb
+        AND (NOT (metadata::jsonb ? 'description') OR jsonb_typeof(metadata::jsonb->'description') IN ('string','null'))),
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    updated_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    UNIQUE (owner_namespace, owner_subject, key),
+    UNIQUE (owner_namespace, owner_subject, provider_id, authorization_key),
+    FOREIGN KEY (owner_namespace, owner_subject) REFERENCES public.integration_owner_states(owner_namespace, owner_subject),
+    CHECK ((auth_method = 'static_secret' AND credential_schema = 'static-v1' AND external_identity IS NULL AND authorization_key IS NULL)
+        OR (auth_method = 'oauth_authorization_code' AND credential_schema IN ('google-v1', 'workspace-fixture-v1', 'workspace-rotating-fixture-v1')
+            AND external_identity IS NOT NULL AND authorization_key IS NOT NULL)),
+    CHECK (external_identity IS NULL OR (external_identity::jsonb ?& ARRAY['kind','subject','authorization_key']
+        AND external_identity::jsonb - ARRAY['kind','subject','authorization_key'] = '{}'::jsonb
+        AND jsonb_typeof(external_identity::jsonb->'kind') = 'string'
+        AND jsonb_typeof(external_identity::jsonb->'subject') = 'string'
+        AND jsonb_typeof(external_identity::jsonb->'authorization_key') = 'string'
+        AND octet_length(external_identity::jsonb->>'kind') BETWEEN 1 AND 128
+        AND octet_length(external_identity::jsonb->>'subject') BETWEEN 1 AND 256
+        AND external_identity::jsonb->>'authorization_key' = authorization_key)),
+    CHECK ((renewal_attempt_id IS NULL AND renewal_generation IS NULL AND renewal_started_at IS NULL AND renewal_deadline IS NULL)
+        OR (renewal_attempt_id IS NOT NULL AND renewal_generation IS NOT NULL AND renewal_started_at IS NOT NULL AND renewal_deadline IS NOT NULL
+            AND auth_method = 'oauth_authorization_code' AND status = 'ready' AND envelope IS NOT NULL
+            AND renewal_generation = credential_generation AND renewal_deadline > renewal_started_at
+            AND renewal_deadline <= renewal_started_at + interval '10 seconds')),
+    CHECK ((status <> 'ready' OR envelope IS NOT NULL) AND (status <> 'disconnected' OR envelope IS NULL))
+);
+-- workspace-fixture-v1 is a contract-test schema, never enabled in the production registry.
+CREATE FUNCTION public.guard_integration_account() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE owner_retired boolean;
+BEGIN
+    IF TG_OP = 'UPDATE' THEN
+        IF ROW(NEW.id, NEW.owner_namespace, NEW.owner_subject, NEW.key, NEW.provider_id,
+            NEW.auth_config_id, NEW.auth_method, NEW.credential_schema, NEW.external_identity, NEW.authorization_key)
+            IS DISTINCT FROM ROW(OLD.id, OLD.owner_namespace, OLD.owner_subject, OLD.key, OLD.provider_id,
+            OLD.auth_config_id, OLD.auth_method, OLD.credential_schema, OLD.external_identity, OLD.authorization_key) THEN
+            RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_account_immutable_identity', MESSAGE = 'Immutable integration identity';
+        END IF;
+        RETURN NEW;
+    END IF;
+    INSERT INTO public.integration_owner_states(owner_namespace, owner_subject)
+        VALUES(NEW.owner_namespace, NEW.owner_subject) ON CONFLICT DO NOTHING;
+    SELECT retired INTO owner_retired FROM public.integration_owner_states
+        WHERE owner_namespace = NEW.owner_namespace AND owner_subject = NEW.owner_subject FOR UPDATE;
+    IF owner_retired THEN
+        RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_owner_retired', MESSAGE = 'Integration owner retired';
+    END IF;
+    IF (SELECT count(*) FROM public.integration_accounts
+        WHERE owner_namespace = NEW.owner_namespace AND owner_subject = NEW.owner_subject) >= 128 THEN
+        RAISE EXCEPTION USING ERRCODE = '23514', CONSTRAINT = 'integration_account_owner_cap', MESSAGE = 'Integration account limit';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER integration_account_guard BEFORE INSERT OR UPDATE ON public.integration_accounts
+    FOR EACH ROW EXECUTE FUNCTION public.guard_integration_account();
+
+CREATE TABLE public.integration_teardown_intents (
+    id uuid PRIMARY KEY,
+    kind text NOT NULL CHECK (kind IN ('owner', 'company', 'membership')),
+    owner_namespace text NOT NULL CHECK (octet_length(owner_namespace) BETWEEN 1 AND 256),
+    owner_subject text NOT NULL CHECK (octet_length(owner_subject) <= 256),
+    host_binding text NOT NULL CHECK (octet_length(host_binding) <= 256),
+    state text NOT NULL DEFAULT 'pending' CHECK (state IN ('pending', 'completed', 'failed')),
+    attempts integer NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 8),
+    available_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    completed_at timestamptz,
+    UNIQUE (kind, owner_namespace, owner_subject, host_binding),
+    CHECK ((kind = 'owner' AND owner_subject <> '' AND host_binding = '')
+        OR (kind = 'company' AND owner_subject = '' AND host_binding <> '')
+        OR (kind = 'membership' AND owner_subject <> '' AND host_binding <> ''))
+);
+CREATE INDEX integration_teardown_due ON public.integration_teardown_intents(available_at, id) WHERE state = 'pending';
