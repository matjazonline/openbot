+        lease::lock_fence(&mut tx, fence, Duration::from_secs(2))
+            .await
+            .unwrap()
+    );
+    let safe: Option<bool> = sqlx::query_scalar("SELECT workflow_action_retry_safe($1,$2)")
+        .bind(fence.scope.company.as_uuid())
+        .bind(fence.scope.execution.as_uuid())
