+async fn cancel_queued(f: &ManualHistory, scope: ActivationRequest) {
+    let p = f.f.s.p();
+    let owner = pointer(p, scope).await;
+    let result = p
+        .cancel(CancelCommand {
+            company_id: scope.company,
+            run_id: scope.run,
+            actor: f.actor,
+            command_key: IdempotencyKey::parse("p07-cancel-queued").unwrap(),
+            expected_revision: p
