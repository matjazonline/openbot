+                .await
+                .unwrap()
+                .unwrap()
+                .revision,
+        })
+        .await
+        .unwrap();
+    assert!(matches!(result, CancelResult::Applied { .. }));
+    assert_eq!(
+        pointer(p, scope).await,
+        owner,
+        "queued cancellation must not release the other owner"
+    );
+    assert_eq!(exchange(p, scope).await.unwrap()["state"], "cancelled");
