+-- Initial, code-owned history limits; workflow/checkpoint storage has its own retention owner.
+CREATE FUNCTION public.agent_history_limits()
+RETURNS TABLE(conversation_payloads bigint, company_payloads bigint, recent_payloads bigint,
+    pressure_payloads bigint, conversation_metadata bigint, company_metadata bigint, company_conversations bigint)
+LANGUAGE sql IMMUTABLE AS $$ SELECT 128::bigint,2048::bigint,64::bigint,1536::bigint,4096::bigint,32768::bigint,2048::bigint $$;
+
+CREATE FUNCTION public.agent_history_conversation_available(tenant uuid)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+DECLARE maximum bigint;
+BEGIN
+    PERFORM 1 FROM public.companies WHERE id=tenant FOR NO KEY UPDATE NOWAIT;
+    IF NOT FOUND THEN RETURN false; END IF;
+    SELECT company_conversations INTO STRICT maximum FROM public.agent_history_limits();
+    RETURN (SELECT count(*)<maximum FROM (SELECT 1 FROM public.agent_history_conversations
+        WHERE company_id=tenant LIMIT maximum) AS rows);
+END $$;
+
+CREATE FUNCTION public.agent_history_conversation_unused(conversation public.agent_history_conversations)
+RETURNS boolean LANGUAGE sql VOLATILE AS $$
+    SELECT conversation.active_exchange_id IS NULL
+      AND NOT EXISTS(SELECT 1 FROM public.agent_history_exchanges AS exchange
+        WHERE exchange.company_id=conversation.company_id AND exchange.conversation_id=conversation.id)
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_runs AS run
+        WHERE run.company_id=conversation.company_id AND run.state IN ('queued','running','waiting') AND (
+          (conversation.scope_kind='child_branch' AND run.id=conversation.child_run_id)
+          OR (conversation.scope_kind='thread' AND run.channel_id=conversation.channel_id AND run.thread_id=conversation.thread_id)
+          OR (conversation.scope_kind='private_session' AND EXISTS(SELECT 1 FROM public.workflow_agent_sessions AS mapping
+            WHERE mapping.company_id=run.company_id AND mapping.run_id=run.id AND mapping.session_id=conversation.session_id))))
+$$;
+
+CREATE FUNCTION public.guard_agent_history_conversation_delete() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NOT EXISTS(SELECT 1 FROM public.companies WHERE id=OLD.company_id) THEN RETURN OLD; END IF;
+    PERFORM 1 FROM public.companies WHERE id=OLD.company_id FOR NO KEY UPDATE NOWAIT;
+    -- A child source cascade may also remove its safely expired terminal metadata.
+    IF OLD.scope_kind='child_branch' AND NOT EXISTS(SELECT 1 FROM public.workflow_runs
+        WHERE company_id=OLD.company_id AND id=OLD.child_run_id)
+        AND OLD.active_exchange_id IS NULL AND NOT EXISTS(SELECT 1 FROM public.agent_history_exchanges
+            WHERE company_id=OLD.company_id AND conversation_id=OLD.id AND payload_retained) THEN RETURN OLD; END IF;
+    IF NOT public.agent_history_conversation_unused(OLD) THEN
+        RAISE EXCEPTION 'agent conversation has retained metadata or live work' USING ERRCODE='23514';
+    END IF;
+    RETURN OLD;
+END $$;
+CREATE TRIGGER agent_history_conversation_delete BEFORE DELETE ON public.agent_history_conversations
+    FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_conversation_delete();
+
+CREATE FUNCTION public.agent_history_storage_available(tenant uuid, conversation uuid)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+DECLARE bounds record;
+BEGIN
+    -- Direct writers also serialize before taking local locks. Reverse-order callers fail busy.
+    PERFORM 1 FROM public.companies WHERE id=tenant FOR NO KEY UPDATE NOWAIT;
+    IF NOT FOUND THEN RETURN false; END IF;
+    SELECT * INTO STRICT bounds FROM public.agent_history_limits();
+    RETURN (SELECT count(*)<bounds.conversation_payloads FROM (SELECT 1 FROM public.agent_history_exchanges
+        WHERE company_id=tenant AND conversation_id=conversation AND payload_retained LIMIT bounds.conversation_payloads) AS rows)
+      AND (SELECT count(*)<bounds.company_payloads FROM (SELECT 1 FROM public.agent_history_exchanges
+        WHERE company_id=tenant AND payload_retained LIMIT bounds.company_payloads) AS rows)
+      AND (SELECT count(*)<bounds.conversation_metadata FROM (SELECT 1 FROM public.agent_history_exchanges
+        WHERE company_id=tenant AND conversation_id=conversation LIMIT bounds.conversation_metadata) AS rows)
+      AND (SELECT count(*)<bounds.company_metadata FROM (SELECT 1 FROM public.agent_history_exchanges
+        WHERE company_id=tenant LIMIT bounds.company_metadata) AS rows);
+END $$;
+
+CREATE FUNCTION public.agent_history_payload_expirable(exchange public.agent_history_exchanges)
+RETURNS boolean LANGUAGE sql VOLATILE AS $$
+    SELECT exchange.payload_retained AND exchange.state IN ('completed','failed','cancelled')
+      AND (exchange.state<>'failed' OR run.deadline<=clock_timestamp())
+      AND job.status IN ('completed','failed')
+      AND (execution.completed_at IS NOT NULL OR run.state IN ('succeeded','failed','cancelled'))
+      AND NOT EXISTS(SELECT 1 FROM public.agent_history_conversations AS conversation
+        WHERE conversation.company_id=exchange.company_id AND conversation.id=exchange.conversation_id
+          AND conversation.active_exchange_id=exchange.id)
+      AND NOT EXISTS(SELECT 1 FROM public.task_attempts AS attempt WHERE attempt.task_id=job.id AND attempt.status='processing')
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_waits AS wait WHERE wait.company_id=exchange.company_id
+        AND wait.run_id=exchange.run_id AND wait.execution_id=exchange.execution_id AND wait.state='waiting')
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_decisions AS decision
+        JOIN public.workflow_waits AS wait ON wait.company_id=decision.company_id AND wait.id=decision.wait_id
+        WHERE decision.company_id=exchange.company_id AND decision.run_id=exchange.run_id
+          AND wait.execution_id=exchange.execution_id AND decision.submitted_at IS NULL AND wait.state='waiting')
+      AND public.workflow_action_retry_safe(exchange.company_id,exchange.execution_id) IS DISTINCT FROM false
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_action_evidence_conflicts AS conflict
+        WHERE conflict.company_id=exchange.company_id AND conflict.run_id=exchange.run_id)
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_message_actions AS action
+        WHERE action.company_id=exchange.company_id AND action.run_id=exchange.run_id AND action.state IN ('pending','uncertain','stalled'))
+      AND NOT EXISTS(SELECT 1 FROM public.channel_reply_decisions AS final
+        LEFT JOIN public.message_deliveries AS delivery ON delivery.company_id=final.company_id AND delivery.id=final.delivery_id
+        WHERE final.company_id=exchange.company_id AND final.run_id=exchange.run_id
+          AND (final.state IN ('pending','claimed') OR (final.state='published' AND final.delivery_id IS NOT NULL
+            AND (delivery.id IS NULL OR delivery.status NOT IN ('delivered','dead_letter')))))
+      AND (exchange.finished_at<=clock_timestamp()-interval '90 days'
+        OR (SELECT count(*)>=bounds.recent_payloads FROM (SELECT 1 FROM public.agent_history_exchanges AS newer
+          WHERE newer.company_id=exchange.company_id AND newer.conversation_id=exchange.conversation_id
+            AND newer.payload_retained AND newer.state IN ('completed','failed','cancelled')
+            AND newer.position>exchange.position LIMIT bounds.recent_payloads) AS rows)
+        OR (SELECT count(*)>bounds.pressure_payloads FROM (SELECT 1 FROM public.agent_history_exchanges AS retained
+          WHERE retained.company_id=exchange.company_id AND retained.payload_retained LIMIT bounds.pressure_payloads+1) AS rows))
+    FROM public.workflow_runs AS run
+    JOIN public.workflow_executions AS execution ON execution.company_id=run.company_id AND execution.run_id=run.id
+    JOIN public.background_tasks AS job ON job.company_id=execution.company_id AND job.workflow_execution_id=execution.id
+    CROSS JOIN public.agent_history_limits() AS bounds
+    WHERE run.company_id=exchange.company_id AND run.id=exchange.run_id
+      AND execution.id=exchange.execution_id AND job.id=exchange.job_id
+$$;
+
+CREATE FUNCTION public.agent_history_expiry_allowed(exchange public.agent_history_exchanges)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+BEGIN
+    -- A direct UPDATE already owns the exchange tuple; never wait in reverse lock order.
+    PERFORM 1 FROM public.companies WHERE id=exchange.company_id FOR NO KEY UPDATE NOWAIT;
+    PERFORM 1 FROM public.workflow_runs WHERE company_id=exchange.company_id AND id=exchange.run_id FOR SHARE NOWAIT;
+    PERFORM 1 FROM public.workflow_executions WHERE company_id=exchange.company_id AND id=exchange.execution_id FOR SHARE NOWAIT;
+    PERFORM 1 FROM public.background_tasks WHERE company_id=exchange.company_id AND id=exchange.job_id FOR SHARE NOWAIT;
+    RETURN public.agent_history_payload_expirable(exchange) IS TRUE;
+END $$;
