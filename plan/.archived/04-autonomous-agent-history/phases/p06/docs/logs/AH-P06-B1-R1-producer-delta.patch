+CREATE FUNCTION public.agent_history_expiry_allowed(exchange public.agent_history_exchanges)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+BEGIN
+    -- A direct UPDATE already owns the exchange tuple; never wait in reverse lock order.
+    PERFORM 1 FROM public.companies WHERE id=exchange.company_id FOR NO KEY UPDATE NOWAIT;
+    PERFORM 1 FROM public.workflow_runs WHERE company_id=exchange.company_id AND id=exchange.run_id FOR SHARE NOWAIT;
+    PERFORM 1 FROM public.workflow_executions WHERE company_id=exchange.company_id AND id=exchange.execution_id FOR SHARE NOWAIT;
+    PERFORM 1 FROM public.background_tasks WHERE company_id=exchange.company_id AND id=exchange.job_id FOR SHARE NOWAIT;
+    RETURN public.agent_history_payload_expirable(exchange) IS TRUE;
+END $$;
