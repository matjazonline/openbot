+/// The step read already applied a fresh viewer check to its run-selected summary.
+/// GET /ui/workflow-runs/{run}/steps/{execution} — one step's body, when its row opens.
+async fn step(
+    ui: Ui,
+    Path((run, execution)): Path<(Uuid, Uuid)>,
+    Query(query): Query<CompanyQuery>,
+) -> AppResult<Html<String>> {
+    let company = ui.company(query.company_id).await?.id;
+    ui.visible_run(company, run).await?;
+    let company_id = super::company(company);
+    let step = ui
+        .engine
+        .run_views()
+        .step_view(
+            crate::application::workflow::run_views::RunReadScope {
+                company: company_id,
+                run: RunId::new(run),
+                viewer: ui.actor()?,
+            },
+            execution,
+        )
+        .await?
+        .ok_or_else(|| AppError::NotFound("Workflow step not found".into()))?;
+    let mut body = pages::run_step_body(&pages::StepBodyView {
+        company_id: company,
+        step: &step,
+    });
+    if step.agent.is_some() || step.payload_restricted {
+        body.push_str(&pages::agent_history_loader(pages::HistoryAnchor {
+            company,
+            run,
+            execution,
+        }));
+    }
+    Ok(Html(body))
+}
