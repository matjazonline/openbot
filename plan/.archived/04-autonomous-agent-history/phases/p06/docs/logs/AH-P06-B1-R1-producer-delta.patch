+#[derive(sqlx::FromRow)]
+pub(super) struct Metadata {
+    pub id: Uuid,
+    pub run_id: Uuid,
+    pub execution_id: Uuid,
+    pub checkpoint_id: Option<Uuid>,
+    pub agent_id: Uuid,
+    pub revision_id: Uuid,
