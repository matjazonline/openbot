@@ -0,0 +1,208 @@
+//! Application-wide storage maintenance. Discovery never grants deletion authority.
+use crate::{
+    app_error::{AppError, AppResult},
+    domain::{
+        monitoring::MonitoringService,
+        workflow::{CompanyId, RunId},
+    },
+};
+use async_trait::async_trait;
+use chrono::{DateTime, Utc};
+use std::time::Duration;
+use tokio_util::sync::CancellationToken;
+
+pub const RETENTION_PAGE_SIZE: usize = 4;
+pub const STORAGE_SWEEP_LIMIT: u16 = 256;
+// Reserve work for both payloads and unused scopes so either protected prefix cannot starve the other.
+pub const HISTORY_EXPIRY_SWEEP_LIMIT: u16 = STORAGE_SWEEP_LIMIT / 2;
+const OPERATION_BUDGET: Duration = Duration::from_secs(6);
+const SWEEP_INTERVAL: Duration = Duration::from_secs(60);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RetentionRoot {
+    pub finished_at: DateTime<Utc>,
+    pub company: CompanyId,
+    pub run: RunId,
+}
+#[derive(Debug)]
+pub struct RetentionPage {
+    pub roots: Vec<RetentionRoot>,
+    pub next: Option<RetentionRoot>,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RetiredTree {
+    pub runs: u64,
+    pub jobs: u64,
+    pub calls: u64,
+}
+
+/// Discovery cursor, never authority to expire a record.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct HistoryCandidate {
+    pub company: CompanyId,
+    pub finished_at: DateTime<Utc>,
+    pub exchange: crate::application::workflow::agent_history::AgentExchangeId,
+}
+
+#[derive(Debug)]
+pub struct HistoryPage {
+    pub candidates: Vec<HistoryCandidate>,
+}
+
+#[derive(Default)]
+struct SweepCursor {
+    root: Option<RetentionRoot>,
+    history: Option<HistoryCandidate>,
+    history_scope: Option<CompanyId>,
+}
+
+#[async_trait]
+pub trait WorkflowStorageMaintenance: Send + Sync {
+    async fn sweep_obsolete_witnesses(&self, limit: u16) -> AppResult<u64>;
+    async fn history_page(&self, after: Option<HistoryCandidate>) -> AppResult<HistoryPage>;
+    /// Lock current source ownership and recheck every pin before clearing history copies.
+    async fn expire_history(&self, candidate: HistoryCandidate) -> AppResult<bool>;
+    async fn history_scope_page(&self, after: Option<CompanyId>) -> AppResult<Vec<CompanyId>>;
+    async fn prune_history(&self, company: CompanyId, limit: u16) -> AppResult<u64>;
+    async fn retention_page(&self, after: Option<RetentionRoot>) -> AppResult<RetentionPage>;
+    /// Recheck and lock the complete tree; archive usage and remove runs/jobs atomically.
+    async fn retire_tree(&self, root: RetentionRoot) -> AppResult<Option<RetiredTree>>;
+    async fn sweep_unused_bundles(&self, limit: u16) -> AppResult<u64>;
+    async fn oldest_terminal_root(&self) -> AppResult<Option<DateTime<Utc>>>;
+}
+
+async fn bounded<T>(
+    future: impl std::future::Future<Output = AppResult<T>>,
+    monitoring: &dyn MonitoringService,
+) -> AppResult<T> {
+    let result = tokio::time::timeout(OPERATION_BUDGET, future)
+        .await
+        .unwrap_or_else(|_| {
+            Err(AppError::Timeout(
+                "Workflow storage operation timed out".into(),
+            ))
+        });
+    if let Err(error) = &result {
+        monitoring.increment_counter("workflow_storage_errors_total", 1, &[]);
+        tracing::warn!(%error, "Workflow storage operation failed");
+    }
+    result
+}
+
+async fn sweep(
+    port: &dyn WorkflowStorageMaintenance,
+    monitoring: &dyn MonitoringService,
+    cursor: &mut SweepCursor,
+) {
+    if let Ok(count) = bounded(
+        port.sweep_obsolete_witnesses(STORAGE_SWEEP_LIMIT),
+        monitoring,
+    )
+    .await
+    {
+        monitoring.increment_counter("workflow_storage_witnesses_deleted_total", count, &[]);
+    }
+    sweep_history(port, monitoring, cursor).await;
+    if let Ok(page) = bounded(port.retention_page(cursor.root), monitoring).await {
+        // Advance past every candidate, including protected or failed trees. Wrap on exhaustion.
+        cursor.root = page.next;
+        for root in page.roots {
+            match bounded(port.retire_tree(root), monitoring).await {
+                Ok(Some(deleted)) => {
+                    for (name, count) in [
+                        ("workflow_storage_trees_deleted_total", 1),
+                        ("workflow_storage_runs_deleted_total", deleted.runs),
+                        ("workflow_storage_jobs_deleted_total", deleted.jobs),
+                        ("workflow_storage_usage_archived_total", deleted.calls),
+                    ] {
+                        monitoring.increment_counter(name, count, &[]);
+                    }
+                }
+                Ok(None) => {
+                    monitoring.increment_counter("workflow_storage_trees_skipped_total", 1, &[])
+                }
+                Err(_) => {}
+            }
+        }
+    }
+    if let Ok(count) = bounded(port.sweep_unused_bundles(STORAGE_SWEEP_LIMIT), monitoring).await {
+        monitoring.increment_counter("workflow_storage_bundles_deleted_total", count, &[]);
+    }
+    if let Ok(oldest) = bounded(port.oldest_terminal_root(), monitoring).await {
+        monitoring.record_gauge(
+            "workflow_storage_oldest_terminal_root_finished_timestamp_seconds",
+            oldest.map_or(0.0, |time| time.timestamp() as f64),
+            &[],
+        );
+        monitoring.record_gauge(
+            "workflow_storage_last_observation_timestamp_seconds",
+            Utc::now().timestamp() as f64,
+            &[],
+        );
+    }
+}
+
+async fn sweep_history(
+    port: &dyn WorkflowStorageMaintenance,
+    monitoring: &dyn MonitoringService,
+    cursor: &mut SweepCursor,
+) {
+    if let Ok(page) = bounded(port.history_page(cursor.history), monitoring).await {
+        if page.candidates.is_empty() {
+            cursor.history = None;
+        }
+        for candidate in page.candidates {
+            // Advance before mutation, including a busy/protected/error candidate.
+            cursor.history = Some(candidate);
+            match bounded(port.expire_history(candidate), monitoring).await {
+                Ok(true) => {
+                    monitoring.increment_counter("agent_history_payloads_expired_total", 1, &[])
+                }
+                Ok(false) => {
+                    monitoring.increment_counter("agent_history_payloads_skipped_total", 1, &[])
+                }
+                Err(_) => {}
+            }
+        }
+    }
+    if let Ok(companies) = bounded(port.history_scope_page(cursor.history_scope), monitoring).await
+    {
+        if companies.is_empty() {
+            cursor.history_scope = None;
+        }
+        for company in companies {
+            cursor.history_scope = Some(company);
+            let limit =
+                (STORAGE_SWEEP_LIMIT - HISTORY_EXPIRY_SWEEP_LIMIT) / RETENTION_PAGE_SIZE as u16;
+            if let Ok(count) = bounded(port.prune_history(company, limit), monitoring).await {
+                monitoring.increment_counter("agent_history_scopes_pruned_total", count, &[]);
+            }
+        }
+    }
+}
+
+/// The host owns and joins this future. Cancellation drops the actual in-flight transaction.
+pub async fn run(
+    port: &dyn WorkflowStorageMaintenance,
+    monitoring: &dyn MonitoringService,
+    shutdown: &CancellationToken,
+) {
+    let mut cursor = SweepCursor::default();
+    loop {
+        tokio::select! {
+            biased;
+            _ = shutdown.cancelled() => return,
+            _ = sweep(port, monitoring, &mut cursor) => {}
+        }
+        // A full page or an error never turns cleanup into a busy polling loop.
+        tokio::select! {
+            biased;
+            _ = shutdown.cancelled() => return,
+            _ = tokio::time::sleep(SWEEP_INTERVAL) => {}
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "storage_tests.rs"]
+mod tests;
--- a/src/application/workflow/storage_tests.rs
+++ b/src/application/workflow/storage_tests.rs
@@ -0,0 +1,245 @@
+use super::*;
+use crate::adapters::monitoring::InMemoryMonitor;
+use std::sync::{
+    Mutex,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+use uuid::Uuid;
+
+struct Port {
+    cursors: Mutex<Vec<Option<RetentionRoot>>>,
+    visits: AtomicUsize,
+    pending: bool,
+    entered: tokio::sync::Notify,
+    dropped: AtomicBool,
+    history_records: Vec<HistoryCandidate>,
+    history_cursors: Mutex<Vec<Option<HistoryCandidate>>>,
+    history_visits: Mutex<Vec<Uuid>>,
+    scope_companies: Vec<CompanyId>,
+    scope_cursors: Mutex<Vec<Option<CompanyId>>>,
+    scope_limits: Mutex<Vec<u16>>,
+}
+impl Port {
+    fn new(pending: bool) -> Self {
+        Self {
+            cursors: Mutex::new(Vec::new()),
+            visits: AtomicUsize::new(0),
+            pending,
+            entered: Default::default(),
+            dropped: AtomicBool::new(false),
+            history_records: vec![],
+            history_cursors: Mutex::new(vec![]),
+            history_visits: Mutex::new(vec![]),
+            scope_companies: vec![],
+            scope_cursors: Mutex::new(vec![]),
+            scope_limits: Mutex::new(vec![]),
+        }
+    }
+}
+fn root(id: u128) -> RetentionRoot {
+    RetentionRoot {
+        finished_at: DateTime::from_timestamp(100, 0).unwrap(),
+        company: CompanyId::new(Uuid::from_u128(1)),
+        run: RunId::new(Uuid::from_u128(id)),
+    }
+}
+struct PendingWrite<'a>(&'a AtomicBool);
+impl Drop for PendingWrite<'_> {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::SeqCst);
+    }
+}
+#[async_trait]
+impl WorkflowStorageMaintenance for Port {
+    async fn sweep_obsolete_witnesses(&self, _: u16) -> AppResult<u64> {
+        Ok(0)
+    }
+    async fn history_page(&self, after: Option<HistoryCandidate>) -> AppResult<HistoryPage> {
+        self.history_cursors.lock().unwrap().push(after);
+        Ok(HistoryPage {
+            candidates: self
+                .history_records
+                .iter()
+                .filter(|candidate| {
+                    after
+                        .is_none_or(|after| candidate.exchange.as_uuid() > after.exchange.as_uuid())
+                })
+                .take(usize::from(HISTORY_EXPIRY_SWEEP_LIMIT))
+                .copied()
+                .collect(),
+        })
+    }
+    async fn expire_history(&self, candidate: HistoryCandidate) -> AppResult<bool> {
+        self.history_visits
+            .lock()
+            .unwrap()
+            .push(candidate.exchange.as_uuid());
+        match candidate.exchange.as_uuid().as_u128() {
+            1 => Err(AppError::DatabaseTimeout("busy history record".into())),
+            2..=128 => Ok(false),
+            _ => Ok(true),
+        }
+    }
+    async fn history_scope_page(&self, after: Option<CompanyId>) -> AppResult<Vec<CompanyId>> {
+        self.scope_cursors.lock().unwrap().push(after);
+        Ok(self
+            .scope_companies
+            .iter()
+            .filter(|company| after.is_none_or(|after| company.as_uuid() > after.as_uuid()))
+            .take(RETENTION_PAGE_SIZE)
+            .copied()
+            .collect())
+    }
+    async fn prune_history(&self, company: CompanyId, limit: u16) -> AppResult<u64> {
+        self.scope_limits.lock().unwrap().push(limit);
+        if company.as_uuid().as_u128() == 1 {
+            return Err(AppError::DatabaseTimeout("busy history scope".into()));
+        }
+        Ok(1)
+    }
+    async fn retention_page(&self, after: Option<RetentionRoot>) -> AppResult<RetentionPage> {
+        self.cursors.lock().unwrap().push(after);
+        Ok(if after.is_none() {
+            RetentionPage {
+                roots: (1..=4).map(root).collect(),
+                next: Some(root(4)),
+            }
+        } else {
+            RetentionPage {
+                roots: vec![root(5)],
+                next: None,
+            }
+        })
+    }
+    async fn retire_tree(&self, root: RetentionRoot) -> AppResult<Option<RetiredTree>> {
+        self.visits.fetch_add(1, Ordering::SeqCst);
+        if self.pending {
+            let _write = PendingWrite(&self.dropped);
+            self.entered.notify_one();
+            return std::future::pending().await;
+        }
+        match root.run.as_uuid().as_u128() {
+            1 => Err(AppError::Timeout("protected lock".into())),
+            2..=4 => Ok(None),
+            _ => Ok(Some(RetiredTree {
+                runs: 2,
+                jobs: 2,
+                calls: 1,
+            })),
+        }
+    }
+    async fn sweep_unused_bundles(&self, _: u16) -> AppResult<u64> {
+        Ok(0)
+    }
+    async fn oldest_terminal_root(&self) -> AppResult<Option<DateTime<Utc>>> {
+        self.entered.notify_one();
+        Ok(None)
+    }
+}
+
+#[tokio::test]
+async fn workflow_storage_cursor_advances_past_full_error_and_protected_page_without_time_advance()
+{
+    let port = Port::new(false);
+    let monitor = InMemoryMonitor::new();
+    let mut cursor = SweepCursor::default();
+    sweep(&port, &monitor, &mut cursor).await;
+    assert_eq!(cursor.root, Some(root(4)));
+    sweep(&port, &monitor, &mut cursor).await;
+    assert_eq!(cursor.root, None);
+    assert_eq!(*port.cursors.lock().unwrap(), vec![None, Some(root(4))]);
+    assert_eq!(port.visits.load(Ordering::SeqCst), 5);
+}
+#[tokio::test]
+async fn workflow_storage_shutdown_drops_pending_write_and_joins() {
+    let port = Port::new(true);
+    let monitor = InMemoryMonitor::new();
+    let shutdown = CancellationToken::new();
+    let stop = async {
+        port.entered.notified().await;
+        shutdown.cancel();
+    };
+    tokio::time::timeout(Duration::from_secs(1), async {
+        tokio::join!(run(&port, &monitor, &shutdown), stop);
+    })
+    .await
+    .unwrap();
+    assert!(port.dropped.load(Ordering::SeqCst));
+    assert_eq!(port.visits.load(Ordering::SeqCst), 1);
+}
+#[tokio::test]
+async fn workflow_storage_full_error_page_still_has_positive_worker_delay() {
+    let port = Port::new(false);
+    let monitor = InMemoryMonitor::new();
+    let shutdown = CancellationToken::new();
+    let stop = async {
+        port.entered.notified().await;
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        assert_eq!(port.cursors.lock().unwrap().len(), 1);
+        shutdown.cancel();
+    };
+    tokio::time::timeout(Duration::from_secs(1), async {
+        tokio::join!(run(&port, &monitor, &shutdown), stop);
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn workflow_storage_history_cursors_advance_past_error_and_protected_prefix_and_share_the_record_budget()
+ {
+    let mut port = Port::new(false);
+    port.history_records = (1..=129)
+        .map(|id| HistoryCandidate {
+            company: CompanyId::new(Uuid::from_u128(1)),
+            finished_at: DateTime::from_timestamp(100, 0).unwrap(),
+            exchange: crate::application::workflow::agent_history::AgentExchangeId::new(
+                Uuid::from_u128(id),
+            ),
+        })
+        .collect();
+    port.scope_companies = (1..=5)
+        .map(|id| CompanyId::new(Uuid::from_u128(id)))
+        .collect();
+    let monitor = InMemoryMonitor::new();
+    let mut cursor = SweepCursor::default();
+    sweep(&port, &monitor, &mut cursor).await;
+    assert_eq!(cursor.history, Some(port.history_records[127]));
+    assert_eq!(cursor.history_scope, Some(port.scope_companies[3]));
+    assert_eq!(port.history_visits.lock().unwrap().len(), 128);
+    assert_eq!(
+        port.scope_limits
+            .lock()
+            .unwrap()
+            .iter()
+            .copied()
+            .sum::<u16>()
+            + HISTORY_EXPIRY_SWEEP_LIMIT,
+        STORAGE_SWEEP_LIMIT
+    );
+    sweep(&port, &monitor, &mut cursor).await;
+    assert_eq!(cursor.history, Some(port.history_records[128]));
+    assert_eq!(cursor.history_scope, Some(port.scope_companies[4]));
+    sweep(&port, &monitor, &mut cursor).await;
+    assert!(cursor.history.is_none() && cursor.history_scope.is_none());
+    assert_eq!(
+        *port.history_cursors.lock().unwrap(),
+        vec![
+            None,
+            Some(port.history_records[127]),
+            Some(port.history_records[128])
+        ]
+    );
+    assert_eq!(
+        *port.scope_cursors.lock().unwrap(),
+        vec![
+            None,
+            Some(port.scope_companies[3]),
+            Some(port.scope_companies[4])
+        ]
+    );
+    assert_eq!(
+        *port.history_visits.lock().unwrap(),
+        (1..=129).map(Uuid::from_u128).collect::<Vec<_>>()
+    );
+}
