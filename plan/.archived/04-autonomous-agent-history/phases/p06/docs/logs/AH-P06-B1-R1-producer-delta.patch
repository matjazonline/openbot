+CREATE FUNCTION public.agent_history_payload_expirable(exchange public.agent_history_exchanges)
+RETURNS boolean LANGUAGE sql VOLATILE AS $$
+    SELECT exchange.payload_retained AND exchange.state IN ('completed','failed','cancelled')
+      AND (exchange.state<>'failed' OR run.deadline<=clock_timestamp())
+      AND job.status IN ('completed','failed')
+      AND (execution.completed_at IS NOT NULL OR run.state IN ('succeeded','failed','cancelled'))
+      AND NOT EXISTS(SELECT 1 FROM public.agent_history_conversations AS conversation
+        WHERE conversation.company_id=exchange.company_id AND conversation.id=exchange.conversation_id
+          AND conversation.active_exchange_id=exchange.id)
+      AND NOT EXISTS(SELECT 1 FROM public.task_attempts AS attempt WHERE attempt.task_id=job.id AND attempt.status='processing')
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_waits AS wait WHERE wait.company_id=exchange.company_id
+        AND wait.run_id=exchange.run_id AND wait.execution_id=exchange.execution_id AND wait.state='waiting')
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_decisions AS decision
+        JOIN public.workflow_waits AS wait ON wait.company_id=decision.company_id AND wait.id=decision.wait_id
+        WHERE decision.company_id=exchange.company_id AND decision.run_id=exchange.run_id
+          AND wait.execution_id=exchange.execution_id AND decision.submitted_at IS NULL AND wait.state='waiting')
+      AND public.workflow_action_retry_safe(exchange.company_id,exchange.execution_id) IS DISTINCT FROM false
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_action_evidence_conflicts AS conflict
+        WHERE conflict.company_id=exchange.company_id AND conflict.run_id=exchange.run_id)
+      AND NOT EXISTS(SELECT 1 FROM public.workflow_message_actions AS action
+        WHERE action.company_id=exchange.company_id AND action.run_id=exchange.run_id AND action.state IN ('pending','uncertain','stalled'))
+      AND NOT EXISTS(SELECT 1 FROM public.channel_reply_decisions AS final
+        LEFT JOIN public.message_deliveries AS delivery ON delivery.company_id=final.company_id AND delivery.id=final.delivery_id
+        WHERE final.company_id=exchange.company_id AND final.run_id=exchange.run_id
+          AND (final.state IN ('pending','claimed') OR (final.state='published' AND final.delivery_id IS NOT NULL
+            AND (delivery.id IS NULL OR delivery.status NOT IN ('delivered','dead_letter')))))
+      AND (exchange.finished_at<=clock_timestamp()-interval '90 days'
+        OR (SELECT count(*)>=bounds.recent_payloads FROM (SELECT 1 FROM public.agent_history_exchanges AS newer
+          WHERE newer.company_id=exchange.company_id AND newer.conversation_id=exchange.conversation_id
+            AND newer.payload_retained AND newer.state IN ('completed','failed','cancelled')
+            AND newer.position>exchange.position LIMIT bounds.recent_payloads) AS rows)
+        OR (SELECT count(*)>bounds.pressure_payloads FROM (SELECT 1 FROM public.agent_history_exchanges AS retained
+          WHERE retained.company_id=exchange.company_id AND retained.payload_retained LIMIT bounds.pressure_payloads+1) AS rows))
+    FROM public.workflow_runs AS run
+    JOIN public.workflow_executions AS execution ON execution.company_id=run.company_id AND execution.run_id=run.id
+    JOIN public.background_tasks AS job ON job.company_id=execution.company_id AND job.workflow_execution_id=execution.id
+    CROSS JOIN public.agent_history_limits() AS bounds
+    WHERE run.company_id=exchange.company_id AND run.id=exchange.run_id
+      AND execution.id=exchange.execution_id AND job.id=exchange.job_id
+$$;
