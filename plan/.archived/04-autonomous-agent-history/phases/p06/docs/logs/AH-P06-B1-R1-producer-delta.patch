+async fn complete(f: &HistoryThread, expected: &str) -> ClaimedWorkflow {
+    let claim = f.next().await;
+    assert_eq!(
+        Box::pin(runtime(f).execute(&WorkflowStepKind("agent.run".into()), &claim))
+            .await
+            .completed_result()
+            .unwrap(),
