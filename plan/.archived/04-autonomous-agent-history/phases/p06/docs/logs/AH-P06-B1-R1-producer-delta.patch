+            reruns,
+            reruns_truncated,
+            children,
+            children_truncated,
+            controls,
+            controls_truncated,
+            reconciliations,
+            reconciliations_truncated,
+            events,
+            events_truncated,
+        };
+        let levels = crate::adapters::persistence::view_visibility::run_levels_on(
+            self.pool(),
+            company,
+            viewer,
+            &[run.as_uuid()],
+        )
