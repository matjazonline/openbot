+#[derive(Debug, Deserialize)]
+struct PaneQuery {
+    company_id: Uuid,
+    part: Option<PanePart>,
+    /// The pane's epoch, sent back by a body reload (see `pages::control_key`).
+    epoch: Option<Uuid>,
+}
