+    assert_eq!(boundary(p, &claim).await, old_boundary);
+    source.rollback().await.unwrap();
+    assert!(
+        p.expire_history(clock::candidate(p, claim.fence.scope).await)
+            .await
+            .unwrap()
+    );
+    assert_eq!(llm.finish().await.unwrap(), 1);
+}
