+-- OwnDatabase-only historical load prefix. Keep real FKs/checks and actual production limits.
+-- USER lifecycle triggers are restored before any admission/cleanup assertion.
+CREATE TEMP TABLE ah_history_prefix (id uuid PRIMARY KEY,job_id uuid NOT NULL,position bigint NOT NULL) ON COMMIT DROP;
+INSERT INTO ah_history_prefix SELECT gen_random_uuid(),gen_random_uuid(),position FROM generate_series(2,$6::bigint) AS position;
+INSERT INTO workflow_executions(company_id,run_id,id,step_id,activation,created_at,activated_at,frozen_inputs,
+    completed_at,committed_output,response_disposition,frozen_choice,committed_route,route_target,successor_execution_id)
+SELECT execution.company_id,execution.run_id,prefix.id,execution.step_id,execution.activation+prefix.position-1,
+    execution.created_at,execution.activated_at,execution.frozen_inputs,NULL,NULL,'automatic',NULL,NULL,NULL,NULL
+FROM workflow_executions AS execution CROSS JOIN ah_history_prefix AS prefix
+WHERE execution.company_id=$1 AND execution.run_id=$2 AND execution.id=$3;
+INSERT INTO background_tasks(id,company_id,channel_id,thread_id,correlation_id,status,retry_count,continuation_count,
+    max_retries,worker_id,execution_generation,locked_at,lock_expires_at,run_at,created_at,updated_at,workflow_execution_id)
+SELECT prefix.job_id,job.company_id,job.channel_id,job.thread_id,job.correlation_id,'failed',0,0,
+    job.max_retries,NULL,NULL,NULL,NULL,job.run_at,job.created_at,job.updated_at,prefix.id
+FROM background_tasks AS job CROSS JOIN ah_history_prefix AS prefix WHERE job.company_id=$1 AND job.workflow_execution_id=$3 AND job.id=$4;
+INSERT INTO agent_history_exchanges(company_id,id,conversation_id,agent_id,revision_id,manifest_id,run_id,execution_id,job_id,
+    position,input_digest,provenance,access_level,state,output,frozen_preparation,payload_retained,payload_expired_at,
+    preparation_digest,created_at,activated_at,finished_at)
+SELECT exchange.company_id,prefix.id,exchange.conversation_id,exchange.agent_id,exchange.revision_id,exchange.manifest_id,
+    exchange.run_id,prefix.id,prefix.job_id,prefix.position,exchange.input_digest,exchange.provenance,exchange.access_level,
+    'cancelled',NULL,CASE WHEN $8='retained' THEN jsonb_set($7::jsonb,'{history_exchange}',to_jsonb(prefix.id::text)) ELSE NULL END,
+    $8='retained',CASE WHEN $8='expired' THEN clock_timestamp() ELSE NULL END,
+    sha256(convert_to(jsonb_set($7::jsonb,'{history_exchange}',to_jsonb(prefix.id::text))::text,'UTF8')),
+    exchange.created_at,exchange.activated_at,exchange.finished_at
+FROM agent_history_exchanges AS exchange CROSS JOIN ah_history_prefix AS prefix WHERE exchange.company_id=$1 AND exchange.run_id=$2 AND exchange.id=$3;
+UPDATE agent_history_conversations AS conversation SET last_exchange_order=$6,
+    expired_count=$6-(SELECT count(*) FROM agent_history_exchanges AS exchange
+      WHERE exchange.company_id=$1 AND exchange.conversation_id=$5 AND exchange.payload_retained),
+    expired_through_order=COALESCE((SELECT min(position)-1 FROM agent_history_exchanges AS exchange
+      WHERE exchange.company_id=$1 AND exchange.conversation_id=$5 AND exchange.payload_retained),$6)
+WHERE conversation.company_id=$1 AND conversation.id=$5;
--- a/src/adapters/persistence/workflow/agent_history_capacity_prefix_fixture.rs
+++ b/src/adapters/persistence/workflow/agent_history_capacity_prefix_fixture.rs
@@ -0,0 +1,147 @@
+//! Historical count fixtures, not a simulated end-to-end producer journey.
+//! Only in ManualHistory's OwnDatabase. Actual limits, FKs and CHECKs remain unchanged.
+//! Source jobs/executions are copied from a genuine cancelled pre-model call. USER lifecycle
+//! triggers are disabled transactionally for that old prefix, then restored before real competitors.
+use super::*;
+use crate::adapters::persistence::workflow::agent_history_retention_fixture as clock;
+
+pub(super) enum PayloadPrefix {
+    Retained,
+    Expired,
+}
+impl PayloadPrefix {
+    fn as_str(&self) -> &'static str {
+        match self {
+            Self::Retained => "retained",
+            Self::Expired => "expired",
+        }
+    }
+}
+pub(super) struct Prefix {
+    pub scope: crate::application::workflow::activation::ActivationRequest,
+    pub conversation: Uuid,
+}
+
+pub(super) async fn seed(f: &mut ManualHistory, count: u16, mode: PayloadPrefix) -> Prefix {
+    assert!((1..=4096).contains(&count));
+    f.from_run = None;
+    let claim = f.start(json!("historical count fixture")).await;
+    f.f.s
+        .p()
+        .prepare_agent(&claim, policy())
+        .await
+        .unwrap()
+        .expect_ready();
+    cancel(
+        &f.f,
+        &claim,
+        &format!("prefix-source-{}", claim.fence.scope.run.as_uuid()),
+    )
+    .await;
+    let scope = claim.fence.scope;
+    let prepared: Value = sqlx::query_scalar(
+        "SELECT frozen_preparation FROM agent_history_exchanges WHERE company_id=$1 AND id=$2",
+    )
+    .bind(scope.company.as_uuid())
+    .bind(scope.execution.as_uuid())
+    .fetch_one(f.f.s.pool())
+    .await
+    .unwrap();
+    let conversation: Uuid = sqlx::query_scalar(
+        "SELECT conversation_id FROM agent_history_exchanges WHERE company_id=$1 AND id=$2",
+    )
+    .bind(scope.company.as_uuid())
+    .bind(scope.execution.as_uuid())
+    .fetch_one(f.f.s.pool())
+    .await
+    .unwrap();
+    if matches!(mode, PayloadPrefix::Expired) {
+        clock::expire(f.f.s.p(), scope).await;
+    }
+    let snapshot = SeedSnapshot {
+        scope,
+        conversation,
+        prepared,
+    };
+    populate(f, &snapshot, count, mode).await;
+    Prefix {
+        scope,
+        conversation,
+    }
+}
+
+struct SeedSnapshot {
+    scope: crate::application::workflow::activation::ActivationRequest,
+    conversation: Uuid,
+    prepared: Value,
+}
+
+async fn populate(f: &ManualHistory, snapshot: &SeedSnapshot, count: u16, mode: PayloadPrefix) {
+    let scope = snapshot.scope;
+    let conversation = snapshot.conversation;
+    let prepared = &snapshot.prepared;
+    let mut tx = f.f.s.pool().begin().await.unwrap();
+    for table in [
+        "workflow_executions",
+        "background_tasks",
+        "agent_history_exchanges",
+        "agent_history_conversations",
+    ] {
+        sqlx::query(&format!("ALTER TABLE {table} DISABLE TRIGGER USER"))
+            .execute(&mut *tx)
+            .await
+            .unwrap();
+    }
+    // SQLx's extended protocol accepts one statement per query; bind the identical native source
+    // identities to each count-fixture statement, never string-interpolate payloads or identifiers.
+    for statement in include_str!("agent_history_capacity_prefix.sql")
+        .split(';')
+        .filter(|sql| !sql.trim().is_empty())
+    {
+        let mut query = sqlx::query(statement);
+        let maximum = (1..=8)
+            .rev()
+            .find(|number| statement.contains(&format!("${number}")))
+            .unwrap_or(0);
+        for number in 1..=maximum {
+            query = match number {
+                1 => query.bind(scope.company.as_uuid()),
+                2 => query.bind(scope.run.as_uuid()),
+                3 => query.bind(scope.execution.as_uuid()),
+                4 => query.bind(scope.job.0),
+                5 => query.bind(conversation),
+                6 => query.bind(i64::from(count)),
+                7 => query.bind(prepared),
+                8 => query.bind(mode.as_str()),
+                _ => unreachable!(),
+            };
+        }
+        query.execute(&mut *tx).await.unwrap();
+    }
+    sqlx::query("SET CONSTRAINTS ALL IMMEDIATE")
+        .execute(&mut *tx)
+        .await
+        .unwrap();
+    for table in [
+        "workflow_executions",
+        "background_tasks",
+        "agent_history_exchanges",
+        "agent_history_conversations",
+    ] {
+        sqlx::query(&format!("ALTER TABLE {table} ENABLE TRIGGER USER"))
+            .execute(&mut *tx)
+            .await
+            .unwrap();
+    }
+    sqlx::query("ALTER TABLE workflow_runs ENABLE TRIGGER workflow_run_snapshot_immutable")
+        .execute(&mut *tx)
+        .await
+        .unwrap();
+    tx.commit().await.unwrap();
+    let guarded:bool=sqlx::query_scalar("SELECT NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid=ANY(ARRAY['workflow_executions'::regclass,'background_tasks'::regclass,'agent_history_exchanges'::regclass,'agent_history_conversations'::regclass]) AND tgenabled<>'O')")
+        .fetch_one(f.f.s.pool()).await.unwrap();
+    assert!(
+        guarded,
+        "every native guard is restored before exercising real producers"
+    );
+}
