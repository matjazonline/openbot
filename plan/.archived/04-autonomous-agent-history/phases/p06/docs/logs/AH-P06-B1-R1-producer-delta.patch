+                &child_call_keys(&children),
+            )
+            .await?;
+        let mut view = StepView {
+            agent,
+            calls,
+            payload_restricted: false,
+            execution,
+            step: row.step_id,
+            activation: row.activation,
+            created_at: row.created_at,
+            activated_at: row.activated_at,
+            completed_at: row.completed_at,
