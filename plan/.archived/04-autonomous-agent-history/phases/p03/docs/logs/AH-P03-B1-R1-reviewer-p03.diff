+    let command = cancel_command(&setup, parent.fence.scope).await;
+    let mut leaf = p.pool().begin().await.unwrap();
+    let leaf_pid: i32 = sqlx::query_scalar("SELECT pg_backend_pid()")
+        .fetch_one(&mut *leaf)
