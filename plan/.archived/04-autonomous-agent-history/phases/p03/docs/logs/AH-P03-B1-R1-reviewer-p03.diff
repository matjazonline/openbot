 CREATE TRIGGER agent_history_routed_failure AFTER UPDATE OF committed_route ON public.workflow_executions
     FOR EACH ROW EXECUTE FUNCTION public.settle_agent_history_routed_failure();
+
+-- AH-P03-D1/r2: own run/checkpoint/job/exchange -> conversation -> admission leaf.
+-- Only membership increases take the leaf. Release never locks another source.
+ALTER TABLE public.agent_history_exchanges
+    ADD UNIQUE (company_id,conversation_id,id),
+    ADD UNIQUE (company_id,run_id,execution_id,id);
+ALTER TABLE public.agent_history_conversations ADD FOREIGN KEY (company_id,id,active_exchange_id)
+    REFERENCES public.agent_history_exchanges(company_id,conversation_id,id) DEFERRABLE INITIALLY DEFERRED;
+-- NO ACTION is checked at commit: tenant teardown finishes its existing cascades,
+-- while a retained companion still prevents an exchange-only deletion from committing.
+ALTER TABLE public.workflow_waits ADD FOREIGN KEY (company_id,run_id,execution_id,agent_exchange_id)
+    REFERENCES public.agent_history_exchanges(company_id,run_id,execution_id,id) DEFERRABLE INITIALLY DEFERRED;
+CREATE UNIQUE INDEX agent_history_one_active ON public.agent_history_exchanges(company_id,conversation_id)
+    WHERE state='active';
+CREATE INDEX agent_history_company_pending ON public.agent_history_exchanges(company_id)
+    WHERE state IN ('queued','active');
+CREATE TABLE public.agent_history_admission (
+    company_id uuid PRIMARY KEY REFERENCES public.companies(id) ON DELETE CASCADE
+);
+CREATE FUNCTION public.guard_agent_history_admission() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='DELETE' AND NOT EXISTS(SELECT 1 FROM public.companies WHERE id=OLD.company_id) THEN
+        RETURN OLD;
+    END IF;
+    RAISE EXCEPTION 'agent admission identity is immutable' USING ERRCODE='23514';
+END $$;
+CREATE TRIGGER agent_history_admission_guard BEFORE UPDATE OR DELETE ON public.agent_history_admission
+    FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_admission();
+
+CREATE FUNCTION public.agent_history_admit(tenant uuid, conversation uuid)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+BEGIN
+    PERFORM 1 FROM public.agent_history_conversations WHERE company_id=tenant AND id=conversation FOR UPDATE;
+    IF NOT FOUND THEN RETURN false; END IF;
+    INSERT INTO public.agent_history_admission(company_id) VALUES(tenant) ON CONFLICT DO NOTHING;
+    PERFORM 1 FROM public.agent_history_admission WHERE company_id=tenant FOR UPDATE;
+    RETURN (SELECT count(*)<32 FROM (SELECT 1 FROM public.agent_history_exchanges
+                WHERE company_id=tenant AND conversation_id=conversation AND state IN ('queued','active') LIMIT 32) AS pending)
+       AND (SELECT count(*)<256 FROM (SELECT 1 FROM public.agent_history_exchanges
+                WHERE company_id=tenant AND state IN ('queued','active') LIMIT 256) AS pending);
+END $$;
+
+CREATE OR REPLACE FUNCTION public.guard_agent_history_conversation() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE owner public.agent_history_exchanges;
+BEGIN
+    IF TG_OP='INSERT' THEN
+        IF NEW.last_exchange_order<>0 OR NEW.active_exchange_id IS NOT NULL THEN
+            RAISE EXCEPTION 'new conversation has no order or owner' USING ERRCODE='23514';
+        END IF;
+        IF NEW.scope_kind='child_branch' AND NOT EXISTS(SELECT 1 FROM public.workflow_runs
+            WHERE company_id=NEW.company_id AND id=NEW.child_run_id
+                AND parent_run_id IS NOT NULL AND parent_execution_id IS NOT NULL) THEN
+            RAISE EXCEPTION 'agent child conversation requires genuine child run' USING ERRCODE='23514';
+        END IF;
+        RETURN NEW;
+    END IF;
+    IF (to_jsonb(NEW)-ARRAY['last_exchange_order','active_exchange_id']) IS DISTINCT FROM
+       (to_jsonb(OLD)-ARRAY['last_exchange_order','active_exchange_id']) THEN
+        RAISE EXCEPTION 'agent conversation identity is immutable' USING ERRCODE='23514';
+    END IF;
+    IF NEW.last_exchange_order IS DISTINCT FROM OLD.last_exchange_order THEN
+        IF NEW.active_exchange_id IS DISTINCT FROM OLD.active_exchange_id
+            OR NEW.last_exchange_order::numeric<>OLD.last_exchange_order::numeric+1
+            OR NOT EXISTS(SELECT 1 FROM public.agent_history_exchanges
+                WHERE company_id=NEW.company_id AND conversation_id=NEW.id AND position=NEW.last_exchange_order) THEN
+            RAISE EXCEPTION 'agent conversation order has no exchange' USING ERRCODE='23514';
+        END IF;
+    END IF;
+    IF NEW.active_exchange_id IS NOT DISTINCT FROM OLD.active_exchange_id THEN RETURN NEW; END IF;
+    IF OLD.active_exchange_id IS NOT NULL THEN
+        IF NEW.active_exchange_id IS NOT NULL OR EXISTS(SELECT 1 FROM public.agent_history_exchanges
+            WHERE company_id=OLD.company_id AND id=OLD.active_exchange_id AND state IN ('queued','active')) THEN
+            RAISE EXCEPTION 'unfinished agent turn cannot be released or stolen' USING ERRCODE='23514';
+        END IF;
+        RETURN NEW;
+    END IF;
+    SELECT * INTO owner FROM public.agent_history_exchanges
+        WHERE company_id=NEW.company_id AND conversation_id=NEW.id AND id=NEW.active_exchange_id;
+    IF NOT FOUND OR owner.state<>'queued' OR owner.position IS DISTINCT FROM
+        (SELECT min(position) FROM public.agent_history_exchanges
+            WHERE company_id=NEW.company_id AND conversation_id=NEW.id AND state='queued')
+        OR NOT EXISTS(SELECT 1 FROM public.workflow_runs AS run
+            JOIN public.workflow_executions AS execution ON execution.company_id=run.company_id AND execution.run_id=run.id
+            JOIN public.background_tasks AS job ON job.company_id=execution.company_id AND job.workflow_execution_id=execution.id
+            WHERE run.company_id=owner.company_id AND run.id=owner.run_id AND execution.id=owner.execution_id
+                AND job.id=owner.job_id AND run.deadline>clock_timestamp() AND run.state IN ('queued','running','waiting')
+                AND execution.completed_at IS NULL AND execution.committed_route IS NULL
+                AND ((job.status='processing' AND job.lock_expires_at>clock_timestamp())
+                    OR (job.status='completed' AND EXISTS(SELECT 1 FROM public.workflow_waits AS wait
+                        WHERE wait.company_id=owner.company_id AND wait.run_id=owner.run_id
+                            AND wait.execution_id=owner.execution_id AND wait.agent_exchange_id=owner.id
+                            AND wait.reason='agent_turn' AND wait.state='waiting')))) THEN
+        RAISE EXCEPTION 'agent turn requires the eligible live source' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+
+CREATE FUNCTION public.agent_history_take_turn(tenant uuid, exchange_id uuid)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+DECLARE exchange public.agent_history_exchanges;
+        held uuid;
+BEGIN
+    SELECT * INTO exchange FROM public.agent_history_exchanges WHERE company_id=tenant AND id=exchange_id;
+    IF NOT FOUND THEN RETURN false; END IF;
+    IF exchange.state='completed' THEN RETURN true; END IF;
+    IF exchange.state NOT IN ('queued','active') THEN RETURN false; END IF;
+    SELECT active_exchange_id INTO STRICT held FROM public.agent_history_conversations
+        WHERE company_id=tenant AND id=exchange.conversation_id FOR UPDATE;
+    IF held IS NOT NULL THEN RETURN held=exchange_id; END IF;
+    IF exchange.position IS DISTINCT FROM(SELECT min(position) FROM public.agent_history_exchanges
+        WHERE company_id=tenant AND conversation_id=exchange.conversation_id AND state='queued') THEN RETURN false; END IF;
+    UPDATE public.agent_history_conversations SET active_exchange_id=exchange_id
+        WHERE company_id=tenant AND id=exchange.conversation_id AND active_exchange_id IS NULL;
+    RETURN true;
+END $$;
+
+CREATE FUNCTION public.agent_history_turn_ready(tenant uuid, exchange_id uuid)
+RETURNS boolean LANGUAGE sql STABLE AS $$
+    SELECT EXISTS(SELECT 1 FROM public.agent_history_exchanges AS exchange
+        JOIN public.agent_history_conversations AS conversation
+            ON conversation.company_id=exchange.company_id AND conversation.id=exchange.conversation_id
+        WHERE exchange.company_id=tenant AND exchange.id=exchange_id AND exchange.state='queued'
+            AND (conversation.active_exchange_id=exchange.id OR (conversation.active_exchange_id IS NULL
+                AND exchange.position=(SELECT min(position) FROM public.agent_history_exchanges
+                    WHERE company_id=tenant AND conversation_id=exchange.conversation_id AND state='queued'))))
+$$;
+
+CREATE FUNCTION public.release_agent_history_turn() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.state IN ('completed','failed','cancelled') AND OLD.state IS DISTINCT FROM NEW.state THEN
+        UPDATE public.agent_history_conversations SET active_exchange_id=NULL
+            WHERE company_id=NEW.company_id AND id=NEW.conversation_id AND active_exchange_id=NEW.id;
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE TRIGGER agent_history_turn_release AFTER UPDATE OF state ON public.agent_history_exchanges
+    FOR EACH ROW EXECUTE FUNCTION public.release_agent_history_turn();
+
+CREATE FUNCTION public.guard_agent_history_turn_agreement() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE tenant uuid;
+        conversation uuid;
+BEGIN
+    tenant:=NEW.company_id;
+    IF TG_TABLE_NAME='agent_history_conversations' THEN conversation:=NEW.id;
+    ELSE conversation:=NEW.conversation_id; END IF;
+    IF EXISTS(SELECT 1 FROM public.agent_history_conversations AS stream
+        LEFT JOIN public.agent_history_exchanges AS owner ON owner.company_id=stream.company_id
+            AND owner.conversation_id=stream.id AND owner.id=stream.active_exchange_id
+        WHERE stream.company_id=tenant AND stream.id=conversation
+            AND stream.active_exchange_id IS NOT NULL AND (owner.id IS NULL OR owner.state NOT IN ('queued','active')))
+        OR EXISTS(SELECT 1 FROM public.agent_history_exchanges AS exchange
+            JOIN public.agent_history_conversations AS stream ON stream.company_id=exchange.company_id AND stream.id=exchange.conversation_id
+            WHERE exchange.company_id=tenant AND exchange.conversation_id=conversation AND exchange.state='active'
+                AND stream.active_exchange_id IS DISTINCT FROM exchange.id) THEN
+        RAISE EXCEPTION 'agent turn and exchange must agree' USING ERRCODE='23514';
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER agent_history_turn_conversation_agreement AFTER INSERT OR UPDATE ON public.agent_history_conversations
+    DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_turn_agreement();
+CREATE CONSTRAINT TRIGGER agent_history_turn_exchange_agreement AFTER INSERT OR UPDATE ON public.agent_history_exchanges
+    DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_turn_agreement();
+
+CREATE FUNCTION public.guard_agent_turn_wait() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' AND (to_jsonb(NEW)-ARRAY['state','settled_at','failure_code']) IS DISTINCT FROM
+        (to_jsonb(OLD)-ARRAY['state','settled_at','failure_code']) THEN
+        RAISE EXCEPTION 'agent turn wait identity is immutable' USING ERRCODE='23514';
+    END IF;
+    IF TG_OP='INSERT' AND (NEW.state<>'waiting' OR NOT EXISTS(
+        SELECT 1 FROM public.agent_history_exchanges AS exchange
+        JOIN public.workflow_runs AS run ON run.company_id=exchange.company_id AND run.id=exchange.run_id
+        JOIN public.background_tasks AS job ON job.company_id=exchange.company_id AND job.id=exchange.job_id
+        JOIN public.task_attempts AS attempt ON attempt.task_id=job.id AND attempt.attempt_number=NEW.parked_attempt_number
+        WHERE exchange.company_id=NEW.company_id AND exchange.id=NEW.agent_exchange_id
+            AND exchange.run_id=NEW.run_id AND exchange.execution_id=NEW.execution_id AND exchange.state='queued'
+            AND NEW.deadline=run.deadline AND run.deadline>clock_timestamp() AND run.state IN ('queued','running')
+            AND job.status='processing' AND job.attempt_ordinal=NEW.parked_attempt_number
+            AND job.lock_expires_at>clock_timestamp() AND job.continuation_count<public.workflow_job_continuation_limit()
+            AND attempt.status='processing' AND attempt.worker_id=job.worker_id
+            AND attempt.execution_generation=job.execution_generation)) THEN
+        RAISE EXCEPTION 'agent turn wait requires its live exact attempt' USING ERRCODE='23514';
+    END IF;
+    IF TG_OP='UPDATE' AND OLD.state<>'waiting' AND to_jsonb(NEW) IS DISTINCT FROM to_jsonb(OLD) THEN
+        RAISE EXCEPTION 'settled agent turn wait is immutable' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER agent_turn_wait_insert BEFORE INSERT ON public.workflow_waits
+    FOR EACH ROW WHEN (NEW.reason='agent_turn') EXECUTE FUNCTION public.guard_agent_turn_wait();
+CREATE TRIGGER agent_turn_wait_change BEFORE UPDATE ON public.workflow_waits
+    FOR EACH ROW WHEN (OLD.reason='agent_turn' OR NEW.reason='agent_turn') EXECUTE FUNCTION public.guard_agent_turn_wait();
+
+CREATE FUNCTION public.check_agent_turn_wait() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE saved public.workflow_waits;
+BEGIN
