+async fn insert(db: &mut sqlx::PgConnection, row: &Value) -> Result<(), sqlx::Error> {
+    sqlx::query("INSERT INTO task_harness_runs SELECT (jsonb_populate_record(NULL::task_harness_runs,$1)).*")
+        .bind(row).execute(db).await.map(|_| ())
+}
