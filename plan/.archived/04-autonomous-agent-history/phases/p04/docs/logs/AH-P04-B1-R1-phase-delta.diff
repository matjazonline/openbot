+        )
+        .unwrap()
+        .with_history(AgentExchangeId::for_execution(claim.fence.scope.execution))
+        .unwrap();
+        history.budget = base.history_budget(&history.seed).unwrap();
+        let prepared = base.with_frozen_history(history).unwrap();
