+fn check_trailing_repair(body: &serde_json::Value, provider: &str) -> Result<(), &'static str> {
+    let turns = match provider {
+        "google" => &body["contents"],
+        "xai" => &body["input"],
+        _ => &body["messages"],
+    };
+    let last = turns
+        .as_array()
+        .and_then(|turns| turns.last())
+        .ok_or("turns")?;
+    if last["role"] != "user"
+        || !last
+            .to_string()
+            .contains("Validation reason: schema_mismatch")
+    {
+        return Err("the repair is not the trailing user turn");
+    }
+    Ok(())
+}
+
+fn check_replayed_result(body: &serde_json::Value, provider: &str) -> Result<(), &'static str> {
+    let mut body = body.clone();
+    let encoded = json!({"value":"record-value"}).to_string();
+    if let Some(messages) = body["messages"].as_array_mut() {
+        for message in messages
+            .iter_mut()
+            .filter(|message| message["role"] == "tool")
+        {
+            if message["content"] != encoded {
+                return Err("persisted JSON result changed");
+            }
+            message["content"] = json!("record-value");
+        }
+    }
+    if let Some(input) = body["input"].as_array_mut() {
+        for item in input
+            .iter_mut()
+            .filter(|item| item["type"] == "function_call_output")
+        {
+            if item["output"] != encoded {
+                return Err("persisted JSON result changed");
+            }
+            item["output"] = json!("record-value");
+        }
+    }
+    check_result(&body, provider)
+}
