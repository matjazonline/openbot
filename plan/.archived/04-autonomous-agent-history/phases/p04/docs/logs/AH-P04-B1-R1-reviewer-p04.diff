+        ("cancelled source", cancelled),
+        ("foreign source", foreign),
+    ] {
+        let mut document = valid.clone();
+        document["history"]["selected"][1] = metadata;
+        cases.push((label, document));
+    }
+    let mut document = valid.clone();
