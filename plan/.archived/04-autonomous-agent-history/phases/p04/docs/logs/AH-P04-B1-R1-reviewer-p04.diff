+
+fn check_seed(
+    request: &crate::services::test_support::ScriptedRequest,
+) -> Result<(), &'static str> {
+    let text = request.body.to_string();
+    if !text.contains("seed-user-marker")
+        || !text.contains("seed-assistant-marker")
+        || !text.contains("current-task")
