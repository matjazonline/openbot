+        let id = turn.calls[0].invocation_id;
+        saved = saved.apply(Mutation::Reserve(budget.clone())).unwrap().0;
+        saved = saved.apply(Mutation::Model(turn)).unwrap().0;
+        saved = saved.apply(Mutation::Prepare(id)).unwrap().0;
