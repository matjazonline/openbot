+    let mut stale = setup.claim.clone();
+    stale.fence.attempt.0 += 1;
+    assert!(p.prepare_agent(&stale, policy).await.is_err());
+    assert_eq!(captured(&setup).await, before);
+    assert_eq!(before.len(), 1);
+    assert_eq!(before[0].position, 1);
+}
