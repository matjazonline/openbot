+        .unwrap()
+        .unwrap();
+    let prepared = crate::application::workflow::agent::AgentPreparation::prepare_agent(
+        p,
+        &claim,
+        f.write.lease_policy,
+    )
+    .await
+    .unwrap()
+    .prepared;
+    let WriteOutcome::AlreadyApplied(checkpoint) = p
+        .open_workflow_checkpoint(
+            claim.fence,
+            &prepared.spec(claim.fence).unwrap(),
