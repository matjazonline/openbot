+-- A position belongs to the logical activation, including authorized control retry.
+CREATE TABLE public.agent_history_exchanges (
+    company_id uuid NOT NULL REFERENCES public.companies(id) ON DELETE CASCADE,
+    id uuid NOT NULL,
+    conversation_id uuid NOT NULL,
+    agent_id uuid NOT NULL,
+    revision_id uuid NOT NULL,
+    manifest_id uuid NOT NULL,
+    run_id uuid NOT NULL,
+    execution_id uuid NOT NULL,
+    job_id uuid NOT NULL,
+    position bigint NOT NULL CHECK (position > 0),
+    input_digest bytea NOT NULL CHECK (octet_length(input_digest)=32),
+    provenance jsonb NOT NULL CHECK (jsonb_typeof(provenance)='object' AND octet_length(provenance::text)<=262144),
+    access_level public.access_level NOT NULL,
+    state text NOT NULL CHECK (state IN ('queued','active','completed','failed','cancelled')),
+    checkpoint_id uuid,
+    output jsonb,
+    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+    activated_at timestamptz,
+    finished_at timestamptz,
+    PRIMARY KEY (company_id,id),
+    UNIQUE (company_id,execution_id),
+    UNIQUE (company_id,conversation_id,position),
+    FOREIGN KEY (company_id,agent_id,conversation_id)
+        REFERENCES public.agent_history_conversations(company_id,agent_id,id),
+    FOREIGN KEY (company_id,agent_id,revision_id) REFERENCES public.agent_revisions(company_id,agent_id,id),
+    FOREIGN KEY (company_id,manifest_id) REFERENCES public.agent_dependency_manifests(company_id,id),
+    FOREIGN KEY (company_id,run_id,execution_id) REFERENCES public.workflow_executions(company_id,run_id,id),
+    FOREIGN KEY (company_id,execution_id,job_id) REFERENCES public.background_tasks(company_id,workflow_execution_id,id),
+    FOREIGN KEY (company_id,job_id,checkpoint_id) REFERENCES public.task_harness_runs(company_id,task_id,id)
+        DEFERRABLE INITIALLY DEFERRED,
+    CHECK (id=execution_id),
+    CHECK ((state='completed')=(output IS NOT NULL)),
+    CHECK (output IS NULL OR octet_length(output::text)<=1048576),
+    CHECK ((state IN ('completed','failed','cancelled'))=(finished_at IS NOT NULL)),
+    CHECK (state NOT IN ('active','completed') OR (checkpoint_id IS NOT NULL AND activated_at IS NOT NULL)),
+    CHECK (activated_at IS NULL OR activated_at>=created_at),
+    CHECK (finished_at IS NULL OR finished_at>=created_at)
+);
+CREATE INDEX agent_history_exchanges_pending ON public.agent_history_exchanges
+    (company_id,conversation_id,position) WHERE state IN ('queued','active');
+CREATE INDEX agent_history_exchanges_recent ON public.agent_history_exchanges
+    (company_id,conversation_id,access_level,position DESC) WHERE state='completed';
+CREATE INDEX agent_history_exchanges_source ON public.agent_history_exchanges(company_id,run_id,execution_id);
+CREATE INDEX agent_history_exchanges_checkpoint ON public.agent_history_exchanges(company_id,checkpoint_id)
+    WHERE checkpoint_id IS NOT NULL;
