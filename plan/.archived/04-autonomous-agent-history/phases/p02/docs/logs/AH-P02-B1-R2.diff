+CREATE FUNCTION public.agent_history_checkpoint_matches(exchange public.agent_history_exchanges)
+RETURNS boolean LANGUAGE sql VOLATILE AS $$
+    SELECT CASE WHEN exchange.checkpoint_id IS NULL THEN exchange.state IN ('queued','failed','cancelled')
+    ELSE EXISTS (
+        SELECT 1 FROM public.task_harness_runs AS checkpoint
+        JOIN public.workflow_executions AS execution ON execution.company_id=checkpoint.company_id
+            AND execution.run_id=checkpoint.workflow_run_id AND execution.id=checkpoint.workflow_execution_id
+        WHERE checkpoint.company_id=exchange.company_id AND checkpoint.id=exchange.checkpoint_id
+            AND checkpoint.task_id=exchange.job_id AND checkpoint.workflow_run_id=exchange.run_id
+            AND checkpoint.workflow_execution_id=exchange.execution_id AND checkpoint.agent_id=exchange.agent_id
+            AND checkpoint.workflow_prepared->>'version'='4'
+            AND checkpoint.workflow_prepared->>'history_exchange'=exchange.id::text
+            AND checkpoint.workflow_prepared->'selection'->>'mode'='tools'
+            AND checkpoint.workflow_prepared->'selection'->>'manifest'=exchange.manifest_id::text
+            AND checkpoint.workflow_prepared->'selection'->>'agent'=exchange.agent_id::text
+            AND checkpoint.workflow_prepared->'selection'->>'revision'=exchange.revision_id::text
+            AND checkpoint.workflow_prepared->'context'=execution.frozen_inputs->'context'
+            AND checkpoint.checkpoint->'identity'->'response_contract'=exchange.provenance->'output_contract'
+            AND checkpoint.checkpoint->'identity'->>'provider'=exchange.provenance->'model'->>'provider'
+            AND checkpoint.checkpoint->'identity'->>'model'=exchange.provenance->'model'->>'model'
+            AND (checkpoint.state='completed')=(exchange.state='completed')
+            AND (checkpoint.state<>'invalid_output' OR exchange.state IN ('failed','cancelled'))
+            AND (exchange.state<>'completed' OR (
+                checkpoint.checkpoint->'final_output'->'structured'->'contract'=exchange.provenance->'output_contract'
+                AND exchange.output=(checkpoint.checkpoint->'final_output'->'structured'->>'body')::jsonb))
+    ) END
+$$;
+
+CREATE FUNCTION public.agent_history_transition_allowed(
+    previous public.agent_history_exchanges, following public.agent_history_exchanges)
+RETURNS boolean LANGUAGE plpgsql VOLATILE AS $$
+BEGIN
+    IF previous.state=following.state THEN
+        RETURN true;
+    END IF;
+    IF following.state='active' THEN
+        RETURN previous.state='queued' AND following.checkpoint_id IS NOT NULL;
+    END IF;
+    IF following.state='completed' THEN
+        RETURN previous.state='active' AND following.checkpoint_id IS NOT NULL;
+    END IF;
+    IF following.state='failed' AND previous.state IN ('queued','active') THEN
+        RETURN EXISTS (
+            SELECT 1 FROM public.workflow_runs AS run
+            JOIN public.workflow_executions AS execution ON execution.company_id=run.company_id AND execution.run_id=run.id
+            WHERE run.company_id=following.company_id AND run.id=following.run_id AND execution.id=following.execution_id
+                AND (run.state='failed' OR execution.committed_route='final_error'
+                    OR EXISTS (SELECT 1 FROM public.task_harness_runs AS checkpoint
+                        WHERE checkpoint.company_id=following.company_id AND checkpoint.id=following.checkpoint_id
+                            AND checkpoint.state='invalid_output')));
+    END IF;
+    IF following.state='cancelled' AND previous.state IN ('queued','active') THEN
+        RETURN EXISTS (SELECT 1 FROM public.workflow_runs AS run
+            WHERE run.company_id=following.company_id AND run.id=following.run_id AND run.state='cancelled');
+    END IF;
+    IF previous.state='failed' AND following.state='queued' AND pg_trigger_depth()>1 THEN
+        -- Only the genuine native failed-root reopen hook may take this exceptional edge.
+        RETURN EXISTS (
+            SELECT 1 FROM public.workflow_runs AS run
+            JOIN public.workflow_executions AS execution ON execution.company_id=run.company_id AND execution.run_id=run.id
+            JOIN public.background_tasks AS job ON job.company_id=execution.company_id AND job.workflow_execution_id=execution.id
+            WHERE run.company_id=following.company_id AND run.id=following.run_id AND run.state='running'
+                AND execution.id=following.execution_id AND execution.completed_at IS NULL
+                AND job.id=following.job_id AND job.status='pending'
+                AND public.workflow_control_retry_safe(run.company_id,run.id,job.id));
+    END IF;
+    RETURN false;
+END $$;
+
+CREATE FUNCTION public.guard_agent_history_exchange_change() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE current_level public.access_level;
+        source record;
+BEGIN
+    IF TG_OP='DELETE' THEN
+        IF NOT EXISTS (SELECT 1 FROM public.companies WHERE id=OLD.company_id) THEN
+            RETURN OLD; -- Intentional whole-tenant teardown owns its cascades.
+        END IF;
+        IF OLD.state IN ('queued','active') THEN
+            RAISE EXCEPTION 'live agent exchange cannot be removed' USING ERRCODE='23514';
+        END IF;
+        IF OLD.state='failed' THEN
+            -- DELETE already owns the exchange tuple. Never wait for the opposite
+            -- run->exchange control order: fail busy while another owner has the run.
+            SELECT state,deadline,terminal_execution_id INTO STRICT source
+                FROM public.workflow_runs WHERE company_id=OLD.company_id AND id=OLD.run_id
+                FOR SHARE NOWAIT;
+            IF source.deadline>clock_timestamp() AND (
+                source.state NOT IN ('succeeded','failed','cancelled')
+                OR (source.state='failed' AND source.terminal_execution_id=OLD.execution_id
+                    AND public.workflow_control_retry_safe(OLD.company_id,OLD.run_id,OLD.job_id))
+            ) THEN
+                RAISE EXCEPTION 'resumable agent exchange cannot be removed' USING ERRCODE='23514';
+            END IF;
+        END IF;
+        RETURN OLD;
+    END IF;
+    IF to_jsonb(NEW)=to_jsonb(OLD) AND NEW.output::text IS NOT DISTINCT FROM OLD.output::text THEN
+        RETURN NEW;
+    END IF;
+    IF OLD.state IN ('completed','cancelled')
+        OR (to_jsonb(NEW)-ARRAY['state','checkpoint_id','output','access_level','activated_at','finished_at']::text[])
+            IS DISTINCT FROM
+           (to_jsonb(OLD)-ARRAY['state','checkpoint_id','output','access_level','activated_at','finished_at']::text[])
+        OR (OLD.checkpoint_id IS NOT NULL AND NEW.checkpoint_id IS DISTINCT FROM OLD.checkpoint_id)
+        OR (OLD.activated_at IS NOT NULL AND NEW.activated_at IS DISTINCT FROM OLD.activated_at)
+        OR NOT public.agent_history_transition_allowed(OLD,NEW)
+    THEN
+        RAISE EXCEPTION 'agent exchange identity or lifecycle changed' USING ERRCODE='23514';
+    END IF;
+    SELECT content_level INTO STRICT current_level FROM public.workflow_runs
+        WHERE company_id=NEW.company_id AND id=NEW.run_id;
+    IF NEW.access_level<OLD.access_level OR NEW.access_level<current_level
+        OR (NEW.finished_at IS NOT NULL AND NEW.finished_at>clock_timestamp())
+        OR (NEW.activated_at IS NOT NULL AND NEW.activated_at>clock_timestamp())
+        OR NOT public.agent_history_checkpoint_matches(NEW)
+    THEN
+        RAISE EXCEPTION 'agent exchange level/checkpoint agreement failed' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER agent_history_exchange_change BEFORE UPDATE OR DELETE ON public.agent_history_exchanges
+    FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_exchange_change();
+
+CREATE FUNCTION public.guard_agent_history_checkpoint_agreement() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE related public.agent_history_exchanges;
+        proof text;
+BEGIN
+    IF TG_TABLE_NAME='task_harness_runs' THEN
+        proof:=NEW.workflow_prepared->>'history_exchange';
+        IF proof IS NULL THEN
+            RETURN NULL;
+        END IF;
+        SELECT * INTO related FROM public.agent_history_exchanges
+            WHERE company_id=NEW.company_id AND id=proof::uuid;
+        IF NOT FOUND AND NOT EXISTS (SELECT 1 FROM public.companies WHERE id=NEW.company_id) THEN
+            RETURN NULL;
+        END IF;
+        IF NOT FOUND OR related.checkpoint_id IS DISTINCT FROM NEW.id THEN
+            RAISE EXCEPTION 'checkpoint has no matching logical exchange' USING ERRCODE='23514';
+        END IF;
+    ELSE
+        SELECT * INTO related FROM public.agent_history_exchanges WHERE company_id=NEW.company_id AND id=NEW.id;
+        IF NOT FOUND THEN
+            IF EXISTS (SELECT 1 FROM public.companies WHERE id=NEW.company_id) THEN
+                RAISE EXCEPTION 'agent exchange disappeared during its write' USING ERRCODE='23514';
+            END IF;
+            RETURN NULL;
+        END IF;
+    END IF;
+    IF NOT public.agent_history_checkpoint_matches(related) THEN
+        RAISE EXCEPTION 'agent output and final checkpoint must agree' USING ERRCODE='23514';
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER agent_history_exchange_agreement AFTER INSERT OR UPDATE ON public.agent_history_exchanges
+    DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_checkpoint_agreement();
+CREATE CONSTRAINT TRIGGER agent_history_checkpoint_agreement AFTER INSERT OR UPDATE ON public.task_harness_runs
+    DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_checkpoint_agreement();
+
+CREATE INDEX agent_history_exchanges_live_source ON public.agent_history_exchanges(company_id,run_id,execution_id)
+    WHERE state IN ('queued','active');
+
+CREATE FUNCTION public.settle_agent_history_run() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.state IN ('failed','cancelled') AND OLD.state IS DISTINCT FROM NEW.state THEN
+        UPDATE public.agent_history_exchanges SET
+            state=CASE WHEN NEW.state='cancelled' THEN 'cancelled' ELSE 'failed' END,
+            access_level=GREATEST(access_level,NEW.content_level),
+            finished_at=COALESCE(finished_at,clock_timestamp())
+        WHERE company_id=NEW.company_id AND run_id=NEW.id AND state IN ('queued','active');
+        IF NEW.state='failed' THEN
+            -- An invalid-output checkpoint may have closed its input before run retirement.
+            UPDATE public.agent_history_exchanges SET access_level=GREATEST(access_level,NEW.content_level)
+                WHERE company_id=NEW.company_id AND run_id=NEW.id
+                    AND execution_id=NEW.terminal_execution_id AND state='failed';
+        END IF;
+    ELSIF OLD.state='failed' AND NEW.state='running' AND OLD.terminal_execution_id IS NOT NULL THEN
+        -- The existing run transition guard proves safe native control retry on this job.
+        UPDATE public.agent_history_exchanges AS exchange SET state='queued',finished_at=NULL,
+            access_level=GREATEST(exchange.access_level,NEW.content_level)
+        WHERE exchange.company_id=NEW.company_id AND exchange.run_id=NEW.id
+            AND exchange.execution_id=OLD.terminal_execution_id AND exchange.state='failed'
+            AND public.workflow_control_retry_safe(NEW.company_id,NEW.id,exchange.job_id);
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE TRIGGER agent_history_run_terminal AFTER UPDATE OF state ON public.workflow_runs
+    FOR EACH ROW EXECUTE FUNCTION public.settle_agent_history_run();
+
+CREATE FUNCTION public.settle_agent_history_routed_failure() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.committed_route='final_error' AND OLD.committed_route IS DISTINCT FROM NEW.committed_route THEN
+        UPDATE public.agent_history_exchanges AS exchange SET state='failed',
+            access_level=GREATEST(exchange.access_level,run.content_level),
+            finished_at=clock_timestamp()
+        FROM public.workflow_runs AS run
+        WHERE exchange.company_id=NEW.company_id AND exchange.run_id=NEW.run_id
+            AND exchange.execution_id=NEW.id AND exchange.state IN ('queued','active')
+            AND run.company_id=exchange.company_id AND run.id=exchange.run_id;
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE TRIGGER agent_history_routed_failure AFTER UPDATE OF committed_route ON public.workflow_executions
+    FOR EACH ROW EXECUTE FUNCTION public.settle_agent_history_routed_failure();
