+        p.open_workflow_checkpoint(f.write.fence, &result.spec, f.write.lease_policy)
+            .await
+            .unwrap(),
+        WriteOutcome::OwnershipLost
+    ));
+    assert_eq!(accounting(f).await["calls"], 1);
+}
