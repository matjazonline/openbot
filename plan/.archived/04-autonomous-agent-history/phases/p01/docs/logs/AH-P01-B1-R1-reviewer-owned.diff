+CREATE FUNCTION public.guard_agent_history_session() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        -- Retain the immutable audit snapshot while the real principal deletion clears its
+        -- live link. Neither an ordinary NULL update nor a later principal can retarget it.
+        IF OLD.live_creator_principal_id IS NOT NULL AND NEW.live_creator_principal_id IS NULL
+            AND (to_jsonb(NEW)-'live_creator_principal_id') IS NOT DISTINCT FROM
+                (to_jsonb(OLD)-'live_creator_principal_id')
+            AND NOT EXISTS (SELECT 1 FROM public.principals AS creator
+                WHERE creator.company_id=OLD.company_id AND creator.id=OLD.live_creator_principal_id)
+        THEN
+            RETURN NEW;
+        END IF;
+        RAISE EXCEPTION 'agent history session identity is immutable' USING ERRCODE='23514';
+    END IF;
+    IF NOT EXISTS (
+        SELECT 1 FROM public.workflow_runs AS run
+        JOIN public.workflow_admissions AS admission ON admission.company_id=run.company_id AND admission.run_id=run.id
+        JOIN public.workflow_run_events AS event ON event.company_id=run.company_id AND event.run_id=run.id
+            AND event.sequence=1 AND event.event_kind='admitted' AND event.actor_id=run.actor_id
+        JOIN public.principals AS creator ON creator.company_id=run.company_id
+            AND creator.id=NEW.creator_principal_id AND creator.id=NEW.live_creator_principal_id
+            AND creator.kind='person' AND creator.user_id=run.actor_id
+        WHERE run.company_id=NEW.company_id AND run.id=NEW.id AND run.parent_run_id IS NULL
+            AND NEW.creator_user_id=run.actor_id
+            AND NEW.channel_id IS NOT DISTINCT FROM run.channel_id
+            AND NEW.thread_id IS NOT DISTINCT FROM run.thread_id
+    ) THEN
+        RAISE EXCEPTION 'agent history session requires genuine root admission' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER agent_history_session_guard BEFORE INSERT OR UPDATE ON public.agent_history_sessions
+    FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_session();
+
+CREATE FUNCTION public.guard_workflow_agent_session() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        RAISE EXCEPTION 'workflow private session is immutable' USING ERRCODE='23514';
+    END IF;
+    IF TG_OP='DELETE' THEN
+        IF EXISTS (SELECT 1 FROM public.workflow_runs AS run WHERE run.company_id=OLD.company_id AND run.id=OLD.run_id) THEN
+            RAISE EXCEPTION 'live workflow private session cannot be removed' USING ERRCODE='23514';
+        END IF;
+        RETURN OLD;
+    END IF;
+    IF NOT EXISTS (
+        SELECT 1 FROM public.workflow_runs AS run
+        JOIN public.workflow_admissions AS admission ON admission.company_id=run.company_id AND admission.run_id=run.id
+        JOIN public.workflow_run_events AS event ON event.company_id=run.company_id AND event.run_id=run.id
+            AND event.sequence=1 AND event.event_kind='admitted' AND event.actor_id=run.actor_id
+        JOIN public.agent_history_sessions AS session ON session.company_id=run.company_id AND session.id=NEW.session_id
+        WHERE run.company_id=NEW.company_id AND run.id=NEW.run_id AND run.parent_run_id IS NULL
+            AND session.creator_user_id=run.actor_id
+            AND session.channel_id IS NOT DISTINCT FROM run.channel_id
+            AND session.thread_id IS NOT DISTINCT FROM run.thread_id
+            AND (session.id=run.id OR (
+                (substring(admission.source_key FROM 4)::jsonb->>0)='manual'
+                AND EXISTS (SELECT 1 FROM public.workflow_agent_sessions AS source
+                    WHERE source.company_id=NEW.company_id AND source.session_id=NEW.session_id)))
+    ) THEN
+        RAISE EXCEPTION 'workflow session requires matching trusted admission' USING ERRCODE='23514';
+    END IF;
+    IF NEW.thread_input_proven AND NOT EXISTS (
+        SELECT 1 FROM public.workflow_runs AS run
+        JOIN public.workflow_message_intents AS intent ON intent.company_id=run.company_id
+            AND intent.id=run.trigger_id AND intent.channel_id=run.channel_id AND intent.thread_id=run.thread_id
+        JOIN public.workflow_admissions AS admission ON admission.company_id=run.company_id AND admission.run_id=run.id
+        WHERE run.company_id=NEW.company_id AND run.id=NEW.run_id AND run.parent_run_id IS NULL
+            AND (substring(admission.source_key FROM 4)::jsonb)=jsonb_build_array('message',intent.message_id)
+            AND run.input->>'source_message'=intent.message_id::text
+    ) THEN
+        RAISE EXCEPTION 'thread input proof requires actual message producer' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER workflow_agent_session_guard BEFORE INSERT OR UPDATE OR DELETE ON public.workflow_agent_sessions
+    FOR EACH ROW EXECUTE FUNCTION public.guard_workflow_agent_session();
+
+CREATE FUNCTION public.guard_agent_history_conversation() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='UPDATE' THEN
+        RAISE EXCEPTION 'agent conversation identity is immutable' USING ERRCODE='23514';
+    END IF;
+    IF NEW.scope_kind='child_branch' AND NOT EXISTS (
+        SELECT 1 FROM public.workflow_runs AS run WHERE run.company_id=NEW.company_id
+            AND run.id=NEW.child_run_id AND run.parent_run_id IS NOT NULL
+            AND run.parent_execution_id IS NOT NULL
+    ) THEN
+        RAISE EXCEPTION 'agent child conversation requires genuine child run' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER agent_history_conversation_guard BEFORE INSERT OR UPDATE ON public.agent_history_conversations
+    FOR EACH ROW EXECUTE FUNCTION public.guard_agent_history_conversation();
