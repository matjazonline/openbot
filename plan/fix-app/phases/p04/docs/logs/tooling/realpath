#!/usr/bin/env python3
"""Only the GNU realpath invocation used by the installed snapshot.sh on macOS."""
import os
import sys
args = sys.argv[1:]
if len(args) != 4 or args[0] != "-m" or not args[1].startswith("--relative-to=") or args[2] != "--":
    raise SystemExit("unsupported snapshot realpath arguments")
print(os.path.relpath(os.path.realpath(args[3]), args[1].split("=", 1)[1]))
