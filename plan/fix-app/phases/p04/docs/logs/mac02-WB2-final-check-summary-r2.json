[
  {
    "name": "clippy-r2",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--offline",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "fmt-final",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "whitespace-final",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit": 0
  }
]
