-        format!(r##"<ul class="text-xs space-y-1">{usage}</ul>"##)
-    };
-    format!(
-        r##"<div class="text-xs font-mono text-base-content/70">Run <span class="text-primary">{run_id}</span></div>
-                                {steps}
-                                {usage}"##,
-        run_id = run.run_id,
-    )
-}
