diff --git a/src/application/use_cases/user/auth.rs b/src/application/use_cases/user/auth.rs
new file mode 100644
index 0000000..322dfbb
--- /dev/null
+++ b/src/application/use_cases/user/auth.rs
@@ -0,0 +1,64 @@
+//! Authentication digests and admitted-work ownership.
+use hmac::{Hmac, Mac};
+use secrecy::{ExposeSecret, SecretString};
+use sha2::Sha256;
+use std::{any::Any, sync::Arc};
+
+/// Independently configured authentication signing key. Debug is redacted by SecretString.
+#[derive(Clone, Debug)]
+pub struct AuthAttemptSecret(SecretString);
+impl AuthAttemptSecret {
+    pub(crate) fn expose_secret(&self) -> &str {
+        self.0.expose_secret()
+    }
+}
+impl From<String> for AuthAttemptSecret {
+    fn from(value: String) -> Self {
+        Self(value.into())
+    }
+}
+impl From<&str> for AuthAttemptSecret {
+    fn from(value: &str) -> Self {
+        value.to_owned().into()
+    }
+}
+impl From<Arc<str>> for AuthAttemptSecret {
+    fn from(value: Arc<str>) -> Self {
+        value.to_string().into()
+    }
+}
+/// A domain-separated keyed digest. Neither identity nor source is persisted in plaintext.
+#[derive(Clone, Copy, Eq, PartialEq)]
+pub struct AuthAttemptKey([u8; 32]);
+
+/// Opaque ownership of an admitted authentication request. The HTTP adapter supplies a source
+/// guard; a blocking password job retains a clone until the worker actually finishes.
+#[derive(Clone)]
+pub struct AuthWorkLifetime {
+    _owner: Arc<dyn Any + Send + Sync>,
+}
+
+impl AuthWorkLifetime {
+    pub(crate) fn new<T: Any + Send + Sync>(owner: T) -> Self {
+        Self {
+            _owner: Arc::new(owner),
+        }
+    }
+}
+
+impl AuthAttemptKey {
+    pub fn as_bytes(&self) -> &[u8; 32] {
+        &self.0
+    }
+}
+
+pub(crate) fn auth_attempt_key(secret: &str, domain: &str, components: &[&[u8]]) -> AuthAttemptKey {
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret.as_bytes())
+        .expect("HMAC-SHA256 accepts any key length");
+    mac.update(domain.as_bytes());
+    for component in components {
+        mac.update(&(component.len() as u64).to_be_bytes());
+        mac.update(component);
+    }
+    AuthAttemptKey(mac.finalize().into_bytes().into())
+}
diff --git a/src/application/use_cases/user/codes.rs b/src/application/use_cases/user/codes.rs
new file mode 100644
index 0000000..21a8e8c
--- /dev/null
+++ b/src/application/use_cases/user/codes.rs
@@ -0,0 +1,75 @@
+//! Domain-separated HMAC confirmation digests; independent of session signing.
+use super::{AccountChangeKind, AuthAttemptSecret, auth_attempt_key};
+use uuid::Uuid;
+pub(super) fn confirmation_number() -> u32 {
+    let bytes = *Uuid::new_v4().as_bytes();
+    u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]) % 1_000_000
+}
+fn digest(secret: &AuthAttemptSecret, domain: &str, components: &[&[u8]]) -> String {
+    auth_attempt_key(secret.expose_secret(), domain, components)
+        .as_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+pub(super) fn account_change_code_hash(
+    secret: &AuthAttemptSecret,
+    user_id: Uuid,
+    kind: AccountChangeKind,
+    code: &str,
+) -> String {
+    let domain = match kind {
+        AccountChangeKind::Email => "confirmation:account-email:v1",
+        AccountChangeKind::Password => "confirmation:account-password:v1",
+    };
+    digest(secret, domain, &[user_id.as_bytes(), code.as_bytes()])
+}
+pub(super) fn confirmation_code_hash(
+    secret: &AuthAttemptSecret,
+    canonical_email: &str,
+    code: &str,
+) -> String {
+    digest(
+        secret,
+        "confirmation:registration:v1",
+        &[canonical_email.as_bytes(), code.as_bytes()],
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn confirmation_hmac_separates_code_kinds_accounts_and_attempt_budgets() {
+        let secret = AuthAttemptSecret::from("independent-confirmation-secret-for-tests");
+        let id = Uuid::new_v4();
+        let code = "123456";
+        let email = account_change_code_hash(&secret, id, AccountChangeKind::Email, code);
+        let password = account_change_code_hash(&secret, id, AccountChangeKind::Password, code);
+        let registration = confirmation_code_hash(&secret, "alice@example.test", code);
+        assert_ne!(email, password);
+        assert_ne!(email, registration);
+        assert_ne!(password, registration);
+        assert_ne!(
+            email,
+            account_change_code_hash(&secret, Uuid::new_v4(), AccountChangeKind::Email, code)
+        );
+        assert_ne!(
+            registration,
+            confirmation_code_hash(&secret, "bob@example.test", code)
+        );
+        let attempt = auth_attempt_key(
+            secret.expose_secret(),
+            "registration-code:v1",
+            &[b"alice@example.test"],
+        );
+        let attempt_hex: String = attempt
+            .as_bytes()
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect();
+        assert_ne!(registration, attempt_hex);
+        assert_eq!(registration.len(), 64);
+        assert!(!format!("{secret:?}").contains("independent-confirmation-secret-for-tests"));
+    }
+}
