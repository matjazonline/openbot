-    }
-
-    impl RecordingSender {
-        /// The code from the most recent mail, and where it went.
-        fn last(&self) -> (EmailAddress, String, ConfirmationPurpose) {
-            self.sent
-                .lock()
-                .unwrap()
-                .last()
-                .cloned()
-                .expect("a code was mailed")
-        }
-    }
