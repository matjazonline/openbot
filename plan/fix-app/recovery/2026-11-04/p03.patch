+        };
+        let raise = |code: &str, constraint: &str| {
+            format!(
+                "DO $$ BEGIN RAISE EXCEPTION 'refused' USING ERRCODE='{code}', CONSTRAINT='{constraint}'; END $$"
+            )
+        };
