+        role: DepartmentRole,
+        kind: RoleRefusalKind,
+    ) -> Self {
+        Self {
+            format: RoleRefusalFormat::V1,
+            step,
+            role,
+            kind,
+        }
+    }
+}
+
+impl fmt::Display for RoleAdmissionRefusal {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "{}: step {} requires role {}",
+            self.kind.code(),
+            self.step,
+            self.role
+        )
+    }
+}
