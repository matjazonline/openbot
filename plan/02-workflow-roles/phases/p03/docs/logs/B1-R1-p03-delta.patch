+                .unwrap(),
+        }
+        let pending: NoticeState =
+            sqlx::query_as("SELECT status,cancellation_reason FROM message_deliveries WHERE id=$1")
+                .bind(pending)
+                .fetch_one(f.persistence().pool())
+                .await
+                .unwrap();
+        let sending: NoticeState =
