+            )
+            .await
+            .unwrap();
+    }
+    let today = PrincipalId::new(f.role.admission.binding.fixture.principal(owner).await);
+    departments
+        .assign_role(
+            owner,
+            f.role.company().as_uuid(),
+            f.role.department,
+            DepartmentRole::Reviewer,
+            today,
+        )
+        .await
+        .unwrap();
+    today
+}
