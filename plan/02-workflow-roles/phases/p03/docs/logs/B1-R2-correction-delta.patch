+fn default_approval_contains_role(binding: &Binding) -> bool {
+    match binding {
+        Binding::Default { fallback, .. } => {
+            approval_reviewers(fallback)
+                .as_ref()
+                .is_some_and(contains_role)
+                || default_approval_contains_role(fallback)
+        }
+        _ => false,
+    }
 }
 
