+fn private_observation() -> KnowledgeObservation {
+    KnowledgeObservation::new(
+        json!({"passages":[{"file":"sales.md","heading":null,"text":"PRIVATE FLOOR 60"}]}),
+        Some(AccessLevel::L5),
