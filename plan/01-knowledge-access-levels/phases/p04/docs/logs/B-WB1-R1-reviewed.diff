+            monitoring: Arc::new(crate::adapters::monitoring::InMemoryMonitor::new()),
+            // Five DB connections: preserve the existing single-slot ingress fixture budget.
+            slots: 1,
+            knowledge,
+        },
+    )
+    .unwrap()
+}
