+
+fn observation(text: &str, level: AccessLevel) -> KnowledgeObservation {
+    KnowledgeObservation::new(
+        json!({"passages":[{"file":"sales.md","heading":null,"text":text}]}),
+        Some(level),
+    )
+}
+
+#[tokio::test]
