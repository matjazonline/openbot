[
  {
    "name": "setup-initdb",
    "command": [
      "/opt/homebrew/opt/postgresql@18/bin/initdb",
      "-D",
      "/Users/mac02/dev/openbot-recovery/.worktrees/pg-knowledge-p02",
      "-U",
      "mac02",
      "-A",
      "trust",
      "--locale=en_US.UTF-8",
      "--encoding=UTF8"
    ],
    "exit_code": 0
  },
  {
    "name": "setup-start",
    "command": [
      "/opt/homebrew/opt/postgresql@18/bin/pg_ctl",
      "-D",
      "/Users/mac02/dev/openbot-recovery/.worktrees/pg-knowledge-p02",
      "-l",
      "/Users/mac02/dev/openbot-recovery/.worktrees/pg-knowledge-p02/server.log",
      "-w",
      "start"
    ],
    "exit_code": 0
  },
  {
    "name": "setup-create-open_bots",
    "command": [
      "/opt/homebrew/opt/postgresql@18/bin/createdb",
      "-h",
      "127.0.0.1",
      "-p",
      "55502",
      "-U",
      "mac02",
      "open_bots"
    ],
    "exit_code": 0
  },
  {
    "name": "setup-migrate-open_bots",
    "command": [
      "cargo",
      "sqlx",
      "migrate",
      "run",
      "--database-url",
      "postgres://mac02@127.0.0.1:55502/open_bots"
    ],
    "exit_code": 0
  },
