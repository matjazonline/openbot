+struct CurrentGate<'a> {
+    vault: &'a PostgresVault,
+    expected: &'a AuthorizedInvocation,
+    passed: AtomicBool,
+}
+#[async_trait]
+impl CredentialDispatchGate for CurrentGate<'_> {
+    async fn check(
+        &self,
+        invocation: &AuthorizedInvocation,
+        host: HostAuthorityFacts,
+    ) -> IntegrationResult<()> {
+        if serde_json::to_value(invocation).map_err(|_| IntegrationError::Invalid)?
+            != serde_json::to_value(self.expected).map_err(|_| IntegrationError::Invalid)?
+        {
+            return Err(IntegrationError::Denied);
+        }
+        if invocation.deadline <= chrono::Utc::now() {
+            return Err(IntegrationError::Denied);
+        }
+        let mut tx = self
+            .vault
+            .persistence
+            .pool()
+            .begin()
+            .await
+            .map_err(storage_error)?;
+        sqlx::query("SET LOCAL lock_timeout='5s'")
+            .execute(&mut *tx)
+            .await
+            .map_err(storage_error)?;
+        let grant = grant_on(&mut tx, invocation.authorization.grant).await?;
+        let account = account_on(&mut tx, &grant.owner, grant.account).await?;
+        let grant = grant_on(&mut tx, grant.id).await?;
+        pending(&mut tx, &account.owner, &grant.host_scope).await?;
+        authorize_dispatch(&account, &grant, &invocation.authorization, host)?;
+        if self.vault.registry.policy(&grant.app)? != grant.app_policy {
+            return Err(IntegrationError::Denied);
+        }
+        self.vault
+            .validate_binding_payload(
+                &mut tx,
+                &account,
+                &grant.app,
+                &grant.destination,
+                grant.purpose,
+            )
+            .await?;
+        tx.commit().await.map_err(storage_error)?;
+        self.passed.store(true, Ordering::Release);
+        Ok(())
+    }
+}
