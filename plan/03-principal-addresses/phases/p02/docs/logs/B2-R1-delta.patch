+    assert_eq!(after.items[0].state, NotificationState::Active);
+    assert!(after.items[0].read_at.is_some());
+    let mail: i64 =
+        sqlx::query_scalar("SELECT count(*) FROM message_deliveries WHERE purpose='notification'")
+            .fetch_one(f.pool())
+            .await
+            .unwrap();
+    assert_eq!(
+        mail, 0,
