+    Box::pin(race(Revoke::SourceAddress)).await;
+}
+
+#[tokio::test]
+async fn relay_identity_target_revocation_after_observation_refuses_commit_and_redelivery() {
+    Box::pin(race(Revoke::TargetSettings)).await;
+}
