+        return
+    with tempfile.TemporaryFile() as errors:
+        try:
+            subprocess.run(args, cwd=cwd, check=True, stderr=errors, **kwargs)
+        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
+            report_failure(args, errors)
+            raise
+        finally:
+            errors.seek(0)
