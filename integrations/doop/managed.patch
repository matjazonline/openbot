+  }
+  await succeeding
+  expect((await fixture.db.query("SELECT id FROM canvases WHERE id='legacy-should-not-publish'")).rows).toEqual([])
+  expect((await fetch(`${fixture.server.base}/healthz`)).status).toBe(200)
+  await expect
+    .poll(
