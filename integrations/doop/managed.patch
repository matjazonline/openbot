diff --git a/server/materializationJob.ts b/server/materializationJob.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d07110e0d88438459465ed557d7fed93e6d24119
--- /dev/null
+++ b/server/materializationJob.ts
@@ -0,0 +1,118 @@
+import { PRIVATE_MEDIA_LIMITS, PrivateMaterializationError } from '../shared/privateMedia.ts'
+import { renderAdmission } from './renderAdmission.ts'
+
+export interface MaterializationJob {
+  readonly signal: AbortSignal
+  /** Call before and after every leaf; cancellation never starts another read. */
+  check(): void
+  read<T>(start: () => Promise<T>): Promise<T>
+  /** The tracked worker leaf must stay pending until its actual exit. */
+  onCancel(stop: () => void): () => void
+}
+
+/** The caller deadline and the underlying operation's lifetime are different.
+ * Only execution/drain owns admission; a timed-out caller never transfers it. */
+export function createMaterializationRunner({
+  responseMs = PRIVATE_MEDIA_LIMITS.responseMs,
+}: { responseMs?: number } = {}) {
+  const acquire = renderAdmission(4)
+  return function run<T>(work: (job: MaterializationJob) => Promise<T>, signal?: AbortSignal): Promise<T> {
+    const controller = new AbortController()
+    const pending = new Set<Promise<unknown>>()
+    const stoppers = new Set<() => void>()
+    const deadline = Date.now() + responseMs
+    let settled = false
+    let resolveCaller!: (value: T) => void
+    let rejectCaller!: (error: unknown) => void
+    const caller = new Promise<T>((resolve, reject) => {
+      resolveCaller = resolve
+      rejectCaller = reject
+    })
+    const finish = (result: { value: T } | { error: unknown }) => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      signal?.removeEventListener('abort', cancel)
+      if ('value' in result) resolveCaller(result.value)
+      else rejectCaller(result.error)
+    }
+    const stop = () => {
+      if (controller.signal.aborted) return
+      controller.abort()
+      for (const stopper of stoppers) {
+        // A failed stop request is not proof of exit: the leaf keeps its slot.
+        try {
+          stopper()
+        } catch {
+          // Drain still waits for the tracked operation's settlement.
+        }
+      }
+    }
+    const cancel = () => {
+      stop()
+      finish({ error: new PrivateMaterializationError('aborted') })
+    }
+    const timer = setTimeout(cancel, Math.max(0, responseMs))
+    const job: MaterializationJob = {
+      signal: controller.signal,
+      check() {
+        if (controller.signal.aborted || Date.now() >= deadline) {
+          cancel()
+          throw new PrivateMaterializationError('aborted')
+        }
+      },
+      async read<R>(start: () => Promise<R>): Promise<R> {
+        job.check()
+        // Defer invocation until it has been registered as owned work.
+        const leaf = Promise.resolve().then(() => {
+          job.check()
+          return start()
+        })
+        pending.add(leaf)
+        try {
+          const value = await leaf
+          job.check()
+          return value
+        } finally {
+          pending.delete(leaf)
+        }
+      },
+      onCancel(stopper) {
+        if (controller.signal.aborted) stopper()
+        else stoppers.add(stopper)
+        return () => stoppers.delete(stopper)
+      },
+    }
+    signal?.addEventListener('abort', cancel, { once: true })
+    if (signal?.aborted) {
+      cancel()
+      return caller
+    }
+    const drain = async () => {
+      while (pending.size) await Promise.allSettled([...pending])
+    }
+    // This continuation outlives a cancelled caller. Its permit cannot be
+    // transferred until every begun, possibly signal-ignoring leaf settles.
+    void (async () => {
+      let release: (() => void) | undefined
+      try {
+        release = await acquire()
+        job.check()
+        const value = await work(job)
+        await drain()
+        job.check()
+        finish({ value })
+      } catch (error) {
+        stop()
+        finish({ error })
+      } finally {
+        await drain()
+        stoppers.clear()
+        release?.()
+      }
+    })()
+    return caller
+  }
+}
+
+export const runMaterializationJob = createMaterializationRunner()
diff --git a/server/mcpMedia.ts b/server/mcpMedia.ts
new file mode 100644
index 0000000000000000000000000000000000000000..efee9980ba3ebca1a5d1ec6a166a15a2b0813210
--- /dev/null
+++ b/server/mcpMedia.ts
@@ -0,0 +1,16 @@
+import { PrivateMediaBudget } from '../shared/privateMedia.ts'
+import { runMaterializationJob } from './materializationJob.ts'
+import { prepareMediaPreview } from './privateMediaValidation.ts'
+import { assertRenderRead, type PrivateRenderScope } from './privateResources.ts'
+
+/** Acquire only after rendering finishes: a renderer needs this same admission. */
+export function privateMcpImage(bytes: Uint8Array, scope: PrivateRenderScope) {
+  return runMaterializationJob(async (job) => {
+    await job.read(() => assertRenderRead(scope))
+    const budget = new PrivateMediaBudget()
+    budget.chargeEncoded(bytes.byteLength)
+    const result = await prepareMediaPreview(job, bytes, (cost) => budget.chargeDecoded(cost.decodedBytes))
+    await job.read(() => assertRenderRead(scope))
+    return result
+  })
+}
diff --git a/server/mcpSchemas.ts b/server/mcpSchemas.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb19319ac0f1e0bcb069b759070faa33fb596436
--- /dev/null
+++ b/server/mcpSchemas.ts
@@ -0,0 +1,81 @@
+import { McpServer, type RegisteredTool } from '@modelcontextprotocol/sdk/server/mcp.js'
+import {
+  isZ4Schema,
+  normalizeObjectSchema,
+  type AnySchema,
+  type ZodRawShapeCompat,
+} from '@modelcontextprotocol/sdk/server/zod-compat.js'
+import { toJsonSchemaCompat } from '@modelcontextprotocol/sdk/server/zod-json-schema-compat.js'
+import { ListToolsRequestSchema, type Tool } from '@modelcontextprotocol/sdk/types.js'
+
+type DefinitionSchema = AnySchema | ZodRawShapeCompat | undefined
+
+function containsTuple(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(containsTuple)
+  if (value === null || typeof value !== 'object') return false
+  return Object.entries(value).some(([key, child]) => key === 'prefixItems' || containsTuple(child))
+}
+
+function publishSchema(schema: DefinitionSchema, io: 'input' | 'output'): Tool['inputSchema'] {
+  if (schema === undefined) {
+    return { $schema: 'https://json-schema.org/draft/2020-12/schema', type: 'object', properties: {} }
+  }
+  const object = normalizeObjectSchema(schema)
+  if (!object || !isZ4Schema(object)) throw new Error('MCP definitions require Zod4 object schemas')
+  const converted = toJsonSchemaCompat(object, { target: 'draft-2020-12', pipeStrategy: io, strictUnions: true })
+  // The pinned converter omits fixed-tuple cardinality. Refuse unsupported definitions rather
+  // than advertise a contract that admits values the actual SDK rejects.
+  if (containsTuple(converted)) throw new Error('MCP tuple schema conversion is unsupported')
+  if (converted.type !== 'object') throw new Error('MCP definitions require object schemas')
+  return { ...converted, type: 'object' }
+}
+
+/** Emit the workflow's dialect from the same public handles the SDK validates and invokes. */
+export class WorkflowMcpServer extends McpServer {
+  private readonly listedTools = new Map<string, RegisteredTool>()
+
+  override registerTool: McpServer['registerTool'] = (name, config, callback) => {
+    publishSchema(config.inputSchema, 'input')
+    if (config.outputSchema) publishSchema(config.outputSchema, 'output')
+    const tool = super.registerTool(name, config, callback)
+    const update = tool.update
+    let removed = false
+    tool.update = (changes) => {
+      if (removed) {
+        if (changes.name === null) return
+        throw new Error('MCP tool registration was removed')
+      }
+      // SDK1.30 closes over the original name, so rename then remove leaves a callable alias.
+      if (changes.name !== undefined && changes.name !== null && changes.name !== name) {
+        throw new Error('MCP tool registration names are fixed')
+      }
+      if (changes.paramsSchema !== undefined) publishSchema(changes.paramsSchema, 'input')
+      if (changes.outputSchema !== undefined) publishSchema(changes.outputSchema, 'output')
+      update(changes)
+      if (changes.name === null) {
+        removed = true
+        this.listedTools.delete(name)
+      }
+    }
+    this.listedTools.set(name, tool)
+    this.server.setRequestHandler(ListToolsRequestSchema, () => ({
+      tools: [...this.listedTools]
+        .filter(([, entry]) => entry.enabled)
+        .map(([toolName, entry]) => this.definition(toolName, entry)),
+    }))
+    return tool
+  }
+
+  private definition(name: string, tool: RegisteredTool): Tool {
+    return {
+      name,
+      title: tool.title,
+      description: tool.description,
+      inputSchema: publishSchema(tool.inputSchema, 'input'),
+      ...(tool.outputSchema ? { outputSchema: publishSchema(tool.outputSchema, 'output') } : {}),
+      annotations: tool.annotations,
+      execution: tool.execution,
+      _meta: tool._meta,
+    }
+  }
+}
