+        expect(response.headers.get('cache-control')).toBe('private, no-store')
+        expect(response.headers.get('vary')).toContain('Cookie')
+        for (const key of [
+          'etag',
+          'last-modified',
+          'content-type',
+          'content-disposition',
+          'location',
+          'access-control-allow-origin',
