+++ b/tests/companyManaged.test.ts
@@ -0,0 +1,83 @@
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { Client, startServer, type Server } from './harness.ts'
+
+let server: Server
+let human: Client
+let bot: Client
+let foreign: Client
+let botId: string
+let workspaceId: string
+let foreignWorkspace: string
+let canvasId: string
+let configuration: Record<string, string>
+
+beforeAll(async () => {
+  server = await startServer()
+  human = await new Client(server).signUp('company-human@test.dev', 'Human')
+  bot = await new Client(server).signUp('company-bot@test.dev', 'Bot')
+  foreign = await new Client(server).signUp('company-foreign@test.dev', 'Foreign')
+  botId = (await (await bot.get('/api/me')).json()).id
+  workspaceId = (await (await human.post('/api/workspaces', { name: 'Private company' })).json()).id
+  foreignWorkspace = (await (await foreign.post('/api/workspaces', { name: 'Foreign company' })).json()).id
+  expect((await human.post(`/api/workspaces/${workspaceId}/members`, { email: 'company-bot@test.dev' })).status).toBe(
+    200,
+  )
+  const welcome = await (await bot.get('/api/canvases')).json()
+  for (const canvas of welcome) {
+    if (canvas.ownerId === botId && !canvas.workspaceId)
+      expect((await bot.delete(`/api/canvases/${canvas.id}`)).status).toBe(200)
+  }
+  configuration = { MANAGED_COMPANY_WORKSPACES: JSON.stringify([{ workspaceId, botUserId: botId }]) }
+  server.stop({ keepData: true })
+  server = await startServer(configuration, server.dataDir)
+}, 70_000)
+
+afterAll(() => server?.stop())
+
+it('allows own private work and copying while competing foreign invites and personal creates fail', async () => {
+  const created = await bot.post('/api/canvases', { name: 'Private work', workspaceId })
+  expect(created.status).toBe(200)
+  canvasId = (await created.json()).id
+  expect((await human.get(`/api/canvases/${canvasId}`)).status).toBe(200)
+  expect((await foreign.get(`/api/canvases/${canvasId}`)).status).toBe(403)
+  const copy = await bot.post(`/api/canvases/${canvasId}/duplicate`)
+  expect(copy.status).toBe(200)
+  expect((await copy.json()).workspaceId).toBe(workspaceId)
+  const contenders = await Promise.all([
+    foreign.post(`/api/workspaces/${foreignWorkspace}/members`, { email: 'company-bot@test.dev' }),
+    foreign.post(`/api/workspaces/${foreignWorkspace}/members`, { email: 'company-bot@test.dev' }),
+    bot.post('/api/canvases', { name: 'Forbidden one' }),
+    bot.post('/api/canvases', { name: 'Forbidden two' }),
+  ])
+  expect(contenders.map((response) => response.status)).toEqual([403, 403, 403, 403])
+  const listing = await (await bot.get('/api/canvases')).json()
+  expect(listing.length).toBe(2)
+  expect(listing.every((canvas: { workspaceId: string }) => canvas.workspaceId === workspaceId)).toBe(true)
+})
+
+it('denies audience widening, promotion, workspace deletion and private design-sync keys', async () => {
+  expect((await bot.patch(`/api/canvases/${canvasId}`, { linkAccess: 'edit' })).status).toBe(403)
+  expect((await bot.put(`/api/canvases/${canvasId}/workspace`, { workspaceId: null })).status).toBe(403)
+  expect((await bot.post(`/api/canvases/${canvasId}/members`, { email: 'company-foreign@test.dev' })).status).toBe(403)
+  expect((await bot.post('/api/workspaces', { name: 'Forbidden workspace' })).status).toBe(403)
+  expect((await human.patch(`/api/workspaces/${workspaceId}/members/${botId}`, { role: 'admin' })).status).toBe(403)
+  expect((await human.delete(`/api/workspaces/${workspaceId}`)).status).toBe(403)
+  expect((await human.get(`/api/canvases/${canvasId}/sync-keys`)).status).toBe(403)
+  expect((await human.post(`/api/canvases/${canvasId}/sync-keys`, { name: 'Forbidden key' })).status).toBe(403)
+})
+
+it('revokes owner read/list/copy/room access and preserves removal across restart', async () => {
+  expect((await bot.joinWs(canvasId)).kind).toBe('init')
+  expect((await human.delete(`/api/workspaces/${workspaceId}/members/${botId}`)).status).toBe(200)
+  const denied = async () => {
+    expect((await bot.get(`/api/canvases/${canvasId}`)).status).toBe(403)
+    expect(await (await bot.get('/api/canvases')).json()).toEqual([])
+    expect((await bot.post(`/api/canvases/${canvasId}/duplicate`)).status).toBe(403)
+    expect(await bot.joinWs(canvasId)).toEqual({ kind: 'closed', code: 4403 })
+    expect((await human.get(`/api/canvases/${canvasId}`)).status).toBe(200)
+  }
+  await denied()
+  server.stop({ keepData: true })
+  server = await startServer(configuration, server.dataDir)
+  await denied()
+}, 70_000)
diff --git a/tests/companyPolicy.test.ts b/tests/companyPolicy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a5191483eaff005bff0a4b768f29fc82c97cc8c
--- /dev/null
+++ b/tests/companyPolicy.test.ts
@@ -0,0 +1,128 @@
+import { describe, expect, it } from 'vitest'
+import { CompanyPolicy, CompanyPolicyError } from '../server/companyPolicy.ts'
+import type { Canvas } from '../shared/types.ts'
+
+const configured = JSON.stringify([{ workspaceId: 'space_a', botUserId: 'bot_a' }])
+const policy = () => new CompanyPolicy(configured)
+const canvas = (patch: Partial<Canvas> = {}): Canvas => ({
+  id: 'canvas_a',
+  name: 'Synthetic',
+  ownerId: 'bot_a',
+  workspaceId: 'space_a',
+  frames: [],
+  createdAt: 1,
+  updatedAt: 1,
+  ...patch,
+})
+const setup = () => ({
+  users: [{ id: 'bot_a', role: null as string | null }],
+  workspaces: [{ id: 'space_a', ownerId: 'human_a' }],
+  memberships: [{ workspaceId: 'space_a', userId: 'bot_a', role: 'member' }],
+  canvases: [canvas()],
+})
+
+describe('company policy configuration and setup', () => {
+  it.each([
+    'null',
+    '{}',
+    'oops',
+    '[{}]',
+    '[{"workspaceId":"x","botUserId":"b","unknown":true}]',
+    '[{"workspaceId":"../foreign","botUserId":"b"}]',
+    ' '.repeat(65537),
+  ])('rejects malformed or unbounded configuration', (value) => {
+    expect(() => new CompanyPolicy(value)).toThrow(CompanyPolicyError)
+  })
+
+  it('rejects duplicate bot/workspace assignments and excessive entries', () => {
+    const entry = { workspaceId: 'space_a', botUserId: 'bot_a' }
+    expect(() => new CompanyPolicy(JSON.stringify([entry, { ...entry, workspaceId: 'space_b' }]))).toThrow()
+    expect(() => new CompanyPolicy(JSON.stringify([entry, { ...entry, botUserId: 'bot_b' }]))).toThrow()
+    expect(
+      () =>
+        new CompanyPolicy(
+          JSON.stringify(Array.from({ length: 129 }, (_, i) => ({ workspaceId: 's' + i, botUserId: 'b' + i }))),
+        ),
+    ).toThrow()
+  })
+
+  it('validates ready setup and preserves deliberate membership revocation', () => {
+    const facts = setup()
+    expect(() => policy().validate(facts)).not.toThrow()
+    facts.memberships = []
+    expect(() => policy().validate(facts)).not.toThrow()
+  })
+
+  it('rejects missing/admin users and bot-owned workspaces', () => {
+    const facts = setup()
+    expect(() => policy().validate({ ...facts, users: [] })).toThrow()
+    expect(() => policy().validate({ ...facts, workspaces: [] })).toThrow()
+    expect(() => policy().validate({ ...facts, users: [{ id: 'bot_a', role: 'admin' }] })).toThrow()
+    expect(() => policy().validate({ ...facts, workspaces: [{ id: 'space_a', ownerId: 'bot_a' }] })).toThrow()
+  })
+
+  it('rejects foreign membership, promotion, ownership and direct invitations', () => {
+    const facts = setup()
+    expect(() =>
+      policy().validate({ ...facts, memberships: [{ workspaceId: 'space_b', userId: 'bot_a', role: 'member' }] }),
+    ).toThrow()
+    expect(() =>
+      policy().validate({ ...facts, memberships: [{ workspaceId: 'space_a', userId: 'bot_a', role: 'admin' }] }),
+    ).toThrow()
+    expect(() => policy().validate({ ...facts, canvases: [canvas({ workspaceId: undefined })] })).toThrow()
+    expect(() =>
+      policy().validate({
+        ...facts,
+        canvases: [canvas({ ownerId: 'human_b', workspaceId: 'space_b', memberIds: ['bot_a'] })],
+      }),
+    ).toThrow()
+  })
+
+  it('rejects preexisting shared/published company canvases without repairing data', () => {
+    const facts = setup()
+    const shared = canvas({ linkAccess: 'view' })
+    expect(() => policy().validate({ ...facts, canvases: [shared] })).toThrow()
+    expect(shared.linkAccess).toBe('view')
+    expect(() => policy().validate({ ...facts, canvases: [canvas({ publishedAt: 1 })] })).toThrow()
+  })
+})
+
+describe('company policy ongoing mutations', () => {
+  it('constrains all managed creation/adoption destinations and workspace ownership', () => {
+    const p = policy()
+    expect(() => p.assertCreation('bot_a', 'space_a')).not.toThrow()
+    for (const destination of [undefined, 'space_b']) expect(() => p.assertCreation('bot_a', destination)).toThrow()
+    expect(() => p.assertWorkspaceOwner('bot_a')).toThrow()
+    expect(() => p.assertCreation('human_a', undefined)).not.toThrow()
+  })
+
+  it('denies public features and cross-workspace detachment even to the owner', () => {
+    const p = policy()
+    expect(() => p.assertPublicFeature('space_a')).toThrow()
+    expect(() => p.assertMove(canvas(), undefined)).toThrow()
+    expect(() => p.assertMove(canvas({ ownerId: 'human_a' }), 'space_b')).toThrow()
+    expect(() => p.assertMove(canvas(), 'space_a')).not.toThrow()
+    expect(() => p.assertPublicFeature(undefined)).not.toThrow()
+  })
+
+  it('does not adopt public content into a private workspace', () => {
+    expect(() =>
+      policy().assertMove(canvas({ ownerId: 'human_a', workspaceId: undefined, linkAccess: 'view' }), 'space_a'),
+    ).toThrow()
+    expect(() =>
+      policy().assertMove(canvas({ ownerId: 'human_a', workspaceId: undefined, publishedAt: 1 }), 'space_a'),
+    ).toThrow()
+  })
+
+  it('binds invitations and roles and requires current membership for private listing', () => {
+    const p = policy()
+    expect(p.allowsMembership('space_a', 'bot_a', 'member')).toBe(true)
+    expect(p.allowsMembership('space_b', 'bot_a', 'member')).toBe(false)
+    expect(p.allowsMembership('space_a', 'bot_a', 'admin')).toBe(false)
+    expect(() => p.assertInvite(canvas({ ownerId: 'human_b', workspaceId: 'space_b' }), 'bot_a')).toThrow()
+    expect(p.allowsListing('bot_a', canvas(), ['space_a'])).toBe(true)
+    expect(p.allowsListing('bot_a', canvas(), [])).toBe(false)
+    expect(p.allowsListing('human_a', canvas({ ownerId: 'human_a' }), [])).toBe(false)
+    expect(p.allowsListing('bot_a', canvas({ ownerId: undefined, workspaceId: undefined }), [])).toBe(false)
+  })
+})
