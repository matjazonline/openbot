+})
+
+const variants = [
+  ['conditional', 'GET', { 'If-None-Match': '*' }],
+  ['modified', 'GET', { 'If-Modified-Since': 'Wed, 21 Oct 2099 07:28:00 GMT' }],
+  ['multi-range', 'GET', { Range: 'bytes=0-1,4-6' }],
+  ['if-range', 'GET', { Range: 'bytes=0-7', 'If-Range': 'secret-validator' }],
