--- /dev/null
+++ b/src/components/PrivateCanvasChoice.tsx
@@ -0,0 +1,58 @@
+import { useEffect, useState } from 'react'
+import type { CanvasMeta } from '../../shared/types'
+import { api, errorMessage } from '../lib/api'
+import { Note } from './ui/note'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from './ui/select'
+
+/** A visible storage choice: private files never acquire an implicit parent. */
+export function PrivateCanvasChoice({
+  value,
+  onChange,
+  workspaceId,
+  disabled,
+}: {
+  value: string
+  onChange(value: string): void
+  workspaceId?: string
+  disabled?: boolean
+}) {
+  const [canvases, setCanvases] = useState<CanvasMeta[]>([])
+  const [error, setError] = useState('')
+  useEffect(() => {
+    let live = true
+    api.listCanvases().then(
+      (list) => {
+        if (live) setCanvases(list.filter((c) => !workspaceId || c.workspaceId === workspaceId))
+      },
+      (reason: unknown) => {
+        if (live) setError(errorMessage(reason, 'The canvas list could not be loaded.'))
+      },
+    )
+    return () => {
+      live = false
+    }
+  }, [workspaceId])
+  return (
+    <div className="flex flex-col gap-2">
+      <label className="flex flex-col gap-1 text-body">
+        Store files in canvas
+        <Select value={value} disabled={disabled || !canvases.length} onValueChange={onChange}>
+          <SelectTrigger aria-label="Store files in canvas">
+            <SelectValue placeholder="Choose a canvas" />
+          </SelectTrigger>
+          <SelectContent>
+            {canvases.map((canvas) => (
+              <SelectItem key={canvas.id} value={canvas.id}>
+                {canvas.name}
+              </SelectItem>
+            ))}
+          </SelectContent>
+        </Select>
+      </label>
+      <Note>
+        Only people with current access to this canvas can load these files. Create a canvas first if the list is empty.
+      </Note>
+      {error && <Note tone="error">{error}</Note>}
+    </div>
+  )
+}
diff --git a/src/lib/privateExport.ts b/src/lib/privateExport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..170647776325f38cfeaafb63ccc4e1ed36c7bd2a
--- /dev/null
+++ b/src/lib/privateExport.ts
@@ -0,0 +1,151 @@
+import type { Frame } from '../../shared/types'
+import * as css from 'css-tree'
+import { inlineMedia } from '../../shared/inlineMedia'
+import {
+  PrivateMediaBudget,
+  PrivateMaterializationError,
+  PRIVATE_MEDIA_LIMITS,
+  assertPrivateMediaCosts,
+  type PrivateMediaAllowance,
+  type PrivateDocumentContext,
+  type PrivateMaterialization,
+} from '../../shared/privateMedia'
+import { preparePrivateDocument, privateMediaOperation, type PrivateMaterializer } from './privateMaterialization'
+
+/** One trusted-parent export. No completed bytes or authority survive its close. */
+export class PrivateExportOperation {
+  readonly budget = new PrivateMediaBudget()
+  readonly context: PrivateDocumentContext
+  private readonly lifetime
+  readonly signal: AbortSignal
+  private preparation = Promise.resolve()
+  private readonly inlineResources = new Set<string>()
+  private readonly publicBytes = new Map<string, number>()
+
+  constructor(
+    frame: Pick<Frame, 'id' | 'canvasId'>,
+    signal?: AbortSignal,
+    private readonly materialize: PrivateMaterializer = preparePrivateDocument,
+  ) {
+    this.context = Object.freeze({ canvasId: frame.canvasId, kind: 'frame', id: frame.id })
+    this.lifetime = privateMediaOperation(signal)
+    this.signal = this.lifetime.signal
+  }
+
+  async document(source: string, syntax: 'html' | 'stylesheet' | 'value' = 'html'): Promise<PrivateMaterialization> {
+    return this.serial(async () => {
+      const prepared = await this.materialize(source, this.context, this.signal, syntax, this.budget.remaining)
+      this.signal.throwIfAborted()
+      this.budget.merge(prepared.costs)
+      for (const row of prepared.costs.resources) if (row.key.startsWith('inline:')) this.inlineResources.add(row.key)
+      return prepared
+    })
+  }
+
+  /** Call after asynchronous raster/crop work and immediately before delivery. */
+  async revalidate(): Promise<void> {
+    await this.serial(async () => {
+      await this.materialize('', this.context, this.signal, 'html', this.budget.remaining)
+      this.signal.throwIfAborted()
+    })
+  }
+
+  /** Reserve anonymous chunks before buffering, without trusting an HTTP length. */
+  publicChunk(key: string, bytes: number): void {
+    this.signal.throwIfAborted()
+    if (!this.publicBytes.has(key) && this.publicBytes.size >= PRIVATE_MEDIA_LIMITS.references)
+      throw new PrivateMaterializationError('limit')
+    this.budget.chargeEncoded(bytes)
+    this.publicBytes.set(key, (this.publicBytes.get(key) ?? 0) + bytes)
+  }
+
+  privateResource(url: string): Promise<string> {
+    return this.serial(async () => {
+      const { prepared, row } = await this.resource(url, { ...this.budget.remaining, references: 1 })
+      if (!row.key.startsWith(`private:${this.context.canvasId}:`) || prepared.replacements.length !== 1)
+        throw new PrivateMaterializationError('invalid')
+      this.budget.reserveEncoded(row.key, row.encodedBytes)
+      this.budget.reserveDecoded(row.key, row.decodedBytes)
+      return prepared.replacements[0]!.inline
+    })
+  }
+
+  publicResource(uri: string, key: string, bytes: number): Promise<string> {
+    return this.serial(async () => {
+      if (this.publicBytes.get(key) !== bytes) throw new PrivateMaterializationError('invalid')
+      // The wrapper uses the bytes/reference already reserved for this resource.
+      // Every supplied limit remains <= the fixed server maximum; costs come back
+      // from the real server parser/decoder, never from the browser request.
+      const { row } = await this.resource(uri, {
+        ...this.budget.remaining,
+        references: 1,
+        encodedBytes: this.budget.remaining.encodedBytes + bytes,
+      })
+      if (!row.key.startsWith('inline:') || row.encodedBytes !== bytes) throw new PrivateMaterializationError('invalid')
+      this.budget.reserveDecoded(`public:${key}:${row.key}`, row.decodedBytes)
+      return `data:${row.mime};base64,${uri.slice(uri.indexOf(',') + 1)}`
+    })
+  }
+
+  inlineResource(uri: string): Promise<string> {
+    return this.serial(async () => {
+      const media = inlineMedia(uri, 'media')
+      if (!media || media.syntax) throw new PrivateMaterializationError('unsupported')
+      const digest = await crypto.subtle.digest('SHA-256', new Uint8Array(media.bytes))
+      this.signal.throwIfAborted()
+      const hash = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')
+      const key = `inline:${media.mime}:${hash}`
+      // Reuse only an identical payload already admitted by this operation's
+      // producer. Alternate data-URL encodings cannot spend its budget twice.
+      if (this.inlineResources.has(key)) return uri
+      const { row } = await this.resource(uri, { ...this.budget.remaining, references: 1 })
+      if (row.key !== key) throw new PrivateMaterializationError('invalid')
+      this.budget.reserveEncoded(row.key, row.encodedBytes)
+      this.budget.reserveDecoded(row.key, row.decodedBytes)
+      this.inlineResources.add(key)
+      return uri
+    })
+  }
+
+  private async resource(source: string, allowance: PrivateMediaAllowance) {
+    const prepared = await this.materialize(
+      `url(${css.string.encode(source)})`,
+      this.context,
+      this.signal,
+      'value',
+      allowance,
+    )
+    this.signal.throwIfAborted()
+    assertPrivateMediaCosts(prepared.costs)
+    const row = prepared.costs.resources[0]
+    if (
+      prepared.costs.references !== 1 ||
+      prepared.costs.resources.length !== 1 ||
+      !row ||
+      !/^(?:image|font)\//.test(row.mime)
+    )
+      throw new PrivateMaterializationError('unsupported')
+    this.budget.chargeWork(prepared.costs.parserWork)
+    return { prepared, row }
+  }
+
+  private serial<T>(work: () => Promise<T>): Promise<T> {
+    const pending = this.preparation.then(() => {
+      this.signal.throwIfAborted()
+      return work()
+    })
+    this.preparation = pending.then(
+      () => {},
+      () => {
+        this.close()
+      },
+    )
+    return pending
+  }
+
+  close(): void {
+    this.lifetime.close()
+    this.publicBytes.clear()
+    this.inlineResources.clear()
+  }
+}
diff --git a/src/lib/privateMaterialization.ts b/src/lib/privateMaterialization.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8198fed05b1582a02476f1421141f7efe235fc2b
--- /dev/null
+++ b/src/lib/privateMaterialization.ts
@@ -0,0 +1,192 @@
+import { createContext, useContext, useEffect, useState, useSyncExternalStore } from 'react'
+import { api, ApiError } from './api'
+import {
+  PRIVATE_MEDIA_LIMITS,
+  assertPrivateMediaCosts,
+  type PrivateMediaAllowance,
+  PrivateMaterializationError,
+  type PrivateDocumentContext,
+  type PrivateMaterialization,
+} from '../../shared/privateMedia'
+
+let epoch = 0
+let actor: string | null | undefined
+const blocked = new Set<string>()
+const pending = new Set<AbortController>()
+const listeners = new Set<() => void>()
+
+/** Existing epoch cancellation also covers a whole export between API reads. */
+export function privateMediaOperation(signal?: AbortSignal) {
+  const controller = new AbortController()
+  pending.add(controller)
+  return {
+    signal: signal ? AbortSignal.any([signal, controller.signal]) : controller.signal,
+    close: () => {
+      pending.delete(controller)
+      controller.abort()
+    },
+  }
+}
+
+export function invalidatePrivateMedia(canvasId?: string): void {
+  if (canvasId) blocked.add(canvasId)
+  epoch++
+  for (const controller of [...pending]) controller.abort()
+  for (const notify of [...listeners]) notify()
+}
+
+/** Observes the existing session owner; it does not authenticate independently. */
+export function observePrivateMediaActor(id: string | null): void {
+  if (actor === id) return
+  actor = id
+  blocked.clear()
+  invalidatePrivateMedia()
+}
+
+/** Called only after the existing canvas loader has obtained fresh access. */
+export function observePrivateCanvasAccess(canvasId: string): void {
+  if (!blocked.delete(canvasId)) return
+  invalidatePrivateMedia()
+}
+
+export function usePrivateMediaEpoch(): number {
+  return useSyncExternalStore(
+    (notify) => {
+      listeners.add(notify)
+      return () => {
+        listeners.delete(notify)
+      }
+    },
+    () => epoch,
+  )
+}
+
+export type PrivateMaterializer = (
+  source: string,
+  context: PrivateDocumentContext,
+  signal?: AbortSignal,
+  syntax?: 'html' | 'stylesheet' | 'value',
+  remaining?: PrivateMediaAllowance,
+) => Promise<PrivateMaterialization>
+
+export const preparePrivateDocument: PrivateMaterializer = async (
+  source,
+  context,
+  signal,
+  syntax = 'html',
+  remaining,
+) => {
+  if (blocked.has(context.canvasId)) throw new PrivateMaterializationError('aborted')
+  const started = epoch
+  const controller = new AbortController()
+  pending.add(controller)
+  const combined = signal ? AbortSignal.any([signal, controller.signal]) : controller.signal
+  try {
+    const result = await api.privateMaterialization(context, source, combined, syntax, remaining)
+    if (combined.aborted || epoch !== started) throw new PrivateMaterializationError('aborted')
+    if (
+      !result ||
+      typeof result.html !== 'string' ||
+      typeof result.privateMedia !== 'boolean' ||
+      !Array.isArray(result.replacements) ||
+      result.replacements.length > PRIVATE_MEDIA_LIMITS.references ||
+      result.replacements.some(
+        (value) => !value || typeof value.inline !== 'string' || typeof value.canonical !== 'string',
+      ) ||
+      new TextEncoder().encode(result.html).length > PRIVATE_MEDIA_LIMITS.expandedBytes ||
+      new TextEncoder().encode(JSON.stringify(result.replacements)).length > PRIVATE_MEDIA_LIMITS.replacementBytes
+    )
+      throw new PrivateMaterializationError('invalid')
+    assertPrivateMediaCosts(result.costs)
+    return result
+  } catch (error) {
+    if (error instanceof ApiError && [401, 403, 404].includes(error.status) && epoch === started) {
+      let lostContext = true
+      if (error.status === 404 && source && !combined.aborted) {
+        // A missing/foreign file is not evidence of lost canvas access. Ask the
+        // same current-context owner, without reading another resource or cache.
+        try {
+          await api.privateMaterialization(context, '', combined, 'html', {
+            encodedBytes: 0,
+            decodedBytes: 0,
+            references: 0,
+            parserWork: 0,
+            expandedBytes: 0,
+          })
+          lostContext = false
+        } catch (probe) {
+          lostContext = probe instanceof ApiError && [401, 403, 404].includes(probe.status)
+        }
+      }
+      if (lostContext && epoch === started) invalidatePrivateMedia(context.canvasId)
+    }
+    if (combined.aborted || epoch !== started) throw new PrivateMaterializationError('aborted')
+    if (error instanceof PrivateMaterializationError) throw error
+    throw new PrivateMaterializationError(
+      error instanceof ApiError && error.status === 413
+        ? 'limit'
+        : error instanceof ApiError && error.status === 422
+          ? 'unsupported'
+          : 'invalid',
+    )
+  } finally {
+    pending.delete(controller)
+  }
+}
+
+/** Synthetic component fixtures can supply an explicit transport through React;
+ * the application default always uses its normal authenticated API owner. */
+export const PrivateMaterializationContext = createContext<PrivateMaterializer>(preparePrivateDocument)
+
+/** Identity is checked during render too, so a changed actor/context never
+ * commits the prior document while its replacement request is still pending. */
+export function usePrivateDocument(source: string, context: PrivateDocumentContext | null) {
+  const canvasId = context?.canvasId
+  const kind = context?.kind
+  const id = context?.id
+  const materialize = useContext(PrivateMaterializationContext)
+  const currentEpoch = usePrivateMediaEpoch()
+  const [state, setState] = useState<{
+    source: string
+    context: PrivateDocumentContext
+    epoch: number
+    prepared?: PrivateMaterialization
+    error?: Error
+  }>()
+  useEffect(() => {
+    if (!canvasId || !kind || !id) return
+    const requestContext = { canvasId, kind, id }
+    const controller = new AbortController()
+    let cancelled = false
+    void materialize(source, requestContext, controller.signal)
+      .then((prepared) => {
+        if (!cancelled && !controller.signal.aborted)
+          setState({ source, context: requestContext, epoch: currentEpoch, prepared })
+      })
+      .catch((error: unknown) => {
+        if (!cancelled && !controller.signal.aborted)
+          setState({
+            source,
+            context: requestContext,
+            epoch: currentEpoch,
+            error: error instanceof PrivateMaterializationError ? error : new PrivateMaterializationError('invalid'),
+          })
+      })
+    return () => {
+      cancelled = true
+      controller.abort()
+    }
+  }, [source, canvasId, kind, id, currentEpoch, materialize])
+  const matches =
+    !!context &&
+    state?.source === source &&
+    state.epoch === currentEpoch &&
+    state.context.canvasId === context.canvasId &&
+    state.context.kind === context.kind &&
+    state.context.id === context.id
+  return {
+    prepared: matches ? state.prepared : undefined,
+    error: matches ? state.error : undefined,
+    epoch: currentEpoch,
+  }
+}
diff --git a/tests/canvasCreationVisibility.test.ts b/tests/canvasCreationVisibility.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc2ef98f3d21f31e20c774861a915b94fe1356e6
--- /dev/null
+++ b/tests/canvasCreationVisibility.test.ts
@@ -0,0 +1,94 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import type { Canvas } from '../shared/types.ts'
+
+const persistence = vi.hoisted(() => ({
+  insertCanvas: vi.fn<(canvas: Canvas) => Promise<void>>(),
+  saveCanvas: vi.fn(),
+  saveFrame: vi.fn(),
+  deleteCanvas: vi.fn(),
+}))
+vi.mock('../server/db/persist.ts', () => persistence)
+const { store, CanvasCreationUncertainError } = await import('../server/store.ts')
+const { seed } = await import('../server/seed.ts')
+
+beforeEach(() => {
+  store.canvases.clear()
+  vi.clearAllMocks()
+})
+
+function holdInsert() {
+  let candidate: Canvas | undefined
+  let commit!: () => void
+  let fail!: (error: Error) => void
+  const held = new Promise<void>((resolve, reject) => {
+    commit = resolve
+    fail = reject
+  })
+  persistence.insertCanvas.mockImplementation((canvas) => {
+    candidate = canvas
+    return held
+  })
+  return {
+    get candidate() {
+      return candidate!
+    },
+    commit,
+    fail,
+  }
+}
+
+describe('one initial canvas publication boundary', () => {
+  it('denies candidate reads, lists, child writes and deletion until commit, then publishes once', async () => {
+    const insert = holdInsert()
+    const creating = store.createCanvas('Held private parent', 'owner')
+    const id = insert.candidate.id
+    expect(store.getCanvas(id)).toBeUndefined()
+    expect(store.listCanvases('owner')).toEqual([])
+    expect(store.createFrame(id, { name: 'Premature child', html: '<p>x</p>' }, 'owner')).toBeUndefined()
+    expect(await store.deleteCanvas(id)).toBeUndefined()
+    expect(persistence.saveFrame).not.toHaveBeenCalled()
+    expect(persistence.deleteCanvas).not.toHaveBeenCalled()
+    insert.commit()
+    const created = await creating
+    expect(created).toBe(insert.candidate)
+    expect(store.getCanvas(id)).toBe(created)
+    expect(store.listCanvases('owner').map((c) => c.id)).toEqual([id])
+    expect(store.createFrame(id, { name: 'Committed child', html: '<p>x</p>' }, 'owner')).toBeTruthy()
+    expect(persistence.insertCanvas).toHaveBeenCalledOnce()
+  })
+
+  it('retains no failed parent/child and exposes only bounded uncertainty', async () => {
+    const insert = holdInsert()
+    const creating = store.createCanvas('Private title', 'owner')
+    const rejected = expect(creating).rejects.toBeInstanceOf(CanvasCreationUncertainError)
+    insert.fail(new Error('SQL statement with secret parameters'))
+    await rejected
+    expect(store.getCanvas(insert.candidate.id)).toBeUndefined()
+    expect(store.listCanvases('owner')).toEqual([])
+    expect(store.createFrame(insert.candidate.id, { name: 'Phantom', html: '<p>x</p>' }, 'owner')).toBeUndefined()
+    expect(persistence.saveCanvas).not.toHaveBeenCalled()
+    expect(persistence.saveFrame).not.toHaveBeenCalled()
+    expect(persistence.insertCanvas).toHaveBeenCalledOnce()
+  })
+
+  it('seed waits for a durable parent before creating either child', async () => {
+    const insert = holdInsert()
+    const seeding = seed()
+    expect(store.canvases.size).toBe(0)
+    expect(persistence.saveFrame).not.toHaveBeenCalled()
+    persistence.saveFrame.mockImplementation((frame) => {
+      expect(store.getCanvas(frame.canvasId)).toBe(insert.candidate)
+    })
+    insert.commit()
+    await seeding
+    expect(insert.candidate.frames).toHaveLength(2)
+    expect(persistence.saveFrame).toHaveBeenCalledTimes(2)
+  })
+
+  it('failed seed rejects startup work without publishing a parent or queuing children', async () => {
+    persistence.insertCanvas.mockRejectedValueOnce(new Error('owned database rejection'))
+    await expect(seed()).rejects.toBeInstanceOf(CanvasCreationUncertainError)
+    expect(store.canvases.size).toBe(0)
+    expect(persistence.saveFrame).not.toHaveBeenCalled()
+  })
+})
