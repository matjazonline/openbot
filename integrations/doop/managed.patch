new file mode 100644
index 0000000000000000000000000000000000000000..0276034fcb0d964694322e9863593efb541e7a5d
--- /dev/null
+++ b/server/privateMaterialization.ts
@@ -0,0 +1,300 @@
+import { createHash } from 'node:crypto'
+import * as css from 'css-tree'
+import { assetMetadata, getAsset } from './assets.ts'
+import { env } from './env.ts'
+import {
+  assertRenderRead,
+  PrivateResourceError,
+  resourceReadError,
+  type PrivateRenderScope,
+} from './privateResources.ts'
+import {
+  PRIVATE_REFERENCE_LIMITS,
+  PrivateReferenceError,
+  privateAssetUrl,
+  visitPrivateReferences,
+  type PrivateReference,
+  type PrivateUrlKind,
+} from '../shared/privateReferences.ts'
+import { inlineMedia } from '../shared/inlineMedia.ts'
+import {
+  PRIVATE_MEDIA_LIMITS,
+  PrivateMediaBudget,
+  PrivateMaterializationError,
+  type PrivateMaterialization,
+  type PrivateReplacement,
+  type PrivateMediaAllowance,
+  type PrivateResourceCost,
+} from '../shared/privateMedia.ts'
+import type { MediaInput } from './privateMediaFiles.ts'
+import { validateMediaInputs } from './privateMediaValidation.ts'
+import { runMaterializationJob } from './materializationJob.ts'
+
+type Syntax = 'html' | 'stylesheet' | 'value'
+type StoredInput = { reference: PrivateReference; expectedBytes: number; media?: MediaInput }
+
+/** Only this owner turns canonical private references into bytes for a render.
+ * No asset HTTP fetch, credential serialization, public listener or ID-derived scope. */
+export async function materializePrivateResources(
+  source: string,
+  scope: PrivateRenderScope,
+  {
+    syntax = 'html',
+    signal,
+    limits,
+    publicReference,
+    budget = new PrivateMediaBudget(0, limits),
+  }: {
+    syntax?: Syntax
+    signal?: AbortSignal
+    budget?: PrivateMediaBudget
+    limits?: PrivateMediaAllowance
+    publicReference?: (url: string) => void
+  } = {},
+): Promise<PrivateMaterialization> {
+  try {
+    return await runMaterializationJob(async (job) => {
+      await job.read(() => assertRenderRead(scope))
+      if (source === '') {
+        // The normal empty-source request revalidates this same live scope.
+        // No source/parser/media allocation is needed, even with no budget left.
+        await job.read(() => assertRenderRead(scope))
+        return {
+          html: '',
+          replacements: [],
+          privateMedia: false,
+          costs: { resources: [], references: 0, parserWork: 0, expandedBytes: 0 },
+        }
+      }
+      const stored = new Map<string, StoredInput>()
+      const inline = new Map<string, MediaInput>()
+      const references: PrivateReference[] = []
+      let declaredBytes = 0
+      let sourceReferences = 0
+      let parserWork = 0
+      const countReference = () => {
+        sourceReferences++
+        budget.reference()
+      }
+      const work = (count: number) => {
+        parserWork += count
+        budget.chargeWork(count)
+      }
+      const privateKey = (ref: PrivateReference) => `private:${scope.canvasId}:${ref.id}.${ref.ext}`
+      const sourceUrl = (raw: string, base: string, kind: PrivateUrlKind = 'other', depth = 0) => {
+        if (!raw.trim() || raw.trim().startsWith('#')) return
+        const url = new URL(raw, base)
+        if (url.protocol === 'data:') {
+          dataReference(url.href, depth, kind)
+          return
+        }
+        if (privateAssetUrl(raw, env.BETTER_AUTH_URL, base)) return
+        if (!['http:', 'https:', 'blob:'].includes(url.protocol)) return
+        countReference()
+        if (url.protocol !== 'blob:') {
+          url.hash = ''
+          publicReference?.(url.href)
+        }
+      }
+      const dataReference = (raw: string, depth: number, kind: PrivateUrlKind) => {
+        job.check()
+        countReference()
+        const media = inlineMedia(raw, kind === 'other' ? 'source' : kind)
+        if (!media) return
+        if (depth >= PRIVATE_REFERENCE_LIMITS.depth) throw new PrivateMaterializationError('limit')
+        const key = `${media.mime}:${createHash('sha256').update(media.bytes).digest('hex')}`
+        if (inline.has(key)) return
+        declaredBytes += media.bytes.byteLength
+        if (declaredBytes > PRIVATE_MEDIA_LIMITS.encodedBytes) throw new PrivateMaterializationError('limit')
+        budget.reserveEncoded(`inline:${key}`, media.bytes.byteLength)
+        inline.set(key, media)
+        if (media.syntax) {
+          const nested = new TextDecoder('utf-8', { fatal: true }).decode(media.bytes)
+          visitPrivateReferences(
+            nested,
+            env.BETTER_AUTH_URL,
+            () => {
+              // Encoded HTML/CSS is intentionally kept canonical. A hidden private
+              // reference cannot be repaired by returning an unscoped hotlink.
+              throw new PrivateMaterializationError('unsupported')
+            },
+            media.syntax,
+            {
+              work,
+              url: (value, base, kind) => sourceUrl(value, base, kind, depth + 1),
+            },
+          )
+        }
+      }
+      visitPrivateReferences(
+        source,
+        env.BETTER_AUTH_URL,
+        (reference) => {
+          job.check()
+          countReference()
+          // Preflight every row before the first storage read, even if the actor
+          // owns both canvases. The expected parent comes only from the scope.
+          const row = assetMetadata(reference.id)
+          if (!row || row.canvasId !== scope.canvasId || row.ext !== reference.ext) throw new PrivateResourceError()
+          references.push(reference)
+          const key = `${reference.id}.${reference.ext}`
+          if (!stored.has(key)) {
+            declaredBytes += row.size
+            if (!Number.isSafeInteger(declaredBytes) || declaredBytes > PRIVATE_MEDIA_LIMITS.encodedBytes)
+              throw new PrivateMaterializationError('limit')
+            budget.reserveEncoded(privateKey(reference), row.size)
+            stored.set(key, { reference, expectedBytes: row.size })
+          }
+        },
+        syntax,
+        {
+          work,
+          url: sourceUrl,
+        },
+      )
+
+      const wanted = [...stored.values()]
+      let next = 0
+      let failed = false
+      const loaders = Array.from(
+        { length: Math.min(PRIVATE_MEDIA_LIMITS.storageConcurrency, wanted.length) },
+        async () => {
+          try {
+            while (next < wanted.length && !failed) {
+              job.check()
+              const entry = wanted[next++]!
+              const asset = await job.read(() => getAsset(entry.reference.id, scope, entry.reference.ext))
+              if (failed) return
+              if (!asset) throw new PrivateResourceError()
+              if (asset.buf.length !== entry.expectedBytes || asset.meta.size !== entry.expectedBytes)
+                throw new PrivateMaterializationError('invalid')
+              entry.media = { bytes: asset.buf, mime: asset.meta.mime }
+            }
+          } catch (error) {
+            failed = true
+            throw error
+          }
+        },
+      )
+      const loaded = await Promise.allSettled(loaders)
+      const failure = loaded.find((result) => result.status === 'rejected')
+      if (failure?.status === 'rejected') throw failure.reason
+      job.check()
+      const inputs = [
+        ...wanted.map((entry) => {
+          if (!entry.media) throw new PrivateResourceError()
+          return { key: privateKey(entry.reference), media: entry.media }
+        }),
+        ...[...inline.entries()]
+          .filter(([, value]) => !('syntax' in value))
+          .map(([key, media]) => ({ key: `inline:${key}`, media })),
+      ]
+      // Reserve expanded strings before base64 generation, including repeated and
+      // deeply escaped srcdoc insertions. Intrinsic decode remains a separate unit.
+      const lengths = new Map(
+        wanted.map((entry) => {
+          const file = entry.media!
+          return [
+            `${entry.reference.id}.${entry.reference.ext}`,
+            Buffer.byteLength(`data:${file.mime};doop-resource=${entry.reference.id};base64,`) +
+              4 * Math.ceil(file.bytes.byteLength / 3),
+          ] as const
+        }),
+      )
+      let estimated = Buffer.byteLength(source)
+      for (const ref of references) {
+        estimated +=
+          lengths.get(`${ref.id}.${ref.ext}`)! +
+          Buffer.byteLength(ref.hash) * (4 * PRIVATE_REFERENCE_LIMITS.depth + 6) +
+          512 * PRIVATE_REFERENCE_LIMITS.depth
+        budget.assertExpansion(estimated)
+      }
+      budget.assertExpansion(estimated)
+      let nextCost = 0
+      const results = inputs.length
+        ? await validateMediaInputs(
+            job,
+            inputs.map((entry) => entry.media),
+            (cost) => {
+              const entry = inputs[nextCost++]!
+              budget.reserveDecoded(entry.key, cost.decodedBytes)
+              work(cost.parserWork ?? 0)
+            },
+            PRIVATE_MEDIA_LIMITS.parserWork - budget.remaining.parserWork,
+          )
+        : []
+      const resources: PrivateResourceCost[] = inputs.map((entry, index) => ({
+        key: entry.key,
+        mime: entry.media.mime,
+        encodedBytes: entry.media.bytes.byteLength,
+        decodedBytes: results[index]!.decodedBytes,
+      }))
+      for (const [key, media] of inline)
+        if ('syntax' in media)
+          resources.push({
+            key: `inline:${key}`,
+            mime: media.mime,
+            encodedBytes: media.bytes.byteLength,
+            decodedBytes: 0,
+          })
+      const dataUrls = new Map<string, string>()
+      for (const entry of wanted) {
+        job.check()
+        const { id, ext } = entry.reference
+        const file = entry.media!
+        dataUrls.set(
+          `${id}.${ext}`,
+          `data:${file.mime};doop-resource=${id};base64,${Buffer.from(file.bytes).toString('base64')}`,
+        )
+      }
+      const replacements = new Map<string, PrivateReplacement>()
+      const html = visitPrivateReferences(
+        source,
+        env.BETTER_AUTH_URL,
+        (ref) => {
+          const data = dataUrls.get(`${ref.id}.${ref.ext}`)
+          if (!data) throw new PrivateResourceError()
+          const value = data + ref.hash
+          const cssInline = css.string.encode(value).slice(1, -1)
+          const cssCanonical = css.string.encode(ref.url).slice(1, -1)
+          replacements.set(value, {
+            inline: value,
+            canonical: ref.url,
+            ...(cssInline !== value ? { cssInline, cssCanonical } : {}),
+          })
+          return value
+        },
+        syntax,
+        { work },
+      )
+      const values = [...replacements.values()]
+      const table = JSON.stringify(values)
+      if (
+        Buffer.byteLength(html) > PRIVATE_MEDIA_LIMITS.expandedBytes ||
+        Buffer.byteLength(table) > PRIVATE_MEDIA_LIMITS.replacementBytes
+      )
+        throw new PrivateMaterializationError('limit')
+      if (
+        estimated + Buffer.byteLength(table) + Buffer.byteLength(source) * 5 + 65_536 >
+        PRIVATE_MEDIA_LIMITS.responseBytes
+      )
+        throw new PrivateMaterializationError('limit')
+      const expandedBytes = Buffer.byteLength(html)
+      budget.chargeExpanded(expandedBytes)
+      const result: PrivateMaterialization = {
+        html,
+        replacements: values,
+        privateMedia: stored.size > 0 || inline.size > 0,
+        costs: { resources, references: sourceReferences, parserWork, expandedBytes },
+      }
+      if (Buffer.byteLength(JSON.stringify(result)) > PRIVATE_MEDIA_LIMITS.responseBytes)
+        throw new PrivateMaterializationError('limit')
+      await job.read(() => assertRenderRead(scope))
+      job.check()
+      return result
+    }, signal)
+  } catch (error) {
+    if (error instanceof PrivateReferenceError) throw new PrivateMaterializationError('invalid')
+    throw resourceReadError(error)
+  }
+}
diff --git a/server/privateMediaDecoder.ts b/server/privateMediaDecoder.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d2b2a897c87de02915d15eee055054fd2122a43
--- /dev/null
+++ b/server/privateMediaDecoder.ts
@@ -0,0 +1,79 @@
+import { parentPort, workerData } from 'node:worker_threads'
+import { validateMedia, type MediaInput } from './privateMediaFiles.ts'
+import { PrivateMaterializationError, PrivateMediaBudget } from '../shared/privateMedia.ts'
+import { makeMediaPreview } from './privateMediaPreview.ts'
+
+if (!parentPort) throw new Error('private media decoder requires its worker port')
+const port = parentPort
+let next = 0
+const reservations = new Map<number, { resolve: () => void; reject: (error: Error) => void }>()
+port.on('message', (message: unknown) => {
+  if (!message || typeof message !== 'object' || !('type' in message) || message.type !== 'admitted') return
+  const value = message as { id?: unknown; accepted?: unknown }
+  if (typeof value.id !== 'number') return
+  const reservation = reservations.get(value.id)
+  if (!reservation) return
+  reservations.delete(value.id)
+  if (value.accepted === true) reservation.resolve()
+  else reservation.reject(new PrivateMaterializationError('limit'))
+})
+
+async function reserve(cost: import('./privateMediaFiles.ts').MediaAdmission): Promise<void> {
+  const id = next++
+  await new Promise<void>((resolve, reject) => {
+    reservations.set(id, { resolve, reject })
+    port.postMessage({ type: 'admit', id, cost })
+  })
+}
+
+try {
+  const request: unknown = workerData
+  if (!request || typeof request !== 'object' || !('operation' in request))
+    throw new PrivateMaterializationError('invalid')
+  const budget = new PrivateMediaBudget()
+  if (request.operation === 'preview') {
+    if (!('bytes' in request) || !(request.bytes instanceof Uint8Array))
+      throw new PrivateMaterializationError('invalid')
+    budget.chargeEncoded(request.bytes.byteLength)
+    const result = await makeMediaPreview(request.bytes, async (cost) => {
+      budget.chargeDecoded(cost.decodedBytes)
+      await reserve(cost)
+    })
+    port.postMessage({ type: 'complete', result })
+  } else {
+    if (
+      request.operation !== 'validate' ||
+      !('items' in request) ||
+      !('parserWork' in request) ||
+      typeof request.parserWork !== 'number'
+    )
+      throw new PrivateMaterializationError('invalid')
+    const items: unknown = request.items
+    if (!Array.isArray(items)) throw new PrivateMaterializationError('invalid')
+    budget.chargeWork(request.parserWork)
+    for (const item of items) {
+      if (!item || typeof item !== 'object' || !(item.bytes instanceof Uint8Array) || typeof item.mime !== 'string')
+        throw new PrivateMaterializationError('invalid')
+      budget.reference()
+      budget.chargeEncoded(item.bytes.byteLength)
+    }
+    const results = []
+    for (const item of items as MediaInput[]) {
+      const result = await validateMedia(
+        item,
+        async (cost) => {
+          budget.chargeDecoded(cost.decodedBytes)
+          await reserve(cost)
+        },
+        (count) => budget.chargeWork(count),
+      )
+      results.push(result)
+    }
+    port.postMessage({ type: 'complete', result: results })
+  }
+} catch (error) {
+  // No native parser errors, file contents, paths or diagnostics cross the boundary.
+  port.postMessage({ type: 'failed', kind: error instanceof PrivateMaterializationError ? error.kind : 'invalid' })
+} finally {
+  port.close()
+}
diff --git a/server/privateMediaFiles.ts b/server/privateMediaFiles.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d7b977d8a081c98eb412a4bc24735c552ad6116
--- /dev/null
+++ b/server/privateMediaFiles.ts
@@ -0,0 +1,151 @@
+import sharp from 'sharp'
+import { inspectFontFile } from './fontFile.ts'
+import { visitPrivateReferences } from '../shared/privateReferences.ts'
+import { PRIVATE_MEDIA_LIMITS, PrivateMaterializationError, rasterDecodedBytes } from '../shared/privateMedia.ts'
+
+export interface MediaInput {
+  readonly bytes: Uint8Array
+  readonly mime: string
+}
+
+export interface MediaAdmission {
+  readonly decodedBytes: number
+  readonly parserWork?: number
+  readonly width?: number
+  readonly height?: number
+  readonly pages?: number
+}
+
+const rasterFormats = new Set(['png', 'jpeg', 'webp', 'gif'])
+const fontMimes = new Set(['font/woff2', 'font/woff', 'font/ttf', 'font/otf'])
+
+/** SVG files are independent images. They may not hide another resource graph.
+ * XML features whose parsing differs from the HTML carrier walker are rejected. */
+export function assertSelfContainedSvg(bytes: Uint8Array, work?: (count: number) => void): void {
+  const source = Buffer.from(bytes).toString('utf8')
+  const body = source.replace(
+    /^\s*<\?xml\s+version\s*=\s*["']1\.[01]["'](?:\s+encoding\s*=\s*["']utf-8["'])?\s*\?>/i,
+    '',
+  )
+  if (/<\?|<!\s*(?:DOCTYPE|ENTITY|\[CDATA\[)/i.test(body)) throw new PrivateMaterializationError('unsupported')
+  let sawSvg = false
+  visitPrivateReferences(
+    body,
+    'https://private-media.invalid',
+    () => {
+      throw new PrivateMaterializationError('unsupported')
+    },
+    'html',
+    {
+      work,
+      url(raw) {
+        if (raw && !raw.startsWith('#')) throw new PrivateMaterializationError('unsupported')
+      },
+      element(tag, attributes) {
+        const lower = tag.toLowerCase()
+        if (lower === 'svg') sawSvg = true
+        if (
+          lower.includes(':') ||
+          [
+            'script',
+            'foreignobject',
+            'iframe',
+            'object',
+            'embed',
+            'audio',
+            'video',
+            'set',
+            'animate',
+            'animatemotion',
+            'animatetransform',
+            'discard',
+          ].includes(lower)
+        )
+          throw new PrivateMaterializationError('unsupported')
+        for (const [name, value] of Object.entries(attributes)) {
+          if (
+            name.startsWith('on') ||
+            name === 'xml:base' ||
+            (name.includes(':') && !['xlink:href', 'xmlns:xlink', 'xml:space', 'xml:lang'].includes(name))
+          )
+            throw new PrivateMaterializationError('unsupported')
+          if (
+            (name === 'xmlns' && value !== 'http://www.w3.org/2000/svg') ||
+            (name === 'xmlns:xlink' && value !== 'http://www.w3.org/1999/xlink')
+          )
+            throw new PrivateMaterializationError('unsupported')
+        }
+      },
+    },
+  )
+  if (!sawSvg) throw new PrivateMaterializationError('invalid')
+}
+
+/** Runs in the job's one decoder worker. `admit` reserves the shared cost
+ * before a full raster decode and before bytes are ever handed to Chromium. */
+export async function validateMedia(
+  input: MediaInput,
+  admit: (cost: MediaAdmission) => Promise<void>,
+  work?: (count: number) => void,
+): Promise<MediaAdmission> {
+  try {
+    const bytes = Buffer.from(input.bytes)
+    if (!bytes.length || bytes.length > PRIVATE_MEDIA_LIMITS.encodedBytes)
+      throw new PrivateMaterializationError('limit')
+    if (fontMimes.has(input.mime)) {
+      const inspection = inspectFontFile(bytes)
+      if (inspection.mime !== input.mime) throw new PrivateMaterializationError('invalid')
+      const cost = { decodedBytes: inspection.decodedBytes }
+      await admit(cost)
+      const font = inspection.read()
+      if (font.decodedBytes !== cost.decodedBytes) throw new PrivateMaterializationError('invalid')
+      return cost
+    }
+    const svg = input.mime === 'image/svg+xml'
+    let parserWork = 0
+    if (svg)
+      assertSelfContainedSvg(bytes, (count) => {
+        parserWork += count
+        work?.(count)
+      })
+    const image = sharp(bytes, { animated: true, limitInputPixels: PRIVATE_MEDIA_LIMITS.pixels })
+    const metadata = await image.metadata()
+    if (svg ? metadata.format !== 'svg' : !metadata.format || !rasterFormats.has(metadata.format))
+      throw new PrivateMaterializationError('unsupported')
+    const mime =
+      metadata.format === 'jpeg'
+        ? 'image/jpeg'
+        : metadata.format === 'svg'
+          ? 'image/svg+xml'
+          : `image/${metadata.format}`
+    if (mime !== input.mime) throw new PrivateMaterializationError('invalid')
+    const pages = metadata.pages ?? 1
+    const width = metadata.width ?? 0
+    const height = metadata.pageHeight ?? metadata.height ?? 0
+    if (pages > 1 && (!metadata.pageHeight || metadata.height !== height * pages))
+      throw new PrivateMaterializationError('invalid')
+    const cost = {
+      decodedBytes: rasterDecodedBytes(width, height, pages),
+      width,
+      height,
+      pages,
+      ...(svg ? { parserWork } : {}),
+    }
+    await admit(cost)
+    const decoded = await image.toColourspace('srgb').ensureAlpha().raw().toBuffer({ resolveWithObject: true })
+    if (
+      decoded.info.width !== width ||
+      decoded.info.height !== height * pages ||
+      decoded.info.channels !== 4 ||
+      decoded.data.length !== cost.decodedBytes
+    )
+      throw new PrivateMaterializationError('invalid')
+    return cost
+  } catch (error) {
+    if (error instanceof PrivateMaterializationError) throw error
+    // Sharp enforces its input-pixel ceiling even for metadata inspection.
+    if (error instanceof Error && error.message === 'Input image exceeds pixel limit')
+      throw new PrivateMaterializationError('limit')
+    throw new PrivateMaterializationError('invalid')
+  }
+}
