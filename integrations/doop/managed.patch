+import { afterEach, expect, it, vi } from 'vitest'
+vi.mock('../server/auth.ts', async (original) => ({
+  ...(await original<typeof import('../server/auth.ts')>()),
+  isBanned: async () => false,
+}))
+vi.mock('../server/db/persist.ts', async (original) => ({
+  ...(await original<typeof import('../server/db/persist.ts')>()),
+  saveFrame: vi.fn(),
+}))
+import * as assets from '../server/assets.ts'
+import { materializePrivateResources } from '../server/privateMaterialization.ts'
+import { frameReadScope } from '../server/privateResources.ts'
+import { store } from '../server/store.ts'
+import type { Canvas, Frame } from '../shared/types.ts'
+import { PRIVATE_MEDIA_LIMITS, PrivateMediaBudget, privateMediaAllowance } from '../shared/privateMedia.ts'
+
+afterEach(() => vi.restoreAllMocks())
+
+it('one resource reuses its encoded/decoded charge while repeated references and expansion still count', () => {
+  const budget = new PrivateMediaBudget()
+  const costs = {
+    resources: [{ key: 'private:canvas:file.png', mime: 'image/png', encodedBytes: 7, decodedBytes: 8 }],
+    references: 1,
+    parserWork: 2,
+    expandedBytes: 32,
+  }
+  budget.merge(costs)
+  budget.merge(costs)
+  expect(budget.usage).toEqual({ encodedBytes: 7, decodedBytes: 8, references: 2, parserWork: 4, expandedBytes: 64 })
+  budget.reference(62)
+  expect(() => budget.reference()).toThrow()
+})
+
+it('distinct identities cannot each spend a separate decoded budget', () => {
+  const budget = new PrivateMediaBudget(0, { decodedBytes: 12 })
+  budget.reserveDecoded('private:a:first.png', 8)
+  expect(() => budget.reserveDecoded('private:a:second.png', 8)).toThrow()
+  expect(() => budget.reserveDecoded('private:a:first.png', 9)).toThrow()
+})
+
+it('remaining allowances accept zero and reject forged, fractional or raised values', () => {
+  expect(privateMediaAllowance({ decodedBytes: 0 }).decodedBytes).toBe(0)
+  for (const invalid of [
+    null,
+    [],
+    { costs: [] },
+    { encodedBytes: PRIVATE_MEDIA_LIMITS.encodedBytes + 1 },
+    { references: -1 },
+    { references: 0.5 },
+    { parserWork: null },
+    { expandedBytes: Infinity },
+    { decodedBytes: NaN },
+  ])
+    expect(() => privateMediaAllowance(invalid)).toThrow()
+})
+
+it('the actual materializer rejects a lower encoded allowance before starting private storage IO', async () => {
+  const frame = {
+    id: 'cost-frame',
+    canvasId: 'cost-canvas',
+    name: 'Cost',
+    x: 0,
+    y: 0,
+    width: 16,
+    height: 16,
+    html: '<p>Cost</p>',
+    createdAt: 0,
+    updatedAt: 0,
+    updatedBy: 'cost-owner',
+  } as Frame
+  store.init([
+    { id: frame.canvasId, name: 'Cost', ownerId: 'cost-owner', frames: [frame], createdAt: 0, updatedAt: 0 } as Canvas,
+  ])
+  vi.spyOn(assets, 'assetMetadata').mockReturnValue({
+    id: 'cost-image',
+    canvasId: frame.canvasId,
+    ext: 'png',
+    mime: 'image/png',
+    size: 128,
+  } as NonNullable<ReturnType<typeof assets.assetMetadata>>)
+  const reads = vi.spyOn(assets, 'getAsset')
+  const scope = frameReadScope({ actorId: 'cost-owner', currentActor: async () => 'cost-owner' }, frame)
+  await expect(
+    materializePrivateResources('<img src="/a/cost-image.png">', scope, { limits: { encodedBytes: 127 } }),
+  ).rejects.toMatchObject({ kind: 'limit' })
+  expect(reads).not.toHaveBeenCalled()
+})
diff --git a/tests/privateMaterializationDrain.test.ts b/tests/privateMaterializationDrain.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b18e40f3d2e09828e305218f1d09792b773e1edc
--- /dev/null
+++ b/tests/privateMaterializationDrain.test.ts
@@ -0,0 +1,100 @@
+import { expect, it, vi } from 'vitest'
+import { constants } from 'node:fs'
+import { open, rename, rm } from 'node:fs/promises'
+import { execFileSync } from 'node:child_process'
+import path from 'node:path'
+import sharp from 'sharp'
+import { Client } from './harness'
+import { startPrivateServer } from './privateServer'
+
+it('real held disk reads retain all four materializer slots after the default thirty-second caller deadline', async () => {
+  const fixture = await startPrivateServer()
+  const pipes: { file: string; saved: string; writer?: Awaited<ReturnType<typeof open>> }[] = []
+  try {
+    const owner = await new Client(fixture.server).signUp('real-drain@test.dev', 'Disk drain')
+    const canvas = await (await owner.post('/api/canvases', { name: 'Actual disk drain' })).json()
+    const frame = await (
+      await owner.post(`/api/canvases/${canvas.id}/frames`, {
+        name: 'Drain',
+        x: 0,
+        y: 0,
+        width: 16,
+        height: 16,
+        html: '<p>Drain</p>',
+      })
+    ).json()
+    const urls: string[] = []
+    for (let index = 0; index < 4; index++) {
+      const image = await sharp({
+        create: { width: 4, height: 4, channels: 4, background: { r: 10 + index, g: 90, b: 40, alpha: 1 } },
+      })
+        .png()
+        .toBuffer()
+      const response = await owner.req(`/api/canvases/${canvas.id}/assets`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'image/png' },
+        body: new Uint8Array(image),
+      })
+      expect(response.status).toBe(200)
+      const url = (await response.json()).url as string
+      urls.push(url)
+      const file = path.join(fixture.server.dataDir, 'data', 'assets', path.basename(new URL(url).pathname))
+      const saved = file + '.drain-original'
+      await rename(file, saved)
+      pipes.push({ file, saved })
+      execFileSync('mkfifo', ['-m', '600', file])
+    }
+    const request = (source: string) =>
+      owner.post(`/api/canvases/${canvas.id}/private-materialization`, {
+        source,
+        syntax: 'html',
+        context: { kind: 'frame', id: frame.id },
+      })
+    const started = Date.now()
+    const held = urls.map((url) => request(`<img src="${url}">`))
+    // Opening each real FIFO writer proves the production disk reader began.
+    // No bytes/EOF are supplied until all caller responses have expired.
+    for (const pipe of pipes) {
+      await vi.waitFor(
+        async () => {
+          pipe.writer = await open(pipe.file, constants.O_WRONLY | constants.O_NONBLOCK)
+        },
+        { timeout: 10_000, interval: 20 },
+      )
+    }
+    const responses = await Promise.all(held)
+    expect(Date.now() - started).toBeGreaterThanOrEqual(29_000)
+    for (const response of responses) {
+      expect(response.status).toBe(503)
+      expect(await response.json()).toEqual({ error: 'Private media preparation was cancelled or timed out.' })
+    }
+    // This competing request uses PG only, so blocked filesystem threads cannot
+    // hide an incorrectly released permit behind another disk read.
+    let settled = false
+    const competitor = request('').then((response) => {
+      settled = true
+      return response
+    })
+    await new Promise((resolve) => setTimeout(resolve, 250))
+    expect(settled).toBe(false)
+    await pipes[0]!.writer!.close()
+    pipes[0]!.writer = undefined
+    const fresh = await competitor
+    expect(fresh.status).toBe(200)
+    expect((await fresh.json()).costs).toEqual({ resources: [], references: 0, parserWork: 0, expandedBytes: 0 })
+    // Repeated fresh claims must remain usable; drained stale readers can never
+    // publish the missing file or consume the transferred slot again.
+    expect((await request('')).status).toBe(200)
+    expect((await request('')).status).toBe(200)
+  } finally {
+    for (const pipe of pipes) {
+      // Unblock even a pending open on an early assertion/setup failure.
+      const unblock = await open(pipe.file, constants.O_RDWR | constants.O_NONBLOCK).catch(() => undefined)
+      await pipe.writer?.close().catch(() => {})
+      await unblock?.close().catch(() => {})
+      await rm(pipe.file, { force: true })
+      await rename(pipe.saved, pipe.file)
+    }
+    await fixture.close()
+  }
+}, 60_000)
