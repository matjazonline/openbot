<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.openbot.cloudroom-local</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/NODE24/bin/node</string><string>/ABSOLUTE/PLUGIN/services/run.mjs</string>
    <string>--source</string><string>/ABSOLUTE/cloudroom</string>
    <string>--profile</string><string>/ABSOLUTE/private-cloudroom-profile</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/cloudroom/gui</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/ABSOLUTE/NODE24/bin:/ABSOLUTE/PROVIDER/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>15</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
