  "guarantees": {
    "pluginReloadAndDurability": "PASS: live public SDK, disposable profile",
    "localCreateRequestIdIdempotency": "UNSUPPORTED: two equal requests created two scheduled threads",
    "queuedSendRequestIdIdempotency": "UNSUPPORTED: two equal sends produced two queue entries",
    "backgroundCancellation": "PASS: abort recorded before storage closes on reload",
    "targetedTurnStop": "UNSUPPORTED: public stop accepts only a thread ID",
    "terminalTurnCorrelation": "PASS: native client request -> accepted turn -> matching terminal event and output marker for Claude Code, Codex and OpenCode; idle/latest output alone is never used",
    "eventReplay": "PASS: nonempty public SDK pagination/replay for all 3 native providers; Claude/Codex history retained across server restart",
    "nativeProviderInference": "PASS: Claude Code 2.1.319, Codex 0.166.0 and OpenCode 1.19.5 in disposable projects using authorized local logins",
    "macOSUI": "PASS: actual built Cloudroom UI renders SDK-identical native threads for all 3 providers; real Codex approval denial and Claude user-question answer recover their native turns without a hosted account",
    "headlessLinux": "NOT EXERCISED",
    "acceptedCreateMetadataRecovery": "PASS: SIGKILL after SDK acceptance before plugin mapping; positive operation metadata recovered after server restart without a new spawn",
    "serverRestartIdentity": "PASS: same disposable profile retains secret, SQLite journal and host identity across crash and graceful restart",
    "twoClients": "PASS: public SDK and independent Cloudroom CLI share queued message order; active-turn interleaving NOT EXERCISED",
    "providerModelDiscovery": "PASS: Claude Code, Codex and OpenCode 1.19.5 public SDK catalogs; catalog discovery is distinct from authentication and inference",
    "activeThreadStop": "PASS: public thread-wide stop during native Codex shell execution yields interrupted for the same accepted turn; no atomic targeted-turn stop exists",
    "optionalLocalOnboarding": "PASS: reviewed UI-only patch, production build/typecheck, real native interaction controls visible without hosted account, manual setup opens and Skip setup dismisses",
    "mutationCancellation": "PASS: actual patched public SDK HTTP header/body waits abort for spawn/send/stop/archive/archiveAll, including pre-aborted calls; cancellation never proves native nonexecution",
    "eventSequence": "Strictly increasing retained-event cursors; completed streaming deltas may be compacted. Only completed message snapshots become terminal output; sequence gaps conservatively mark truncation."
  },
