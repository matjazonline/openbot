+import { withTestHarness } from "../helpers/test-app.js";
+
+async function skill(root: string) {
+  const files = [
+    { path: "SKILL.md",mode:0o644,bytes:Buffer.from("---\nname: required-proof\ndescription: Complete native directory\n---\nRead the script and adjacent files.\n") },
+    { path: ".bb-registry-skill.json",mode:0o644,bytes:Buffer.from("preserved supporting bytes\n") },
+    { path: "assets/data.bin",mode:0o644,bytes:Buffer.from([0,255,3,128]) },
+    { path: "scripts/run.sh",mode:0o755,bytes:Buffer.from('#!/bin/sh\nset -eu\nroot="$(dirname "$0")/.."\ncat "$root/.bb-registry-skill.json"\nshasum -a 256 "$root/assets/data.bin"\n') },
+  ];
+  for (const file of files) { const target=path.join(root,file.path); await mkdir(path.dirname(target),{recursive:true}); await writeFile(target,file.bytes); await chmod(target,file.mode); }
+  return { root:await fs.promises.realpath(root),files,hash:hashSkillTreeEntries(files) };
+}
+
+describe("required skill directory transfer",()=>{
+  it("authenticates the required route, preserves every byte/mode through production daemon staging and executes an adjacent-file script",async()=>{
+    await withTestHarness(async harness=>{
