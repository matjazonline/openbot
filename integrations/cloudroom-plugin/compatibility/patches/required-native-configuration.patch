+      await writeFile(path.join(root,file.path),file.bytes);
+    }
+    expect(files.reduce((total,file)=>total+file.bytes.length,0)).toBe(REQUIRED_TREE_LIMITS.totalBytes);
+    const hash=hashSkillTreeEntries(files);expect(readRequiredSkillTree(root,hash).entries).toHaveLength(REQUIRED_TREE_LIMITS.files);
+    registerRequiredSkillTree(root,hash);
+    const {host}=seedHostSession(harness.deps,{id:"host-required-max"});
