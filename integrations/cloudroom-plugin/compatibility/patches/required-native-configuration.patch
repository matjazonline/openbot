@@ -0,0 +1,15 @@
+import path from "node:path";
+import type { RequiredAgentConfiguration } from "@get-bb/plugin-sdk";
+
+export function normalizeRequiredAgentConfiguration(value: unknown): RequiredAgentConfiguration {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("Invalid required configuration");
+  const raw = value as Record<string, unknown>;
+  if (Object.keys(raw).some(key => key !== "instructions" && key !== "skillDirectories") || typeof raw.instructions !== "string" || Buffer.byteLength(raw.instructions) > 32768 || raw.instructions.includes("\0") || !Array.isArray(raw.skillDirectories) || raw.skillDirectories.length > 16) throw new Error("Invalid or oversized required configuration");
+  const skillDirectories = raw.skillDirectories.map(item => {
+    if (!item || typeof item !== "object" || Array.isArray(item)) throw new Error("Invalid required directory");
+    const entry = item as Record<string, unknown>;
+    if (Object.keys(entry).some(key => key !== "rootPath" && key !== "expectedTreeHash") || typeof entry.rootPath !== "string" || Buffer.byteLength(entry.rootPath) > 4096 || entry.rootPath.includes("\0") || !path.isAbsolute(entry.rootPath) || path.normalize(entry.rootPath) !== entry.rootPath || typeof entry.expectedTreeHash !== "string" || !/^[0-9a-f]{64}$/.test(entry.expectedTreeHash)) throw new Error("Invalid required directory descriptor");
+    return { rootPath: entry.rootPath, expectedTreeHash: entry.expectedTreeHash };
+  });
+  return { instructions: raw.instructions, skillDirectories };
+}
diff --git a/gui/apps/server/src/services/skills/required-skill-trees.ts b/gui/apps/server/src/services/skills/required-skill-trees.ts
new file mode 100644
index 0000000000000000000000000000000000000000..53769c9d50de1495a124d338974369f1121b2f0e
--- /dev/null
+++ b/gui/apps/server/src/services/skills/required-skill-trees.ts
@@ -0,0 +1,82 @@
+import fs from "node:fs";
+import path from "node:path";
+import { parse as parseYaml } from "yaml";
+import type { HostDaemonInjectedSkillSource } from "@cloudroom/host-daemon-contract";
+import { hashSkillTreeEntries, type SkillTreeEntry } from "./injected-skills.js";
+
+const roots = new Map<string, string>();
+export const REQUIRED_TREE_REGISTRY_LIMIT = 4096;
+export const REQUIRED_TREE_LIMITS = Object.freeze({ files: 65, entryBytes: 20 * 1024, fileBytes: 256 * 1024, totalBytes: 1024 * 1024, visitedEntries: 8192 });
+type FileDescriptor = { absolute: string; relative: string; stat: fs.Stats };
+
+function portable(relative: string): void {
+  if (!relative || Buffer.byteLength(relative) > 240 || !/^[A-Za-z0-9._/ -]+$/.test(relative) || relative.split("/").some(part => !part || part === "." || part === ".." || part.startsWith(" ") || /[. ]$/.test(part)) || (relative.split("/")[0]?.toLowerCase() === "skill.md" && relative !== "SKILL.md")) throw new Error("Unsafe required skill path");
+}
+
+function descriptors(root: string): FileDescriptor[] {
+  if (!path.isAbsolute(root) || Buffer.byteLength(root) > 4096 || path.normalize(root) !== root || fs.realpathSync(root) !== root || !fs.lstatSync(root).isDirectory()) throw new Error("Invalid required skill root");
+  const pending = [root]; const files: FileDescriptor[] = []; const paths = new Set<string>();
+  let total = 0; let visited = 0;
+  while (pending.length) {
+    const directory = fs.opendirSync(pending.pop()!);
+    try {
+      for (let entry = directory.readSync(); entry !== null; entry = directory.readSync()) {
+        if (++visited > REQUIRED_TREE_LIMITS.visitedEntries) throw new Error("Required tree entry count exceeded");
+        const absolute = path.join(directory.path, entry.name);
+        const relative = path.relative(root, absolute).split(path.sep).join("/"); portable(relative);
+        const folded = relative.toLowerCase(); if (paths.has(folded)) throw new Error("Required skill case collision"); paths.add(folded);
+        const stat = fs.lstatSync(absolute);
+        if (stat.isSymbolicLink()) throw new Error("Required skill symlink refused");
+        if (stat.isDirectory()) { pending.push(absolute); continue; }
+        if (!stat.isFile()) throw new Error("Required skill special file refused");
+        const limit = relative === "SKILL.md" ? REQUIRED_TREE_LIMITS.entryBytes : REQUIRED_TREE_LIMITS.fileBytes;
+        total += stat.size;
+        if (stat.size > limit || total > REQUIRED_TREE_LIMITS.totalBytes || files.length >= REQUIRED_TREE_LIMITS.files || ![0o644,0o755].includes(stat.mode & 0o777)) throw new Error("Required skill capacity or mode refused");
+        files.push({ absolute, relative, stat });
+      }
+    } finally { directory.closeSync(); }
+  }
+  if ([...paths].some(entry => !files.some(file => file.relative.toLowerCase() === entry || file.relative.toLowerCase().startsWith(`${entry}/`)))) throw new Error("Unexpected empty required directory");
+  if (!files.some(file => file.relative === "SKILL.md")) throw new Error("Required skill entry is missing");
+  return files;
+}
+
+function readBounded(file: FileDescriptor): SkillTreeEntry {
+  const fd = fs.openSync(file.absolute, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+  try {
+    const current = fs.fstatSync(fd);
+    if (!current.isFile() || current.ino !== file.stat.ino || current.dev !== file.stat.dev || current.size !== file.stat.size || current.mode !== file.stat.mode) throw new Error("Required file changed before read");
+    const bytes = Buffer.alloc(file.stat.size); let offset = 0;
+    while (offset < bytes.length) { const read = fs.readSync(fd, bytes, offset, bytes.length - offset, null); if (!read) throw new Error("Incomplete required file"); offset += read; }
+    if (fs.readSync(fd, Buffer.alloc(1),0,1,null) !== 0) throw new Error("Required file grew during read");
+    const after = fs.fstatSync(fd);
+    if (after.size !== current.size || after.mode !== current.mode || after.ctimeMs !== current.ctimeMs || after.mtimeMs !== current.mtimeMs) throw new Error("Required file changed during read");
+    return { path: file.relative, mode: current.mode & 0o777, bytes };
+  } finally { fs.closeSync(fd); }
+}
+
+export function readRequiredSkillTree(root: string, expectedTreeHash: string) {
+  const entries = descriptors(root).map(readBounded);
+  const treeHash = hashSkillTreeEntries(entries);
+  if (treeHash !== expectedTreeHash) throw new Error("Required tree hash mismatch");
+  const entry = entries.find(file => file.path === "SKILL.md")!;
+  const markdown = new TextDecoder("utf-8", { fatal: true }).decode(entry.bytes);
+  const header = /^\uFEFF?---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/.exec(markdown)?.[1];
+  if (header === undefined) throw new Error("Required skill frontmatter is missing");
+  const metadata: unknown = parseYaml(header, { maxAliasCount: 0 });
+  if (!metadata || typeof metadata !== "object" || !("name" in metadata) || typeof metadata.name !== "string" || !/^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$/.test(metadata.name) || !("description" in metadata) || typeof metadata.description !== "string" || !metadata.description.trim() || [...metadata.description].length > 1024) throw new Error("Invalid required skill metadata");
+  return { entries, treeHash, name: metadata.name, description: metadata.description };
+}
+
+export function registerRequiredSkillTree(root: string, expectedTreeHash: string): HostDaemonInjectedSkillSource {
+  const tree = readRequiredSkillTree(root, expectedTreeHash);
+  roots.delete(tree.treeHash); roots.set(tree.treeHash,root);
+  if (roots.size > REQUIRED_TREE_REGISTRY_LIMIT) roots.delete(roots.keys().next().value!);
+  return { kind: "required-tree", sourceType: "managed", treeHash: tree.treeHash, entryPath: "SKILL.md", name: tree.name, description: tree.description };
+}
+
+export function readRegisteredRequiredSkillTree(hash: string) {
+  const root = roots.get(hash); if (root === undefined) throw new Error("Required tree registration is unavailable");
+  roots.delete(hash); roots.set(hash,root);
+  return readRequiredSkillTree(root,hash);
+}
