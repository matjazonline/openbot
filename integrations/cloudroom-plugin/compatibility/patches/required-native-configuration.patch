+
+
+it("accepts exact count, file, entry and portable-path limits and refuses the next byte",async()=>{
+  await withTestHarness(async harness=>{
+    const root=(await skill(path.join(harness.config.dataDir,"required-max"))).root;
+    const markdown="---\nname: required-max\ndescription: Maximum complete directory\n---\n";
+    const files=[{path:"SKILL.md",mode:0o644,bytes:Buffer.from(markdown+"x".repeat(REQUIRED_TREE_LIMITS.entryBytes-Buffer.byteLength(markdown)))},
