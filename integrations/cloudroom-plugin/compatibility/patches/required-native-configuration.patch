+import { describe, expect, it } from "vitest";
+import { NativeToolOrigins, NATIVE_ORIGIN_LIMITS } from "../native-tool-origins.js";
+import { BB_BRIDGE_MCP_SERVER_NAME } from "../../tool-classification.js";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { InMemoryTransport } from "@modelcontextprotocol/sdk/inMemory.js";
+import { buildBridgeMcpServer } from "../tool-proxy-mcp.js";
+const tool = `mcp__${BB_BRIDGE_MCP_SERVER_NAME}__openbot_company_mcp`;
+const args = { alias: "crm", operation: "call", arguments: { key: "hello" } };
+
+describe("explicit native tool origins", () => {
+  it("forwards the actual outer MCP tool id without a descriptor after ambiguous native hooks", async () => {
+    const origins = new NativeToolOrigins();
+    origins.enqueue("creq_A", "same input");
+    origins.enqueue("creq_B", "same input");
+    const hooks = origins.hooks();
+    const common = { session_id: "sdk_session", transcript_path: "/fixture/transcript", cwd: "/fixture" };
+    const options = { signal: new AbortController().signal };
+    await hooks.UserPromptSubmit![0]!.hooks[0]!({ ...common, hook_event_name: "UserPromptSubmit", prompt_id: "prompt_B", prompt: "same input" }, undefined, options);
+    await hooks.PreToolUse![0]!.hooks[0]!({ ...common, hook_event_name: "PreToolUse", prompt_id: "prompt_B", tool_use_id: "toolu_B", tool_name: tool, tool_input: args }, "toolu_B", options);
+    const forwarded: unknown[] = [];
+    const server = buildBridgeMcpServer([{ name: "openbot_company_mcp", description: "fixture", inputSchema: { type: "object" } }], async (name, input, callId) => {
+      forwarded.push({ callId, invocation: origins.resolve(callId, name, input) });
+      return { content: "refused without native invocation" };
+    });
+    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+    await server.instance.connect(serverTransport);
+    const client = new Client({ name: "origin-boundary", version: "1" });
+    try {
+      await client.connect(clientTransport);
+      await client.callTool({ name: "openbot_company_mcp", arguments: args, _meta: { "claudecode/toolUseId": "toolu_B" } });
+      expect(forwarded).toEqual([{ callId: "toolu_B", invocation: undefined }]);
+    } finally { await client.close(); }
+  });
+
+  it("refuses identical pending inputs in either hook order without revoking unrelated proven calls", () => {
+    for (const first of ["prompt_A", "prompt_B"]) {
+      const origins = new NativeToolOrigins();
+      origins.enqueue("creq_proven", "proven input");
+      expect(origins.acknowledge("prompt_proven", "proven input")).toBe(true);
+      expect(origins.observeTool("prompt_proven", "toolu_proven", tool, args)).toBe(true);
+      origins.enqueue("creq_A", "same input");
+      origins.enqueue("creq_B", "same input");
+      expect(origins.acknowledge(first, "same input")).toBe(false);
+      expect(origins.acknowledge(first === "prompt_A" ? "prompt_B" : "prompt_A", "same input")).toBe(false);
+      expect(origins.observeTool("prompt_B", "toolu_B", tool, args)).toBe(false);
+      expect(origins.resolve("toolu_B", "openbot_company_mcp", args)).toBeUndefined();
+      expect(origins.resolve("toolu_proven", "openbot_company_mcp", args)?.clientRequestId).toBe("creq_proven");
+      origins.enqueue("creq_C", "unique C");
+      expect(origins.acknowledge("prompt_C", "unique C")).toBe(true);
+    }
+  });
+
+  it("never reuses cancelled input proof and invalidates a replayed prompt id after identical resubmission", () => {
+    const origins = new NativeToolOrigins();
+    const cancelled = origins.enqueue("creq_cancelled", "cancelled input");
+    origins.cancel(cancelled);
+    origins.enqueue("creq_later", "cancelled input");
+    expect(origins.acknowledge("prompt_delayed", "cancelled input")).toBe(false);
+    origins.enqueue("creq_A", "owned A");
+    expect(origins.acknowledge("prompt_A", "owned A")).toBe(true);
+    expect(origins.acknowledge("prompt_A", "owned A")).toBe(true);
+    expect(origins.observeTool("prompt_A", "toolu_A", tool, args)).toBe(true);
+    origins.enqueue("creq_replay", "owned A");
+    expect(origins.acknowledge("prompt_new", "owned A")).toBe(false);
+    expect(origins.resolve("toolu_A", "openbot_company_mcp", args)?.clientRequestId).toBe("creq_A");
+    expect(origins.acknowledge("prompt_A", "owned A")).toBe(false);
+    expect(origins.observeTool("prompt_A", "toolu_replay", tool, args)).toBe(false);
+    expect(origins.resolve("toolu_replay", "openbot_company_mcp", args)).toBeUndefined();
+  });
+
+  it("refuses the next prompt and tool record at the exact epoch bounds without reassigning old calls", () => {
+    const origins = new NativeToolOrigins();
+    for (let i=0;i<NATIVE_ORIGIN_LIMITS.prompts;i++) {
+      origins.enqueue(`creq_${i}`,`input ${i}`);
+      expect(origins.acknowledge(`prompt_${i}`,`input ${i}`)).toBe(true);
+    }
+    expect(()=>origins.enqueue("creq_overflow","overflow")).toThrow("identity unavailable");
+    for (let i=0;i<NATIVE_ORIGIN_LIMITS.calls;i++) expect(origins.observeTool("prompt_0",`toolu_${i}`,tool,args)).toBe(true);
+    expect(origins.observeTool("prompt_0","toolu_overflow",tool,args)).toBe(false);
+    expect(origins.resolve("toolu_overflow","openbot_company_mcp",args)).toBeUndefined();
+    expect(origins.resolve("toolu_0","openbot_company_mcp",args)?.clientRequestId).toBe("creq_0");
+  });
+
+  it("bounds submitted UTF-8 bytes and canonical tool arguments before identity hashing", () => {
+    const origins=new NativeToolOrigins();const input="é".repeat(NATIVE_ORIGIN_LIMITS.bytes/2);
+    origins.enqueue("creq_bytes",input);expect(origins.acknowledge("prompt_bytes",input)).toBe(true);
+    expect(()=>origins.enqueue("creq_too_large",input+"x")).toThrow("capacity exceeded");
+    const value={value:"x".repeat(NATIVE_ORIGIN_LIMITS.bytes-12)};
+    expect(origins.observeTool("prompt_bytes","toolu_bytes",tool,value)).toBe(true);
+    expect(()=>origins.observeTool("prompt_bytes","toolu_large",tool,{value:"x".repeat(NATIVE_ORIGIN_LIMITS.bytes)})).toThrow("capacity exceeded");
+    expect(origins.resolve("toolu_large","openbot_company_mcp",value)).toBeUndefined();
+  });
+
+  it("keeps A after queued B acknowledgment and refuses unknown/current-turn substitution", () => {
+    const origins = new NativeToolOrigins();
+    origins.enqueue("creq_A", "owned A"); origins.enqueue("creq_B", "owned B");
+    expect(origins.acknowledge("prompt_B", "owned B")).toBe(false);
+    expect(origins.acknowledge("prompt_A", "owned A")).toBe(true);
+    expect(origins.acknowledge("prompt_B", "owned B")).toBe(true);
+    expect(origins.observeTool("prompt_A", "toolu_A", tool, args)).toBe(true);
+    expect(origins.resolve("toolu_A", "openbot_company_mcp", args)).toEqual({ clientRequestId: "creq_A", callId: "toolu_A" });
+    expect(origins.resolve("call-1", "openbot_company_mcp", args)).toBeUndefined();
+    expect(origins.observeTool("unknown", "toolu_unknown", tool, args)).toBe(false);
+    expect(origins.resolve("toolu_unknown", "openbot_company_mcp", args)).toBeUndefined();
+  });
+
+  it("refuses conflicting tool/input identity, unowned prompts and replaced SDK epochs", () => {
+    const prior = new NativeToolOrigins(); prior.enqueue("creq_A", "owned A");
+    expect(prior.acknowledge("fake", "different input")).toBe(false);
+    prior.acknowledge("prompt_A", "owned A"); prior.observeTool("prompt_A", "toolu_A", tool, args);
+    expect(prior.resolve("toolu_A", "openbot_company_mcp", { ...args, alias: "other" })).toBeUndefined();
+    prior.close();
+    const replacement = new NativeToolOrigins(); replacement.enqueue("creq_B", "owned B"); replacement.acknowledge("prompt_B", "owned B");
+    replacement.observeTool("prompt_B", "toolu_A", tool, args);
+    expect(prior.resolve("toolu_A", "openbot_company_mcp", args)).toBeUndefined();
+    expect(prior.acknowledge("prompt_B", "owned B")).toBe(false);
+    expect(replacement.resolve("toolu_A", "openbot_company_mcp", args)?.clientRequestId).toBe("creq_B");
+    expect(replacement.observeTool("prompt_B", "toolu_A", tool, { ...args, alias: "changed" })).toBe(false);
+    expect(replacement.resolve("toolu_A", "openbot_company_mcp", args)).toBeUndefined();
+  });
+
+  it("does not grant native subagent/absent metadata authority and bounds the pending acknowledgment queue", () => {
+    const origins = new NativeToolOrigins();
+    for (let i = 0; i < NATIVE_ORIGIN_LIMITS.pending; i++) origins.enqueue(`creq_${i}`, `owned ${i}`);
+    expect(() => origins.enqueue("creq_overflow", "overflow")).toThrow("identity unavailable");
+    expect(origins.acknowledge("prompt_0", "owned 0", "subagent")).toBe(false);
+    expect(origins.acknowledge("prompt_0", "owned 0")).toBe(true);
+    expect(origins.observeTool("prompt_0", "toolu_0", tool, args, "subagent")).toBe(false);
+    expect(origins.resolve(undefined, "openbot_company_mcp", args)).toBeUndefined();
+    const pending = origins.enqueue("creq_extra", "owned extra"); origins.cancel(pending);
+    expect(origins.acknowledge("prompt_extra", "owned extra")).toBe(false);
+  });
+});
diff --git a/gui/plugins/provider-claude-code/src/bridge/native-tool-origins.ts b/gui/plugins/provider-claude-code/src/bridge/native-tool-origins.ts
