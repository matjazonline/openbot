+import { createServer } from "node:http";
+import { mkdtemp, mkdir, writeFile, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { once } from "node:events";
+import { it, expect } from "vitest";
+import { createIntegrationHarness } from "../helpers/harness.js";
+import { createProjectFixture } from "../helpers/fixtures.js";
+import { getThreadEvents } from "../helpers/api.js";
+
+async function ownedJson(file:string):Promise<any> {
+  const until=Date.now()+150000;
+  for(;;) {
+    await assertOwnedLive(path.dirname(file));
+    try{return JSON.parse(await readFile(file,"utf8"));}catch(error){if((error as NodeJS.ErrnoException).code!=="ENOENT")throw error;}
+    if(Date.now()>until)throw new Error(`Owned fixture handshake timed out: ${path.basename(file)}`);
+    await new Promise(resolve=>setTimeout(resolve,50));
+  }
+}
+
+async function assertOwnedLive(directory:string):Promise<void> {
+  try {await readFile(directory+"/abort.json");}
+  catch(error){if((error as NodeJS.ErrnoException).code==="ENOENT")return;throw error;}
+  throw new Error("Owned native fixture was cancelled");
+}
+async function writeOwned(file:string,value:unknown):Promise<void> {
+  const {rename}=await import("node:fs/promises");
+  await writeFile(file+".tmp",JSON.stringify(value,null,2));await rename(file+".tmp",file);
+}
+
+function reply(body:Record<string,any>):string {
+  const messages=JSON.stringify(body.messages??[]);
+  const definition=body.tools?.find((tool:any)=>tool.name.endsWith("__openbot_company_mcp"));
+  const search=!definition && messages.includes("NATIVE_COMPANY_MCP")
+    ? body.tools?.find((tool:any)=>tool.name==="ToolSearch"):undefined;
+  const results=(body.messages??[]).flatMap((message:any)=>Array.isArray(message.content)?message.content:[])
+    .filter((part:any)=>part.type==="tool_result");
+  const done=(id:string)=>results.some((part:any)=>part.tool_use_id===id);
+  const retained=/NATIVE_COMPANY_MCP_STATUS: ([0-9a-f-]{36})/.exec(messages);
+  const phase=retained?"status":!done("toolu_company_list")?"list":!done("toolu_company_describe")?"describe":"call";
+  const call=(definition||search) && !done(retained?"toolu_company_status":"toolu_company_call");
+  const id=definition?`toolu_company_${phase}`:`toolu_company_search_${messages.length}`;
+  const input=search?{query:"openbot_company_mcp"}:retained?{kind:"status",call_id:retained[1]}:phase==="list"?{kind:"list"}:phase==="describe"?{kind:"describe",alias:"crm.lookup"}
+    :{kind:"call",alias:"crm.lookup",arguments:{query:"actual native company MCP"}};
+  const message={id:"msg_company",type:"message",role:"assistant",content:[],model:body.model,stop_reason:null,stop_sequence:null,usage:{input_tokens:100,output_tokens:0}};
+  return [
+    ["message_start",{type:"message_start",message}],
+    ["content_block_start",{type:"content_block_start",index:0,content_block:call?{type:"tool_use",id,name:(definition??search).name,input:{}}:{type:"text",text:""}}],
+    ["content_block_delta",{type:"content_block_delta",index:0,delta:call?{type:"input_json_delta",partial_json:JSON.stringify(input)}:{type:"text_delta",text:"NATIVE_COMPANY_MCP_FINISHED"}}],
+    ["content_block_stop",{type:"content_block_stop",index:0}],
+    ["message_delta",{type:"message_delta",delta:{stop_reason:call?"tool_use":"end_turn",stop_sequence:null},usage:{output_tokens:20}}],
+    ["message_stop",{type:"message_stop"}],
+  ].map(([event,payload])=>`event: ${event}\ndata: ${JSON.stringify(payload)}\n\n`).join("");
+}
+
+it.skipIf(!process.env.OPENBOT_NATIVE_COMPANY_MCP_CONFIG)(
+  "runs the loaded Openbot proxy from the actual native Claude CLI through authenticated PostgreSQL broker approval and the normal MCP worker",
+  async()=>{
+    const config=JSON.parse(await readFile(process.env.OPENBOT_NATIVE_COMPANY_MCP_CONFIG!,"utf8"));
+    const root=await mkdtemp(path.join(tmpdir(),"openbot-native-company-mcp-"));
+    const observed:unknown[]=[];
+    const api=createServer(async(request,response)=>{
+      let raw="";for await(const chunk of request){raw+=chunk;if(Buffer.byteLength(raw)>4*1024*1024){response.writeHead(413).end();return;}}
+      if(request.url?.includes("count_tokens")){response.writeHead(200,{"content-type":"application/json"}).end('{"input_tokens":100}');return;}
+      const body=JSON.parse(raw||"{}");observed.push({model:body.model,messages:body.messages,tools:(body.tools??[]).map((tool:any)=>tool.name)});
+      response.writeHead(200,{"content-type":"text/event-stream"}).end(reply(body));
+    });
