+    });
+  });
+
+  it("refuses unregistered or changed trees and does not fall back to the ordinary registry",async()=>{
+    await withTestHarness(async harness=>{
+      const {host}=seedHostSession(harness.deps,{id:"host-required-refusal"});
+      const root=path.join(harness.config.dataDir,"required-changed"); const fixture=await skill(root);
+      harness.deps.skillTreeRegistry.register(fixture.hash,root);
+      const headers=internalAuthHeaders(harness,{hostId:host.id});
+      expect((await harness.app.request(`/internal/skills/required-tree/${fixture.hash}`,{headers})).status).toBe(404);
