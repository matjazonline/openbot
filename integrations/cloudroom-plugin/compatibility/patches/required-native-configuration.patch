index 0000000000000000000000000000000000000000..e31c62555bbcbf4ceb95d47210c01ed57c2ae605
--- /dev/null
+++ b/gui/plugins/provider-claude-code/src/bridge/native-tool-origins.ts
@@ -0,0 +1,143 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { HookCallback, Options } from "@anthropic-ai/claude-agent-sdk";
+import { BB_BRIDGE_MCP_SERVER_NAME } from "../tool-classification.js";
+
+export const NATIVE_ORIGIN_LIMITS = Object.freeze({ pending: 32, prompts: 256, calls: 4096, bytes: 128 * 1024 });
+export type ExplicitNativeInvocation = Readonly<{ clientRequestId: string; callId: string }>;
+type InputOwner = { token: string; request: string; digest: string };
+type ToolOwner = { request: string; prompt: string; tool: string; digest: string };
+const toolPrefix = `mcp__${BB_BRIDGE_MCP_SERVER_NAME}__`;
+const validId = (id: unknown): id is string =>
+  typeof id === "string" && id.length > 0 && id.length <= 128 && !/[\x00-\x1f\x7f]/.test(id);
+
+function inputDigest(text: string): string {
+  if (Buffer.byteLength(text) > NATIVE_ORIGIN_LIMITS.bytes) throw new Error("Native input identity capacity exceeded");
+  return createHash("sha256").update(text).digest("hex");
+}
+
+function toolDigest(value: unknown): string {
+  let nodes = 0;
+  let budget = NATIVE_ORIGIN_LIMITS.bytes;
+  const canonical = (item: unknown, depth: number): unknown => {
+    if (++nodes > 4096 || depth > 32) throw new Error("Native tool identity capacity exceeded");
+    if (item === null || typeof item === "boolean") return item;
+    if (typeof item === "number" && Number.isFinite(item)) return item;
+    if (typeof item === "string") {
+      budget -= Buffer.byteLength(item);
+      if (budget < 0) throw new Error("Native tool identity capacity exceeded");
+      return item;
+    }
+    if (Array.isArray(item)) return item.map((entry) => canonical(entry, depth + 1));
+    if (item && typeof item === "object") {
+      const entries = Object.entries(item);
+      if (entries.length > 4096) throw new Error("Native tool identity capacity exceeded");
+      return Object.fromEntries(entries.sort(([a], [b]) => a.localeCompare(b)).map(([key, entry]) => {
+        budget -= Buffer.byteLength(key);
+        if (budget < 0) throw new Error("Native tool identity capacity exceeded");
+        return [key, canonical(entry, depth + 1)];
+      }));
+    }
+    throw new Error("Invalid native tool identity input");
+  };
+  return inputDigest(JSON.stringify(canonical(value, 0)));
+}
+
+/** One exact SDK session owns this object. Replacement hooks never consult a resident session. */
+export class NativeToolOrigins {
+  private closed = false;
+  private readonly pending: InputOwner[] = [];
+  private readonly requests = new Set<string>();
+  // Retain cancelled and acknowledged digests for this bounded SDK epoch too:
+  // a delayed hook must never become proof for a later identical input.
+  private readonly inputDigests = new Set<string>();
+  private readonly ambiguousDigests = new Set<string>();
+  private readonly prompts = new Map<string, InputOwner | null>();
+  private readonly calls = new Map<string, ToolOwner | null>();
+
+  enqueue(clientRequestId: string, input: string): string {
+    if (this.closed || !validId(clientRequestId) || this.requests.has(clientRequestId)
+      || this.pending.length >= NATIVE_ORIGIN_LIMITS.pending || this.requests.size >= NATIVE_ORIGIN_LIMITS.prompts) {
+      throw new Error("Native input identity unavailable");
+    }
+    const owner = { token: randomUUID(), request: clientRequestId, digest: inputDigest(input) };
+    this.requests.add(clientRequestId);
+    if (this.inputDigests.has(owner.digest)) {
+      this.ambiguousDigests.add(owner.digest);
+      for (let i = this.pending.length - 1; i >= 0; i--) {
+        if (this.pending[i]!.digest === owner.digest) this.pending.splice(i, 1);
+      }
+      return owner.token;
+    }
+    this.inputDigests.add(owner.digest);
+    this.pending.push(owner);
+    return owner.token;
+  }
+
+  cancel(token: string): void {
+    const pending = this.pending.findIndex((owner) => owner.token === token);
+    if (pending >= 0) this.pending.splice(pending, 1);
+    for (const [prompt, owner] of this.prompts) if (owner?.token === token) this.prompts.set(prompt, null);
+  }
+
+  acknowledge(promptId: unknown, input: string, agentId?: string): boolean {
+    if (this.closed || agentId !== undefined || !validId(promptId)) return false;
+    const digest = inputDigest(input);
+    if (this.prompts.has(promptId)) {
+      const prior = this.prompts.get(promptId);
+      if (prior?.digest === digest && !this.ambiguousDigests.has(digest)) return true;
+      this.prompts.set(promptId, null);
+      return false;
+    }
+    if (this.ambiguousDigests.has(digest)) return false;
+    const owner = this.pending[0];
+    if (!owner || owner.digest !== digest || this.prompts.size >= NATIVE_ORIGIN_LIMITS.prompts) return false;
+    this.pending.shift();
+    this.prompts.set(promptId, owner);
+    return true;
+  }
+
+  observeTool(promptId: unknown, callId: unknown, tool: string, input: unknown, agentId?: string): boolean {
+    if (this.closed || agentId !== undefined || !validId(promptId) || !validId(callId) || (!tool.startsWith(toolPrefix) || tool.length > 512)) return false;
+    const owner = this.prompts.get(promptId);
+    if (!owner) return false;
+    const digest = toolDigest(input);
+    const prior = this.calls.get(callId);
+    if (this.calls.has(callId)) {
+      if (prior?.request === owner.request && prior.prompt === promptId && prior.tool === tool && prior.digest === digest) return true;
+      this.calls.set(callId, null);
+      return false;
+    }
+    if (this.calls.size >= NATIVE_ORIGIN_LIMITS.calls) return false;
+    this.calls.set(callId, { request: owner.request, prompt: promptId, tool, digest });
+    return true;
+  }
+
+  resolve(callId: unknown, tool: string, input: unknown): ExplicitNativeInvocation | undefined {
+    if (this.closed || !validId(callId)) return undefined;
+    const owner = this.calls.get(callId);
+    if (!owner || !this.prompts.get(owner.prompt) || owner.tool !== toolPrefix + tool || owner.digest !== toolDigest(input)) return undefined;
+    return Object.freeze({ clientRequestId: owner.request, callId });
+  }
+
+  close(): void {
+    this.closed = true;
+    this.pending.length = 0;
+    this.prompts.clear();
+    this.calls.clear();
+    this.requests.clear();
+    this.inputDigests.clear();
+    this.ambiguousDigests.clear();
+  }
+
+  hooks(): NonNullable<Options["hooks"]> {
+    const submitted: HookCallback = async (input) => {
+      if (input.hook_event_name === "UserPromptSubmit") this.acknowledge(input.prompt_id, input.prompt, input.agent_id);
+      return { continue: true };
+    };
+    const tool: HookCallback = async (input) => {
+      if (input.hook_event_name === "PreToolUse") this.observeTool(input.prompt_id, input.tool_use_id, input.tool_name, input.tool_input, input.agent_id);
+      return { continue: true };
+    };
+    return { UserPromptSubmit: [{ hooks: [submitted] }], PreToolUse: [{ hooks: [tool] }] };
+  }
+}
