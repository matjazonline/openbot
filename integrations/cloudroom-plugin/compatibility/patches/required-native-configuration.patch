+      for(const file of fixture.files) { expect(await readFile(path.join(stagedRoot,file.path))).toEqual(file.bytes); expect((await stat(path.join(stagedRoot,file.path))).mode & 0o777).toBe(file.mode); }
+      expect(await hashInstalledSkillDirectory({name:source.name,skillDirectoryPath:stagedRoot,sourceKind:"required-tree"})).toBe(fixture.hash);
