+        );
+        expect(pending, "actual native permission request must reach the persisted interaction path").toBeDefined();
+        approvals.push({ phase, interactionId: pending!.id, statusBeforeApproval: pending!.status });
+        expect(existsSync(targets[phase - 1]!)).toBe(false);
+        await pause(150);
+        expect((await sdk.threads.interactions.get({ threadId: thread.id, interactionId: pending!.id })).status).toBe("pending");
+        expect(existsSync(targets[phase - 1]!)).toBe(false);
+        await sdk.threads.interactions.resolve({
+          threadId: thread.id, interactionId: pending!.id,
+          resolution: { decision: "allow_once", grantedPermissions: null },
+        });
+        const effectDeadline = Date.now() + 20000;
+        while (!existsSync(targets[phase - 1]!) && Date.now() < effectDeadline) await pause(25);
+        expect(await readFile(targets[phase - 1]!, "utf8")).toContain(`OPENBOT_PERMISSION_RESUMED_${phase}`);
+        expect((await sdk.threads.interactions.get({ threadId: thread.id, interactionId: pending!.id })).status).toBe("resolved");
+        await waitForThreadStatus(harness.api, thread.id, "idle", 20000);
+      }
+      expect(observed.some((event) => event.phase === 1 && event.tool_result_received)).toBe(true);
+      expect(observed.some((event) => event.phase === 2 && event.tool_result_received)).toBe(true);
+      if (process.env.OPENBOT_NATIVE_PERMISSION_OUTPUT) await writeFile(
+        process.env.OPENBOT_NATIVE_PERMISSION_OUTPUT,
+        JSON.stringify({ status: "PASS", modeRecords, approvals, pendingBeforeApproval: 2, protectedEffectsBeforeApproval: 0, resolvedAndContinued: 2, observed,
+          limitations: "Actual pinned server, daemon, Claude bridge and native CLI with isolated local scripted Messages; no model reasoning or paid inference claimed.",
+        }, null, 2) + "\n",
+      );
+    } finally {
+      if (harness) {
+        if (threadId && sdk) await sdk.threads.stop({ threadId }).catch(() => {});
+        await harness.cleanup();
+        await harness.server.pluginService.stop();
+      }
+      api.closeAllConnections();
+      await new Promise<void>((resolve) => api.close(() => resolve()));
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+  120000,
+);
