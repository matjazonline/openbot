+        expect(response.status).toBe(200); return hostDaemonSkillTreeSchema.parse(await response.json());
+      };
+      const unauthenticated=await harness.app.request(`/internal/skills/required-tree/${fixture.hash}`);
+      expect(unauthenticated.status).toBe(401);
