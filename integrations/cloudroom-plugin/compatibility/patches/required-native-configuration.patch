+      expect(result.stdout).toContain("preserved supporting bytes"); expect(result.stdout).toContain("assets/data.bin");
+      expect(readSkillTreeManifest(fixture.root).entries.some(file=>file.path===".bb-registry-skill.json")).toBe(false);
+      expect(readRequiredSkillTree(fixture.root,fixture.hash).entries.some(file=>file.path===".bb-registry-skill.json")).toBe(true);
+      await writeFile(path.join(stagedRoot,"assets/data.bin"),"tampered");
