  "query": "SELECT i.id, i.company_id, c.name as \"company_name?\", i.email, i.status, i.created_at as \"created_at!\"\n               FROM company_invites i\n               JOIN companies c ON c.id = i.company_id\n               WHERE i.email = $1\n               ORDER BY i.created_at DESC, i.id DESC LIMIT 200",
