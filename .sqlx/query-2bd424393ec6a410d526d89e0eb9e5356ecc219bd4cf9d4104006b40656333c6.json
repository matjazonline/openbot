  "query": "SELECT m.id, m.company_id, m.user_id, u.username as \"username?\", u.email as \"email?\", u.avatar_url, m.role, m.created_at as \"created_at!\"\n               FROM company_members m\n               JOIN users u ON u.id = m.user_id\n               WHERE m.company_id = $1\n               ORDER BY m.created_at ASC, m.id ASC LIMIT 200",
