                  },
                  "confidence": 0.8
                },
                "severity": {
                  "type": "score",
                  "score": 1.5,
                  "probabilities": {
                    "0": 0.1,
                    "1": 0.3,
                    "2": 0.6
                  },
                  "legend": {
                    "0": "Cosmetic",
                    "1": "Workaround available",
                    "2": "Blocking"
                  },
                  "confidence": 0.7
                }
              },
              "usage": {
                "input_tokens": 120,
