{
  "source": {
    "format_version": 1,
    "workflow_id": "00000000-0000-0000-0000-000000000001",
    "input_schema": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "thread_id",
        "raw"
      ],
      "additionalProperties": false
    },
    "parameter_schema": {
      "type": "object",
      "properties": {
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "user"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reviewers"
      ],
      "additionalProperties": false
    },
    "output_schema": true,
    "resources": [
      {
        "slot": "service",
        "kind": "http"
      }
    ],
    "entry": "start",
    "steps": {
      "start": {
        "type": "http.request",
        "with": {
          "connection": {
            "literal": "service"
          },
          "method": {
            "literal": "POST"
          },
          "path": {
            "literal": "/gmail/v1/users/me/messages/send"
          },
          "headers": {
            "literal": {
              "Accept": "application/json",
              "Content-Type": "application/json"
            }
          },
          "body": {
            "object": {
              "threadId": {
                "ref": "/input/thread_id"
              },
              "raw": {
                "ref": "/input/raw"
              }
            }
          },
          "approval": {
            "object": {
              "reviewers": {
                "ref": "/params/reviewers"
              },
              "deadline": {
                "ref": "/run/deadline"
              }
            }
          }
        },
        "routes": {
          "success": "$end"
        }
      }
    },
    "limits": {
      "max_steps": 10,
      "max_context_bytes": 65536
    }
  },
