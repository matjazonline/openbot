DATABASE_URL=postgres://user:password@localhost/mail_agents
RUST_LOG="mail_agents=debug,tower_http=debug,sqlx=warn"
REFRESH_TOKEN_TTL_DAYS="30"
JWT_SECRET=replace_this_with_a_random_secret
APP_DOMAIN_NAME=localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@localhost
INCOMING_SMTP_ENABLED=true
INCOMING_SMTP_HOST=0.0.0.0
INCOMING_SMTP_PORT=2525

# Spam Scanning Settings
# MAX_SPAM_SCORE: Threshold score above which an inbound email is rejected as spam.
MAX_SPAM_SCORE=5.0

# ENABLE_HEURISTIC_SCANNER: Stage 1 local pattern matcher (default: true).
# Set to false along with ENABLE_SPAM_SCANNER and ENABLE_LLM_SPAM_GUARDRAIL to completely disable spam scan.
ENABLE_HEURISTIC_SCANNER=true

# ENABLE_SPAM_SCANNER: Stage 2 external daemon scan (Rspamd or SpamAssassin) (default: false).
ENABLE_SPAM_SCANNER=false
SPAM_SCANNER_TYPE=rspamd
SPAM_SCANNER_URL=http://localhost:11333/checkv2

# ENABLE_LLM_SPAM_GUARDRAIL: Stage 3 LLM prompt injection and security check (default: false).
ENABLE_LLM_SPAM_GUARDRAIL=false

# INCOMING_SMTP_DNSBL_ENABLED: Real-time DNS IP Blacklist checking during SMTP HELO (default: false).
INCOMING_SMTP_DNSBL_ENABLED=false

# NOTE ON DISABLED SPAM SCAN:
# When all spam scan options (HEURISTIC, SPAM_SCANNER, LLM_GUARDRAIL) are set to false,
# spam protection is completely disabled. In this state, saving a workflow without participant
# email restrictions requires explicit user confirmation (`confirm_spam_disabled=true`)
# to acknowledge that open/public workflows will process emails without spam filtering.




