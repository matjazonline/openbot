DATABASE_URL=postgres://user:password@localhost/mail_agents
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=10
RUST_LOG="mail_agents=debug,tower_http=debug,sqlx=warn"
ENABLE_AI_AGENTS_OBSERVABILITY=false
ACCESS_TOKEN_TTL_SECS="30"
REFRESH_TOKEN_TTL_DAYS="30"
# Signs every session cookie, so this is the key to every account: at least 32 characters, and
# the app refuses to start with less. `openssl rand -base64 48` is a fine way to make one.
JWT_SECRET=replace_this_with_a_random_secret
# Optional. Whether session cookies are marked `Secure`. Derived from APP_DOMAIN_NAME (off for
# localhost, on for a real domain); set it only when TLS terminates somewhere the app cannot see.
COOKIE_SECURE=
APP_DOMAIN_NAME=localhost
# Comma-separated addresses that see /ui/dashboard across every company rather than scoped
# to one. Unset means nobody does; a company `admin` is not a system operator.
OPERATOR_EMAILS=
# Comma-separated browser origins allowed to call the API with credentials.
# Wildcards are not possible here because credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@localhost
# Registration requires a six-digit email confirmation code only when SMTP_HOST is non-local and
# SMTP_FROM_ADDRESS is explicitly changed from noreply@localhost. Otherwise confirmation is skipped.
INCOMING_SMTP_ENABLED=true
INCOMING_SMTP_HOST=0.0.0.0
INCOMING_SMTP_PORT=2525
INCOMING_SMTP_DNSBL_SERVERS=zen.spamhaus.org,bl.spamcop.net
INCOMING_SMTP_RATE_LIMIT_PER_IP=30
INCOMING_SMTP_REJECT_SELF_HELO=true

# Optional provider credentials. The selected provider-specific key takes precedence; LLM_API_KEY
# and API_KEY are fallbacks for custom provider names.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_API_KEY=
API_KEY=

# File uploads (avatars). Both are needed together, or uploads stay off and the picture
# pickers say so. The key is the service account JSON file, base64-encoded, because JSON does
# not survive an environment variable intact:
#   base64 -i service-account.json | tr -d '\n'
# The service account needs Storage Object Creator on the bucket, and the bucket has to be
# publicly readable for a browser to load what it stores.
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_JSON_BASE64=
# Optional. A CDN or custom domain in front of the bucket; defaults to
# https://storage.googleapis.com/$GCS_BUCKET
GCS_PUBLIC_BASE_URL=
# Optional. The folder inside the bucket avatars are written to (default: avatars).
GCS_AVATAR_FOLDER=
# Mail attachments. A SEPARATE bucket with no public access at all: what arrives on a channel is
# served only by this app, to whoever that channel's participant rules allow. Unset means
# attachments are recorded but not stored.
GCS_ATTACHMENTS_BUCKET=
# Optional. The folder inside the private bucket (default: attachments).
GCS_ATTACHMENTS_FOLDER=

# Spam Scanning Settings
# MAX_SPAM_SCORE: Threshold score above which an inbound email is rejected as spam.
MAX_SPAM_SCORE=5.0

# ENABLE_HEURISTIC_SCANNER: Stage 1 local pattern matcher (default: true).
# Set to false along with ENABLE_SPAM_SCANNER and ENABLE_LLM_SPAM_GUARDRAIL to completely disable spam scan.
ENABLE_HEURISTIC_SCANNER=true

# ENABLE_SPAM_SCANNER: Stage 2 external daemon scan (Rspamd or SpamAssassin) (default: false).
ENABLE_SPAM_SCANNER=false
SPAM_SCANNER_TYPE=rspamd
SPAM_SCANNER_URL=http://localhost:11333/checkv2

# ENABLE_LLM_SPAM_GUARDRAIL: Stage 3 LLM prompt injection and security check (default: false).
ENABLE_LLM_SPAM_GUARDRAIL=false

# INCOMING_SMTP_DNSBL_ENABLED: Real-time DNS IP Blacklist checking during SMTP HELO (default: false).
INCOMING_SMTP_DNSBL_ENABLED=false

# NOTE ON DISABLED SPAM SCAN:
# When all spam scan options (HEURISTIC, SPAM_SCANNER, LLM_GUARDRAIL) are set to false,
# spam protection is completely disabled. In this state, saving a workflow without participant
# email restrictions requires explicit user confirmation (`confirm_spam_disabled=true`)
# to acknowledge that open/public workflows will process emails without spam filtering.
