DATABASE_URL=postgres://user:password@localhost/mail_agents
# Optional. Maximum number of connections in the database pool (default: 10).
#DATABASE_MAX_CONNECTIONS=10
# Optional. Maximum time to wait for a database connection (default: 10 seconds).
#DATABASE_ACQUIRE_TIMEOUT_SECS=10
# Maximum agent tasks executed concurrently by this process (valid range: 1-64).
TASK_WORKER_CONCURRENCY=16
RUST_LOG="mail_agents=debug,tower_http=debug,sqlx=warn"
# Optional. Enables AI-agent observability instrumentation (default: false).
#ENABLE_AI_AGENTS_OBSERVABILITY=false
# Optional. Refresh-token lifetime in days (default: 30).
#REFRESH_TOKEN_TTL_DAYS="30"
# Signs every session cookie, so this is the key to every account: at least 32 characters, and
# the app refuses to start with less. `openssl rand -base64 48` is a fine way to make one.
JWT_SECRET=replace_this_with_a_random_secret
# Optional. Whether browsers must use HTTPS for session and OAuth cookies. When unset, this is
# derived from APP_DOMAIN_NAME: false for localhost/127.0.0.1 and true for a real domain. Set it
# explicitly when the public scheme cannot be inferred (for example, behind a TLS-terminating
# proxy). Use true in production and false only for local HTTP development. An empty value counts
# as false, so comment out this line to use the derived default.
# COOKIE_SECURE=true
APP_DOMAIN_NAME=localhost
# Optional Google registration/login. Configure this redirect URI in Google Cloud:
# http://localhost/auth/google/callback (include APP_DOMAIN_NAME's port when it has one).
# Set both values or neither; Google buttons are hidden when they are absent.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Optional Sign in with Apple. Apple requires a real HTTPS domain and does not accept localhost.
# Register https://<APP_DOMAIN_NAME>/auth/apple/callback as the Services ID return URL.
# Base64-encode the downloaded .p8 private key. Set all four values or none.
#APPLE_OAUTH_CLIENT_ID=
#APPLE_OAUTH_TEAM_ID=
#APPLE_OAUTH_KEY_ID=
#APPLE_OAUTH_PRIVATE_KEY_BASE64=
# Comma-separated addresses that see /ui/dashboard across every company rather than scoped
# to one. Unset means nobody does; a company `admin` is not a system operator.
OPERATOR_EMAILS=
# Comma-separated browser origins allowed to call the API with credentials.
# Wildcards are not possible here because credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Registration requires a six-digit email confirmation code only when SMTP_HOST is non-local and
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM_ADDRESS is explicitly changed from noreply@localhost. Otherwise confirmation is skipped.
SMTP_FROM_ADDRESS=noreply@localhost

INCOMING_SMTP_ENABLED=true
INCOMING_SMTP_HOST=0.0.0.0
INCOMING_SMTP_PORT=2525
# Optional SendGrid Inbound Parse. The public key is the ECDSA P-256 PEM key configured by
# SendGrid; requests are signed over the untouched timestamp + request body.
#SENDGRID_INBOUND_ENABLED=false
#SENDGRID_WEBHOOK_PUBLIC_KEY=
#SENDGRID_WEBHOOK_MAX_AGE_SECS=300
#INCOMING_SMTP_DNSBL_SERVERS=zen.spamhaus.org,bl.spamcop.net
#INCOMING_SMTP_RATE_LIMIT_PER_IP=30
#INCOMING_SMTP_REJECT_SELF_HELO=true

# Required for provider credentials stored in PostgreSQL. Generate a 32-byte key and base64 it.
# Keep old versioned keys in the list during rotation; the highest version encrypts new values.
# Example: 1:BASE64_KEY,2:NEW_BASE64_KEY
CREDENTIAL_ENCRYPTION_KEYS=

# Optional HydraDB long-term memory. These four values are all-or-none; startup rejects partial
# configuration, non-positive timeouts, non-HTTP(S) base URLs, and a thinking timeout shorter
# than the fast timeout. The API key is deployment-wide and is never stored in PostgreSQL.
#HYDRA_DB_API_KEY=
#HYDRA_DB_BASE_URL=https://api.hydradb.example
#HYDRA_DB_FAST_TIMEOUT_SECS=10
#HYDRA_DB_THINKING_TIMEOUT_SECS=60

# File uploads (avatars). Both are needed together, or uploads stay off and the picture pickers
# say so. The key is the service account JSON file, base64-encoded, because JSON does not survive
# an environment variable intact:
#   base64 -i service-account.json | tr -d '\n'
# The service account needs Storage Object Creator on the bucket, and the bucket has to be publicly
# readable for a browser to load what it stores.
GCS_SERVICE_ACCOUNT_JSON_BASE64=
GCS_AVATAR_BUCKET_PUBLIC=
# Optional. A CDN or custom domain in front of the bucket; defaults to
# https://storage.googleapis.com/$GCS_AVATAR_BUCKET_PUBLIC
#GCS_PUBLIC_BASE_URL=
# Optional. The folder inside the bucket avatars are written to (default: avatars).
#GCS_AVATAR_FOLDER=
# Mail attachments use a separate private storage/security boundary. This bucket must have no
# public access: what arrives on a channel is served only by this app, to whoever that channel's
# participant rules allow. Unset means attachments are recorded but not stored.
GCS_ATTACHMENTS_BUCKET_PRIVATE=
# Optional. The object-key prefix inside the private bucket, useful when sharing a bucket between
# environments or applications (default: $APP_DOMAIN_NAME/mail-attachments).
#GCS_ATTACHMENTS_FOLDER=

# Spam Scanning Settings
# MAX_SPAM_SCORE: Threshold score above which an inbound email is rejected as spam.
MAX_SPAM_SCORE=4.0

# ENABLE_HEURISTIC_SCANNER: Stage 1 local pattern matcher (default: true).
# Set to false along with ENABLE_SPAM_SCANNER and ENABLE_LLM_SPAM_GUARDRAIL to completely disable spam scan.
ENABLE_HEURISTIC_SCANNER=true

# ENABLE_SPAM_SCANNER: Stage 2 external daemon scan (Rspamd or SpamAssassin) (default: false).
#ENABLE_SPAM_SCANNER=false
#SPAM_SCANNER_TYPE=rspamd
#SPAM_SCANNER_URL=http://localhost:11333/checkv2

# ENABLE_LLM_SPAM_GUARDRAIL: Stage 3 LLM prompt injection and security check (default: false).
#ENABLE_LLM_SPAM_GUARDRAIL=false

# INCOMING_SMTP_DNSBL_ENABLED: Real-time DNS IP Blacklist checking during SMTP HELO (default: false).
#INCOMING_SMTP_DNSBL_ENABLED=false

# NOTE ON DISABLED SPAM SCAN:
# When all spam scan options (HEURISTIC, SPAM_SCANNER, LLM_GUARDRAIL) are set to false,
# spam protection is completely disabled. In this state, saving a workflow without participant
# email restrictions requires explicit user confirmation (`confirm_spam_disabled=true`)
# to acknowledge that open/public workflows will process emails without spam filtering.
