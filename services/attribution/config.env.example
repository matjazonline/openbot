# Examples contain no credentials. Set the database URL through your secret store.
ATTRIBUTION_DATABASE_URL=postgres://attribution@localhost/attribution
ATTRIBUTION_PUBLIC_ORIGIN=http://localhost:8091
ATTRIBUTION_BIND_ADDR=127.0.0.1:8091
ATTRIBUTION_DB_MAX_CONNECTIONS=5
# Explicit local fixture choices, not approved production delivery/refund policy.
# Both are required integers in 1..3650. Retention must cover these horizons.
ATTRIBUTION_EVENT_MAX_AGE_DAYS=7
ATTRIBUTION_REFUND_WINDOW_DAYS=365
ATTRIBUTION_CLICK_RETENTION_DAYS=38
ATTRIBUTION_OBSERVATION_RETENTION_DAYS=30
ATTRIBUTION_FINANCIAL_RETENTION_DAYS=400
ATTRIBUTION_EVENT_RETENTION_DAYS=8
ATTRIBUTION_AUDIT_RETENTION_DAYS=90
RUST_LOG=attribution_service=info

# Required for serve; migrate does not require identity secrets.
ATTRIBUTION_OPENBOT_ORIGIN=https://openbot.example.test
# Generate each value independently: unpadded base64url of 32 random bytes.
# ATTRIBUTION_CLIENT_SECRET=<registered confidential-client secret>
# ATTRIBUTION_LIFECYCLE_SECRET=<dedicated lifecycle delivery secret>
# ATTRIBUTION_SESSION_KEYS={"active":1,"keys":[{"version":1,"key":"<32-byte key in base64url>"}]}
# Optional bounded lifecycle rotation (both keys required together):
# ATTRIBUTION_PREVIOUS_LIFECYCLE_SECRET=<previous delivery secret>
# ATTRIBUTION_PREVIOUS_LIFECYCLE_SECRET_EXPIRES_AT=<RFC3339 instant within 24 hours>
