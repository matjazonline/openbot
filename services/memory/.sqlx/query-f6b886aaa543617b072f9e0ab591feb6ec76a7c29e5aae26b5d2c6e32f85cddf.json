  "db_name": "PostgreSQL",
  "query": "SELECT g.namespace_id, n.external_id, g.read_max::smallint AS read_max, g.write_max::smallint AS write_max, g.operations FROM credential_grants AS g JOIN namespaces AS n ON (n.tenant_id, n.id) = (g.tenant_id, g.namespace_id) WHERE g.tenant_id = $1 AND g.credential_id = $2 AND n.state = 'active' ORDER BY n.external_id",
